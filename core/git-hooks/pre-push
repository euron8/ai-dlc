#!/usr/bin/env bash
# pre-push — the CONSUMER's local gate. Shipped by AI/DLC, run by the consumer.
#
# THE GAP THIS CLOSES. `validate-layer-entries.sh` is correct, fires on real
# consumers, and — until now — was bound to nothing but `retro.md`, which runs AFTER
# the sprint has already paid for the drift. Rule 27 has no gate check and no
# `enforcement-map.yaml` row, so layer hygiene was enforced by a human remembering to
# type a command. That is the same half-wired shape v0.52.0 is named for, one layer up.
#
# WHY NOT GITHUB ACTIONS. Operator policy: no CI in GitHub, here or in the
# distribution. A gate hosted in a service we do not run is a gate we do not control.
# This runs on the machine doing the pushing: no runner, no network, no third party.
#
# WHAT IT DOES NOT DO. It runs LOCALLY DECIDABLE checks only. Gate-time validators
# (provenance, retro evidence, adversarial convergence, steering budget) need live pipeline
# state and belong at their gates, not here. Putting them in a push hook would make them
# fire on every unrelated service commit, and a gate that fires on everything gets turned off.
# This line read "only TREE-LEVEL checks — ones decidable from the files on disk" until
# arm 0, which judges the commits being pushed. That was the right boundary described by the
# wrong measure: the ref protocol arrives on stdin and needs no more pipeline state than a
# file does. Everything here is still decidable on this machine with no gate and no network.
#
# ENABLE (once per clone, and NOT before your layer entries are clean — see below):
#     git config core.hooksPath .githooks
#
# ORDERING HAZARD, STATED PLAINLY. If `validate-layer-entries.sh` currently exits 1 on
# your repo, enabling this hook blocks your next push. Installing the FILE is
# therefore harmless and automatic; ENABLING it is an explicit operator action you take
# once the tree is clean. Run the checks by hand first:
#
#     bash scripts/ai-dlc/validate-layer-entries.sh
#
# `git push --no-verify` bypasses the hook. That is a decision made on the record,
# not a default fallen into.
#
# AI_DLC_READSET_LIVE_TRACE=0 stops the detached read-set trace a green suite starts for its
# unmapped fixtures (readset_live_trace); default on. It needs sandbox-exec, /usr/bin/log and
# python3, and without them the hook says so in one line and behaves as it did before.

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

# git hands a pre-push hook the ref protocol ON STDIN, and it can be read once. Drain it HERE,
# before any step runs, because a later step that reads stdin would leave arm 0 judging nothing —
# and arm 0 judging nothing looks exactly like arm 0 finding nothing wrong.
# `[ -t 0 ]` guards the other direction: this file is run by hand during development, and an
# unguarded `cat` would hang on a terminal forever. On a terminal REFS stays empty and arm 0 says
# so in its own words rather than reporting a pass it did not earn.
PUSH_REFS=""
[ -t 0 ] || PUSH_REFS="$(cat)"

fail=0
step() {
  printf '\n── %s\n' "$1"; shift
  if "$@"; then printf '   PASS\n'; else printf '   FAIL\n'; fail=1; fi
}

# 0. THE ONLY ARM HERE THAT JUDGES THE PUSH RATHER THAN THE TREE, and the header's "only
#    TREE-LEVEL checks" line is written to admit it. The distinction that line was drawing is
#    between what is decidable locally and what needs live pipeline state; the ref protocol is
#    the former — it arrives on stdin, costs nothing, and needs no gate.
#    WHAT IT IS FOR. retro.md Step 5b cannot route one commit through a PR: the retro-PR merge
#    SHA is not knowable until that PR has merged, so Step 5b tells the lead to push the SHA
#    straight to the trunk. That sentence is a standing licence to write to `main` outside the
#    PR route, and core shipped it with nothing defining what it licenses — no subject, no path
#    bound, no reader. On the reference consumer it has been exercised 106 times.
#    It bounds that commit; it does not police the trunk. See the schema's
#    `$backfill_commit_comment` for what is deliberately left alone and why.
trunk_push() { printf '%s' "$PUSH_REFS" | bash scripts/ai-dlc/validate-audit-anchors.sh --trunk-push; }
if [ -f scripts/ai-dlc/validate-audit-anchors.sh ]; then
  step "trunk push (the Step 5b backfill commit is the only one this arm bounds)" trunk_push
fi

# 1. Rule 27 layer hygiene. Overrides carry a resolvable `base_sha`; extension checks
#    do not collide with a core check NUMBER (a bare "Check N" in a gate log has no
#    referent when two catalogs share one integer). THE check this hook exists for.
if [ -f scripts/ai-dlc/validate-layer-entries.sh ]; then
  step "layer entries (Rule 27: override base_sha, catalog collisions)" \
    bash scripts/ai-dlc/validate-layer-entries.sh
fi

# 2. The context bands derive from the resolved effective window, so red fires
#    before the harness compacts by construction. This guards the lead constants
#    (yellow > red > imminent > 0, red with runway to spare) and reports the
#    resolved autoCompactWindow, FAILing on an out-of-range value. Decidable from
#    disk.
if [ -f scripts/ai-dlc/validate-compact-window.sh ]; then
  step "compact-window invariant" \
    bash scripts/ai-dlc/validate-compact-window.sh
fi

# 3. The schema an agent is TAUGHT and the schema the gate READS must be the same schema.
#    When they diverged, the role file taught a provenance block in a ``` fence, the adversary
#    emitted exactly that, the parser matched nothing, and validate-provenance-block.sh said
#    "no provenance block required or present" and exited 0 — so two full adversarial passes
#    of a real sprint went unadjudicated and the gate called them clean. An unparseable block
#    scores exactly like a clean artifact.
if [ -f scripts/ai-dlc/sync-taught-schema.sh ]; then
  step "taught schema == read schema (provenance examples derive from schemas/)" \
    bash scripts/ai-dlc/sync-taught-schema.sh --check
fi

# 3a. The corpus-wide floor under the current-scope carve-out. Every gate-time reader of a
#     provenance block is handed ONE artifact it was already told is in scope, and the scope rule
#     deliberately forgives historical informational blocks so an ever-growing artifact tree does
#     not brick every future sprint. A party-mode block RELOCATED into a file with no
#     pipeline-validation purpose — the shape that evades the retro's transcript-SHA match — is
#     therefore invisible to all of them, not by oversight but by construction: the file it moved
#     to is never in anyone's scope. This is the only reader whose subject is the tree.
#     Decidable from disk, which is why it belongs here and not at a gate.
if [ -f scripts/ai-dlc/validate-provenance-block.sh ]; then
  step "stray party-mode provenance (no forged block outside a ceremony home)" \
    bash scripts/ai-dlc/validate-provenance-block.sh --strays
fi

# 3b. Rule 27 makes `extensions/` and `overrides/` the ONLY rule files a consumer may
#     author — and they are inside the rule-file audit's corpus. Nothing else in this
#     hook reads them for style: validate-layer-entries.sh checks frontmatter validity,
#     restatement, restriction and dangling Step pointers, never prose. So a version tag,
#     an origin parenthetical or an embedded date authored into a consumer's own layer
#     entry was caught by nothing until retro Step 4. Only the deterministic tier gates
#     the push; the judgement tier prints and is dispositioned at retro.
if [ -f scripts/ai-dlc/audit-rule-files.sh ]; then
  step "rule-file audit (origin tags, dates, dangling pointers)" \
    bash scripts/ai-dlc/audit-rule-files.sh --fail-on=deterministic
fi

# 3c. THE ARTIFACT PATH GRAMMAR, HELD AGAINST REAL FILENAMES. `artifact-path-grammar.md` makes
#     the DIRECTORY the only sprint slot. Core's own prescriptions are bound to that by I82 in
#     the distribution, and `migrate-artifact-paths.sh` moves a consumer's tree onto it ONCE —
#     but nothing stopped the tree drifting back off it the next sprint, and a convention with
#     only a one-time migration behind it has a half-life. This is the standing arm.
#
#     IT BLOCKS ON EXACTLY WHAT THE MIGRATION WOULD MOVE, and that scope is measured rather than
#     chosen for comfort. On the reference consumer the day it shipped: 0 movable, 48 the
#     migration REFUSES (a basename naming two sprints, a sprint directory under no area) and
#     1024 under `stories/`, which core defers because the sprint is spelled two ways there and
#     one of them is the bare number this grammar's own story form uses as the story INDEX.
#     Blocking on all 1072 would wedge first contact on a tree whose operator had already done
#     everything core asked. Every one of them is still PRINTED, with its reason, and the class
#     is computed from the path rather than read from a list — so nothing can fall out of date
#     and nothing can be added to it by hand.
#
#     Decidable from disk, which is why it belongs here and not at a gate. Its remedy is one
#     command and the hook prints it.
if [ -f scripts/ai-dlc/validate-artifact-paths.sh ]; then
  step "artifact paths (the directory is the only sprint slot)" \
    bash scripts/ai-dlc/validate-artifact-paths.sh
fi

# 3d. A HOOK ON DISK THAT NOTHING REGISTERS NEVER FIRES, AND NEVER SAYS SO.
#     A hook reaches a consumer in two halves and they are enforced differently. The FILE is
#     a pure apply: `reconcile/apply.sh` writes `.claude/hooks/ai-dlc-<x>.sh` from theirs, in
#     the driver, with a manifest row. The REGISTRATION is `reconcile/settings-merge.sh`
#     rewriting `.claude/settings.json` -- and nothing CALLS it. Its only two invocation sites
#     in the whole distribution are PROSE, in `ai-dlc-update/SKILL.md`. A pull that skips the
#     prose leaves the hook sitting there, executable, looking installed, wired to nothing.
#
#     WHY THIS BELONGS HERE AND NOT ONLY IN THE PULL. The pull-time checks answer "did THIS
#     pull register the hook". They cannot answer "is this consumer broken now", and the two
#     are different populations: `preclassify.sh` buckets settings.json `TEMPLATE-UNCHANGED-NOOP`
#     whenever the template itself did not move, so a tree that went stale on an EARLIER pull
#     produces no row, no worklist item and no gate anywhere. Measured on the reference consumer
#     the day this shipped: `ai-dlc-rules-floor.sh` -- whose own header reads "Makes an INERT
#     rule file LOUD" -- present and unregistered since v0.350.0, six releases, across pulls that
#     every one of them reported success. This arm reads DISK STATE, so it sees that tree.
#
#     Decidable from disk, which is why it belongs here and not at a gate. Its remedy is one
#     command, the validator prints it with no placeholders left in it, and the command ends by
#     re-running this check.
if [ -f scripts/ai-dlc/validate-write-format-steering.sh ]; then
  # 3c-bis. Every SHARED APPEND-ONLY artifact under the pipeline root declares WHERE its
  #     entry format lives, and every declaration still resolves in THIS tree's layout.
  #
  #     NO CEILING IS PASSED HERE, AND THAT IS DELIBERATE RATHER THAN AN OMISSION. The
  #     distribution's own hook passes `--max-undeclared` because its undeclared count is a
  #     number this repo controls and ratchets down. A consumer's count is whatever its
  #     installed release last shipped, so a ceiling written here would fire on a tree whose
  #     operator had done nothing wrong and could fix nothing -- the shape of gate that gets
  #     switched off. What runs on a consumer is the half with no false-positive path: a
  #     declaration naming a file that is absent, or one that no longer carries its anchor.
  #     Absence is still PRINTED every run, so the backlog is visible without being fatal.
  step "write-format steering (each shared append-only artifact declares its entry format)" \
    bash scripts/ai-dlc/validate-write-format-steering.sh --report
fi

# 3e. A ROLE'S CONFIGURED EFFORT IS BOUND BY ITS AGENT DEFINITION AND BY NOTHING ELSE.
#     `.claude/agents/<role>.md` frontmatter is the only channel that reaches a subagent's
#     reasoning effort. The dispatch guard STATES the effort in the prompt because the Agent
#     tool has no parameter for it, and a prompt cannot set effort -- measured on the reference
#     consumer, every spawn ran at the effort the SESSION resolved, from its launch flag or the
#     user's `effortLevel`/`modelSettings`, and never at the role's. The directive was read and
#     had no effect. The definition OUTRANKS that resolution rather than filling a gap in it.
#
#     SO A DRIFTED DEFINITION IS SILENT IN BOTH DIRECTIONS. A role whose settings entry moved
#     keeps running at the old level, and one whose definition was never rendered runs at the
#     session's resolved effort rather than its own; the spawn ledger records `effort_bound`
#     null for both, because a drifted definition is never selected and an absent one binds
#     nothing, so a ledger row says an effort was not bound and never says which of the two
#     states it was. This arm is what does.
#
#     THREE OUTCOMES AND THEY ARE DISTINCT, which is the whole reason the renderer has a third
#     exit code. A consumer with no `aiDlcRoles` is NOT APPLICABLE and prints as such; one whose
#     definitions are current PASSes; one whose definitions drifted FAILs with the one command
#     that clears it. Collapsing the first into a pass is this repository's named defect.
#
#     Decidable from disk, which is why it belongs here and not at a gate.
if [ -f scripts/ai-dlc/render-agent-definitions.sh ]; then
  #     `--root .` RATHER THAN THE RENDERER'S OWN WALK, and the two are not interchangeable
  #     here. This hook has already `cd`-ed to `git rev-parse --show-toplevel`, so the root is
  #     resolved by git itself; the walk is the fallback for a hand invocation and answers by
  #     looking for `.git` or `VERSION` above the SCRIPT. Passing the root git gave us means a
  #     tree where that walk would answer differently -- a submodule, a `--git-dir` pointing
  #     elsewhere -- cannot make this arm check a different project than the one being pushed.
  #
  #     AN ABSENT DIRECTORY IS RENDERED, A PRESENT ONE IS ONLY CHECKED. `.claude/agents/` is a
  #     derived, gitignored artifact, so every fresh `git worktree add` or clone starts without
  #     it and this arm failed every pinned role on the first push from that tree -- a state no
  #     edit caused and the pusher cannot see coming. Rendering there is regenerating a build
  #     product from the tracked declaration, which is what a fresh checkout is owed. A PRESENT
  #     directory stays check-only: a drifted definition is either a hand edit or a settings
  #     change nobody re-rendered, and silently overwriting it here would erase the evidence of
  #     which. The renderer's own `--check` never writes; the write is this hook's decision and
  #     is taken only on absence. The renderer refuses before any write on a settings file with
  #     no aiDlcRoles (3) or one it cannot parse (2), and the `--check` below then says so.
  agent_definitions() {
    local out rc
    if [ ! -d .claude/agents ]; then
      out="$(bash scripts/ai-dlc/render-agent-definitions.sh --root . 2>&1)"
      [ -d .claude/agents ] \
        && printf '   .claude/agents/ was absent (a gitignored, derived directory), so it was rendered:\n'
      printf '%s\n' "$out"
    fi
    out="$(bash scripts/ai-dlc/render-agent-definitions.sh --check --root . 2>&1)"; rc=$?
    printf '%s\n' "$out"
    case "$rc" in
      3) printf '   NOT APPLICABLE -- this project declares no aiDlcRoles, so it pins no role\n'
         printf '   models or efforts and there are no agent definitions to render.\n'
         return 0 ;;
      0) return 0 ;;
      *) return 1 ;;
    esac
  }
  step "agent definitions (a role's configured effort binds through .claude/agents/, or not at all)" \
    agent_definitions
fi

if [ -f scripts/ai-dlc/validate-hook-registration.sh ]; then
  step "hook registration (a hook on disk that nothing registers never fires)" \
    bash scripts/ai-dlc/validate-hook-registration.sh
else
  # NOT A SILENT SKIP, and the reason is this arm's own subject. Every guard above skips in
  # silence when its validator is absent, and a silent skip prints exactly what a pass prints.
  # For a check whose entire point is "absent-and-inert is indistinguishable from working",
  # inheriting that shape would be the joke telling itself. A consumer that predates the
  # validator gets a named, visible NOT CHECKED instead.
  printf '\n── %s\n' "hook registration (a hook on disk that nothing registers never fires)"
  printf '   NOT CHECKED -- scripts/ai-dlc/validate-hook-registration.sh is not in this tree.\n'
  printf '   This is not a pass. Nothing here verified that this project'"'"'s ai-dlc hooks are\n'
  printf '   registered in .claude/settings.json; any of them may be present and inert.\n'
  printf '   The validator arrives with the next /ai-dlc-update pull, and this arm starts working.\n'
fi

# 4. A shipped script with a syntax error is a gate that cannot run at all.
#    The glob set below is the consumer image of the distribution hook's set, one
#    entry per class after the core/ -> consumer mapping. validate-enforcement-map.sh
#    asserts the two agree; a class present there and absent here is a class of
#    shipped script that reaches every consumer unchecked. That already happened:
#    core validators moved to scripts/ai-dlc/ and this glob was not followed, so no
#    shipped validator -- and no part of the update engine that delivers the fix --
#    was syntax-checked on any consumer.
# SYNTAX_GLOB_BEGIN
syntax_all() {
  local rc=0 f
  for f in scripts/*.sh scripts/ai-dlc/*.sh .claude/hooks/*.sh \
           .claude/skills/ai-dlc-update/reconcile/*.sh .githooks/*; do
    [ -f "$f" ] || continue
    bash -n "$f" 2>/dev/null || { printf '   syntax error: %s\n' "$f"; rc=1; }
  done
  return $rc
}
# SYNTAX_GLOB_END
step "shell syntax (every shipped script and hook)" syntax_all

# 5. Fixtures are adversarial self-tests for the gate checks. A fixture never driven is
#    a green light nobody earned.
#
#    AND THE LOOP BELOW IS WHERE THEY GO UNEARNED. `[ -f "$d/run.sh" ] || continue` prints
#    nothing for what it skips, so a directory with no driver reads exactly like one that
#    passed. The distribution catches that where fixtures are AUTHORED (I20 in
#    validate-enforcement-map.sh, a dev-repo gate that says so in its own header) and H1
#    catches it at gate time for fixtures a `kind: check` entry BINDS — which on the
#    reference consumer is none. Between the two, a consumer's own fixture directory was
#    covered by nothing. `drivability` below is that cover. It runs BEFORE the suite so the
#    accounting is stated whether or not a driver later fails, and — like the suite — it is
#    UNDER the mid-pull guard: /ai-dlc-update writes core one file at a time, so a tree with
#    the marker up can hold a core fixture directory whose run.sh has not been written yet,
#    and reporting that would name a core file the consumer did not write and cannot fix.
drivability() { bash scripts/ai-dlc/validate-fixture-drivability.sh; }

#    AND THE SUITE RAN SERIALLY, AND PASSED WHEN IT RAN NOTHING. Until v0.226.0 the
#    loop below was `for d in ...; do bash "$d/run.sh"; done` with `return $rc` and
#    nothing else: no pool, no verdict accounting, and rc=0 both when the glob matched
#    no directory and when no directory carried a run.sh. Measured on the reference
#    consumer with 0.224.0 applied: 106 drivable fixtures, 188.0s serial wall clock,
#    67.8s user against 102.3s SYSTEM -- fork-bound, not work-bound -- and a
#    sum-over-max of 10.2x available from a pool. The distribution had fixed all three
#    for its own tree and shipped none of them; install.sh marks this file
#    "always overwrite -- upstream-owned", so a consumer could not fix it either.
#
#    THE TWO ARMS THAT ARE NOT ABOUT SPEED ARE WHY THIS IS NOT A NICE-TO-HAVE. An empty
#    suite that returns 0 is a gate reporting a pass it never earned, and with a worker
#    pool a dropped job produces no verdict file while the report still reads green and
#    merely SHORTER. Both are this repo's named class sitting in the gate a consumer
#    actually runs, so both are asserted rather than assumed.
#
#    THE BLOCK IS JOINED TO .githooks/pre-push BY I66 on EXECUTABLE LINES ONLY, so the
#    two suites cannot silently fork again. The prose differs on purpose; the code does
#    not. Comments are stripped before that comparison, because a join a comment can
#    satisfy is I64's defect.
#
#    RE-DERIVE THE POOL SIZE ON YOUR OWN BOX rather than inheriting 12. It is measured
#    on one 18-core machine, which is why it stays the tunable AI_DLC_FIXTURE_JOBS.
#
#    WHY 12 AND NOT MORE, on that box: past twelve the wall clock stops falling while the
#    CPU the run costs keeps rising, all of it in system time. A wider pool there buys no
#    time and spends contention for it. Your suite is a different size on different cores,
#    so the useful thing to copy is the METHOD, not the number: pin the dispatched set with
#    AI_DLC_FIXTURE_NO_SKIP=1 so every run does the same work, reset the durations record
#    before each run so one run's schedule does not decide the next one's, alternate the
#    widths rather than running all of one then all of the other, and take a difference as
#    real only where two widths' readings do not overlap.
# FIXTURE_POOL_BEGIN
FIXTURE_JOBS="${AI_DLC_FIXTURE_JOBS:-12}"
# THE FIXTURE ROOT, SPELLED ONCE AND SLASH-TERMINATED. It is the one line I66 maps between the hooks.
FXROOT="tests/fixtures/"
# RECURSION BOUND. A fixture that drives a hook runs this pool again, and nothing else limits the
# nesting. The depth marker is deliberately NOT named AI_DLC_*: fixtures scrub that whole prefix from
# their environment before driving a hook, so a marker carrying it would be removed exactly where it
# has to survive. Depth 1 is a hook started under a pool's fixture, and its pool is narrowed to two
# workers, not one, because a fixture that asserts parallelism needs two in flight. Depth 2 or more
# refuses to open a pool (run_fixtures). No AI_DLC_FIXTURE_JOBS value lifts the depth-1 cap: one or two
# is kept, and anything else -- larger, zero (BSD `xargs -P 0` is UNLIMITED), not a number, or longer
# than five digits -- becomes two. A drive under `env -i` clears the marker with everything else and must
# pass the depth explicitly. A marker that is SET but not a number, or longer than five digits, is depth
# 2 and refuses: it FAILS CLOSED, because bash arithmetic wraps a 20-digit value (2^64 reads as 0) and
# `[` errors on one, either of which would otherwise open a full pool. The `10#` reads 08 as eight.
POOL_DEPTH_IN="${PREPUSH_POOL_DEPTH:-0}"
case "$POOL_DEPTH_IN" in *[!0-9]*|??????*) POOL_DEPTH_IN=2 ;; esac
POOL_DEPTH_IN=$((10#$POOL_DEPTH_IN))
if [ "$POOL_DEPTH_IN" -ge 1 ]; then
  case "$FIXTURE_JOBS" in ''|*[!0-9]*|??????*) FIXTURE_JOBS=2 ;; esac
  if [ "$FIXTURE_JOBS" -lt 1 ] || [ "$FIXTURE_JOBS" -gt 2 ]; then FIXTURE_JOBS=2; fi
fi
# RESOLVE THE GIT DIRECTORY; NEVER SPELL IT `.git/`. In a LINKED WORKTREE `.git` is a
# FILE, not a directory, so every record below fails to open -- and each write is
# error-suppressed, so the suite proceeds and the banner is unaffected while the
# cross-run evidence is silently lost. `--git-common-dir` answers `.git` in a primary
# checkout and the shared admin directory from a worktree, so one spelling is correct
# in both. The fallback keeps the old behaviour if rev-parse is unavailable.
GITDIR="$(git rev-parse --git-common-dir 2>/dev/null)" || GITDIR=".git"
[ -n "$GITDIR" ] || GITDIR=".git"
DURATIONS_RECORD="$GITDIR/ai-dlc-fixture-durations"
# THIS RUN'S COSTS, UNMERGED. The record above merges each run over the last so a fixture that
# was SKIPPED keeps the cost it had -- which is what the longest-first dispatch wants, and which
# makes every row in it a floor of unknown age. If you want to know what your suite cost THIS
# push, read this file: it holds only the units this pool actually timed.
#
# EMPTIED WHEN THE POOL STARTS AND WRITTEN ONLY IF EVERY UNIT CAME BACK GREEN. So an empty file
# means "no complete measurement" -- a red unit, a killed push, or a suite that never ran -- and
# a non-empty one means a full green pool. A red run's timings describe a suite that stopped
# early, and treating those as a measurement reads a short run as a fast one.
LASTRUN_RECORD="$GITDIR/ai-dlc-fixture-durations.last"
READSET_MAP=".ai-dlc-fixture-readsets.tsv"
# THE VERIFIED-STATE RECORD LIVES UNDER .git FOR I55 ARM 4'S REASON EXACTLY: the content key
# hashes the working tree, so a cross-run record inside it would change the key that decides
# whether this suite runs at all.
VERIFIED_RECORD="$GITDIR/ai-dlc-fixture-verified"
# THE RECORD'S FORMAT STAMP IS A SIDECAR, NOT A HEADER LINE, so the record stays pure
# `path<TAB>sha` rows and every reader of it -- `comm`, `cut`, and the fixtures that seed one
# by copying a manifest -- is unchanged. Written only beside a record THIS hook wrote, which is
# already filtered of ignored paths at the manifest; see the reader in apply_readset_skip.
VERIFIED_FORMAT="$GITDIR/ai-dlc-fixture-verified.format"
# ONE KEY RECORD PER FIXTURE, `<fixture>.key`; see the header of apply_readset_skip.
KEYS_DIR="$GITDIR/ai-dlc-fixture-keys"
# WHEN A FIXTURE GOES RED, THIS IS THE FILE TO READ. The pool runs each unit in its own worker
# and keeps only a verdict, so without this record a failing fixture left you one line --
# `FAIL <name>` -- and no way to see what it actually printed. Re-running the fixture by hand
# is not the same run: the pool schedules sixteen at once, and a unit that only fails under
# that load passes every time you drive it alone.
#
# UNDER .git FOR THE SAME REASON AS THE TWO ABOVE: the content key hashes the working tree, so a
# record written into it would change the key that decides whether this suite runs at all. It is
# not a tracked file and will not appear in `git status`.
#
# NEVER DELETED ON A GREEN RUN. If a push goes red and the next one goes green, this file still
# holds the red run's output -- which is the case you most want it for.
#
# EVERY RED RUN ALSO LEAVES ITS OWN COPY, because the record above is overwritten by the NEXT
# red run. Two reds in a row used to leave only the second, so an intermittent failure was gone
# the moment anything else failed. Each copy is named
# `ai-dlc-fixture-failures.<UTC %Y%m%dT%H%M%SZ>.<pid>`, and only the newest FAILLOG_KEEP of
# that shape are kept. The prune takes a name only if it starts with a year and month AND ends
# in a dot followed by digits alone. A copy you save beside them is safe if its name fails either
# test -- add any non-numeric suffix (`.keep`, `.notes`) to a retained copy and the prune skips
# it. A hand-saved name that passes both tests is indistinguishable from a retained copy.
FAILLOG_RECORD="$GITDIR/ai-dlc-fixture-failures"
FAILLOG_KEEP=20

# Reduce "$1" (the dispatch list) to the fixtures a change can actually affect, using the
# trace-derived read-sets in $READSET_MAP. Announces what it skipped and why; leaves the list
# untouched whenever it cannot justify a reduction.
#
# WHY THIS EXISTS BESIDE THE CONTENT KEY. `scripts/suite-content-key.sh` already skips the
# WHOLE suite when nothing moved, and it is NOT touched here -- it stays the safe outer gate.
# What it cannot do is skip PART of the suite, so one changed file costs the full makespan.
# This is the finer skip inside that outer one, and when it is in any doubt the fallback is
# the full run.
#
# EVERY BRANCH THAT CANNOT JUSTIFY A SKIP RUNS EVERYTHING. Under-recording one path does not
# make the suite slow, it makes it SILENTLY SHORT: a fixture that never ran reports nothing
# and the summary still says green. So absence of evidence is spelled "run it" at every step
# -- no map, no state, an unreadable either, a manifest that hashed fewer files than it listed,
# a changed path no fixture is known to read (the update skill's own bookkeeping excepted, see
# the orphan test), or a fixture with no entry of its own.
# Hash every path whose change could matter, into "$1/.now" as `path<TAB>sha`.
#
# THE SUBJECT IS TRACKED FILES *PLUS* EVERY PATH THE MAP NAMES. Tracked files are in it so a
# change to something NO fixture is known to read is still SEEN -- otherwise a validator that
# started reading a new file would drift out of the map with nothing able to notice. Measured
# on this tree: 1% of changed files across 40 commits fell outside every read-set, and that
#1% is exactly the population this arm exists for.
#
# `.git/**` IS DELIBERATELY OUT OF SCOPE, and it is a measurement rather than a convenience.
# Fixtures read git internals constantly -- 33 of 118 name some `.git` path, because validators
# they invoke resolve a root or ask `git status`. But `.git/HEAD`, `.git/index` and the refs
# move on EVERY commit, so honouring them would select those fixtures on every push and take
# the suite-wide win from 42% down to 12%, with two of the heaviest units running every time.
# Measured before excluding them: five fixtures read git HISTORY pointers (refs/HEAD/logs), and
# running all five across an empty commit -- HEAD moved, tree byte-identical -- changed NOT ONE
# verdict, with controls proving HEAD really moved and that the comparison could detect a
# difference. Their git reads are incidental to their verdicts. Excluded here rather than in the
# map so the map stays a faithful record of what was actually read.
# THE CONTENT KEY'S EXCLUSION SET, RESOLVED RATHER THAN RESTATED.
#
# `scripts/suite-content-key.sh` declares which paths cannot change a fixture verdict, and it
# earns each line with a two-tree mutation measurement. The OUTER skip honours that set; this
# INNER one did not, and the asymmetry cost a full suite on almost every push here. A changed
# path in no fixture read-set forces all N, and a NEW file is in no read-set by construction --
# the map is a generated snapshot, so it cannot name a file that did not exist when it was
# derived. `docs/plans/` is edited in nearly every session on this repo, so the arm that exists
# for a genuinely unknown dependency was firing on a directory the key already declares
# irrelevant. Measured: one plan file forced all 133 fixtures on a push whose subject was a
# one-line change.
#
# RESOLVED FROM THE DECLARATION, so this is not a second copy of the list. When the declaring
# script is absent -- it is distribution-only, and a consumer does not have it -- the set is
# EMPTY and this reduces to the previous behaviour exactly. Both hooks run this same code and
# I66 compares them on executable lines.
#
# THE EMPTY CONSUMER SET IS A DECISION, AND SHIPPING THE DISTRIBUTION'S DECLARATION WOULD BE A
# FIDELITY LOSS RATHER THAN A SPEED-UP. CONSUMER FIXTURES READ files under tops this
# declaration excludes. Measured on the reference consumer against the shipped hook's own two
# functions above: shipping `scripts/suite-content-key.sh` verbatim removes 550 paths from that
# consumer's read-set universe, 8 of which are FILES its fixtures read as INPUT, and 26 of its
# 178 mapped fixtures lose at least one. Driven end to end on one of them -- a content change
# to `docs/architecture-index.md`, which 20 consumer fixtures read -- the filter with the
# declaration present drops the path from the manifest, `.changed` comes back EMPTY, and the
# hook takes its whole-suite skip. Twenty fixtures do not run and the push reports green.
# Without the declaration the same change selects those twenty and they run. The exclusion set
# earns its lines from a two-tree mutation measurement taken over THIS repository's fixtures;
# a consumer's fixtures are a different population and nothing has measured them.
#
# SO THE FULL RUN A CONSUMER PAYS IS THE CORRECT BEHAVIOUR, not an oversight. Its cost on the
# reference consumer is one pole, not the sum over the pool -- derive it from the top of
# .git/ai-dlc-fixture-durations rather than quoting a figure here.
#
# AND THE PATH ABOVE IS DELIBERATELY UNCLAIMED, which is what makes a consumer's own set the
# available remedy. `install.sh` writes nothing to it, so a consumer that wants a narrower
# suite authors its own declaration there -- the only thing read out of that file is the
# EXCLUDE_BEGIN/EXCLUDE_END block, and every entry must be a BARE TOP-LEVEL name, since the
# filter above compares for exact equality and I55 arm 1 refuses a slashed entry in this
# repository for the same reason. A consumer excluding its own pipeline-state top gets the
# inner skip; one that ships upstream's set gets a cached green.
#
# `.git` is dropped here because it is already excluded, separately and on different grounds,
# at both of the sites below.
readset_excluded_re() {
  local decl="scripts/suite-content-key.sh" tops t re=""
  [ -f "$decl" ] || return 0
  tops="$(sed -n '/^# EXCLUDE_BEGIN$/,/^# EXCLUDE_END$/p' "$decl" \
          | sed -n 's/^\([A-Za-z0-9._-]\{1,\}\)$/\1/p' | grep -v '^\.git$')"
  [ -n "$tops" ] || return 0
  for t in $tops; do
    re="${re}|^$(printf '%s' "$t" | sed 's/\./\\./g')(/|$)"
  done
  printf '%s' "${re#|}"
}

# Drop every path the exclusion set covers. A no-op when the set is empty -- which is the
# consumer case, and must stay a no-op there rather than filtering on an empty pattern, since
# `grep -vE ""` matches everything and would empty the stream.
readset_drop_excluded() { # reads stdin, writes stdout
  local re; re="$(readset_excluded_re)"
  if [ -n "$re" ]; then grep -vE "$re"; else cat; fi
}

# Copy <in> to <res> minus every row whose first tab field git reports IGNORED. ONE helper for
# both sites that build a path set NOW -- the manifest and the orphan universe -- because they
# must agree or a path dropped from one reads as changed in the other. `check-ignore` in its
# default mode never reports a TRACKED file, so a force-added file that matches an ignore
# pattern stays in; a `.gitignore` grep would drop it. That holds only while the file is STILL
# tracked, which is why a verified RECORD is never passed here, stamped or not: once `git rm`'d
# such a file is untracked and ignored, and filtering the record would erase its vanish.
# Exit 1 means "nothing
# ignored". Any other exit fails CLOSED: <res> is emptied and the caller runs everything.
# A PATH INSIDE A SUBMODULE IS NEVER ASKED, because one such path makes `check-ignore` die with
# 128 ("Pathspec ... is in submodule") and that would fail closed on EVERY push. Measured on the
# reference consumer: 397 of its 21034 map paths sit under its one gitlink. They are kept --
# the superproject's ignore rules do not reach inside a submodule.
readset_drop_ignored() { # <in> <res>
  local in="$1" res="$2" ci_rc
  git -c core.quotePath=false ls-files -s 2>/dev/null \
    | awk '$1 == "160000" { sub(/^[^\t]*\t/, ""); print }' > "$res.gl"
  cut -f1 "$in" | awk -v gl="$res.gl" 'BEGIN { while ((getline l < gl) > 0) g[++n] = l "/" }
    { for (i = 1; i <= n; i++) if (index($0, g[i]) == 1) next; print }' > "$res.q"
  git -c core.quotePath=false check-ignore --stdin < "$res.q" > "$res.ign" 2>/dev/null
  ci_rc=$?
  if [ "$ci_rc" -ne 0 ] && [ "$ci_rc" -ne 1 ]; then : > "$res"; return 1; fi
  awk -F'\t' -v ign="$res.ign" 'BEGIN { while ((getline l < ign) > 0) drop[l] = 1 }
                                !($1 in drop)' "$in" > "$res"
}

readset_manifest() {
  local out="$1" hash_rc ign_rc
  # UNTRACKED-BUT-UNIGNORED FILES ARE IN THE UNIVERSE, AND THE WHOLE-SUITE SKIP BELOW IS WHY.
  # `git ls-files` alone answers about the COMMITTED tree, which is the right population for
  # "what am I pushing" and the wrong one for "what will a fixture read": a fixture reads the
  # WORKING tree, and an untracked file there is one a trace never saw and no read-set names.
  # Without this line `.changed` could be empty while an unignored file sat beside a fixture's
  # subject, and the no-change branch would skip the suite over a tree nobody hashed.
  # Git-ignored paths stay out, for the reason the content key states about the same set:
  # hooks and fixtures WRITE INTO them while the suite runs, so a universe covering them would
  # differ from itself across the very run it is keyed on.
  # THE MAP ARM USED TO BYPASS THAT, and it is dropped here from EVERY source. `--exclude-standard`
  # filters only the untracked listing; a map row naming an ignored file was hashed whenever the
  # file existed. Measured: a trace run in the main checkout recorded three ignored `.DS_Store`
  # files, a green run there wrote them into the verified record in the SHARED git dir, and a
  # push from a worktree without them saw them VANISH -- their parents, `core` among them, joined
  # `.match`, and 11 changed paths selected 226 of 232 fixtures where their own rows select 55.
  #
  # A MANIFEST THAT HASHED LESS THAN IT LISTED IS EMPTIED, so the guard in apply_readset_skip
  # runs everything. `xargs` without `-0` stops at the first apostrophe in a filename and the
  # files after it were never hashed -- measured on the reference consumer, 9600 of 12561, so an
  # edit to any later path read as "nothing changed" and skipped the whole suite. A name git
  # still has to quote (tab, newline, `"` or `\`) cannot be hashed by its listed spelling, and
  # an unreadable file fails shasum; both empty it too, so such a file runs the whole suite on
  # every push until it is renamed or made readable. `--` ends shasum's options, so a top-level
  # name beginning with `-` is hashed as a file rather than refused as an option.
  { git -c core.quotePath=false ls-files 2>/dev/null
    git -c core.quotePath=false ls-files --others --exclude-standard 2>/dev/null
    readset_rows "$out" paths
  } | grep -v '^\.git/' | grep -v '^\.git$' | readset_drop_excluded | sort -u > "$out/.paths.all"
  readset_drop_ignored "$out/.paths.all" "$out/.paths"; ign_rc=$?
  while IFS= read -r p; do [ -f "$p" ] && printf '%s\n' "$p"; done < "$out/.paths" > "$out/.files"
  tr '\n' '\000' < "$out/.files" | xargs -0 -n 200 shasum -a 256 -- > "$out/.sums" 2>/dev/null
  hash_rc=$?
  awk '{ path = $0; sub(/^[0-9a-f]+  /, "", path); print path "\t" $1 }' "$out/.sums" | sort > "$out/.now"
  if [ "$hash_rc" -ne 0 ] || [ "$ign_rc" -ne 0 ] || grep -q '^"' "$out/.paths" \
     || [ "$(wc -l < "$out/.now")" -ne "$(wc -l < "$out/.files")" ]; then
    : > "$out/.now"
  fi
}

# The deriver lands under a different parent on each side (install.sh copies core/scripts/<x>
# to scripts/ai-dlc/<x>), so both are probed and neither is assumed. Consumer layout first,
# the order every two-layout resolver here uses. Prints nothing when neither exists.
readset_deriver_path() {
  local c
  for c in scripts/ai-dlc/derive-fixture-readsets.sh core/scripts/derive-fixture-readsets.sh; do
    [ -f "$c" ] && { printf '%s' "$c"; return 0; }
  done
  return 0
}

# THE LOCAL MAP. After a GREEN suite this hook starts one detached, unprivileged trace of the
# fixtures that have no committed row and no valid local row (readset_live_trace, below), and the
# deriver records each clean trace here, under the git dir, never in the tree. `AI_DLC_READSET_LIVE_TRACE=0`
# turns the trace off; the rows already recorded are still read.
READSET_LOCAL="$GITDIR/ai-dlc-fixture-readsets.local"

# ONE HELPER EMITS THE MERGED ROW SET, AND EVERY SITE THAT READ THE COMMITTED MAP CALLS IT. A missed
# site turns a local-only path into an orphan and forces the full suite, or leaves a locally-mapped
# fixture "unmapped" on one side of a join and mapped on the other.
#   paths  committed paths plus EVERY local candidate path -- the manifest's universe. Validity is
#          NOT applied here: the manifest is what validity is computed FROM.
#   rows   `<fx>\t<path>` for selection. A fixture with VALID local rows (`$out/.local.valid`)
#          uses only those; every other fixture uses its committed rows.
# The local rows are read FIRST, so the committed rows of a locally-traced fixture are dropped.
readset_rows() { # <out> <paths|rows>
  local out="$1" mode="$2"
  { if [ "$mode" = rows ]; then [ -s "$out/.local.valid" ] && sed 's/^/V	/' "$out/.local.valid"
    else [ -s "$READSET_LOCAL" ] && sed 's/^/L	/' "$READSET_LOCAL"; fi
    [ -s "$READSET_MAP" ] && grep -v '^#' "$READSET_MAP" | sed 's/^/C	/'
    :
  } | awk -F'\t' -v mode="$mode" '
    $1 == "V" { loc[$2] = 1; print $2 "\t" $3; next }
    $1 == "L" { if (substr($3, 1, 1) != "#") print $3; next }
    $1 == "C" { if (mode != "rows") print $3; else if (!($2 in loc)) print $2 "\t" $3 }'
}

# A LOCAL ROW SET IS VALID ONLY WHILE EVERY PATH IT RECORDED HASHES AS IT DID IN THE TRACE COPY, AND
# THE DERIVER IS THE ONE THAT TRACED IT. Read off THIS run's `$out/.now`, so a set whose input moved
# is ignored on the very push that moved it: the fixture is unmapped, runs, and is re-traced. A path
# outside the manifest's universe (`.git/**`, the content key's excluded tops, an ignored path) is
# not compared -- no change there can reach `.changed` either, for committed rows or local ones. A
# `-` hash (a directory or an absent name) stays valid while no FILE of that name exists.
# Writes `$out/.local.valid` (`<fx>\t<path>`), `$out/.trace` (the dispatch-list fixtures with no
# committed row and no valid local row) and `$out/.trace.held` (those of them discarded three times
# in a row on their current key, which are not re-traced until the key changes).
readset_local_validate() { # <list> <out>
  local list="$1" out="$2" dv dsha="" rc_map="$READSET_MAP" rl_loc="$READSET_LOCAL" d b k
  : > "$out/.local.valid"; : > "$out/.trace"; : > "$out/.trace.held"
  dv="$(readset_deriver_path)"
  [ -n "$dv" ] && dsha="$(shasum -a 256 -- "$dv" 2>/dev/null | cut -d' ' -f1)"
  [ -s "$rc_map" ] || rc_map=/dev/null
  [ -s "$rl_loc" ] || rl_loc=/dev/null
  if [ -n "$dsha" ] && [ -s "$out/.now" ] && [ "$rl_loc" != /dev/null ]; then
    RL_C="$rc_map" RL_P="$out/.paths" RL_N="$out/.now" awk -F'\t' -v dsha="$dsha" '
      FILENAME == ENVIRON["RL_C"] { if ($0 !~ /^#/) com[$1] = 1; next }
      FILENAME == ENVIRON["RL_P"] { inu[$0] = 1; next }
      FILENAME == ENVIRON["RL_N"] { now[$1] = $2; next }
      $2 == "#deriver" { dok[$1] = ($3 == dsha); next }
      substr($2, 1, 1) == "#" { next }
      { f = $1; seen[f] = 1; rows[f] = rows[f] $2 "\n"
        if ($2 in inu) {
          if ($3 == "-") { if ($2 in now) bad[f] = 1 }
          else if (!(($2 in now) && now[$2] == $3)) bad[f] = 1
        } }
      END { for (f in seen) if ((f in dok) && dok[f] && !(f in bad)) {
              n = split(rows[f], r, "\n"); for (i = 1; i < n; i++) print f "\t" r[i] } }' \
      "$rc_map" "$out/.paths" "$out/.now" "$rl_loc" | sort -u > "$out/.local.valid"
  fi
  readset_rows "$out" rows | cut -f1 | sort -u > "$out/.mapped.all"
  while IFS= read -r d; do
    b="${d%/}"; b="${b##*/}"
    grep -qxF "$b" "$out/.mapped.all" && continue
    readset_trace_add "$out" "$b" "$dsha"
  done < "$list"
}

# Queue <fixture> for the post-green trace, or hold it when its last three traces were discarded on
# the current run.sh and deriver. Unmapped fixtures come here from readset_local_validate, stale
# ones from apply_readset_skip.
readset_trace_add() { # <out> <fixture> <deriver sha>
  local k rl="$READSET_LOCAL"
  [ -s "$rl" ] || rl=/dev/null
  k="$(awk -F'\t' -v p="${FXROOT}$2/run.sh" '$1 == p { print $2 }' "$1/.now")"
  if awk -F'\t' -v f="$2" -v k="${k:--}:$3" '$1 == f && $2 == "#discards" && $3 >= 3 && $4 == k { h = 1 } END { exit !h }' "$rl"; then
    printf '%s\n' "$2" >> "$1/.trace.held"
  else
    printf '%s\n' "$2" >> "$1/.trace"
  fi
}

# THE START TIME OF A PID, ONE NORMALISED STRING, for the live-trace lock. The writer and the reader
# both call this, so the two sides cannot disagree on locale, zone or column padding: `ps` runs
# under LC_ALL=C TZ=UTC0 and its words are re-joined by single spaces. Prints nothing and returns 1
# when `ps` fails or prints nothing (no such pid, or no usable `ps`).
readset_pid_start() { # <pid>
  local x
  x="$(LC_ALL=C TZ=UTC0 ps -o lstart= -p "$1" 2>/dev/null)" || return 1
  set -- $x
  [ -n "$*" ] || return 1
  printf '%s' "$*"
}

# IS THE LIVE-TRACE LOCK STALE? `$lk/pid` is line 1 `<pid> <epoch>` (the only line an older hook
# writes or reads) and line 2 the start time of that pid as readset_pid_start printed it when the
# lock was taken. The pid is the detached trace subshell's `$!`, never `$$`. Decided in this order:
#   (1) a malformed pid or epoch                                   -> stale
#   (2) `kill -0` on the pid fails                                 -> stale
#   (3) the epoch is more than 6h old                              -> stale
#   (4) no start line (a lock taken by an older hook)              -> held, judged as before
#   (5) the pid's start time cannot be read now                    -> held, and it says so
#   (6) the pid's start time differs from the recorded one         -> stale (the pid was reused)
#   otherwise                                                      -> held
# (5) is reached only after `kill -0` succeeded, so an empty `ps` there is a `ps` failure or a pid
# that died in the gap. HELD with the announcement is right for both and the next push re-judges;
# do not turn it into stale, because a false stale lets two traces run at once. A lock dir with no
# pid file is stale once older than 60s (a launcher killed between `mkdir` and writing the pid).
# Never a process-table grep: `kill -0` on the recorded pid is the liveness test.
readset_lock_stale() { # <lock dir>
  local lk="$1" p="" e="" now
  local s="" c=""
  if [ -f "$lk/pid" ]; then
    { read -r p e; read -r s; } < "$lk/pid" 2>/dev/null
    case "$p" in ''|*[!0-9]*) return 0 ;; esac
    case "$e" in ''|*[!0-9]*) return 0 ;; esac
    kill -0 "$p" 2>/dev/null || return 0
    now="$(date +%s)"
    [ $(( now - e )) -gt 21600 ] && return 0
    set -- $s; s="$*"
    [ -n "$s" ] || return 1
    if ! c="$(readset_pid_start "$p")"; then
      printf '   ..    read-set live trace: could not read the start time of lock pid %s (ps failed or printed nothing) -- the lock is judged HELD on pid and age alone\n' "$p"
      return 1
    fi
    [ "$c" != "$s" ] && return 0
    return 1
  fi
  [ -n "$(find "$lk" -maxdepth 0 -mmin +1 2>/dev/null)" ] && return 0
  return 1
}

# AFTER A GREEN SUITE, START ONE DETACHED TRACE OF THE UNMAPPED FIXTURES THAT RAN. The push is never
# delayed: every descriptor goes to a log under the git dir, so git has nothing to wait on, and the
# durations, the pole and the verified record were all written before this runs and are never
# touched by it. A fixture's normal-run output is stashed beside the local map first, because the
# deriver discards a trace whose verdict lines differ from the run that passed. Under a NON-blocking
# lock: if another trace holds it this push starts none and says so. Every precondition that fails
# is ONE line naming it, and the fixtures stay unmapped -- the behaviour before this existed.
readset_live_trace() { # <out>
  local out="$1" b names="" n=0 dv why="" lk tr logf tp
  [ "${AI_DLC_READSET_LIVE_TRACE:-1}" = 0 ] && return 0
  if [ -s "$out/.trace.held" ]; then
    printf '   ..    read-set live trace: NOT re-tracing %s -- discarded 3 times in a row on the same run.sh and deriver; unmapped until one of them changes (see %s.log)\n' \
      "$(tr '\n' ' ' < "$out/.trace.held" | sed 's/ $//')" "$READSET_LOCAL"
  fi
  [ -s "$out/.trace" ] || return 0
  while IFS= read -r b; do
    [ -n "$b" ] && [ "$(cat "$out/$b" 2>/dev/null)" = ok ] || continue
    names="${names}${names:+ }$b"; n=$((n + 1))
  done < "$out/.trace"
  [ "$n" -gt 0 ] || return 0
  dv="$(readset_deriver_path)"
  [ -n "$dv" ] || why="no derive-fixture-readsets.sh in either layout"
  command -v sandbox-exec >/dev/null 2>&1 || why="${why:+$why; }no sandbox-exec"
  [ -x /usr/bin/log ] || why="${why:+$why; }no /usr/bin/log"
  command -v python3 >/dev/null 2>&1 || why="${why:+$why; }no python3"
  [ "$(git rev-parse --git-dir 2>/dev/null)" = "$(git rev-parse --git-common-dir 2>/dev/null)" ] \
    || why="${why:+$why; }a linked worktree (the deriver traces only the main checkout)"
  if [ -n "$why" ]; then
    printf '   ..    read-set live trace: skipped (%s); %s fixture(s) stay unmapped: %s\n' "$why" "$n" "$names"
    return 0
  fi
  lk="$READSET_LOCAL.lock"
  if ! mkdir "$lk" 2>/dev/null; then
    if readset_lock_stale "$lk"; then rm -f "$lk/pid"; rmdir "$lk" 2>/dev/null; fi
    if ! mkdir "$lk" 2>/dev/null; then
      printf '   ..    read-set live trace: another trace holds %s -- none started; %s fixture(s) stay unmapped this push\n' "$lk" "$n"
      return 0
    fi
  fi
  mkdir -p "$READSET_LOCAL.logs" 2>/dev/null
  for b in $names; do cp "$out/.log/$b" "$READSET_LOCAL.logs/$b" 2>/dev/null; done
  tr="${TMPDIR:-/tmp}"; tr="${tr%/}/ai-dlc-readset-live.$$"
  logf="$READSET_LOCAL.log"
  ( trap '' HUP
    AI_DLC_READSET_TRACE_ROOT="$tr" bash "$dv" --list "$names" --tracer sandbox --local-map "$READSET_LOCAL"
    rm -f "$lk/pid"; rmdir "$lk" 2>/dev/null || { sleep 1; rm -f "$lk/pid"; rmdir "$lk" 2>/dev/null; }
  ) </dev/null >"$logf" 2>&1 &
  tp="$!"
  printf '%s %s\n%s\n' "$tp" "$(date +%s)" "$(readset_pid_start "$tp")" > "$lk/pid" 2>/dev/null
  printf '   ..    read-set live trace: started detached for %s unmapped fixture(s) (%s) -> %s\n' "$n" "$names" "$logf"
  return 0
}

# THE TOOLS, KEYED PER FIXTURE. One pass over the manifest's `.sh` files writes `<out>/.ftools`
# (`<file>\t<tool path>`): every word of a non-comment line that names a command on $PATH, the first hit
# on $PATH winning. Derived that way, never hand-listed. `<out>/.tools` is `<tool path>\t<sha256>` for
# every tool named anywhere. F's tool keys are the tools its keyed files name, so a changed binary reruns
# only the fixtures whose files name it. Keyed on the binary's CONTENT: nothing is EXECUTED to read a
# version, because the derived name set includes commands such as `halt`, `yes` and `passwd`.
readset_tools() { # <out>
  local out="$1"
  ( IFS=:; for p in $PATH; do
      [ -d "$p" ] && ls -1 "$p" 2>/dev/null | awk -v d="$p" '{ print d "\t" $0 }'
    done ) > "$out/.pathcmds"
  grep '\.sh$' "$out/.files" | tr '\n' '\000' | RT_CMDS="$out/.pathcmds" xargs -0 awk '
    BEGIN { while ((getline l < ENVIRON["RT_CMDS"]) > 0) { t = index(l, "\t"); n = substr(l, t + 1); if (!(n in cmd)) cmd[n] = substr(l, 1, t - 1) "/" n } }
    FNR == 1 { delete seen }
    /^[[:space:]]*#/ { next }
    { n = split($0, w, /[^A-Za-z0-9_.+-]+/)
      for (i = 1; i <= n; i++) if ((w[i] in cmd) && !(w[i] in seen)) { seen[w[i]] = 1; print FILENAME "\t" cmd[w[i]] } }' \
    > "$out/.ftools" 2>/dev/null
  cut -f2 "$out/.ftools" | LC_ALL=C sort -u | tr '\n' '\000' | xargs -0 shasum -a 256 -- 2>/dev/null \
    | awk '{ p = $0; sub(/^[0-9a-f]+  /, "", p); print p "\t" $1 }' > "$out/.tools"
}

# `<dir>/\t#listing:<sha256>` for every directory a path list implies, derived from the list alone and
# never from readdir. A listing is the directory's immediate entry names, C-sorted, one per line.
readset_listings() { # <path list> <out file>
  local w="$2.d"
  mkdir -p "$w" || { : > "$2"; return 1; }
  awk '{ p = $0; while ((i = match(p, /\/[^\/]*$/)) > 0) { d = substr(p, 1, i - 1); print d "\t" substr(p, i + 1); p = d } }' "$1" \
    | LC_ALL=C sort -u | awk -F'\t' -v w="$w" '
      $1 != d { if (f != "") close(f); d = $1; n++; f = w "/" n; print n "\t" d "/" > (w "/.idx") }
      { print $2 > f }'
  find "$w" -type f ! -name .idx -print0 | xargs -0 shasum -a 256 -- 2>/dev/null \
    | awk -v idx="$w/.idx" 'BEGIN { while ((getline l < idx) > 0) { t = index(l, "\t"); d[substr(l, 1, t - 1)] = substr(l, t + 1) } }
      { n = $0; sub(/^[0-9a-f]+  /, "", n); sub(/.*\//, "", n); if (n in d) print d[n] "\t#listing:" $1 }' > "$2"
}

# THE RECORD, `$KEYS_DIR/<fx>.key`: `#format k1`, `#state ok|stale|seeded`, `#tools per-fixture`
# (a constant; the tools are rows), then one row per key, C-sorted: `<path>\t<sha256>` for a file,
# `<path>\t-` for an absent name, `<dir>/\t#listing:<sha256>` for a directory listing, and
# `<tool path>\t<sha256>` for a tool (an absolute path). A changed tool row reruns F as `tools
# changed` and never stales it.
#
# DECIDE EVERY FIXTURE IN <list> FROM ITS KEY RECORD. Writes `<out>/.kdec`, one line per fixture:
# `<fx>\trun\t<reason>\t<k|u|s>\t<new state>` or `<fx>\tskip\t\t\t<state>`, and the prospective record
# of every fixture that runs (or that a seed skips) to `<out>/.k/<fx>`. The record holds the PRE-RUN
# hashes; run_fixtures publishes it only for a fixture that passed.
#
# THE SEED: no `$KEYS_DIR` yet and a `v2` verified record present. That record is a copy of the
# pre-run `.now` of a suite every fixture passed on, so each fixture's record is the projection of it
# onto K(F) -- listings from its path set, a path it lacks as `-`, its tools as they are now, state
# `seeded`. Once the directory exists the seed never runs again, and a missing record is `unrecorded`.
#
# A LISTING MOVED, AND WHICH ENTRIES ARE NEW. The record holds only a listing's hash, so the old entry
# set is taken from a path list whose listing hash EQUALS the recorded one -- the previous run's `.now`
# (`$KEYS_DIR/.prev`) or the verified record. Every file and directory under a new entry is added to
# the record, which stays `ok`; with no matching list the record goes `stale`. A change to a key added
# that way reruns the fixture and refreshes the key, and does not stale it; nor does a key K(F) gained
# (a trace landed or the map moved), which reruns it once to record the key. An `ok` record's keys
# are carried into the next one while it has any listing key, so a key added that way is not dropped
# when the fixture next runs for another reason; a whole-tree record has no listing key, so an
# unmapped fixture that gains a trace sheds it.
readset_keys() { # <list> <out>
  local list="$1" out="$2" seed=0 v2=/dev/null lp=/dev/null lv=/dev/null pp=/dev/null pv=/dev/null tab
  tab="$(printf '\t')"
  mkdir -p "$out/.k" || return 1
  readset_tools "$out"
  cut -f1 "$out/.now" > "$out/.is"
  readset_listings "$out/.is" "$out/.ls.now"
  if [ -s "$VERIFIED_RECORD" ] && [ "$(cat "$VERIFIED_FORMAT" 2>/dev/null)" = v2 ]; then
    v2="$VERIFIED_RECORD"; cut -f1 "$v2" > "$out/.pv"; pv="$out/.pv"
    readset_listings "$pv" "$out/.ls.v2"; lv="$out/.ls.v2"
    [ -d "$KEYS_DIR" ] || seed=1
  fi
  if [ -s "$KEYS_DIR/.prev" ]; then
    cut -f1 "$KEYS_DIR/.prev" > "$out/.pp"; pp="$out/.pp"
    readset_listings "$pp" "$out/.ls.prev"; lp="$out/.ls.prev"
  fi
  readset_rows "$out" rows | awk -F'\t' -v u="$out/.paths" 'BEGIN { while ((getline l < u) > 0) in_u[l] = 1 } ($2 in in_u)' > "$out/.krows"
  : > "$out/.krecs"
  if [ "$seed" = 0 ]; then
    awk 'FNR == 1 { ok = ($0 == "#format k1"); f = FILENAME; sub(/.*\//, "", f); sub(/\.key$/, "", f); next }
         !ok { next }
         /^#state / { print f "\t#state\t" substr($0, 8); next }
         /^#/ { next }
         { print f "\t" $0 }' "$KEYS_DIR"/*.key > "$out/.krecs" 2>/dev/null
  fi
  while IFS= read -r d; do b="${d%/}"; printf '%s\n' "${b##*/}"; done < "$list" > "$out/.kl"
  : > "$out/.khdr"; : > "$out/.kout"
  KN="$out/.now" KLN="$out/.ls.now" KLP="$lp" KLV="$lv" KPP="$pp" KPV="$pv" KV2="$v2" KR="$out/.krows" \
  KM="$out/.mapped.all" KLOC="$out/.local.valid" KC="$out/.krecs" KF="$out/.kl" KH="$out/.khdr" KO="$out/.kout" \
  KT="$out/.tools" KFT="$out/.ftools" awk -v seed="$seed" -v root="$FXROOT" '
    function rd(file, arr,   l, t) { while ((getline l < file) > 0) { t = index(l, "\t"); arr[substr(l, 1, t - 1)] = substr(l, t + 1) } }
    function kids(file, set,   l, t, p, i) { while ((getline l < file) > 0) { t = index(l, "\t"); p = (t ? substr(l, 1, t - 1) : l)
        while ((i = match(p, /\/[^\/]*$/)) > 0) { set[substr(p, 1, i - 1) SUBSEP substr(p, i + 1)] = 1; p = substr(p, 1, i - 1) } } }
    function cur(k) { if (substr(k, 1, 1) == "/") return (k in TV) ? TV[k] : "-"
      return (k ~ /\/$/) ? ((k in LN) ? LN[k] : "-") : ((k in NV) ? NV[k] : "-") }
    function sv(k) { if (substr(k, 1, 1) == "/") return cur(k)
      return (k ~ /\/$/) ? ((k in LV) ? LV[k] : "-") : ((k in VV) ? VV[k] : "-") }
    function addk(p) { if (p in NV) K[p] = 1; else if (p in DN) K[p "/"] = 1; else K[p] = 1 }
    function subtree(q,   p, r, i) {
      if (q in NV) X[q] = 1
      if (!(q in DN)) return
      X[q "/"] = 1
      for (p in NV) if (index(p, q "/") == 1) { X[p] = 1; r = substr(p, length(q) + 2)
        while ((i = match(r, /\/[^\/]*$/)) > 0) { r = substr(r, 1, i - 1); X[q "/" r "/"] = 1 } } }
    function grow(k,   d, rv, src, n, a, j) {
      d = substr(k, 1, length(k) - 1); rv = R[k]
      if (!(d in DN)) return 1
      if (rv == "-") src = ""
      else if ((k in LP) && LP[k] == rv) src = "P"
      else if ((k in LV) && LV[k] == rv) src = "V"
      else return 0
      n = split(KIDS[d], a, "\n")
      for (j = 2; j <= n; j++) {
        if (src == "P" && ((d SUBSEP a[j]) in CP)) continue
        if (src == "V" && ((d SUBSEP a[j]) in CV)) continue
        subtree(d "/" a[j]) }
      return 1 }
    BEGIN {
      rd(ENVIRON["KN"], NV); rd(ENVIRON["KLN"], LN); rd(ENVIRON["KLP"], LP); rd(ENVIRON["KLV"], LV)
      kids(ENVIRON["KPP"], CP); kids(ENVIRON["KPV"], CV)
      if (seed) rd(ENVIRON["KV2"], VV)
      rd(ENVIRON["KT"], TV)
      while ((getline l < ENVIRON["KFT"]) > 0) { t = index(l, "\t"); f = substr(l, 1, t - 1); FT[f] = FT[f] "\n" substr(l, t + 1) }
      for (p in NV) { q = p
        while ((i = match(q, /\/[^\/]*$/)) > 0) { d = substr(q, 1, i - 1); e = substr(q, i + 1)
          DN[d] = 1; if (!((d SUBSEP e) in CN)) { CN[d SUBSEP e] = 1; KIDS[d] = KIDS[d] "\n" e }; q = d }
        if (index(p, root) == 1) { r = substr(p, length(root) + 1); i = index(r, "/"); if (i > 1) OWN[substr(r, 1, i - 1)] = OWN[substr(r, 1, i - 1)] "\n" p } }
      while ((getline l < ENVIRON["KM"]) > 0) MAPPED[l] = 1
      while ((getline l < ENVIRON["KLOC"]) > 0) { t = index(l, "\t"); LOC[substr(l, 1, t - 1)] = 1 }
      while ((getline l < ENVIRON["KR"]) > 0) { t = index(l, "\t"); f = substr(l, 1, t - 1); ROWS[f] = ROWS[f] "\n" substr(l, t + 1) }
      while ((getline l < ENVIRON["KC"]) > 0) { n = split(l, a, "\t")
        if (a[2] == "#state") RST[a[1]] = a[3]
        else if (a[2] == "#tools") RTL[a[1]] = a[3]
        else { RK[a[1]] = RK[a[1]] "\n" a[2]; RV[a[1] SUBSEP a[2]] = a[3] } }
      while ((getline f < ENVIRON["KF"]) > 0) {
        delete K; delete R; delete X; delete LM
        um = !(f in MAPPED)
        if (um) { for (p in NV) K[p] = 1 }
        else { n = split(ROWS[f], a, "\n"); for (j = 2; j <= n; j++) addk(a[j])
               n = split(OWN[f], a, "\n"); for (j = 2; j <= n; j++) K[a[j]] = 1 }
        delete TK
        for (k in K) if (k in FT) { n = split(FT[k], a, "\n"); for (j = 2; j <= n; j++) TK[a[j]] = 1 }
        for (k in TK) K[k] = 1
        has = 0; st = ""; rl = 0
        # A SEEDED WHOLE-TREE KEY ALSO COMPARES EVERY v2 PATH: one deleted since v2 is not in K.
        if (seed) { has = 1; st = "seeded"; for (k in K) R[k] = sv(k); if (um) for (p in VV) if (!(p in R)) R[p] = VV[p] }
        else if (f in RST) { has = 1; st = RST[f]
          n = split(RK[f], a, "\n"); for (j = 2; j <= n; j++) R[a[j]] = RV[f SUBSEP a[j]] }
        first = ""; fch = 0; tch = 0
        if (has) {
          for (k in R) { if (k ~ /\/$/) rl = 1
            if (cur(k) == R[k]) continue
            if (substr(k, 1, 1) == "/") { tch = 1; continue }
            if (first == "" || k < first) first = k; if (k ~ /\/$/) LM[k] = 1; else if (k in K) fch = 1 }
          for (k in K) if (!(k in R)) { if (substr(k, 1, 1) == "/") tch = 1; else if (first == "" || k < first) first = k } }
        run = 1; why = ""; c = ""
        if (!has) { why = "unrecorded"; c = "u" }
        else if (st == "stale") { why = "stale"; c = "s" }
        else if (tch) { why = "tools changed"; c = "k" }
        else if (first != "") { why = um ? "unmapped: closure changed" : "changed " first; c = "k" }
        else run = 0
        if (!run) { if (!seed) { print f "\tskip\t\t\t" st; continue }; ns = "seeded" }
        else if (!has || um) ns = "ok"
        else if (st == "stale") ns = ((f in LOC) ? "ok" : "stale")
        else if (fch) ns = "stale"
        else { ns = "ok"; if (rl) for (k in R) X[k] = 1
               for (k in LM) if (!grow(k)) ns = "stale" }
        for (k in K) X[k] = 1
        print f "\t" ns > ENVIRON["KH"]
        for (k in X) print f "\t" k "\t" cur(k) > ENVIRON["KO"]
        print f "\t" (run ? "run" : "skip") "\t" why "\t" c "\t" ns }
    }' > "$out/.kdec"
  LC_ALL=C sort -t "$tab" -k1,1 -k2 "$out/.kout" | awk -F'\t' -v kd="$out/.k" -v hdr="$out/.khdr" '
    BEGIN { while ((getline l < hdr) > 0) { t = index(l, "\t"); st[substr(l, 1, t - 1)] = substr(l, t + 1) } }
    $1 != f { if (f != "") close(o); f = $1; o = kd "/" f; print "#format k1" > o; print "#state " st[f] > o; print "#tools per-fixture" > o }
    { print substr($0, length(f) + 2) > o }'
}

# PUBLISH EACH PROSPECTIVE RECORD WHOSE FIXTURE PASSED, whatever its neighbours did, and every record a
# seed skipped. A FAIL, a kill or a missing verdict publishes nothing. temp + mv per record. The pre-run
# `.now` is kept as `$KEYS_DIR/.prev`, the path list the next run derives a moved listing's old entries
# from; it is only ever read after its listing hash matches the record's, so a red run may write it.
readset_keys_write() { # <out>
  local out="$1" f b
  [ -d "$out/.k" ] || return 0
  mkdir -p "$KEYS_DIR" 2>/dev/null || return 0
  for f in "$out/.k"/*; do
    [ -f "$f" ] || continue
    b="${f##*/}"
    if [ "$(cat "$out/$b" 2>/dev/null)" = ok ] || grep -qxF "$b" "$out/.k.always" 2>/dev/null; then
      cp "$f" "$KEYS_DIR/$b.key.tmp.$$" 2>/dev/null && mv "$KEYS_DIR/$b.key.tmp.$$" "$KEYS_DIR/$b.key" 2>/dev/null
    fi
  done
  if [ -s "$out/.now" ]; then
    cp "$out/.now" "$KEYS_DIR/.prev.tmp.$$" 2>/dev/null && mv "$KEYS_DIR/.prev.tmp.$$" "$KEYS_DIR/.prev" 2>/dev/null
  fi
  return 0
}

apply_readset_skip() {
  local list="$1" out="$2" n_all n_sel readset_at readset_age n_unmapped unmapped_names readset_deriver dv dsha="" b

  n_all="$(grep -c . "$list" 2>/dev/null)"; case "$n_all" in ''|*[!0-9]*) n_all=0 ;; esac

  # THE MANIFEST IS BUILT FIRST, BEFORE ANY EARLY RETURN: it is the pre-run state every record
  # this run publishes is keyed on.
  readset_manifest "$out"
  readset_local_validate "$list" "$out"

  # THE MAP DECAYS SILENTLY, AND THIS LINE IS THE ONLY THING THAT SAYS SO. A fixture directory
  # added after the last derivation has no entry and is keyed on the whole tree, so it runs on
  # almost every push -- correct, and the cost is invisible unless printed. The map's age and the
  # set it does not cover are printed on every run.
  if [ -s "$READSET_MAP" ] || [ -s "$out/.local.valid" ]; then
    readset_at="$(git log -1 --format=%h -- "$READSET_MAP" 2>/dev/null)"
    if [ -n "$readset_at" ]; then
      readset_age="$(git rev-list --count "${readset_at}..HEAD" 2>/dev/null)"
      case "$readset_age" in ''|*[!0-9]*) readset_age='?' ;; esac
      readset_age="derived at ${readset_at}, ${readset_age} commit(s) ago"
    else
      readset_age="UNTRACKED, age unknown"
    fi
    : > "$out/.unmapped"
    while IFS= read -r d; do
      b="${d%/}"; b="${b##*/}"
      grep -qxF "$b" "$out/.mapped.all" || printf '%s\n' "$b" >> "$out/.unmapped"
    done < "$list"
    n_unmapped="$(grep -c . "$out/.unmapped" 2>/dev/null)"; case "$n_unmapped" in ''|*[!0-9]*) n_unmapped=0 ;; esac
    printf '   ..    read-set map: %s; %s of %s fixture dir(s) UNMAPPED (keyed on the whole tree)' "$readset_age" "$n_unmapped" "$n_all"
    if [ "$n_unmapped" -gt 0 ]; then
      unmapped_names="$(tr '\n' ' ' < "$out/.unmapped" | sed 's/ $//')"
      printf ': %s' "$unmapped_names"
      readset_deriver="$(readset_deriver_path)"
      [ -n "$readset_deriver" ] && printf ' -- the next green push traces them automatically; by hand, with no sudo: bash %s --list "%s" --tracer sandbox' "$readset_deriver" "$unmapped_names"
    fi
    printf '\n'
  fi

  # THE ONLY RUN-ALL: the hashing instrument is broken, so no key can be read.
  [ -s "$out/.now" ] || { printf '   ..    could not hash the working tree -- running all %s\n' "$n_all"; return 0; }

  # A DECISION FILE SHORT OF THE LIST IS A BROKEN INSTRUMENT: an undecided fixture would read as skipped.
  if ! readset_keys "$list" "$out" || [ "$(grep -c . "$out/.kdec" 2>/dev/null)" != "$n_all" ]; then
    printf '   ..    could not build the fixture keys -- running all %s\n' "$n_all"; return 0
  fi
  awk -F'\t' '$2 == "skip" && $5 == "seeded" { print $1 }' "$out/.kdec" > "$out/.k.always"

  if [ "${AI_DLC_FIXTURE_NO_SKIP:-}" = "1" ]; then
    : > "$out/.k.always"
    printf '   ..    read-set skip OFF (AI_DLC_FIXTURE_NO_SKIP=1) -- running all %s\n' "$n_all"
    return 0
  fi

  awk -F'\t' 'NR == FNR { if ($2 == "run") r[$1] = 1; next }
              { b = $0; sub(/\/$/, "", b); sub(/.*\//, "", b) } (b in r)' "$out/.kdec" "$list" > "$out/.list.sel"
  n_sel="$(grep -c . "$out/.list.sel" 2>/dev/null)"; case "$n_sel" in ''|*[!0-9]*) n_sel=0 ;; esac
  printf '   ..    read-set keys: %s of %s fixture(s) run (%s changed, %s unrecorded, %s stale); skipping %s\n' \
    "$n_sel" "$n_all" "$(awk -F'\t' '$4 == "k"' "$out/.kdec" | grep -c .)" \
    "$(awk -F'\t' '$4 == "u"' "$out/.kdec" | grep -c .)" "$(awk -F'\t' '$4 == "s"' "$out/.kdec" | grep -c .)" \
    "$(( n_all - n_sel ))"
  awk -F'\t' '$2 == "run" && n < 10 { n++; print "   ..      " $1 ": " $3 }' "$out/.kdec"

  # A FIXTURE RECORDED STALE IS TRACED after a green run, beside the unmapped ones.
  dv="$(readset_deriver_path)"
  [ -n "$dv" ] && dsha="$(shasum -a 256 -- "$dv" 2>/dev/null | cut -d' ' -f1)"
  awk -F'\t' '$2 == "run" && $5 == "stale" { print $1 }' "$out/.kdec" | while IFS= read -r b; do
    grep -qxF "$b" "$out/.trace" "$out/.trace.held" 2>/dev/null || readset_trace_add "$out" "$b" "$dsha"
  done

  # An EMPTY dispatch list is not a skip: it falls through to the empty-suite FAIL in run_fixtures.
  if [ "$n_sel" -eq 0 ] && [ "$n_all" -gt 0 ]; then
    READSET_NO_CHANGE=1
    return 0
  fi
  mv "$out/.list.sel" "$list"
  return 0
}

run_fixtures() {
  local rc=0 d b out n_expected n_actual n_ordered verdict
  if [ "$POOL_DEPTH_IN" -ge 2 ]; then
    printf '   FAIL  fixture pool refused: nested at depth %s (PREPUSH_POOL_DEPTH=%s), a hook started by a hook started by a pool opens no pool\n' "$POOL_DEPTH_IN" "$POOL_DEPTH_IN"
    return 1
  fi
  if [ "$POOL_DEPTH_IN" -ge 1 ]; then printf '   nested: depth %s, width %s\n' "$POOL_DEPTH_IN" "$FIXTURE_JOBS"; fi
  out="$(mktemp -d)" || return 1
  # DOT-PREFIXED, and that is what makes the name collision-proof rather than
  # unlikely. Every verdict file in "$out" is named for a fixture, and the glob
  # below cannot match a directory whose name begins with a dot -- so no fixture
  # can ever be called `.dur` and land on top of this one. `.log` is the same shape and
  # gets its safety from the same dot.
  mkdir -p "$out/.dur" "$out/.log" || { rm -rf "$out"; return 1; }
  # EMPTY THE THIS-RUN RECORD HERE, on the first line that only runs because the pool is
  # starting. Anything that goes wrong after this -- no fixtures, a red unit, a dead worker --
  # leaves the file empty, so finding it empty tells you no complete measurement exists instead
  # of handing you last week's number as though it were today's. Errors are silenced the way
  # every other write in this block silences them.
  : > "$LASTRUN_RECORD" 2>/dev/null

  for d in "$FXROOT"*/; do
    [ -f "$d/run.sh" ] || continue
    printf '%s\n' "$d"
  done > "$out/list"
  # `grep -c .` PRINTS 0 and EXITS 1 on an empty file, so the obvious
  # `$(grep -c . "$f" || echo 0)` yields the two-line string "0\n0" — and both
  # integer tests in this function then die with "integer expression expected",
  # take their false branch, and the suite returns 0 having run nothing. That is
  # how the empty-suite guard below shipped UNABLE TO FIRE: the line was present,
  # the mechanism was not, and a fixture driving the real hook is what found it.
  # Normalise to a bare integer instead of rescuing a failed exit status.
  READSET_NO_CHANGE=0
  apply_readset_skip "$out/list" "$out"

  # A WHOLE-SUITE SKIP CANNOT BE SIGNALLED BY AN EMPTY LIST, and the guard four lines down is
  # why: an empty list is a hard FAIL here, deliberately, because "an empty suite passes every
  # assertion it never made". So the no-change case is carried by its own flag and returns
  # before the count is taken, leaving the prior verified state and the prior key untouched --
  # nothing ran, so nothing new is blessed.
  if [ "${READSET_NO_CHANGE:-0}" = "1" ]; then
    SUITE_SKIPPED=1
    # A seed that skips every fixture still publishes its records, so it lands once.
    readset_keys_write "$out"
    rm -rf "$out"
    return 0
  fi

  n_expected="$(grep -c . "$out/list" 2>/dev/null)"
  case "$n_expected" in ''|*[!0-9]*) n_expected=0 ;; esac
  if [ "$n_expected" -eq 0 ]; then
    printf '   FAIL  no fixtures found -- an empty suite passes every assertion it never made\n'
    rm -rf "$out"; return 1
  fi

  # DISPATCH LONGEST-FIRST, FROM WHAT YOUR OWN LAST RUN COST.
  #
  # A pool finishes when its longest unit finishes, so what matters is when that unit
  # STARTS. In glob order it starts wherever the alphabet puts it. Measured on the
  # reference consumer's own 109-fixture suite at width 16: the two heaviest units sat
  # at positions 62 and 63, the pole began 5.5s into the run, and the suite ended with
  # it running alone. Dispatched longest-first the pole starts at 0.0s and the suite's
  # median goes 30.83s -> 28.61s over four alternating pairs whose readings do not
  # overlap -- about 7%.
  #
  # NOTHING HERE IS TUNED TO ONE MACHINE, which is the difference between this and the
  # pool width above. The order is derived from YOUR suite's own recorded costs, so a
  # box or a fixture set that makes a different unit the pole gets a different order for
  # free. What you should NOT expect is a fixed percentage: running the heavy units
  # together makes each of them slower, and where one unit dominates the wall clock that
  # trade comes out level. On the distribution's own suite it does exactly that and wins
  # nothing measurable; it is shipped for the schedule shape a consumer suite has.
  #
  # THE RECORD LIVES UNDER .git ON PURPOSE. It is written once per run and it is not
  # part of your project's tree, so it never shows up in a diff, a status, or a commit.
  #
  # IF ANYTHING ABOUT IT IS MISSING OR ODD, THE SUITE RUNS IN PLAIN GLOB ORDER: no
  # record yet (every first run), an unreadable one, or a reordering that did not come
  # back with exactly the units it was handed. That last guard is the one worth stating,
  # because a reorder which DROPS a unit reads exactly like a reorder that is fast --
  # and it still could not hide if the guard were gone, since the expected count and the
  # report below are both taken from "$out/list" and never from the dispatch order.
  cp "$out/list" "$out/.order"
  if [ -s "$DURATIONS_RECORD" ]; then
    awk 'NR==FNR { if (NF == 2) prev[$1] = $2; next }
         { b = $0; sub(/\/$/, "", b); sub(/.*\//, "", b)
           print ((b in prev) ? prev[b] : 999999) " " $0 }' \
        "$DURATIONS_RECORD" "$out/list" 2>/dev/null \
      | sort -k1,1nr | cut -d' ' -f2- > "$out/.order.lpt" 2>/dev/null
    n_ordered="$(grep -c . "$out/.order.lpt" 2>/dev/null)"
    case "$n_ordered" in ''|*[!0-9]*) n_ordered=0 ;; esac
    [ "$n_ordered" -eq "$n_expected" ] && mv "$out/.order.lpt" "$out/.order"
  fi

  # Each worker records its verdict to a file named for its fixture. The verdict is read
  # back from those FILES, not from xargs exit status, because that is what makes the
  # completeness assertion below possible -- and because `xargs` collapses any number of
  # failures into one exit code that cannot say WHICH.
  #
  # It records its own cost beside the verdict, in whole seconds off the worker shell's
  # own SECONDS, which costs no extra process. A unit that never ran simply has no line.
  # A fixture the record has never seen sorts FIRST, because an unknown cost is safer
  # treated as the largest: the case worth avoiding is a new heavy fixture dispatched
  # last, and that is exactly what a brand-new fixture would otherwise be.
  PREPUSH_POOL_DEPTH="$((POOL_DEPTH_IN + 1))" AI_DLC_FX_OUT="$out" xargs -P "$FIXTURE_JOBS" -I{} bash -c '
    d="$1"; b="$(basename "$d")"
    if bash "$d/run.sh" > "$AI_DLC_FX_OUT/.log/$b" 2>&1; then printf ok   > "$AI_DLC_FX_OUT/$b"
    else                                      printf FAIL > "$AI_DLC_FX_OUT/$b"; fi
    printf "%s %s\n" "$b" "$SECONDS" > "$AI_DLC_FX_OUT/.dur/$b"
  ' _ {} < "$out/.order"

  # Rendered in list order, so the output is deterministic and diffable across runs even
  # though the work completed out of order.
  n_actual=0
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    b="$(basename "$d")"
    if [ ! -f "$out/$b" ]; then
      printf '   FAIL  %s  (no verdict recorded)\n' "$b"; rc=1; continue
    fi
    n_actual=$((n_actual + 1))
    verdict="$(cat "$out/$b")"
    if [ "$verdict" = ok ]; then printf '   ok    %s\n' "$b"
    else                        printf '   FAIL  %s\n' "$b"; rc=1; fi
  done < "$out/list"

  # THE CONTROL PARALLELISM MAKES NECESSARY. Serially, a fixture that never ran could not
  # print an `ok` -- the loop and the report were the same thing. With a worker pool they
  # are not: a dropped job produces no verdict file, and a suite reporting 70 greens
  # instead of 75 reads exactly like a suite that passed. This is the check-that-cannot-
  # fire class one layer out, so the count is asserted rather than assumed.
  #
  # WHICH OF THE TWO ARMS DOES THE DETECTING, measured rather than asserted, because
  # this comment used to imply the count was an independent detector and it is not.
  # The report walks the LIST, so a missing verdict is caught by the `[ ! -f ]` branch
  # above; `n_actual` is incremented on exactly the path that branch skips, so the
  # count below can only fire when that branch already has. Its contribution is
  # MAGNITUDE -- one line saying how much of the suite is missing, instead of N lines
  # each saying one fixture is. `consumer-suite-pool`'s M2b mutant is the measurement:
  # remove the per-fixture branch and a lost worker is misreported as a failing
  # fixture while this count stays silent.
  if [ "$n_actual" -ne "$n_expected" ]; then
    printf '   FAIL  %s of %s fixtures produced a verdict -- the pool dropped work, and a short green suite reads exactly like a passing one\n' \
      "$n_actual" "$n_expected"
    rc=1
  fi

  # Publish this run's costs for the next run to dispatch on -- one read for the whole
  # suite, not one per fixture, because a process per item is what made this runner
  # system-bound in the first place. A run that recorded nothing leaves the previous
  # record alone instead of replacing it with an empty one, which would cost the next
  # run its ordering too.
  #
  # THE RECORD IS MERGED, NOT REPLACED. Only a fixture that actually RAN leaves a cost
  # behind, and the read-set skip above means most pushes run a fraction of the suite.
  # Overwriting the record with just those costs threw away everything the skip had
  # decided not to run, and an unknown cost sorts FIRST -- so the next full run picked
  # up its heaviest fixtures LAST and finished later than it needed to.
  #
  # Old record first, this run second, last value wins: a fixture that ran gets its new
  # cost, a fixture that was skipped keeps the one it had. `NF == 2` is the same test the
  # ordering step above applies, so what is written and what is read cannot drift apart.
  # A cost left behind for a fixture you have deleted is harmless -- nothing looks up a
  # name with no directory -- and is not worth the code to remove.
  cat "$out"/.dur/* > "$out/.durations" 2>/dev/null
  if [ -s "$out/.durations" ]; then
    { [ -s "$DURATIONS_RECORD" ] && cat "$DURATIONS_RECORD"; cat "$out/.durations"; } 2>/dev/null \
      | awk 'NF == 2 { c[$1] = $2 } END { for (k in c) print k, c[k] }' \
      | sort > "$out/.merged"
    [ -s "$out/.merged" ] && cp "$out/.merged" "$DURATIONS_RECORD" 2>/dev/null
  fi

  # The format stamp is written only AFTER the record copy succeeds, so a failed copy cannot
  # leave a `v2` stamp vouching for a record this run did not write. A copy that lands with no
  # stamp after it is an unstamped record, which the next run reads as "run everything".
  if [ "$rc" -eq 0 ] && [ -s "$out/.now" ]; then
    cp "$out/.now" "$VERIFIED_RECORD" 2>/dev/null && printf 'v2\n' > "$VERIFIED_FORMAT" 2>/dev/null
  fi
  # PER-FIXTURE KEY RECORDS ARE PUBLISHED ON A RED RUN TOO: each one is gated on its own verdict.
  readset_keys_write "$out"

  # PUBLISH THIS RUN'S UNMERGED COSTS UNDER THE SAME GREEN-ONLY GATE. The file copied is the
  # PRE-MERGE one -- "$out/.durations" holds exactly the units this pool timed, whereas
  # "$out/.merged" above has already absorbed rows from earlier runs. Written only when every
  # unit came back green, because timings from a suite that stopped early describe a shorter
  # suite, not a faster one.
  if [ "$rc" -eq 0 ] && [ -s "$out/.durations" ]; then cp "$out/.durations" "$LASTRUN_RECORD" 2>/dev/null; fi

  # THE DETACHED TRACE STARTS ONLY HERE, after every record above is written and only on a GREEN
  # run: a trace measures reads, but a fixture whose normal run failed has no run to compare it to.
  if [ "$rc" -eq 0 ]; then readset_live_trace "$out"; fi

  # COPY THE RED UNITS' OUTPUT OUT BEFORE THE TEMP DIR IS REMOVED. This is the last line at
  # which "$out" still exists; the `rm -rf` below is straight-line and there is no trap, so
  # anything not copied here is gone for good.
  #
  # A UNIT WITH NO VERDICT IS A FAILURE TOO. Walking the list and re-reading each verdict
  # catches both shapes -- a fixture that ran and failed, and one whose worker died before it
  # recorded anything. The second has no output to show, and the record says so rather than
  # leaving an empty section that looks like a clean unit.
  : > "$out/.failures" 2>/dev/null
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    b="$(basename "$d")"
    [ -f "$out/$b" ] && [ "$(cat "$out/$b")" = ok ] && continue
    { printf '===== %s =====\n' "$b"
      if [ -s "$out/.log/$b" ]; then cat "$out/.log/$b"
      elif [ -f "$out/.log/$b" ]; then printf '(ran and printed nothing)\n'
      else printf '(no capture file: the worker died before it could run this unit)\n'; fi
      printf '\n'; } >> "$out/.failures" 2>/dev/null
  done < "$out/list"

  # THE DISPATCH ORDER GOES IN TOO. If a fixture only fails when the machine is busy, what it
  # was running alongside is the thing you will want to know, and nothing else records it --
  # the durations file holds costs, not co-scheduling.
  if [ -s "$out/.failures" ]; then
    fl_wrote=0
    { printf '===== fixture failures -- %s, pool width %s, %s of %s units red =====\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$FIXTURE_JOBS" \
        "$(grep -c '^===== ' "$out/.failures")" "$n_expected"
      cat "$out/.failures"
      printf '===== dispatch order this run (longest-first) =====\n'
      cat "$out/.order"; :; } > "$FAILLOG_RECORD" 2>/dev/null && fl_wrote=1
    printf '   captured output for the failing unit(s): %s\n' "$FAILLOG_RECORD"
    # THIS RUN'S OWN COPY, taken only when the write above SUCCEEDED. The trailing `:` inside the
    # braces is what makes `fl_wrote` mean "the redirect opened": without it the group's status is
    # `cat .order`'s, and a missing order file would skip a copy of a good record. A copy taken
    # after a FAILED write would be the previous run's record under this run's name. Nothing
    # here can change `rc`: a failed copy or prune is silent and the verdict stands.
    fl_stamp="$(date -u +%Y%m%dT%H%M%SZ 2>/dev/null)" || fl_stamp=""
    fl_copy="$GITDIR/ai-dlc-fixture-failures.$fl_stamp.$$"
    if [ "$fl_wrote" = 1 ] && [ -n "$fl_stamp" ] && cp "$FAILLOG_RECORD" "$fl_copy" 2>/dev/null; then printf '   retained copy of this run: %s\n' "$fl_copy"; fi
    # PRUNE TO THE NEWEST FAILLOG_KEEP, BY NAME, ANCHORED AT BOTH ENDS. The glob anchors the
    # front -- a year, a month -- and never `ai-dlc-fixture-failures.*`, which would also take a
    # record saved under a name of its own. The glob alone cannot anchor the END: a copy saved
    # as `<stamp>.<pid>.keep` matches it, gets deleted, and takes a slot from a real copy. The
    # `case` is that end anchor -- only an all-digit last field (the pid) is a generated name.
    # `[ -e ]` keeps an unmatched glob's literal text from ever reaching `rm`.
    for fl_f in "$GITDIR"/ai-dlc-fixture-failures.2[0-9][0-9][0-9][01][0-9]*Z.*; do
      case "${fl_f##*.}" in ''|*[!0-9]*) continue ;; esac
      [ -e "$fl_f" ] && printf '%s\n' "$fl_f"
    done | sort -r | tail -n +$((FAILLOG_KEEP + 1)) | while IFS= read -r fl_f; do
      [ -e "$fl_f" ] && rm -f "$fl_f" 2>/dev/null
    done
  fi

  rm -rf "$out"
  return $rc
}
# FIXTURE_POOL_END
#    A MID-PULL TREE CANNOT BE JUDGED. /ai-dlc-update writes core one file at a time and
#    clears .claude/.ai-dlc-applying only when it writes the re-stamp, so while that marker
#    exists the tree is a mixture of two releases. Its fixtures then fail in both
#    directions — a fixture newer than its subject asserts behaviour that is not installed
#    yet, an older one breaks against a newer subject — and neither result means anything.
#    REFUSE rather than skip: a skipped suite is the green light nobody earned, and pushing
#    a half-applied core is worse than not pushing.
applying_guard() {
  cat <<'MSG'
   .claude/.ai-dlc-applying exists — this tree is mid-pull, and its fixture suite would
   report failures that are neither a regression nor your fault.

   The re-stamp was withheld for ONE of two reasons, and they have different exits. The
   apply manifest says which: look for the DECISION restamp-withheld row.

   1. A file could not be placed mechanically. Fix the paths that row names, then:

        /ai-dlc-update      (re-run; it resumes and re-stamps once the tree is consistent)

   2. WORKLIST or DECISION rows were handed back and are not yet disposed. Do them —
      each semantic merge, each override readopt/retire, each extension re-read, each
      operator call — and then do what the restamp-withheld row names. Usually that is
      the finisher:

        reconcile/apply.sh --finish [--carried-machinery-slice] <dist> <base> . <theirs>

      RE-RUNNING /ai-dlc-update DOES NOT CLEAR THESE. A hand-back row is derived from the
      upstream range against your extensions, not from the tree, so a re-run re-emits it and
      withholds again. The withheld row prints the exact command with the machinery flag
      already resolved. When a row only a fresh ordinary run clears is outstanding, the
      withheld row names re-render / re-approve / re-run INSTEAD, and says --finish is not
      the next step; follow it.

      --finish checks the tree before it stamps. It withholds again, with a WORKLIST row per
      file, while any file still reads as a pure apply from theirs (missing, or still at
      base), and while any file the apply handed back as a semantic merge is still
      byte-identical to the copy the apply found, mode included. It also withholds when <base>
      is not the stamp's own commit, or when <theirs> is not the ref recorded in this marker. A
      file you merged by hand differs from that copy in bytes or mode and does not hold it up.

      If keeping one of those copies as it is IS the disposition, delete that file's own
      `classify: ... <path>` line from .claude/.ai-dlc-applying and re-run --finish. Every
      other check still runs, and this marker keeps blocking the suite until the stamp.

   LAST RESORT, if that pull was abandoned and the tree is known good: remove the marker.
   This unblocks the fixture suite on whatever the tree holds, and the next --finish stamps
   without checking <theirs> or any handed-back merge:

     rm .claude/.ai-dlc-applying

   Do not push a half-applied core. While this marker exists the stamp does not name the
   release this tree holds, and the next pull computes its merge base from that stamp.
MSG
  return 1
}
# A push issued from a LINKED WORKTREE has git export GIT_DIR (pointed at that
# worktree's private `.git/worktrees/<name>` dir) into this hook's process
# environment; a push from the primary checkout does not. A `git` invocation
# above this line still honors an exported GIT_DIR/GIT_WORK_TREE/GIT_INDEX_FILE
# -- that's git's own behavior, not something this hook's shell code opts into
# -- and every one of those invocations wants exactly that: to operate on the
# worktree actually being pushed. What breaks is different: every fixture below
# builds its own isolated
# sandbox (`mktemp -d`, `cd`, `git -C`, a fresh `git init`) on the assumption
# that git's own upward repository-discovery will find that sandbox -- discovery
# git only consults when GIT_DIR is unset. Leaked and inherited unscrubbed, a
# fixture's `git init`/`git commit` sequence is silently redirected onto THIS
# repository instead of its own sandbox -- a reference consumer hit exactly this
# corruption twice before the scrub was added there. Scrub once here, in the
# parent shell, before either fixture dispatch site (`drivability` below and the
# `xargs`/`bash -c` pool inside `run_fixtures`) so both inherit a clean environment.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY

if [ -f .claude/.ai-dlc-applying ]; then
  step "fixture suite" applying_guard
elif [ -d tests/fixtures ]; then
  [ -f scripts/ai-dlc/validate-fixture-drivability.sh ] &&
    step "fixture drivability (a skipped fixture reads like one that passed)" drivability
  step "fixture suite (${FIXTURE_JOBS}-way)" run_fixtures
fi

if [ "$fail" -ne 0 ]; then
  printf '\npre-push: BLOCKED. Fix the above, or `git push --no-verify` on the record.\n\n'
  exit 1
fi
printf '\npre-push: all gates green.\n\n'
