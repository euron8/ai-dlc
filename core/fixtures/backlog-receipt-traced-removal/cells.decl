# backlog-receipt-traced-removal's validator starts (BL-879 grammar), lead ruling (a), batch 256. Every distinct state
# is ONE start of a copy of scripts/validate-backlog-receipts.sh, tagged at its start through env FXCELL=<cell> by
# run.sh's cli(); run.sh asserts that the tagged starts are exactly the cli cells below, each once. The validator's own
# worker re-starts under a tagged start are covered by the ONE nested row at the end. The in-process passes that remain
# (fx_inproc: r13_untraced, m1_driver_absent, vbr_sec_setup alone) reach no worker start.
# controls
cli scripts/validate-backlog-receipts.sh c-write
cli scripts/validate-backlog-receipts.sh c-replay
cli scripts/validate-backlog-receipts.sh c-moved-judge
cli scripts/validate-backlog-receipts.sh c-moved-named
cli scripts/validate-backlog-receipts.sh red
cli scripts/validate-backlog-receipts.sh overflow
cli scripts/validate-backlog-receipts.sh notrun
cli scripts/validate-backlog-receipts.sh c-stale-high
cli scripts/validate-backlog-receipts.sh c-committed
cli scripts/validate-backlog-receipts.sh pop-1
cli scripts/validate-backlog-receipts.sh pop-2
cli scripts/validate-backlog-receipts.sh within-1
cli scripts/validate-backlog-receipts.sh within-2
cli scripts/validate-backlog-receipts.sh within-3
cli scripts/validate-backlog-receipts.sh c-instr-refused
cli scripts/validate-backlog-receipts.sh base3-3
cli scripts/validate-backlog-receipts.sh cli-wire
cli scripts/validate-backlog-receipts.sh c-m1-e2e
cli scripts/validate-backlog-receipts.sh c-empty-stale
cli scripts/validate-backlog-receipts.sh c-nothing-judged
cli scripts/validate-backlog-receipts.sh c-enum-unguarded
cli scripts/validate-backlog-receipts.sh c-var-built
nested scripts/validate-backlog-receipts.sh scripts/validate-backlog-receipts.sh why=worker re-starts of --score-one, --closed-one and --r13-one
