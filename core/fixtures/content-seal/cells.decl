# The programs those cells start start the shipped seal (and the join its merge) as child programs.
nested core/scripts/merge-adversarial-shards.sh core/scripts/content-seal.sh why=the merge CLI runs of cs-merge-merged and cs-merge-refused start the shipped seal as a program for --check, --last-tool-row, --admit-marker, --program-row and --record
nested core/scripts/join-remediator-shards.sh core/scripts/content-seal.sh why=the join CLI runs of cs-join-joined and cs-join-refused start the shipped seal as a program for --check and --record
nested core/scripts/join-remediator-shards.sh core/scripts/merge-adversarial-shards.sh why=the join CLI runs ask the merge for its pair separator as a program
nested core/scripts/wait-for-deliverable.sh core/scripts/content-seal.sh why=the wfd CLI runs of cs-wfd-mark-pass and the two --status cells start the shipped seal as a program for --record-expect and the marker admission
nested core/scripts/validate-gate-adjudication.sh core/scripts/content-seal.sh why=the validator CLI runs of cs-gate-pass and cs-gate-refuse start the shipped seal as a program for --check, --row and --first-tool-ts
