# subject-partition drives partition-subject.sh with partition-document.sh beside it, copies both into mutant dirs, and its receipt.sh
# (in the fixture's own directory, copied by the runner) drives merge-adversarial-shards.sh and validate-adversarial-convergence.sh.
# Every world is a git repo built under mktemp; no live history is read. Nothing enumerates core/scripts/: each sibling is
# resolved by name (run.sh:41-50, receipt.sh:37-157), so the scripts are declared one by one, against a fresh sandbox read-set
# trace. That trace reads no validate-steering-budget.sh: the convergence --series runs here never reach a steering citation.
!core/scripts/partition-subject.sh
!core/scripts/partition-document.sh
core/scripts/merge-adversarial-shards.sh
core/scripts/validate-adversarial-convergence.sh
# The merge reads BACKDATE_TOL_S from this sibling on every run (its invoked_at bound).
core/scripts/validate-artifact-budget.sh
# The merge derives each shard dispatch id from the write ledger this hook appends; every shard the fixture writes drives it.
core/hooks/ai-dlc-gate-remediation-guard.sh
