# Measured by a counted run through core/scripts/hermetic-run.sh (the judge's own J3 output), once.
# The validator is loaded once and asked in process (inproc row); it starts only in its two cli cells (cells.decl).
3 *
2 core/scripts/validate-provenance-block.sh
5 inproc:core/scripts/validate-provenance-block.sh
