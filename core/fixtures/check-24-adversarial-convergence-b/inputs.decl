# check-24-adversarial-convergence and its three shard drivers (b, c, d, which exec the parent's run.sh --group) share one declaration shape, except the parent's adds the step files read only by unit tstrat, which runs in shard a.
# The validator under test: every case drives it. REQUIRED, printed where the validator is resolved.
!core/scripts/validate-adversarial-convergence.sh
# Its siblings, copied into the mutant and world trees, and driven by the K2 and K3 arms.
core/scripts/validate-steering-budget.sh
core/scripts/partition-document.sh
core/scripts/partition-subject.sh
core/scripts/merge-adversarial-shards.sh
# The merge reads BACKDATE_TOL_S from this sibling on every run (its invoked_at bound).
core/scripts/validate-artifact-budget.sh
# The merge answers --pair-sep from validate-provenance-block.sh and the schema its chain resolves;
# without them here the K3 worlds emit `=` and the `@` build grep reads a broken world.
core/scripts/validate-provenance-block.sh
core/schemas/provenance-block.json
# Read by the live-series, H-BIND and bind arms (extracted and compared, not run).
core/hooks/ai-dlc-acknowledge.sh
core/team-roles/remediator.md
core/skills/ai-dlc/steps/gate-validation.md
core/fixtures/lib/
# The shard drivers: the parent's coverage join reads every one. A fixture's OWN run.sh is not declared: the runner copies the fixture's own directory itself.
core/fixtures/check-24-adversarial-convergence-b/run.sh
core/fixtures/check-24-adversarial-convergence-c/run.sh
core/fixtures/check-24-adversarial-convergence-d/run.sh
# The shards exec the parent run.sh and the parent seeds from its own seed.sh; a sibling directory is not copied unless declared.
core/fixtures/check-24-adversarial-convergence/run.sh
core/fixtures/check-24-adversarial-convergence/seed.sh
# The BL-733 and BL-736 receipts, which units elic and j2h drive as arms (each builds its own worlds).
core/fixtures/check-24-adversarial-convergence/receipt-bl733.sh
core/fixtures/check-24-adversarial-convergence/receipt-bl736.sh
# The BL-814 receipt unit j3 drives, and the step files its J3-MAP arm binds J3_SUCCESSORS against (shard b only).
core/fixtures/check-24-adversarial-convergence/receipt-bl814.sh
core/skills/ai-dlc/steps/carry-over-evaluation.md
core/skills/ai-dlc/steps/requirements.md
core/skills/ai-dlc/steps/research-requirements.md
core/skills/ai-dlc/steps/architecture.md
