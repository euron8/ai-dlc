# The merge under test: the mutation battery copies it and its four siblings into per-mutant
# directories and rewrites one line of the copy. The sibling fixture's lib.sh holds the predicates
# and the seeds (sourced at run.sh line 59); lib/preamble.sh is sourced at run.sh line 2.
!core/scripts/merge-adversarial-shards.sh
core/scripts/validate-adversarial-convergence.sh
core/scripts/partition-document.sh
core/scripts/partition-subject.sh
core/scripts/validate-steering-budget.sh
core/fixtures/adversarial-shard-merge/
core/fixtures/lib/
# Every shard helper in lib.sh drives the remediation-guard hook (the write ledger the merge derives each dispatch id from).
core/hooks/ai-dlc-gate-remediation-guard.sh
# The shard drivers: the coverage join (J0) reads every one.
core/fixtures/adversarial-shard-merge-mutants-b/run.sh
core/fixtures/adversarial-shard-merge-mutants-c/run.sh
core/fixtures/adversarial-shard-merge-mutants-d/run.sh
core/fixtures/adversarial-shard-merge-mutants-e/run.sh
core/fixtures/adversarial-shard-merge-mutants-f/run.sh
