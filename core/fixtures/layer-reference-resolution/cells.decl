# layer-reference-resolution's starts of core/scripts/validate-layer-entries.sh (BL-879 grammar). Every other drive
# is in process: run.sh sources the validator once and calls vle_main in a subshell. One cli cell per distinct CLI
# outcome (exit 0 a contract-only consumer, exit 1 the seeded consumer, exit 1 under --check-refs with its listing,
# exit 2 a tree that is no consumer), each started as FXCELL=<id> bash "$LINTER" in eqv() and compared byte for byte
# with the in-process call on the same input.
cli core/scripts/validate-layer-entries.sh cli-pass
cli core/scripts/validate-layer-entries.sh cli-fail
cli core/scripts/validate-layer-entries.sh cli-refs
cli core/scripts/validate-layer-entries.sh cli-refuse
