# held-stories drives the validator under test and the sprint-status.sh reader it calls as a
# sibling, which resolves the sprint-status schema; s3/s3n drive snapshot-update.sh, which calls
# validate-artifact-budget.sh and the validator as siblings. Its own directory is copied by the runner.
# The S-arms read the two prose carriers: implementation.md section 7 and the recover hook's
# verification turn.
!core/scripts/validate-held-stories.sh
!core/scripts/sprint-status.sh
!core/schemas/sprint-status.json
!core/scripts/snapshot-update.sh
!core/scripts/validate-artifact-budget.sh
core/skills/ai-dlc/steps/implementation.md
core/hooks/ai-dlc-recover.sh
core/fixtures/lib/report.sh
# Loaded in process (BL-878): run.sh sources lib/layout.sh and lib/inproc.sh, which sources lib/mutant.sh for fx_inproc.
core/fixtures/lib/layout.sh
core/fixtures/lib/inproc.sh
core/fixtures/lib/mutant.sh
core/hooks/ai-dlc-window.sh
core/scripts/validate-adversarial-convergence.sh
core/scripts/validate-snapshot-conservation.sh
core/scripts/wait-for-deliverable.sh
