# relabel-theirs-collision's starts of core/skills/ai-dlc-update/reconcile/relabel-extension-checks.sh (BL-879 grammar).
# Every other drive is in process: run.sh loads the subject once (inproc_load) and calls rec_main through rec_ip.
# One cli cell per distinct CLI outcome (exit 1 with the previewed rewrites, exit 0 with the clean line, exit 2 with
# the usage line), each started as FXCELL=<id> bash "$SCRIPT" in eqv() and compared byte for byte with the in-process call.
cli core/skills/ai-dlc-update/reconcile/relabel-extension-checks.sh cli-preview
cli core/skills/ai-dlc-update/reconcile/relabel-extension-checks.sh cli-clean
cli core/skills/ai-dlc-update/reconcile/relabel-extension-checks.sh cli-usage
