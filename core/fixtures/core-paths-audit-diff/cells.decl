# core-paths-audit-diff's starts of core/scripts/core-paths.sh (BL-879 grammar). Every other drive is in process: run.sh asks
# cpth_main through cp_f. One cli cell per distinct CLI outcome of --audit-diff (exit 0 pass, exit 1 flag, exit 2 refusal),
# each started as FXCELL=<id> bash in eqv() and compared byte for byte with the in-process call on the same input.
cli core/scripts/core-paths.sh cli-core-pass
cli core/scripts/core-paths.sh cli-core-fail
cli core/scripts/core-paths.sh cli-core-refuse
