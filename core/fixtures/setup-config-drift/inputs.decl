# read from the reconcile directory; run.sh also copies the whole directory to drive the copy.
!core/skills/ai-dlc-update/reconcile/unregistered-drift.sh
core/skills/ai-dlc-update/reconcile/
core/fixtures/lib/preamble.sh
core/fixtures/lib/report.sh
core/fixtures/lib/layout.sh
core/fixtures/lib/mutant.sh
core/fixtures/lib/inproc.sh
