# budget-summary-verdict reads ONE file outside its own directory: the validator under test.
# run.sh locates it by candidate list, drives it directly, copies it into $WORK/bin for the control,
# and builds every mutant as a sed rewrite of it. Its own directory is copied by the runner.
!core/scripts/validate-artifact-budget.sh
# The F8 arm drives that validator THROUGH verdict.sh, the wrapper Check 14, route Step 0a and
# the between-gates sub-step all call, and builds one mutant of it.
!core/scripts/verdict.sh
# The LATE arms: the validator resolves each agent-cell candidate through the sibling
# wait-for-deliverable.sh --dispatch-ts, which reads its id grammar from the convergence validator
# and sources wfd-start-of.sh when present. The LATE mutants copy all three beside each mutant.
!core/scripts/wait-for-deliverable.sh
!core/scripts/validate-adversarial-convergence.sh
core/scripts/wfd-start-of.sh
# The mutation helpers run.sh sources.
core/fixtures/lib/mutant.sh
core/fixtures/lib/matrix.sh
