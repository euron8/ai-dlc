# layer-debt-ledger's starts of core/scripts/audit-layer-debt.sh (BL-879 grammar). Every other drive is in process:
# run.sh's ald() is inproc_run of ald_main. One cli cell per distinct CLI outcome (exit 0 report, exit 2 DISARMED),
# each started as FXCELL=<id> bash "$AUDIT" in eq_cell() and compared byte for byte with the in-process call.
cli core/scripts/audit-layer-debt.sh cli-report
cli core/scripts/audit-layer-debt.sh cli-disarm
