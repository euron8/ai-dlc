# setup-site-drift's starts of core/skills/ai-dlc-update/reconcile/setup-site-drift.sh (BL-879 grammar). Every other
# drive is in process: run.sh sources the subject once and calls ssd_main in a subshell. One cli cell per distinct CLI
# outcome (exit 0 OK, exit 1 drift, exit 2 usage refusal), each started as FXCELL=<id> bash "$SSD" in eqv() and
# compared byte for byte with the in-process call on the same inputs.
cli core/skills/ai-dlc-update/reconcile/setup-site-drift.sh cli-ok
cli core/skills/ai-dlc-update/reconcile/setup-site-drift.sh cli-drift
cli core/skills/ai-dlc-update/reconcile/setup-site-drift.sh cli-usage
