# apply-drift-after-write's starts of core/skills/ai-dlc-update/reconcile/apply.sh (BL-879 grammar). Every apply runs in process
# (apl -> apl_main); the section after the first apply keeps one program start per distinct CLI outcome, compared byte for
# byte with the in-process answer: no arguments (exit 1) and the passing apply (exit 0).
cli core/skills/ai-dlc-update/reconcile/apply.sh cli-refuse
cli core/skills/ai-dlc-update/reconcile/apply.sh cli-pass
