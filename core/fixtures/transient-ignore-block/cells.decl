# transient-ignore-block's starts of core/scripts/sync-transient-ignore.sh (BL-879 grammar). Every other drive is in
# process: run.sh loads the renderer once and asks sti_main through inproc_run. One cli cell per distinct CLI outcome
# (exit 0 the write path, exit 1 --check with no block, exit 2 an empty block marker), each started as
# FXCELL=<id> bash in eqv() and compared byte for byte with the in-process call.
cli core/scripts/sync-transient-ignore.sh cli-write
cli core/scripts/sync-transient-ignore.sh cli-check-missing
cli core/scripts/sync-transient-ignore.sh cli-refuse
