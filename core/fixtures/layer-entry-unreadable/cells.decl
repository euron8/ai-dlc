# layer-entry-unreadable's starts of core/scripts/validate-layer-entries.sh (BL-879 grammar). Every other drive is in
# process: run.sh sources the validator once and calls vle_main in a subshell, and sources the sealed copy inside the
# capturing subshell of each sr call. One cli cell per distinct CLI outcome the fixture reads (exit 2 the unreadable
# entry, exit 1 the keyless twin, exit 0 the clean consumer), each started as FXCELL=<id> bash "$LINTER" in eqv() and
# compared byte for byte with the in-process call on the same input.
cli core/scripts/validate-layer-entries.sh cli-refuse
cli core/scripts/validate-layer-entries.sh cli-fail
cli core/scripts/validate-layer-entries.sh cli-pass
