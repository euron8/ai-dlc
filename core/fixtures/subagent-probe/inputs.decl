# subagent-probe reads TWO files outside its own directory: the SubagentStop hook under test, and
# the sibling library it sources for its per-turn token def (no row is written without it).
# seed.sh locates the hook and writes it into env.sh as HOOK; every fire() in run.sh pipes a payload into it.
!core/hooks/ai-dlc-subagent-probe.sh
!core/hooks/ai-dlc-usage-tokens.sh
