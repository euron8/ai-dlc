# retired-fixture-orphan's starts of core/skills/ai-dlc-update/reconcile/retired-fixtures.sh (BL-879 grammar). Every
# other drive is in process: rf_run sources one detector copy in a subshell and calls rf_main. One cli cell per distinct
# CLI outcome (orphan rows, the history-unavailable row, the scan-unavailable row), each started as
# FXCELL=<id> bash <copy> in eqv() and compared byte for byte with the in-process call on the same inputs.
cli core/skills/ai-dlc-update/reconcile/retired-fixtures.sh cli-orphans
cli core/skills/ai-dlc-update/reconcile/retired-fixtures.sh cli-shallow
cli core/skills/ai-dlc-update/reconcile/retired-fixtures.sh cli-nomap
