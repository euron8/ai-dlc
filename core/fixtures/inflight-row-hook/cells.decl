# inflight-row-hook's cells. Every start of the hook and of the waiter is one end-to-end cell, tagged at its start
# by hook()/waiter() (FXCELL=<tag>). Both subjects ARE their wiring: a hook is its stdin payload, exit code and the
# snapshot it leaves; the waiter is its argv and the row its DELIVERED line writes. No sourced call reproduces either.
e2e core/hooks/ai-dlc-inflight-row.sh ship.dispatch why=an async launch writes its row, stamped from the ledger
e2e core/hooks/ai-dlc-inflight-row.sh ship.eraold why=the old-era step file: no row, exit 0
e2e core/hooks/ai-dlc-inflight-row.sh ship.nested why=a nested spawn: no row, exit 0
e2e core/hooks/ai-dlc-inflight-row.sh ship.updater why=an /ai-dlc-update transcript: no row, silent, exit 0
e2e core/hooks/ai-dlc-inflight-row.sh ship.leadtr why=the same dispatch over an /ai-dlc transcript writes the row
e2e core/hooks/ai-dlc-inflight-row.sh ship.noledger why=no spawn-ledger row: no row, exit 0
e2e core/hooks/ai-dlc-inflight-row.sh ship.dlparse why=the first path of a Deliverable line naming two
e2e core/hooks/ai-dlc-inflight-row.sh ship.dlfall why=no Deliverable line: the ledger mark_file
e2e core/hooks/ai-dlc-inflight-row.sh ship.nodl why=neither: exit 2 naming the --row-add call
e2e core/hooks/ai-dlc-inflight-row.sh ship.rowdiff why=an existing row with the same id and different cells: exit 2 naming --row-replace
e2e core/hooks/ai-dlc-inflight-row.sh ship.substop why=SubagentStop with the deliverable present flips the row
e2e core/hooks/ai-dlc-inflight-row.sh ship.substopabs why=SubagentStop with the deliverable absent: silent, no write
e2e core/scripts/wait-for-deliverable.sh ship.wstatus why=--status on an armed target writes nothing
e2e core/scripts/wait-for-deliverable.sh ship.wdts why=--dispatch-ts prints the ledger ts and writes nothing
e2e core/scripts/wait-for-deliverable.sh ship.wbeat why=an armed beat that delivers flips the row
e2e core/scripts/wait-for-deliverable.sh ship.wbeatold why=the same beat in the old era leaves the hand-written row alone
e2e core/hooks/ai-dlc-inflight-row.sh control.dispatch why=the unmutated hook copy through the mutant harness
e2e core/scripts/wait-for-deliverable.sh control.wstatus why=the unmutated waiter copy through the mutant harness
e2e core/hooks/ai-dlc-inflight-row.sh m-datestamp.dispatch why=mutant m-datestamp, its deciding cell
e2e core/hooks/ai-dlc-inflight-row.sh m-datestamp.nested why=mutant m-datestamp, its twin
e2e core/hooks/ai-dlc-inflight-row.sh m-noera.eraold why=mutant m-noera, its deciding cell
e2e core/hooks/ai-dlc-inflight-row.sh m-noera.dispatch why=mutant m-noera, its twin
e2e core/hooks/ai-dlc-inflight-row.sh m-nonested.nested why=mutant m-nonested, its deciding cell
e2e core/hooks/ai-dlc-inflight-row.sh m-nonested.dispatch why=mutant m-nonested, its twin
e2e core/hooks/ai-dlc-inflight-row.sh m-noupdater.updater why=mutant m-noupdater, its deciding cell
e2e core/hooks/ai-dlc-inflight-row.sh m-noupdater.leadtr why=mutant m-noupdater, its twin
e2e core/hooks/ai-dlc-inflight-row.sh m-noledger.noledger why=mutant m-noledger, its deciding cell
e2e core/hooks/ai-dlc-inflight-row.sh m-noledger.dispatch why=mutant m-noledger, its twin
e2e core/hooks/ai-dlc-inflight-row.sh m-lastmd.dlparse why=mutant m-lastmd, its deciding cell
e2e core/hooks/ai-dlc-inflight-row.sh m-lastmd.dlfall why=mutant m-lastmd, its twin
e2e core/hooks/ai-dlc-inflight-row.sh m-rowadd.rowdiff why=mutant m-rowadd, its deciding cell
e2e core/hooks/ai-dlc-inflight-row.sh m-rowadd.nodl why=mutant m-rowadd, its twin
e2e core/hooks/ai-dlc-inflight-row.sh m-substop2.substopabs why=mutant m-substop2, its deciding cell
e2e core/hooks/ai-dlc-inflight-row.sh m-substop2.substop why=mutant m-substop2, its twin
e2e core/scripts/wait-for-deliverable.sh m-wstatus.wstatus why=mutant m-wstatus, its deciding cell
e2e core/scripts/wait-for-deliverable.sh m-wstatus.wbeat why=mutant m-wstatus, its twin
e2e core/scripts/wait-for-deliverable.sh m-wnoera.wbeatold why=mutant m-wnoera, its deciding cell
e2e core/scripts/wait-for-deliverable.sh m-wnoera.wbeat why=mutant m-wnoera, its twin
