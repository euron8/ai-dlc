# arm 1b: the role expression is extracted from the subagent probe and bound to the guard's copy.
core/hooks/ai-dlc-subagent-probe.sh
# arm 1b: 1b-name-strip greps the dispatch guard's `del(.name)` emission, which arm 1b relies on.
core/hooks/ai-dlc-dispatch-guard.sh
core/scripts/validate-suppression-lifetime.sh
# arm MD: every sections manifest the recorder's manifest arm reads is written by the real splitter.
core/scripts/partition-document.sh
