# gate-remediation-deny drives the hook under test (!) and seeds copies of the sibling validators and the catalog into each workspace.
!core/hooks/ai-dlc-gate-remediation-guard.sh
core/scripts/validate-steering-budget.sh
# arm 3b: the scan-roots resolver and grammar are seeded into the product workspace, and the
# session-class scan is cmp'd against ai-dlc-acknowledge.sh's copy.
core/scripts/artifact-path-config.sh
core/skills/ai-dlc/artifact-path-grammar.md
core/hooks/ai-dlc-acknowledge.sh
# arm 1b: the role expression is extracted from the subagent probe and bound to the guard's copy.
core/hooks/ai-dlc-subagent-probe.sh
# arm 1b: 1b-name-strip greps the dispatch guard's `del(.name)` emission, which arm 1b relies on.
core/hooks/ai-dlc-dispatch-guard.sh
core/scripts/validate-suppression-lifetime.sh
# arm MD: every sections manifest the recorder's manifest arm reads is written by the real splitter.
core/scripts/partition-document.sh
core/skills/ai-dlc/enforcement-map.yaml
