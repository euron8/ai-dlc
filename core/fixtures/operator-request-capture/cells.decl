# operator-request-capture's starts of core/hooks/ai-dlc-pause.sh (BL-879 grammar). Every other drive is in process
# (run.sh fire(): inproc_load once, inproc_run hkpause_main per prompt). The hook exits 0 and prints nothing on every
# path, so the cli cells are its two outcomes on the project tree (a capture with the pause flag; a harness-raised
# prompt skipped with its reason logged), each started as FXCELL=<id> bash "$HOOK" on a copy of the live project and
# compared with the in-process call on another copy: stdout, stderr, exit and the normalised tree.
cli core/hooks/ai-dlc-pause.sh cli-capture
cli core/hooks/ai-dlc-pause.sh cli-skip
