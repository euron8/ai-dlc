# handoff-completion-assertion drives three hooks and their shared predicate in place, and reads the
# pause-routing vocabulary. The settings template is deliberately NOT declared: a declared path under
# templates/ is exit 2 on a consumer, where it is not installed. The (e6-order) arm that parses it
# lives in schema-install-fallback (.dist-only, declares templates/).
core/hooks/
!core/hooks/ai-dlc-continue.sh
!core/hooks/ai-dlc-recover.sh
!core/hooks/ai-dlc-handoff-pending.sh
!core/schemas/pause-routing.json
core/fixtures/lib/preamble.sh
core/fixtures/lib/report.sh
# Loaded in process (BL-878): the pre-wrap SKIP gate ends through lib/layout.sh, and fx_inproc is lib/mutant.sh.
core/fixtures/lib/layout.sh
core/fixtures/lib/mutant.sh
