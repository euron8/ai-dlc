# retired-layer-passage's starts of core/skills/ai-dlc-update/reconcile/retired-layer-passage.sh (BL-879 grammar). Every
# other drive is in process: run.sh sources the detector once and calls rlp_main in a subshell, and each relocated copy
# (the orphan without setup-sites.md, the reconcile copy whose setup-sites.md is a directory) is sourced in its own
# subshell. One cli cell per distinct CLI outcome (exit 0 with rows, exit 0 with the nothing-deleted NOTE, exit 0 with
# the denominator NOTE, exit 2 refusal), each started as FXCELL=<id> bash <program> in eqv() and compared byte for byte
# with the in-process call on the same world.
cli core/skills/ai-dlc-update/reconcile/retired-layer-passage.sh cli-rows
cli core/skills/ai-dlc-update/reconcile/retired-layer-passage.sh cli-noop
cli core/skills/ai-dlc-update/reconcile/retired-layer-passage.sh cli-den
cli core/skills/ai-dlc-update/reconcile/retired-layer-passage.sh cli-refuse
