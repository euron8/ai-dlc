# Measured by a counted run through core/scripts/hermetic-run.sh (the judge's own J3 output). The detector's starts are
# the four cli cells of cells.decl; the rest of `*` is run.sh, seed.sh, the bash -c lib.sh drives of the K and F cells,
# and the tr and sed stubs. Every other drive is in process (BL-878).
18 *
4 core/skills/ai-dlc-update/reconcile/retired-layer-passage.sh
# inproc rows are P2 units: one fx_inproc per call of rlp_main (7 of the real subject, 2 of its relocated copies).
9 inproc:core/skills/ai-dlc-update/reconcile/retired-layer-passage.sh
