# derivation-differential reads: the helper it asserts (reconcile/derivation-differential.sh, which lifts vd_join out of
# apply.sh and functions out of preclassify.sh beside itself; the reconcile files declared are those the sandbox
# trace read), the real validator it runs on both sides, the REAL scope classifier its join reads out of the distribution at <theirs>
# (check-owed-derivations.sh, with the sprint-status.sh and sprint-status.json that classifier loads), and the shared
# preamble. run.sh prints a HERMETIC-CONSUMED line for each required input where it uses it.
!core/skills/ai-dlc-update/reconcile/derivation-differential.sh
core/skills/ai-dlc-update/reconcile/apply.sh
core/skills/ai-dlc-update/reconcile/preclassify.sh
!core/scripts/validate-artifact-derivations.sh
!core/scripts/check-owed-derivations.sh
!core/scripts/sprint-status.sh
!core/schemas/sprint-status.json
core/fixtures/lib/
