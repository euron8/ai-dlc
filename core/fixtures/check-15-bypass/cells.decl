# check-15-bypass's starts of core/scripts/validate-stub-audit.sh (BL-879 grammar). Every other drive is in process:
# run.sh's audit() is inproc_run of vstub_main. One cli cell per distinct CLI outcome (exit 0 clean, exit 1 a finding,
# exit 4 EXAMINED NOTHING), each started as FXCELL=<id> bash "$AUDIT" in eq_cell() and compared byte for byte with the
# in-process call.
cli core/scripts/validate-stub-audit.sh cli-clean
cli core/scripts/validate-stub-audit.sh cli-finding
cli core/scripts/validate-stub-audit.sh cli-nothing
