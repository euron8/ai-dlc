# mutation-red-replay's starts of core/scripts/validate-mutation-red.sh (BL-879 grammar). Every other drive is in
# process: run.sh loads the subject once and calls vmr_main through `vmr` in a subshell. One cli cell per distinct CLI
# outcome (exit 0 PROVEN, exit 1 UNPROVEN, exit 2 RED-baseline refusal, exit 3 HARD), each started as
# FXCELL=<id> bash "$VALIDATOR" in eqv() and compared byte for byte with the in-process call on the same input.
cli core/scripts/validate-mutation-red.sh cli-proven
cli core/scripts/validate-mutation-red.sh cli-unproven
cli core/scripts/validate-mutation-red.sh cli-refuse
cli core/scripts/validate-mutation-red.sh cli-hard
