# readset-skip-digest-mutants sources the hook's FIXTURE_POOL block, the deriver's READSET_LOCALMAP span and the
# CK_HELPERS / DG_WORLDS / TK_WORLDS spans of readset-skip/run.sh, and edits COPIES of them. The J0 coverage join
# reads the OTHER four shard drivers; a fixture's own directory is copied by the runner, never declared.
!.githooks/pre-push
!core/scripts/derive-fixture-readsets.sh
!core/fixtures/readset-skip/run.sh
core/fixtures/lib/
core/fixtures/readset-skip-digest-mutants/run.sh
core/fixtures/readset-skip-digest-mutants-b/run.sh
core/fixtures/readset-skip-digest-mutants-c/run.sh
core/fixtures/readset-skip-digest-mutants-e/run.sh
# D14 reads every shard's declarations, so each is declared here, identically in every shard.
core/fixtures/readset-skip-digest-mutants/inputs.decl
core/fixtures/readset-skip-digest-mutants/tools.decl
core/fixtures/readset-skip-digest-mutants-b/inputs.decl
core/fixtures/readset-skip-digest-mutants-b/tools.decl
core/fixtures/readset-skip-digest-mutants-c/inputs.decl
core/fixtures/readset-skip-digest-mutants-c/tools.decl
core/fixtures/readset-skip-digest-mutants-d/inputs.decl
core/fixtures/readset-skip-digest-mutants-d/tools.decl
core/fixtures/readset-skip-digest-mutants-e/inputs.decl
core/fixtures/readset-skip-digest-mutants-e/tools.decl
