# remediator-shard-join drives the join and the two hooks it records and captures through, and
# the sibling scripts the join assembles with. lib.sh walks up from its own directory to find
# each of them; the runner copies this fixture's own directory without it being named here.
!core/scripts/join-remediator-shards.sh
!core/hooks/ai-dlc-gate-remediation-guard.sh
!core/hooks/ai-dlc-derivation-capture.sh
core/scripts/validate-adversarial-convergence.sh
core/scripts/partition-document.sh
core/scripts/partition-subject.sh
# Subject mode writes its pair separator from the sibling merge's --pair-sep, whose key reads the
# convergence validator and partition-subject above, and validate-provenance-block.sh with the schema
# its chain resolves. SJ1o drives a copy of the join beside the vendored pre-@ merge in this directory.
core/scripts/merge-adversarial-shards.sh
core/scripts/validate-provenance-block.sh
core/schemas/provenance-block.json
core/scripts/validate-artifact-derivations.sh
# The record-mode seal check runs whenever the library sits beside the join; without it here the
# sandbox takes the absent-sibling path and the --sources/--escalations arms never reach the shipped one.
core/scripts/content-seal.sh
# EC37 closes its parts with the real --mark, resolved beside the join.
core/scripts/wait-for-deliverable.sh
core/team-roles/remediator.md
core/fixtures/lib/
core/team-roles/pm-escalated.md
# BL-716: the join runs the worklist beside itself after a document or subject assembly to derive MOVED-CITE lane edges.
!core/scripts/serial-remediation-worklist.sh
