# check-24-adversarial-convergence (shard a)'s starts of core/scripts/validate-adversarial-convergence.sh (BL-879 grammar).
# Every other drive is in process: run.sh's vac_run sources the validator in a subshell and calls vac_main. One cli
# cell per distinct CLI outcome (gate exit 0, gate exit 1, exit 2 with no staging directory, --cycle-state exit 3),
# each started as FXCELL=<id> bash "$VALIDATOR" in eqv() and compared byte for byte with the in-process call.
cli core/scripts/validate-adversarial-convergence.sh cli-pass
cli core/scripts/validate-adversarial-convergence.sh cli-fail
cli core/scripts/validate-adversarial-convergence.sh cli-nostage
cli core/scripts/validate-adversarial-convergence.sh cli-state
