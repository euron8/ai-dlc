# self-update-gate and its three shard drivers (b, c, d, which exec the parent's run.sh --group) share ONE declaration shape;
# apart from the c lines marked below (d declares the directory whole), the only line that differs is the pre-push hook, REQUIRED (!) only in the shards whose units print its HERMETIC-CONSUMED sentinel.
# The gate under test reads its closure beside itself: self-update-gate.sh loads preclassify.sh, which sources
# consumer-read.sh and lib.sh and reads setup-sites.md; run.sh's engine copies take those files by name (sg_copy).
core/skills/ai-dlc-update/reconcile/self-update-gate.sh
core/skills/ai-dlc-update/reconcile/preclassify.sh
core/skills/ai-dlc-update/reconcile/consumer-read.sh
core/skills/ai-dlc-update/reconcile/lib.sh
!core/skills/ai-dlc-update/reconcile/setup-sites.md
!core/git-hooks/pre-push
# Sourced by the parent run.sh's first line.
core/fixtures/lib/preamble.sh
# The shard drivers: the parent's coverage join reads every one. A fixture's OWN run.sh is not declared: the runner copies the fixture's own directory itself.
core/fixtures/self-update-gate-b/run.sh
core/fixtures/self-update-gate-c/run.sh
core/fixtures/self-update-gate-d/run.sh
# The shards exec the parent run.sh and the parent seeds from its own seed.sh; a sibling directory is not copied unless declared.
core/fixtures/self-update-gate/run.sh
core/fixtures/self-update-gate/seed.sh
core/fixtures/lib/hook-drive.sh
core/fixtures/lib/report.sh
