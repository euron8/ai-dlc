# bmad-invocation-resolve's starts of core/scripts/validate-bmad-invocations.sh (BL-879 grammar). Every other drive is
# in process: run.sh's vbi() is inproc_run of vbi_main. One cli cell per distinct CLI outcome (exit 0 PASS, exit 1 a
# dangling name, exit 2 DISARMED), each started as FXCELL=<id> bash "$V" in eq_cell() and compared byte for byte with
# the in-process call.
cli core/scripts/validate-bmad-invocations.sh cli-pass
cli core/scripts/validate-bmad-invocations.sh cli-fail
cli core/scripts/validate-bmad-invocations.sh cli-disarm
