e2e core/scripts/gate-transition.sh g1 why=gate 1 partitioned, the MAP arm's one end-to-end run
e2e core/scripts/gate-transition.sh g1x why=gate 1 at the captures threshold, the MAPX arm's one end-to-end run
e2e core/scripts/gate-transition.sh g2s why=gate 2 over a stale Dev Agent Record, the DAR arm's refusal run
e2e core/scripts/gate-transition.sh g2 why=gate 2 after the fold, the RECP arm and DAR's control
e2e core/scripts/gate-transition.sh g2r why=gate 2 pass 2 answering GATE1-RERUN, the RERUN arm
e2e core/scripts/gate-transition.sh g2k why=gate 2 pass 2 answering GATE1-SKIP, RERUN's control
e2e core/scripts/gate-transition.sh g3x why=gate 3 with a refusing arm, the G3X arm
e2e core/scripts/gate-transition.sh g3q why=gate 3 with the Check 22 arm exiting 1, the G3Q arm
e2e core/scripts/gate-transition.sh g3 why=gate 3 passing, the G3 arm and OPEN12's control
e2e core/scripts/gate-transition.sh cx why=close over a 26 FAIL ledger, the CLOSEX arm
e2e core/scripts/gate-transition.sh c why=close over a 26 PASS ledger, the CLOSE arm
e2e core/scripts/gate-transition.sh g3p why=gate 3 with the Check 22 arm exiting 3 (PRE-LEDGER), the G3P arm
e2e core/scripts/gate-transition.sh g3n why=gate 3 with the Check 22 arm exiting 3 (NO ROLE-BOUND ROWS), the G3N arm
e2e core/scripts/gate-transition.sh m-pre3 why=mutant m-pre3 in its deciding world
e2e core/scripts/gate-transition.sh m-fixed3 why=mutant m-fixed3 in its deciding world
e2e core/scripts/gate-transition.sh m-open12 why=mutant m-open12 in its deciding world
e2e core/scripts/gate-transition.sh m-noxcap why=mutant m-noxcap in its deciding world
e2e core/scripts/gate-transition.sh m-norm why=mutant m-norm in its deciding world
e2e core/scripts/gate-transition.sh m-early why=mutant m-early in its deciding world
e2e core/scripts/gate-transition.sh m-close26 why=mutant m-close26 in its deciding world
e2e core/scripts/gate-transition.sh m-close26-t why=mutant m-close26 in its twin CLOSE world
e2e core/scripts/gate-transition.sh m-pdir why=mutant m-pdir in its deciding world, the gate-1 start JOIN reads
e2e core/hooks/ai-dlc-dispatch-guard.sh join-jok why=JOIN: the guard over the plan gate 1 printed, the allow cell
e2e core/hooks/ai-dlc-dispatch-guard.sh join-jsha why=JOIN control: the guard over the wrong-sha twin, the deny cell
e2e core/hooks/ai-dlc-dispatch-guard.sh join-jno why=JOIN control: the guard over a brief with no gate-plan line
e2e core/hooks/ai-dlc-dispatch-guard.sh m-pdir-jok why=mutant m-pdir: the guard over the dotted plan path the mutant printed
e2e core/hooks/ai-dlc-dispatch-guard.sh m-pdir-jsha why=mutant m-pdir: the wrong-sha cell, run in the same deciding world
e2e core/hooks/ai-dlc-dispatch-guard.sh m-pdir-jno why=mutant m-pdir: the no-plan cell, run in the same deciding world
e2e core/scripts/gate-transition.sh cmx why=close over a storyless s1 verdict lacking 26 PASS, the CLOSEMX arm
e2e core/scripts/gate-transition.sh cm why=close over a storyless s1 verdict with 26 PASS, the CLOSEM arm
e2e core/scripts/gate-transition.sh cp why=close for a story with a slugged verdict beside a storyless one, the CLOSEP arm
e2e core/scripts/gate-transition.sh m-nosprint why=mutant m-nosprint in its deciding world
e2e core/scripts/gate-transition.sh m-slugok why=mutant m-slugok in its deciding world
e2e core/scripts/gate-transition.sh m-skipolder why=mutant m-skipolder in its deciding world
