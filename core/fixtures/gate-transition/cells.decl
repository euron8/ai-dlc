e2e core/scripts/gate-transition.sh g1 why=gate 1 partitioned, the MAP arm's one end-to-end run
e2e core/scripts/gate-transition.sh g1x why=gate 1 at the captures threshold, the MAPX arm's one end-to-end run
e2e core/scripts/gate-transition.sh g2s why=gate 2 over a stale Dev Agent Record, the DAR arm's refusal run
e2e core/scripts/gate-transition.sh g2 why=gate 2 after the fold, the RECP arm and DAR's control
e2e core/scripts/gate-transition.sh g2r why=gate 2 pass 2 answering GATE1-RERUN, the RERUN arm
e2e core/scripts/gate-transition.sh g2k why=gate 2 pass 2 answering GATE1-SKIP, RERUN's control
e2e core/scripts/gate-transition.sh g3x why=gate 3 with a refusing arm, the G3X arm
e2e core/scripts/gate-transition.sh g3q why=gate 3 with the Check 22 arm exiting 1, the G3Q arm
e2e core/scripts/gate-transition.sh g3 why=gate 3 passing, the G3 arm and OPEN12's control
e2e core/scripts/gate-transition.sh cx why=close over a 26 FAIL ledger, the CLOSEX arm
e2e core/scripts/gate-transition.sh c why=close over a 26 PASS ledger, the CLOSE arm
e2e core/scripts/gate-transition.sh g3p why=gate 3 with the Check 22 arm exiting 3 (PRE-LEDGER), the G3P arm
e2e core/scripts/gate-transition.sh g3n why=gate 3 with the Check 22 arm exiting 3 (NO ROLE-BOUND ROWS), the G3N arm
e2e core/hooks/ai-dlc-dispatch-guard.sh join-jok why=JOIN: the guard over the plan gate 1 printed, the allow cell
e2e core/hooks/ai-dlc-dispatch-guard.sh join-jsha why=JOIN control: the guard over the wrong-sha twin, the deny cell
e2e core/hooks/ai-dlc-dispatch-guard.sh join-jno why=JOIN control: the guard over a brief with no gate-plan line
e2e core/scripts/gate-transition.sh cmx why=close over a storyless s1 verdict lacking 26 PASS, the CLOSEMX arm
e2e core/scripts/gate-transition.sh cm why=close over a storyless s1 verdict with 26 PASS, the CLOSEM arm
e2e core/scripts/gate-transition.sh cp why=close for a story with a slugged verdict beside a storyless one, the CLOSEP arm
e2e core/scripts/gate-transition.sh pm why=gate 1 pass 2 over a real merged prior naming one sha, the PRIORM arm
e2e core/scripts/gate-transition.sh pd why=gate 1 pass 2 over a prior naming two distinct shas, the PRIORD arm
e2e core/scripts/gate-transition.sh px why=gate 1 pass 2 over a prior whose lines read sha (base sha), the PRIORX arm
e2e core/scripts/gate-transition.sh fe why=gate 1 pass 2 over a prior with a fenced second sha, the FENCE arm
e2e core/scripts/gate-transition.sh fc why=gate 1 pass 2 over a prior whose only line is fenced, FENCE's control
e2e core/scripts/gate-transition.sh qm why=gate 2 pass 2 over a merged QA prior naming one sha, the QAM arm
e2e core/scripts/gate-transition.sh qd why=gate 2 pass 2 over a merged QA prior naming two shas, the QAD arm
e2e core/scripts/gate-transition.sh ra1 why=gate 2 pass 2 over an APPROVED latest gate-1 re-review of the rework, the RA1 start
e2e core/scripts/gate-transition.sh ra0 why=the RA1 world without the re-review file, RA0, the control
e2e core/scripts/gate-transition.sh ran why=gate 2 pass 2 over p9 APPROVED and p10 NEEDS_REWORK, the RAN start
e2e core/scripts/gate-transition.sh rax why=gate 2 pass 2 over a re-review not ancestor-related to the QA sha, the RAX start
e2e core/scripts/gate-transition.sh raa why=gate 2 pass 2 over gate-1 files under two index forms, the RAA start
e2e core/scripts/gate-transition.sh ram why=gate 2 pass 2 over a merged gate-1 re-review, the RAM start
e2e core/scripts/gate-transition.sh g3k why=gate 1 pass 2 after a gate-3 rework over a records-only delta, the G3K arm
e2e core/scripts/gate-transition.sh g3c why=gate 1 pass 2 at the sha gate 3 judged, the remedy, G3K's control
e2e core/scripts/gate-transition.sh sk why=gate 2 pass 2 after a gate-3 rework over a records-only delta from the QA sha, the G2K arm
e2e core/scripts/gate-transition.sh sr1 why=gate 2 pass 2 after a gate-3 rework with a comment-only code edit after the g3 sha, G2R1
e2e core/scripts/gate-transition.sh sr2 why=gate 2 pass 2 after a gate-3 rework where an APPROVED gate-1 review at the code commit hides it from Rule A, G2R2
e2e core/scripts/gate-transition.sh sr3 why=gate 2 pass 2 whose frozen sha is the sha gate 3 judged, G2R3
e2e core/scripts/gate-transition.sh sr4 why=gate 2 pass 2 whose QA sha is not an ancestor of the g3 sha, G2R4
e2e core/scripts/gate-transition.sh sr5 why=gate 2 pass 2 whose QA prior reads NEEDS_REWORK, G2R5
e2e core/scripts/gate-transition.sh sr6 why=gate 2 pass 2 whose rework edits the story file outside its Dev Agent Record, G2R6
e2e core/scripts/gate-transition.sh sr7 why=gate 2 pass 2 with no g3 plan, G2R7
e2e core/scripts/gate-transition.sh sd why=gate 2 pass 2 whose rework edits the story file inside its Dev Agent Record, G2D
e2e core/scripts/gate-transition.sh sw1 why=gate 2 pass 3 after a GATE2-SKIP at pass 2, the G2W1 wedge arm
e2e core/scripts/gate-transition.sh sw2 why=gate 1 pass 3 after a GATE1-SKIP at pass 2, the G2W2 wedge arm
e2e core/scripts/gate-transition.sh sw3 why=gate 2 pass 3 after a dispatched pass 2 with no QA file, the G2W3 refusal arm
nested core/scripts/gate-transition.sh core/scripts/gate-transition.sh why=gate 2 pass 2 answering GATE1-RERUN (Rule A) runs gate 1 itself by starting the transition script as a child, once per RERUN, RA0 and RAN world
