# owed-derivations and its two shard drivers (b, c, which exec the parent's run.sh --group) share ONE declaration shape per shard.
# Every shard builds the reader's root with the real validator and the core manifest, copies core-paths.sh beside the reader, and sources the shared preamble and report libraries.
!core/scripts/check-owed-derivations.sh
!core/scripts/validate-artifact-derivations.sh
!core/scripts/core-paths.sh
!core/skills/ai-dlc/core-manifest.md
core/fixtures/lib/preamble.sh
core/fixtures/lib/report.sh
# Shard b runs unit lw. S10 copies the reader the way apply.sh does, beside the REAL sprint-status.sh and its schema. The writer is only resolved (the fixture ships ahead of its subject and skips loudly when it is absent), never run, so it is optional here.
!core/scripts/sprint-status.sh
!core/schemas/sprint-status.json
core/skills/ai-dlc-update/reconcile/derivation-differential.sh
# The shard drivers exec the parent run.sh, and the parent's coverage join reads every driver. A fixture's OWN
# run.sh is not declared by itself, but the siblings' are, so each shard sandbox holds all three.
core/fixtures/owed-derivations/run.sh
core/fixtures/owed-derivations-b/run.sh
core/fixtures/owed-derivations-c/run.sh
