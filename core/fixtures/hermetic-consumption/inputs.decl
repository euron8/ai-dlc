# hermetic-consumption drives the validator under test over the real shipped corpus (arm C) and over
# mini distributions it seeds in mktemp from two shipped fixtures' run.sh and inputs.decl.
# Arm C scans every fixture directory's run.sh, inputs.decl and .dist-only, and derives the scanned count by
# enumerating core/fixtures/*/; the three globs key every such file, so a new or removed fixture moves the key.
# The two producer fixtures the worlds are seeded from are covered by the same globs. Derived from
# `derive-fixture-readsets.sh --list hermetic-consumption --tracer sandbox --declared-out`.
# core-paths.sh is the mapper the validator resolves beside the corpus; VERSION is the marker both
# this run.sh and the validator walk up for.
!scripts/validate-hermetic-consumption.sh
core/scripts/core-paths.sh
core/fixtures/*/run.sh
core/fixtures/*/.dist-only
core/fixtures/lib/preamble.sh
core/fixtures/lib/report.sh
core/fixtures/lib/mutant.sh
# copy-only: core/fixtures/hermetic-consumption/run.sh:46 run.sh tests for the marker beside the validator; nothing reads its content
VERSION
core/fixtures/*/inputs.decl
