# shell-portability copies the validator under test into every seeded sandbox corpus (seed(), run.sh:117).
# VERSION is the marker both run.sh (lines 102-104) and the validator walk up for; plain, so the walk
# resolves inside the sandbox. lib/ holds the sourced preamble.
!scripts/validate-shell-portability.sh
# copy-only: core/fixtures/shell-portability/run.sh:207 run.sh tests for the marker beside the validator; nothing reads its content
VERSION
core/fixtures/lib/matrix.sh
# S15 (BL-917) derives its seeds from the hook and fails any metadata-only test with no classified allowlist row. Each sandbox seeds its
# own copies, so these key the unit on the two files whose change can move the real arm's verdict.
.githooks/pre-push
scripts/presuite-metadata-allowlist.txt
core/fixtures/lib/mutant.sh
core/fixtures/lib/preamble.sh
