# gate-adjudication's starts of core/scripts/validate-gate-adjudication.sh (BL-879 grammar). Every other drive is in
# process: run.sh and seed.sh ask vga_main through vga_f / inproc_run. One cli cell per distinct CLI outcome (exit 0,
# the exit-1 defect, the exit-2 refusal), each started as FXCELL=<id> bash in eqv() and compared byte for byte with the
# in-process call on the same input.
cli core/scripts/validate-gate-adjudication.sh cli-pass
cli core/scripts/validate-gate-adjudication.sh cli-defect
cli core/scripts/validate-gate-adjudication.sh cli-refuse
