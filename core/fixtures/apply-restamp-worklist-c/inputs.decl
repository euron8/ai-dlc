# apply-restamp-worklist and its two shard drivers (b, c, which exec the parent's run.sh --group) share ONE declaration shape.
# apply-restamp-worklist sources the shared preamble, drives apply.sh and its reconcile siblings from copies of that directory, reads the real pre-push for the C6 premise, copies the transient-ignore renderer and its schema into seeded consumers, and runs the real hook-registration validator.
core/fixtures/lib/
core/skills/ai-dlc-update/reconcile/
!core/skills/ai-dlc-update/reconcile/apply.sh
core/git-hooks/pre-push
!core/scripts/sync-transient-ignore.sh
!core/schemas/pipeline-state-paths.json
!core/scripts/check-owed-derivations.sh
!core/scripts/sprint-status.sh
!core/schemas/sprint-status.json
core/scripts/validate-hook-registration.sh
# Shard c runs units bl, t, hr, hu and vf. None of them drives the answer-capture hook (the recorded re-approval arms live in units u, mut, ar and arm, in shards a and b), so the hook is optional here and is only reached through the hoisted lookup; the BL/T inputs above are REQUIRED because units bl and t consume them.
core/hooks/ai-dlc-answer-capture.sh
# The shard drivers exec the parent run.sh, and the parent's coverage join reads every driver. A fixture's OWN
# run.sh is not declared by itself, but the siblings' are, so each shard sandbox holds all three.
core/fixtures/apply-restamp-worklist/run.sh
