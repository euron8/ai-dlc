# schema-install-fallback walks up from its own directory for scripts/install.sh, then runs it into an empty target; install.sh
# copies from core/, patterns/ and templates/ (SCRIPT_DIR/../<tree>), and reads VERSION when present (the stamp value is asserted by no arm). The five scripts under test are the ones that
# install lays down at scripts/ai-dlc/, taken from core/scripts/. A fixture's own directory is copied by the runner, never declared.
!scripts/install.sh
# install.sh sources its function file before it writes anything and refuses the install when it is absent.
scripts/install-scaffold-ignore.sh
# reason: core/ is enumerated -- install.sh (run at run.sh:153) globs core/scripts/*, core/hooks/*.sh, core/schemas/*.json and more, scripts/install.sh:471, :374, :550; run.sh:187 walks the installed scripts.
core/
patterns/
templates/
core/fixtures/lib/mutant.sh
