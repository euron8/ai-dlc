# whole-read-pool reads the validator under test and, for the sprint-slot arm (10b-10d), the
# sprint-status resolver the validator calls plus the schema that resolver loads.
!core/scripts/validate-artifact-budget.sh
# The window resolver lives in the shared hook library; arm 8d also drives the context
# sensor to assert the two readers agree.
core/hooks/ai-dlc-window.sh
core/hooks/ai-dlc-context-sensor.sh
core/scripts/sprint-status.sh
core/schemas/sprint-status.json
