# Every other validator run in this shard is in process, `( vem_entry … )` from one source of the validator (run.sh,
# ip_run). These are the twin cells, one per distinct CLI outcome, each compared byte for byte with the in-process
# answer on the same input: the unmutated contract under `--arms I36` (exit 0), and a contract whose LC-O1 code no
# enforcer emits (exit 1).
cli scripts/validate-enforcement-map.sh cli-pass
cli scripts/validate-enforcement-map.sh cli-refuse
