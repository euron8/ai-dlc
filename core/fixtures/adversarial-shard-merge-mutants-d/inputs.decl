# Shard d driver: execs the parent adversarial-shard-merge-mutants/run.sh --group d, which mutates copies of the merge and scores
# the sibling fixture's predicates (lib.sh, seeds, run.sh arm lines). The merge is the subject; every shard helper drives the
# remediation-guard hook to seed the write ledger the merge derives dispatch ids from. The parent's coverage join (J0) reads the other drivers.
!core/scripts/merge-adversarial-shards.sh
core/hooks/ai-dlc-gate-remediation-guard.sh
core/scripts/validate-adversarial-convergence.sh
core/scripts/partition-document.sh
core/scripts/partition-subject.sh
core/scripts/validate-steering-budget.sh
core/fixtures/adversarial-shard-merge/
core/fixtures/lib/
core/fixtures/adversarial-shard-merge-mutants/run.sh
core/fixtures/adversarial-shard-merge-mutants-b/run.sh
core/fixtures/adversarial-shard-merge-mutants-c/run.sh
core/fixtures/adversarial-shard-merge-mutants-e/run.sh
