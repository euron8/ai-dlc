{
  "aiDlcModels": {
    "opus": "claude-opus-5[1m]",
    "sonnet": "claude-sonnet-5[1m]"
  },
  "aiDlcRoles": {
    "adversary": {
      "model": "opus",
      "effort": "high"
    },
    "analyst": {
      "model": "sonnet",
      "effort": "medium"
    },
    "architect": {
      "model": "opus",
      "effort": "high"
    },
    "code-reviewer": {
      "model": "opus",
      "effort": "high"
    },
    "code-reviewer-escalated": {
      "model": "opus",
      "effort": "high"
    },
    "dev": {
      "model": "sonnet",
      "effort": "medium"
    },
    "dev-escalated": {
      "model": "opus",
      "effort": "high"
    },
    "gate-adjudicator": {
      "model": "opus",
      "effort": "high"
    },
    "pm": {
      "model": "sonnet",
      "effort": "high"
    },
    "pm-escalated": {
      "model": "opus",
      "effort": "max"
    },
    "protected-path-editor": {
      "model": "opus",
      "effort": "high"
    },
    "qa": {
      "model": "sonnet",
      "effort": "medium"
    },
    "remediator": {
      "model": "opus",
      "effort": "high"
    },
    "cis": {
      "effort": "high"
    },
    "sm": {
      "effort": "medium"
    },
    "tea": {
      "effort": "high"
    },
    "ux": {
      "effort": "medium"
    }
  },
  "enabledPlugins": {
    "context-mode@context-mode": true
  },
  "env": {
    "ENABLE_PROMPT_CACHING_1H": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_context-mode_context-mode__ctx_execute_file|mcp__plugin_context-mode_context-mode__ctx_batch_execute|mcp__plugin_context-mode_context-mode__ctx_index",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ai-dlc-protect.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ai-dlc-core-guard.sh"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ai-dlc-dispatch-guard.sh"
          }
        ]
      },
      {
        "matcher": "Agent|Task|Skill|TaskCreate|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ai-dlc-acknowledge.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ai-dlc-answer-capture.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ai-dlc-pause.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ai-dlc-continue.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ai-dlc-driver-signal.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ai-dlc-context-sensor.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ai-dlc-notify.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ai-dlc-subagent-probe.sh"
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ai-dlc-context-sensor.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto|manual",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ai-dlc-precompact.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ai-dlc-recover.sh"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "auto|manual",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ai-dlc-postcompact.sh"
          }
        ]
      }
    ]
  }
}
