{
  "aiDlcModels": {
    "fable": "fable",
    "opus": "opus",
    "sonnet": "sonnet",
    "haiku": "haiku"
  },
  "aiDlcRoles": {
    "adversary": {
      "model": "opus",
      "effort": "medium",
      "omitClaudeMd": true
    },
    "analyst": {
      "model": "sonnet",
      "effort": "medium",
      "omitClaudeMd": true
    },
    "architect": {
      "model": "opus",
      "effort": "medium"
    },
    "code-reviewer": {
      "model": "opus",
      "effort": "medium"
    },
    "code-reviewer-escalated": {
      "model": "opus",
      "effort": "high"
    },
    "dev": {
      "model": "haiku",
      "effort": "medium"
    },
    "dev-escalated": {
      "model": "sonnet",
      "effort": "medium"
    },
    "gate-adjudicator": {
      "model": "sonnet",
      "effort": "medium",
      "omitClaudeMd": true
    },
    "ops": {
      "model": "opus",
      "effort": "medium"
    },
    "pm": {
      "model": "sonnet",
      "effort": "medium"
    },
    "pm-escalated": {
      "model": "opus",
      "effort": "medium"
    },
    "protected-path-editor": {
      "model": "sonnet",
      "effort": "medium"
    },
    "qa": {
      "model": "sonnet",
      "effort": "medium"
    },
    "remediator": {
      "model": "sonnet",
      "effort": "medium"
    },
    "cis": {
      "model": "sonnet",
      "effort": "high"
    },
    "sm": {
      "model": "sonnet",
      "effort": "medium"
    },
    "tea": {
      "model": "sonnet",
      "effort": "high"
    },
    "ux": {
      "model": "sonnet",
      "effort": "medium"
    }
  },
  "bashOutputMaxChars": 8000,
  "enabledPlugins": {
    "context-mode@context-mode": true
  },
  "env": {
    "ENABLE_PROMPT_CACHING_1H": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_context-mode_context-mode__ctx_execute_file|mcp__plugin_context-mode_context-mode__ctx_batch_execute|mcp__plugin_context-mode_context-mode__ctx_index",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ai-dlc-protect.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ai-dlc-core-guard.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ai-dlc-gate-remediation-guard.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ai-dlc-artifact-path-guard.sh"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ai-dlc-dispatch-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ai-dlc-foreground-budget.sh"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|mcp__.*__merge_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ai-dlc-advisor-gate.sh"
          }
        ]
      },
      {
        "matcher": "Agent|Task|Skill|TaskCreate|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ai-dlc-acknowledge.sh"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ai-dlc-recover-gate.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ai-dlc-escalation-delivery.sh"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ai-dlc-answer-capture.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ai-dlc-derivation-capture.sh"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ai-dlc-handoff-entry.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ai-dlc-pause.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ai-dlc-continue.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ai-dlc-driver-signal.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ai-dlc-context-sensor.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ai-dlc-subagent-probe.sh"
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ai-dlc-context-sensor.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto|manual",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ai-dlc-precompact.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ai-dlc-recover.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ai-dlc-rules-floor.sh"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "auto|manual",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ai-dlc-postcompact.sh"
          }
        ]
      }
    ]
  }
}
