      while ((getline l < (w "/sums")) > 0) { q = l; sub(/^[0-9a-f]+  /, "", q); H[q] = substr(l, 1, 64) }
      while ((getline l < (w "/ok")) > 0) { t = index(l, "\t"); OK[substr(l, 1, t - 1)] = 1 }
      while ((getline l < (w "/res")) > 0) { t = index(l, "\t"); V[substr(l, 1, t - 1)] = substr(l, t + 1) }
      while ((getline l < (w "/ms")) > 0) { t = index(l, "\t"); MS[substr(l, 1, t - 1)] = substr(l, t + 1) }
      while ((getline l < (w "/ne")) > 0) NE[l] = 1
      while ((getline l < (w "/pd")) > 0) PD[l] = 1
      while ((getline l < (w "/l")) > 0) { n++; b = w "/" n; v = "whole"; pos = 0
        if (n in NE) pos = 1
        if ((n in OK) && ((b ".o") in H) && ((b ".p") in H) && ((b ".s") in H)) { pos = 1; if (H[b ".o"] == H[b ".p"]) v = H[b ".s"] }
        V[l] = v; f = (substr(l, 1, 1) == "/") ? l : d "/" l
        if (pos && (n in PD) && (l in MS) && (f in H) && H[f] == MS[l] && !(MS[l] in DONE)) { DONE[MS[l]] = 1; print MS[l] "\t" id "\t" v "\tend" > (w "/new") } }
      while ((getline l < (w "/all")) > 0) if ((l in V) && V[l] != "whole") print l "\t" V[l] }' > "$4"
