READSET_VS_FORMAT=1
readset_vs_store() { # <project root>: prints <base>/<root commit sha>, or NOTHING (store OFF)
  local base="" root
  if [ -n "${AI_DLC_VERDICT_STORE:-}" ]; then base="$AI_DLC_VERDICT_STORE"
  elif [ -n "${HOME:-}" ]; then base="$HOME/.cache/ai-dlc/verdicts"; fi
  [ -n "$base" ] || return 0
  root="$(cd "$1" 2>/dev/null && [ "$(git rev-parse --is-shallow-repository 2>/dev/null)" = false ] && git rev-list --max-parents=0 HEAD 2>/dev/null | LC_ALL=C sort | sed -n 1p)"
  case "$root" in *[!0-9a-f]*|'') return 0 ;; esac
