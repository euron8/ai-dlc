#!/usr/bin/env bash
# pre-push — the distribution's own gate. Runs its validators against itself.
#
# THE DEFECT THIS REPLACES. ai-dlc shipped fifteen validators and a CI template *to
# its consumers* while gating none of its own. Every check ran only when a human
# remembered to type it, which is how three releases shipped half-wired: the enforcer
# was named, never invoked. `git log --all -- .github` was empty for the project's
# entire history.
#
# WHY NOT GITHUB ACTIONS. Operator policy: no CI in GitHub, for this repo or the
# reference consumer (which removed its own Actions scaffolding deliberately). A gate
# that lives in a service we do not run is a gate we do not control. This runs on the
# machine doing the pushing, needs no network, no runner, and no third party.
#
# The evidence that local is sufficient: v0.52.0's own packaging bug -- a fixture added
# to install.sh's hardcoded loop but not uninstall.sh's -- was caught by
# `validate-enforcement-map.sh` on a local run, BEFORE the push. The Actions run only
# ever saw the fixed tree and caught nothing.
#
# ENABLE (once per clone):
#     git config core.hooksPath .githooks
#
# Bypass for a genuine emergency is `git push --no-verify`, and it is a decision you
# are making on the record, not a default you fall into.

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

fail=0
step() {
  printf '\n── %s\n' "$1"; shift
  if "$@"; then printf '   PASS\n'; else printf '   FAIL\n'; fail=1; fi
}

# 1. The enforcement map is the index of which rule is enforced by what, and WHERE it
#    is invoked. I9/W1: a script enforcer with no declared call site is a rule guarded
#    by nobody. It also asserts install.sh and uninstall.sh agree on the fixture list.
step "taught schema == read schema (provenance examples derive from schemas/)" \
  bash core/scripts/sync-taught-schema.sh --check

step "enforcement-map integrity (I1-I11)" \
  bash scripts/validate-enforcement-map.sh

# 1a. The same corpus-wide party-mode floor the consumer hook runs, over the DISTRIBUTION's own
#     tree. It is here for a reason beyond symmetry: this tree holds the two files the check has
#     to get right — the one rendered taught example (exempt only because the generated-region
#     carve-out works) and the fixture that embeds five forged blocks on purpose (exempt only
#     because a fixture directory is a declared home). A change that breaks either exemption goes
#     red here, on the machine that made it, instead of on a consumer's next push.
step "stray party-mode provenance (distribution tree)" \
  bash core/scripts/validate-provenance-block.sh --strays

# 1b. A core/ pointer at a dev-repo docs/ spec that install never ships is dead in every
#     consumer tree — resolves for a maintainer, 404s for a consumer. Derived, no hand-list.
step "no dead doc refs (core/ cites no unshipped dev-repo doc)" \
  bash scripts/validate-no-dead-doc-refs.sh

# 1c. Three things name a release -- the commit subject, VERSION, and the CHANGELOG's
#     top heading -- and until v0.125.0 nothing joined them. v0.124.1 was committed
#     with a subject one patch ahead of both. Push is the right seam: it is the last
#     point before the version becomes a claim other people read.
step "release version triple (subject == VERSION == CHANGELOG heading)" \
  bash scripts/validate-release-version.sh

# 2. SKILL.md's first ~5000 tokens are whole-re-read on EVERY compaction. The resident
#    region sits within a few hundred tokens of the ceiling, so an edit above the fold
#    can silently push the post-compact recovery protocol below it.
step "re-attach budget (SKILL.md resident region)" \
  bash core/scripts/validate-reattach-budget.sh --skill core/skills/ai-dlc/SKILL.md

# 2b. Rule 18 and rule-authoring.md govern rule prose, but the audit that enforces them
#     was driven only from a consumer's retro. Narrative authored here reached every
#     consumer before anything could see it. Only the deterministic tier gates the push;
#     the judgement tier prints and is dispositioned at retro.
step "rule-file audit (origin tags, dates, dangling pointers)" \
  bash core/scripts/audit-rule-files.sh --fail-on=deterministic

# 3. Every fixture is an adversarial self-test for one gate check. A fixture that is
#    never driven is a green light nobody earned.
#
# RUN IN PARALLEL, AND THE REASON IS MEASURED. The suite is latency-bound, not
# compute-bound: most of its work is waiting on `git init`/commit/mktemp in per-fixture
# sandboxes. Serially it was 7m06s of wall clock on an idle 18-core machine; 8 workers took
# it to 2m34s.
#
# SIXTEEN, AND THE KNEE MOVED BECAUSE THE FLOOR DID. For four releases this said EIGHT, NOT
# MORE, on a measurement that was true when it was taken: -P16 gave 2m30s against -P8's
# 2m34s, four seconds, because ONE fixture set a floor no pool size beats. That was the
# right reading of a floor-bound suite and the wrong constant to keep once the floor moved.
# `enforcement-map-sites` was 194s in v0.204.0, 107s after v0.205.0, and 25s once it started
# running its own assertions through a pool. Re-measured on the same idle 18-core machine
# with that fixture parallel, over the full 83:
#
#     -P8  95.5s     -P12  80.4s     -P16  72.0s     -P24  64.2s      (83/83 verdicts each)
#
# It is still falling at 24 because the remaining pole sleeps rather than computes, so this
# is not the CPU knee. Sixteen is where the measurement stops buying more than it costs:
# -P24 nearly doubled some units' individual durations through contention (a 25s fixture
# took 47.6s), and this suite has a known intermittent-red class that correlates with
# concurrency and cold caches. Beyond 16 the run gets faster by making every unit slower,
# which is how a timing-sensitive assertion starts failing for reasons that have nothing to
# do with what it tests.
#
# The remaining pole is `wait-stale-deliverable` at ~52s: at -P24 it starts at t=10.8s and
# is still running when everything else has finished. It is sleep-bound rather than
# fork-bound, so no pool size touches it -- the fix is inside that fixture.
#
# THE NUMBER IS MEASURED ON ONE MACHINE. That is why it stays the tunable
# AI_DLC_FIXTURE_JOBS: on a smaller box, re-measure rather than inherit this.
FIXTURE_JOBS="${AI_DLC_FIXTURE_JOBS:-16}"

run_fixtures() {
  local rc=0 d b out n_expected n_actual verdict
  out="$(mktemp -d)" || return 1

  for d in core/fixtures/*/; do
    [ -f "$d/run.sh" ] || continue
    printf '%s\n' "$d"
  done > "$out/list"
  n_expected="$(grep -c . "$out/list" 2>/dev/null || echo 0)"
  if [ "$n_expected" -eq 0 ]; then
    printf '   FAIL  no fixtures found -- an empty suite passes every assertion it never made\n'
    rm -rf "$out"; return 1
  fi

  # Each worker records its verdict to a file named for its fixture. The verdict is read
  # back from those FILES, not from xargs exit status, because that is what makes the
  # completeness assertion below possible -- and because `xargs` collapses any number of
  # failures into one exit code that cannot say WHICH.
  AI_DLC_FX_OUT="$out" xargs -P "$FIXTURE_JOBS" -I{} bash -c '
    d="$1"; b="$(basename "$d")"
    if bash "$d/run.sh" >/dev/null 2>&1; then printf ok   > "$AI_DLC_FX_OUT/$b"
    else                                      printf FAIL > "$AI_DLC_FX_OUT/$b"; fi
  ' _ {} < "$out/list"

  # Rendered in list order, so the output is deterministic and diffable across runs even
  # though the work completed out of order.
  n_actual=0
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    b="$(basename "$d")"
    if [ ! -f "$out/$b" ]; then
      printf '   FAIL  %s  (no verdict recorded)\n' "$b"; rc=1; continue
    fi
    n_actual=$((n_actual + 1))
    verdict="$(cat "$out/$b")"
    if [ "$verdict" = ok ]; then printf '   ok    %s\n' "$b"
    else                        printf '   FAIL  %s\n' "$b"; rc=1; fi
  done < "$out/list"

  # THE CONTROL PARALLELISM MAKES NECESSARY. Serially, a fixture that never ran could not
  # print an `ok` -- the loop and the report were the same thing. With a worker pool they
  # are not: a dropped job produces no verdict file, and a suite reporting 70 greens
  # instead of 75 reads exactly like a suite that passed. This is the check-that-cannot-
  # fire class one layer out, so the count is asserted rather than assumed.
  if [ "$n_actual" -ne "$n_expected" ]; then
    printf '   FAIL  %s of %s fixtures produced a verdict -- the pool dropped work, and a short green suite reads exactly like a passing one\n' \
      "$n_actual" "$n_expected"
    rc=1
  fi

  rm -rf "$out"
  return $rc
}

# THE SUITE DOES NOT RE-RUN OVER A TREE IT ALREADY RAN OVER.
#
# ~50s of the operator's inner loop was being spent re-deriving 84 identical
# verdicts on pushes that changed CHANGELOG.md, VERSION or docs/ and nothing else.
# `scripts/suite-content-key.sh` hashes a SUPERSET of everything the suite can
# read -- listings, contents, exec bits, symlink targets, the tracked-path set,
# the fixture set and the external tools -- and a hit means the suite already ran
# over byte-identical inputs. Read that script's header for the exclusion set and
# the mutation measurement behind it; I55 keeps the exclusions honest.
#
# THIS IS THE CHECK-THAT-CANNOT-FIRE SHAPE AND IT IS TREATED AS ONE. Four
# consequences, all deliberate:
#
#   1. A hit ANNOUNCES ITSELF, names its key, and prints what the key covers. A
#      cached green that looked like an ordinary green would be the defect.
#   2. The final summary line says the suite was skipped, so no run reports "all
#      gates green" while hiding that its largest gate did not execute.
#   3. Every failure path -- key script errors, empty key, unreadable record,
#      malformed record, a changed fixture count -- runs the suite. The skip is
#      the exceptional branch and it needs everything to line up; the full run is
#      what happens by default.
#   4. AI_DLC_FIXTURE_NO_SKIP=1 forces the run, on the record, for an operator who
#      wants the suite regardless.
#
# The record lives in .git/, NOT in the working tree, and that is load-bearing: a
# record inside the tree would be hashed by the key it stores, so writing it would
# invalidate it and no push could ever hit.
KEY_RECORD=".git/ai-dlc-suite-key"

# THE HIT RATE IS THE ONE NUMBER THIS CHANGE COULD NOT MEASURE BEFORE SHIPPING.
# main is squash-merged, so its history records releases and not the pushes inside
# them, which is exactly where the repeat runs happen. The release-granularity
# proxy is 2 of the last 60 commits; the inner-loop rate is higher and unknown.
# So the instrument ships with the change: one line per decision, countable with
#   awk '{print $2}' .git/ai-dlc-suite-key.log | sort | uniq -c
KEY_LOG=".git/ai-dlc-suite-key.log"
key_log() { printf '%s %s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "${2:-none}" >> "$KEY_LOG" 2>/dev/null || true; }

fixture_suite_step() {
  local key cached_key cached_n cached_when n_now record

  # Counted the way run_fixtures counts, so the number in the announce is the
  # number the last green run actually reported. `ls -d core/fixtures/*/` would be
  # three higher -- it includes the data-only directories that carry no run.sh --
  # and an announce saying "87 of 87" beside a suite that prints 84 verdicts is a
  # discrepancy an operator has to go and resolve before they can trust the skip.
  n_now="$(for d in core/fixtures/*/; do [ -f "$d/run.sh" ] && printf 'x\n'; done | wc -l | tr -d ' ')"

  if [ -n "${AI_DLC_FIXTURE_NO_SKIP:-}" ]; then
    printf '   (content-key skip disabled by AI_DLC_FIXTURE_NO_SKIP)\n'
    key="$(bash scripts/suite-content-key.sh 2>/dev/null)" || key=""
    key_log FORCED "$key"
  elif ! key="$(bash scripts/suite-content-key.sh 2>/dev/null)" || [ -z "$key" ]; then
    printf '   (content key unavailable -- running the suite)\n'
    key=""
    key_log UNAVAILABLE
  elif [ ! -r "$KEY_RECORD" ]; then
    printf '   (no prior green run recorded for this clone -- running the suite)\n'
    key_log MISS "$key"
  else
    record="$(cat "$KEY_RECORD" 2>/dev/null)"
    cached_key="$(printf '%s\n' "$record" | awk 'NR==1{print $1}')"
    cached_n="$(printf '%s\n'   "$record" | awk 'NR==1{print $2}')"
    cached_when="$(printf '%s\n' "$record" | awk 'NR==1{print $3}')"
    if [ "$cached_key" = "$key" ] && [ -n "$cached_n" ] && [ "$cached_n" = "$n_now" ]; then
      printf '   SKIPPED -- this exact tree already passed the whole suite.\n'
      printf '     key          %s\n' "$key"
      printf '     last green   %s of %s fixtures at %s\n' "$cached_n" "$n_now" "${cached_when:-unknown}"
      bash scripts/suite-content-key.sh --summary 2>/dev/null | sed 's/^/     /'
      printf '     force a run with AI_DLC_FIXTURE_NO_SKIP=1\n'
      SUITE_SKIPPED=1
      key_log HIT "$key"
      return 0
    fi
    if [ -n "$cached_n" ] && [ "$cached_n" != "$n_now" ]; then
      printf '   (fixture count moved %s -> %s -- running the suite)\n' "$cached_n" "$n_now"
    else
      printf '   (content key changed -- running the suite)\n'
    fi
    key_log MISS "$key"
  fi

  run_fixtures || return 1

  # Recorded only after a full green run. A partial or red suite leaves the prior
  # record in place rather than blessing the tree that just failed.
  #
  # AND ONLY IF THE SUITE LEFT THE TREE AS IT FOUND IT. A fixture is supposed to do
  # all of its work in a sandbox; one that writes into the repository under test is
  # a writer racing the fifteen readers beside it, and v0.208.0 shipped a fix for
  # exactly that -- `taught-schema` was dropping a probe into core/team-roles/ and
  # transiently stripping the real provenance schema, which killed
  # `enforcement-map-sites`' seed on whichever assertion happened to be copying.
  #
  # This catches the half of that class that SURVIVES the run: a fixture that
  # changes the tree and does not put it back. Recording the pre-run key then would
  # bless a tree that no longer exists. It does NOT catch a transient write that is
  # cleaned up -- that needs filesystem watching, and no cheap sound mechanism for
  # it exists; a grep over the fixtures cannot tell a sandbox $ROOT from the real
  # one (measured: the false-positive set is most of the seed corpus).
  if [ -n "$key" ] && [ "${n_now:-0}" -gt 0 ]; then
    local key_after
    key_after="$(bash scripts/suite-content-key.sh 2>/dev/null)" || key_after=""
    if [ -z "$key_after" ]; then
      printf '   (content key unavailable after the run -- not recording)\n'
    elif [ "$key_after" != "$key" ]; then
      printf '   NOT RECORDING: the suite CHANGED the tree it just tested.\n'
      printf '     before %s\n     after  %s\n' "$key" "$key_after"
      printf '     A fixture wrote into the repository instead of its own sandbox. The verdicts\n'
      printf '     above were taken against a tree that no longer exists, and recording this key\n'
      printf '     would let a later push skip on evidence from a different tree. Find the writer;\n'
      printf '     `git status` names it. The suite still PASSED -- this only refuses the cache.\n'
    else
      printf '%s %s %s\n' "$key" "$n_now" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$KEY_RECORD" 2>/dev/null || true
    fi
  fi
  return 0
}

SUITE_SKIPPED=0
step "fixture suite (${FIXTURE_JOBS}-way)" fixture_suite_step

# 4. A shipped script with a syntax error is a gate that cannot run at all.
#    validate-enforcement-map.sh maps this glob set through map_consumer() and
#    asserts it equals the set in core/git-hooks/pre-push. Add a class here and the
#    consumer hook fails until it carries the class too.
# SYNTAX_GLOB_BEGIN
syntax_all() {
  local rc=0 f
  for f in scripts/*.sh core/scripts/*.sh core/hooks/*.sh \
           core/skills/ai-dlc-update/reconcile/*.sh .githooks/*; do
    [ -f "$f" ] || continue
    bash -n "$f" 2>/dev/null || { printf '   syntax error: %s\n' "$f"; rc=1; }
  done
  return $rc
}
# SYNTAX_GLOB_END
step "shell syntax (every shipped script and hook)" syntax_all

if [ "$fail" -ne 0 ]; then
  printf '\npre-push: BLOCKED. Fix the above, or `git push --no-verify` on the record.\n\n'
  exit 1
fi
if [ "$SUITE_SKIPPED" -ne 0 ]; then
  printf '\npre-push: all gates green -- FIXTURE SUITE SKIPPED on an unchanged content key.\n\n'
  exit 0
fi
printf '\npre-push: all gates green.\n\n'
