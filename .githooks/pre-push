#!/usr/bin/env bash
# pre-push — the distribution's own gate. Runs its validators against itself.
#
# THE DEFECT THIS REPLACES. ai-dlc shipped fifteen validators and a CI template *to
# its consumers* while gating none of its own. Every check ran only when a human
# remembered to type it, which is how three releases shipped half-wired: the enforcer
# was named, never invoked. `git log --all -- .github` was empty for the project's
# entire history.
#
# WHY NOT GITHUB ACTIONS. Operator policy: no CI in GitHub, for this repo or the
# reference consumer (which removed its own Actions scaffolding deliberately). A gate
# that lives in a service we do not run is a gate we do not control. This runs on the
# machine doing the pushing, needs no network, no runner, and no third party.
#
# The evidence that local is sufficient: v0.52.0's own packaging bug -- a fixture added
# to install.sh's hardcoded loop but not uninstall.sh's -- was caught by
# `validate-enforcement-map.sh` on a local run, BEFORE the push. The Actions run only
# ever saw the fixed tree and caught nothing.
#
# ENABLE (once per clone):
#     git config core.hooksPath .githooks
#
# Bypass for a genuine emergency is `git push --no-verify`, and it is a decision you
# are making on the record, not a default you fall into.

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

fail=0
step() {
  printf '\n── %s\n' "$1"; shift
  if "$@"; then printf '   PASS\n'; else printf '   FAIL\n'; fail=1; fi
}

# 1. The enforcement map is the index of which rule is enforced by what, and WHERE it
#    is invoked. I9/W1: a script enforcer with no declared call site is a rule guarded
#    by nobody. It also asserts install.sh and uninstall.sh agree on the fixture list.
step "taught schema == read schema (provenance examples derive from schemas/)" \
  bash core/scripts/sync-taught-schema.sh --check

step "enforcement-map integrity (I1-I11)" \
  bash scripts/validate-enforcement-map.sh

# 1b. A core/ pointer at a dev-repo docs/ spec that install never ships is dead in every
#     consumer tree — resolves for a maintainer, 404s for a consumer. Derived, no hand-list.
step "no dead doc refs (core/ cites no unshipped dev-repo doc)" \
  bash scripts/validate-no-dead-doc-refs.sh

# 1c. Three things name a release -- the commit subject, VERSION, and the CHANGELOG's
#     top heading -- and until v0.125.0 nothing joined them. v0.124.1 was committed
#     with a subject one patch ahead of both. Push is the right seam: it is the last
#     point before the version becomes a claim other people read.
step "release version triple (subject == VERSION == CHANGELOG heading)" \
  bash scripts/validate-release-version.sh

# 2. SKILL.md's first ~5000 tokens are whole-re-read on EVERY compaction. The resident
#    region sits within a few hundred tokens of the ceiling, so an edit above the fold
#    can silently push the post-compact recovery protocol below it.
step "re-attach budget (SKILL.md resident region)" \
  bash core/scripts/validate-reattach-budget.sh --skill core/skills/ai-dlc/SKILL.md

# 2b. Rule 18 and rule-authoring.md govern rule prose, but the audit that enforces them
#     was driven only from a consumer's retro. Narrative authored here reached every
#     consumer before anything could see it. Only the deterministic tier gates the push;
#     the judgement tier prints and is dispositioned at retro.
step "rule-file audit (origin tags, dates, dangling pointers)" \
  bash core/scripts/audit-rule-files.sh --fail-on=deterministic

# 3. Every fixture is an adversarial self-test for one gate check. A fixture that is
#    never driven is a green light nobody earned.
#
# RUN IN PARALLEL, AND THE REASON IS MEASURED. The suite is latency-bound, not
# compute-bound: 458 seconds of work across the 75 driven fixtures, almost all of it waiting
# on `git init`/commit/mktemp in per-fixture sandboxes. Serially that was 7m06s of wall clock
# on an idle 18-core machine. At 8 workers it was 2m34s, and after v0.190.0 removed the
# dominant pole it is ~1m34s.
#
# EIGHT, NOT MORE -- AS MEASURED, AND THE KNEE HAS SINCE MOVED. -P16 measured 2m30s against
# -P8's 2m34s, four seconds, because ONE fixture (`enforcement-map-sites`) was 167s by itself
# and set a floor no amount of parallelism beats. v0.190.0 cut that fixture to ~81s, so the
# suite is closer to pool-bound now and a higher count may start paying again. Re-measure
# before changing it: that is why this is the tunable AI_DLC_FIXTURE_JOBS and not a constant.
FIXTURE_JOBS="${AI_DLC_FIXTURE_JOBS:-8}"

run_fixtures() {
  local rc=0 d b out n_expected n_actual verdict
  out="$(mktemp -d)" || return 1

  for d in core/fixtures/*/; do
    [ -f "$d/run.sh" ] || continue
    printf '%s\n' "$d"
  done > "$out/list"
  n_expected="$(grep -c . "$out/list" 2>/dev/null || echo 0)"
  if [ "$n_expected" -eq 0 ]; then
    printf '   FAIL  no fixtures found -- an empty suite passes every assertion it never made\n'
    rm -rf "$out"; return 1
  fi

  # Each worker records its verdict to a file named for its fixture. The verdict is read
  # back from those FILES, not from xargs exit status, because that is what makes the
  # completeness assertion below possible -- and because `xargs` collapses any number of
  # failures into one exit code that cannot say WHICH.
  AI_DLC_FX_OUT="$out" xargs -P "$FIXTURE_JOBS" -I{} bash -c '
    d="$1"; b="$(basename "$d")"
    if bash "$d/run.sh" >/dev/null 2>&1; then printf ok   > "$AI_DLC_FX_OUT/$b"
    else                                      printf FAIL > "$AI_DLC_FX_OUT/$b"; fi
  ' _ {} < "$out/list"

  # Rendered in list order, so the output is deterministic and diffable across runs even
  # though the work completed out of order.
  n_actual=0
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    b="$(basename "$d")"
    if [ ! -f "$out/$b" ]; then
      printf '   FAIL  %s  (no verdict recorded)\n' "$b"; rc=1; continue
    fi
    n_actual=$((n_actual + 1))
    verdict="$(cat "$out/$b")"
    if [ "$verdict" = ok ]; then printf '   ok    %s\n' "$b"
    else                        printf '   FAIL  %s\n' "$b"; rc=1; fi
  done < "$out/list"

  # THE CONTROL PARALLELISM MAKES NECESSARY. Serially, a fixture that never ran could not
  # print an `ok` -- the loop and the report were the same thing. With a worker pool they
  # are not: a dropped job produces no verdict file, and a suite reporting 70 greens
  # instead of 75 reads exactly like a suite that passed. This is the check-that-cannot-
  # fire class one layer out, so the count is asserted rather than assumed.
  if [ "$n_actual" -ne "$n_expected" ]; then
    printf '   FAIL  %s of %s fixtures produced a verdict -- the pool dropped work, and a short green suite reads exactly like a passing one\n' \
      "$n_actual" "$n_expected"
    rc=1
  fi

  rm -rf "$out"
  return $rc
}
step "fixture suite (${FIXTURE_JOBS}-way)" run_fixtures

# 4. A shipped script with a syntax error is a gate that cannot run at all.
#    validate-enforcement-map.sh maps this glob set through map_consumer() and
#    asserts it equals the set in core/git-hooks/pre-push. Add a class here and the
#    consumer hook fails until it carries the class too.
# SYNTAX_GLOB_BEGIN
syntax_all() {
  local rc=0 f
  for f in scripts/*.sh core/scripts/*.sh core/hooks/*.sh \
           core/skills/ai-dlc-update/reconcile/*.sh .githooks/*; do
    [ -f "$f" ] || continue
    bash -n "$f" 2>/dev/null || { printf '   syntax error: %s\n' "$f"; rc=1; }
  done
  return $rc
}
# SYNTAX_GLOB_END
step "shell syntax (every shipped script and hook)" syntax_all

if [ "$fail" -ne 0 ]; then
  printf '\npre-push: BLOCKED. Fix the above, or `git push --no-verify` on the record.\n\n'
  exit 1
fi
printf '\npre-push: all gates green.\n\n'
