#!/usr/bin/env bash
# pre-push — the distribution's own gate. Runs its validators against itself.
#
# THE DEFECT THIS REPLACES. ai-dlc shipped fifteen validators and a CI template *to
# its consumers* while gating none of its own. Every check ran only when a human
# remembered to type it, which is how three releases shipped half-wired: the enforcer
# was named, never invoked. `git log --all -- .github` was empty for the project's
# entire history.
#
# WHY NOT GITHUB ACTIONS. Operator policy: no CI in GitHub, for this repo or the
# reference consumer (which removed its own Actions scaffolding deliberately). A gate
# that lives in a service we do not run is a gate we do not control. This runs on the
# machine doing the pushing, needs no network, no runner, and no third party.
#
# The evidence that local is sufficient: v0.52.0's own packaging bug -- a fixture added
# to install.sh's hardcoded loop but not uninstall.sh's -- was caught by
# `validate-enforcement-map.sh` on a local run, BEFORE the push. The Actions run only
# ever saw the fixed tree and caught nothing.
#
# ENABLE (once per clone):
#     git config core.hooksPath .githooks
#
# Bypass for a genuine emergency is `git push --no-verify`, and it is a decision you
# are making on the record, not a default you fall into.
#
# AI_DLC_READSET_LIVE_TRACE=0 stops the detached read-set trace a green suite starts for its
# unmapped fixtures (readset_live_trace); default on. A fixture that drives a copy of this hook
# sets it to 0 on that drive.

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

# 0. A GREEN GATE IS NOT A LANDED PUSH, and the cause is a dotfile, not this tree. `git push`
#    opens the SSH connection BEFORE this hook runs; the suite below then idles it for minutes,
#    GitHub's sshd drops it, and the pack write takes SIGPIPE -- exit 141, every phase PASS, the
#    ref absent on origin. Measured: three consecutive pushes dropped mid-suite; adding
#    `ServerAliveInterval 60` / `ServerAliveCountMax 30` to the remote's ssh alias was the one
#    change, and the next three landed. This WARNS, once, when the effective ssh config for the
#    push remote carries no keepalive. It never fails the push: the gate's verdict is about the
#    tree, and a missing keepalive is about the transport.
#
#    WHY NOT `git ls-remote` AFTER THE PUSH. pre-push runs before the transport, so it cannot
#    see the outcome; and a reader run from outside races a backgrounded push -- measured
#    reading 0 while the push was still in flight and then landed. The cause is checkable here;
#    the symptom is not.
#
#    IT READS THE SSH COMMAND GIT WILL ACTUALLY RUN, in git's own precedence: GIT_SSH_COMMAND,
#    then core.sshCommand (both run through `sh -c 'CMD "$@"'`, as git does), then GIT_SSH
#    (exec'd directly), then `ssh`. An operator pushing with
#    `GIT_SSH_COMMAND="ssh -o ServerAliveInterval=60"` IS configured, and a plain `ssh -G`
#    would warn at them -- so the effective value is what `-G` prints through THAT command,
#    never what one file says. That is also how the fixture seeds a config without touching
#    `~/.ssh/config`: it sets `GIT_SSH_COMMAND="ssh -F <seeded config>"`, the same knob an
#    operator uses. No test-only variable exists for a mutant to leave switched on.
#
#    SILENT, never guessing, when: the URL is not ssh (https, file, a local path); the args are
#    absent (a hand run or a fixture driving this hook); the command's first word is not
#    `ssh` (plink, a wrapper -- handed `-G` it might connect); or `ssh -G` fails or prints no
#    `serveraliveinterval`. stdin is closed on the probe: it carries git's ref lines.
#
#    FALSE-POSITIVE SET, measured on the operator's box: `origin` is
#    `git@github-euron8:euron8/ai-dlc.git`, `ssh -G github-euron8` reports
#    `serveraliveinterval 60`, and this block is silent; the same args with
#    `GIT_SSH_COMMAND="ssh -F <empty config>"` fire. `core/fixtures/prepush-ssh-keepalive`
#    drives this block, extracted between the sentinels, in both directions with two mutants.
# KEEPALIVE_BEGIN
ssh_keepalive_warn() {
  local url="${2:-}" cmd="" via="" first="" rest="" auth="" target="" port="" host_alias="" out="" line="" iv=""
  [ -n "$url" ] || return 0
  case "$url" in
    ssh://*|git+ssh://*|ssh+git://*)
      rest="${url#*://}"; auth="${rest%%/*}"
      case "$auth" in *\[*) return 0 ;; esac
      target="${auth%%:*}"
      case "$auth" in *:*) port="${auth#*:}" ;; esac ;;
    *://*) return 0 ;;
    *:*)
      target="${url%%:*}"
      case "$target" in ''|*/*) return 0 ;; esac ;;
    *) return 0 ;;
  esac
  [ -n "$target" ] || return 0
  host_alias="${target#*@}"
  if [ -n "${GIT_SSH_COMMAND:-}" ]; then cmd="$GIT_SSH_COMMAND"; via=shell
  elif cmd="$(git config --get core.sshCommand 2>/dev/null)" && [ -n "$cmd" ]; then via=shell
  elif [ -n "${GIT_SSH:-}" ]; then cmd="$GIT_SSH"; via=exec
  else cmd=ssh; via=exec
  fi
  if [ "$via" = shell ]; then first="${cmd%%[[:space:]]*}"; else first="$cmd"; fi
  [ "${first##*/}" = ssh ] || return 0
  command -v "$first" >/dev/null 2>&1 || return 0
  if [ "$via" = shell ]; then
    if [ -n "$port" ]; then
      out="$(sh -c "$cmd"' "$@"' "$cmd" -G -p "$port" "$target" </dev/null 2>/dev/null)" || return 0
    else
      out="$(sh -c "$cmd"' "$@"' "$cmd" -G "$target" </dev/null 2>/dev/null)" || return 0
    fi
  else
    if [ -n "$port" ]; then
      out="$("$cmd" -G -p "$port" "$target" </dev/null 2>/dev/null)" || return 0
    else
      out="$("$cmd" -G "$target" </dev/null 2>/dev/null)" || return 0
    fi
  fi
  while IFS= read -r line; do
    case "$line" in serveraliveinterval\ *) iv="${line#serveraliveinterval }" ;; esac
  done <<EOF
$out
EOF
  [ "$iv" = 0 ] || return 0
  printf 'pre-push: WARNING -- ssh host alias "%s" has no keepalive (ServerAliveInterval 0). The suite below idles the connection git already opened, GitHub drops it, and the push exits 141 with every gate green and the ref NOT on origin. Add "ServerAliveInterval 60" and "ServerAliveCountMax 30" under "Host %s" in ~/.ssh/config. Not blocking.\n' "$host_alias" "$host_alias"
}
ssh_keepalive_warn "${1:-}" "${2:-}"
# KEEPALIVE_END

fail=0
step() {
  printf '\n── %s\n' "$1"; shift
  if "$@"; then printf '   PASS\n'; else printf '   FAIL\n'; fail=1; fi
}

# 1. The enforcement map is the index of which rule is enforced by what, and WHERE it
#    is invoked. I9/W1: a script enforcer with no declared call site is a rule guarded
#    by nobody. It also asserts install.sh and uninstall.sh agree on the fixture list.
step "taught schema == read schema (provenance examples derive from schemas/)" \
  bash core/scripts/sync-taught-schema.sh --check

step "enforcement-map integrity (I1-I11)" \
  bash scripts/validate-enforcement-map.sh

# 1a-i. docs/invariant-index.md is DERIVED from the arm headers in the validator above, and
#       byte-compared here. It replaced a hand-typed enumeration in that script's own `OK:`
#       line which had gone stale by 22 invariants -- it named 71 while 93 arms could fire,
#       and CLAUDE.md pointed readers at it as the live list. The renderer also asserts, on
#       every run, that no emitter sits outside a declared arm, that no declared arm is
#       unable to emit, and that no ID is claimed twice. Runs in ~0.06s and never touches
#       the validator's body, so it costs the pole nothing.
step "invariant index derived from the map's arm headers" \
  bash scripts/render-invariant-index.sh --check

# 1a-ii. docs/vocabulary-index.md is DERIVED from the `# vocabulary:` markers those same arm
#        headers carry, plus every enum in core/schemas/*.json, and byte-compared here. Six
#        invariants in this tree exist only because a closed vocabulary correctly owned by one
#        file kept being restated from memory somewhere else; until this ran there was no place
#        a reader could see the sets at all, so the restating continued and the invariant caught
#        it afterwards. It also fails the push on an arm header that READS as a vocabulary join
#        while carrying no marker, which is what keeps the index's population from going stale
#        as arms are added. Runs in ~0.4s. It must sit AFTER the invariant index, whose output
#        it consumes to resolve every marker's `vocabulary-invariant:` citation.
step "vocabulary index derived from the markers and the schemas" \
  bash scripts/render-vocabulary-index.sh --check

# 1a-iii. The `## Path mapping (core/ -> consumer)` section of core/skills/ai-dlc-update/SKILL.md
#         is DERIVED from map_consumer() in reconcile/preclassify.sh and byte-compared here. It
#         was a hand-written restatement of a six-arm `case` and had been wrong in FOUR ways at
#         once — three subtrees missing and the `core/scripts/` row stale since v0.126.0 — because
#         I16, the only invariant that reads path prose, puts core/skills/ai-dlc-update/** out of
#         scope BY NAME. The section sat in the one file every path invariant is told to skip.
#         It is a standalone renderer rather than an arm inside validate-enforcement-map.sh on
#         purpose: that validator is what the suite pole invokes, and one nested loop added to it
#         once moved the pole from 442s to 595s. Runs in ~0.05s and costs the pole nothing.
step "path mapping derived from map_consumer()" \
  bash scripts/render-path-mapping.sh --check

# 1a-iv. core/skills/ai-dlc/postcompact-digest.md is DERIVED from the part of SKILL.md that a
#        compaction throws away, and byte-compared here. It is the file the lead is now told to
#        Read after a compaction instead of re-reading all ~102 KB of SKILL.md, so a digest that
#        has drifted from the rulebook is a lead running the sprint on stale rules while every
#        other check stays green. The renderer also fails the push when a digest entry ends on a
#        colon -- announcing content it does not carry, which a lead reads as the rule -- and
#        when the selector finds fewer headings than the floor, which is how an extractor that
#        lost SKILL.md's grammar would otherwise byte-compare clean against an empty region.
#        Runs in ~0.05s and costs the pole nothing.
step "post-compact digest derived from SKILL.md past the re-attach cut" \
  bash scripts/render-postcompact-digest.sh --check

# 1a. The same corpus-wide party-mode floor the consumer hook runs, over the DISTRIBUTION's own
#     tree. It is here for a reason beyond symmetry: this tree holds the two files the check has
#     to get right — the one rendered taught example (exempt only because the generated-region
#     carve-out works) and the fixture that embeds five forged blocks on purpose (exempt only
#     because a fixture directory is a declared home). A change that breaks either exemption goes
#     red here, on the machine that made it, instead of on a consumer's next push.
step "stray party-mode provenance (distribution tree)" \
  bash core/scripts/validate-provenance-block.sh --strays

# 1b. A core/ pointer at a dev-repo docs/ spec that install never ships is dead in every
#     consumer tree — resolves for a maintainer, 404s for a consumer. Derived, no hand-list.
step "no dead doc refs (core/ cites no unshipped dev-repo doc)" \
  bash scripts/validate-no-dead-doc-refs.sh

# 1c. Three things name a release -- the commit subject, VERSION, and the CHANGELOG's
#     top heading -- and until v0.125.0 nothing joined them. v0.124.1 was committed
#     with a subject one patch ahead of both. Push is the right seam: it is the last
#     point before the version becomes a claim other people read.
step "release version triple (subject == VERSION == CHANGELOG heading)" \
  bash scripts/validate-release-version.sh

# 1d. A plan in docs/plans/ is a handoff to a session that has never seen this one. Push
#     is the seam: it is the last point before the file becomes the thing someone else is
#     told to READ and FOLLOW. Measured on the first plan promoted here — two status
#     records with the older one a release stale, and two merged releases still written
#     in the imperative. Followed literally, that redoes shipped work.
step "plan shape (docs/plans/ is resumable by a session that never saw this one)" \
  bash scripts/validate-plan-shape.sh

# 1e. Narrow authoring rules live in `.claude/rules/*.md` and load only when Claude READS
#     a matching file -- measured on CC 2.1.226: Read and Edit fire the trigger, Write,
#     Grep, Glob and Bash do not. Three of the four failure modes that creates are silent:
#     a glob matching nothing is a rule that never loads, `globs:`-instead-of-`paths:`
#     frontmatter is a rule that is silently resident in EVERY session, and a rule with
#     neither a CLAUDE.md pointer nor a reasoned no-stub marker is invisible in both
#     channels. The fourth bounds the .gitignore narrowing that lets rule files be
#     committed at all. Push is the seam: it is the last point before the split rulebook
#     becomes what the next session reads.
step "claude-rules joins (tracked paths, live globs, paths-only frontmatter, pointers)" \
  bash scripts/validate-claude-rules.sh

# 1f. docs/backlog.md is a QUEUE and a queue has a depth. Nothing bounded it: A6's byte ceiling
#     in validate-claude-rules.sh covers CLAUDE.md and .claude/rules/ only, and the two scripts
#     that DO own this ledger cannot gate -- backlog-reverify.sh declares itself a classifier
#     that always exits 0, and backlog-rotate.sh returns early whenever nothing is closed, which
#     is precisely the state a ledger is in when it is longest. Neither runs here. Push is the
#     seam: it is the last point before the queue becomes the thing the next triage sweep has to
#     read end to end. Standalone and ~0.06s at 11 forks: deliberately NOT an arm inside
#     validate-enforcement-map.sh, which the suite's mutation batteries drive through ~20 mutants
#     apiece. The ARCHIVE is not bounded -- it is an append-only log, and rotation into it is
#     this arm's only remedy.
step "backlog depth (docs/backlog.md stays a queue, not a log)" \
  bash scripts/validate-backlog-size.sh

# 1h. The step above bounds the ledger's DEPTH and never opens a receipt. This one asks whether
#     the receipts MEAN anything: each is the instrument the next batch uses to decide whether
#     its own fix worked, and measured over one batch's ranked set, nine of ten were satisfied
#     by a bare comment, a pure line reflow, or one word inside an unrelated string.
#     `.claude/rules/verification-discipline.md` says "bind to the line that EMITS the thing"
#     and nothing enforced it. Push is the seam: it is the last point before those receipts
#     become the evidence a later session closes work on.
#
#     STANDALONE, AND NOT AN ARM INSIDE validate-enforcement-map.sh, for a stronger reason than
#     its siblings carry. That validator is driven through ~20 and ~17 mutants by the two sharded
#     batteries, and this arm runs a detached checkout of HEAD -- twice -- for every receipt in
#     the ledger. It is ~22s at 8-way here, which is the most expensive validator in this hook;
#     multiplied by thirty it would be the suite's pole on its own.
#
#     THE CEILINGS ARE RATCHETS AND ONLY EVER MOVE DOWN. Each is the count the arm READ on the
#     tree that registered it, not a policy number -- every receipt under one is a filed defect
#     awaiting per-entry work, and rewriting them is not this step's job. There are three of
#     them plus a floor because ONE ceiling is escapable by leaving the population: building the
#     pattern from a variable, moving it into an awk body, adding an `|| exit 9`, rewriting
#     `verify: sh` as `verify: manual`, or deleting the receipt line all lower the headline
#     count and fix nothing. Lower a number here when the work is done; never raise one.
#
#     `--max-unstable 0` IS NOT A RATCHETED DEBT, and it is the one number here that ships at
#     its standard rather than at a measured count. A receipt whose exit differs between two
#     readings of the SAME commit cannot answer its question on the run that matters either.
#     Measured once in thirty-three runs under three-way contention, and the cost was a real
#     push failure named against a receipt that was fine: the flapping exit landed in the
#     out-of-population count and took it over its ceiling. The arm now re-reads any non-0/1
#     base exit once in a fresh checkout and reports the disagreement by name.
step "backlog receipts (a receipt a COMMENT can satisfy is not a receipt)" \
  bash scripts/validate-backlog-receipts.sh \
    --max-prose-closable 1 --max-unscorable 28 --max-out-of-population 1 \
    --max-unstable 0 --min-sh-receipts 1 --min-entries 1

# 1g. The bash-3.2 / BSD-userland floor for every shipped shell file. GNU-only idioms do not
#     error here, they return the WRONG ANSWER quietly -- `sed -i` takes the script as a
#     backup suffix, `\s` matches a literal `s`, `mapfile` reads nothing. Every arm reports
#     zero over the corpus today and is a pure regression guard, so its fixture is the only
#     evidence any of them works. Standalone and ~0.5s: deliberately NOT an arm inside
#     validate-enforcement-map.sh, which the suite pole invokes at roughly 30s of gate per
#     second of script.
step "shell portability (bash 3.2 + BSD userland floor)" \
  bash scripts/validate-shell-portability.sh

# 2. SKILL.md's first ~5000 tokens are whole-re-read on EVERY compaction. The resident
#    region sits within a few hundred tokens of the ceiling, so an edit above the fold
#    can silently push the post-compact recovery protocol below it.
step "re-attach budget (SKILL.md resident region)" \
  bash core/scripts/validate-reattach-budget.sh --skill core/skills/ai-dlc/SKILL.md

# 2b. Rule 18 and rule-authoring.md govern rule prose, but the audit that enforces them
#     was driven only from a consumer's retro. Narrative authored here reached every
#     consumer before anything could see it. Only the deterministic tier gates the push;
#     the judgement tier prints and is dispositioned at retro.
step "rule-file audit (origin tags, dates, dangling pointers)" \
  bash core/scripts/audit-rule-files.sh --fail-on=deterministic

# 2c. Every SHARED APPEND-ONLY artifact has a DECLARED entry format, and every declaration
#     still resolves. The population is JOINED from pipeline-state-paths.json on
#     transient:false, which I95 already binds in both directions, so this adds no second
#     copy of that set.
#
#     THE RATCHET IS THE POINT AND THE CEILING ONLY MOVES DOWN. Fifteen of the twenty
#     durable artifacts carry no declared format today; failing on that would wedge the push
#     on first contact and be switched off, so absence is REPORTED and the ceiling bounds
#     GROWTH. A BROKEN declaration -- one naming a file that is gone or that no longer
#     carries its anchor -- fails outright, because that is the state which reads as covered
#     and is not. Lower the number in the same change that declares a format; never raise it.
step "write-format steering (every shared append-only artifact declares its entry format)" \
  bash core/scripts/validate-write-format-steering.sh --max-undeclared 15

# 2b. A fixture that builds a scratch repository must scrub the inherited git environment
#     FIRST. Git exports GIT_DIR absolute to a hook run from a linked worktree; a fixture
#     invoked directly inherits it, its `git init` then succeeds WITHOUT creating a
#     repository, and every later git call lands on the caller's index. Measured: 8 of 8
#     wiped a 757-entry index, 6 of them at exit 0 with zero FAILs.
#
#     THE SCRUB ABOVE DOES NOT COVER THIS. It protects the fixture POOL, which is dispatched
#     from inside this hook; a hand running `bash core/fixtures/X/run.sh` passes through no
#     seam at all, and that is the invocation CLAUDE.md prescribes for debugging one.
#
#     The ceiling only moves DOWN. It is 0 today because the seam closed the whole
#     population; a new fixture that skips it is the same defect one instance larger.
step "fixture git-env scrub (a directly-run fixture cannot clobber the caller's index)" \
  bash scripts/validate-fixture-git-env.sh --max-unscrubbed 0

# 2d. THE SHIPPED RENDERER, DRIVEN AGAINST THIS TREE. `.claude/agents/<role>.md` frontmatter is
#     the only channel that binds a role's reasoning EFFORT to its subagent. A prompt cannot set
#     effort -- measured on the reference consumer, every spawn ran at the effort the SESSION
#     resolved, from its launch flag or the user's `effortLevel`/`modelSettings`, never the
#     role's -- and a rendered definition OUTRANKS that resolution rather than filling a gap.
#
#     THIS TREE DECLARES NO `aiDlcRoles` AND THE ARM STILL RUNS, which is the point. The
#     distribution is not a consumer: it has no `.claude/settings.json` at all, so the renderer
#     answers NOT APPLICABLE here and this arm prints that rather than a pass. A green line over
#     a check that had nothing to look at is the failure this repository names most often, and
#     the three outcomes are kept distinct in the renderer's own exit codes (3 not applicable, 0
#     current, 1 drifted) rather than in a second copy of the test written here.
#
#     THE VALUE ON THIS SIDE IS THE PROGRAM, NOT THE VERDICT. A syntax error, a broken root walk
#     or an absent jq makes the renderer exit 2, and this arm goes red -- so the copy that reaches
#     every consumer is driven on every push here, where it can be fixed, rather than first on a
#     consumer's gate where it cannot.
agent_definitions_dist() {
  local out rc
  out="$(bash core/scripts/render-agent-definitions.sh --check --root . 2>&1)"; rc=$?
  printf '%s\n' "$out"
  case "$rc" in
    3) printf '   NOT APPLICABLE -- the distribution declares no aiDlcRoles. This is NOT a pass:\n'
       printf '   nothing here verified a rendered definition, only that the renderer ran and said so.\n'
       return 0 ;;
    0) return 0 ;;
    *) return 1 ;;
  esac
}
step "agent definitions (the shipped renderer runs, and says which of its three states this tree is in)" \
  agent_definitions_dist

# 3. Every fixture is an adversarial self-test for one gate check. A fixture that is
#    never driven is a green light nobody earned.
#
# RUN IN PARALLEL, AND THE PREMISE THAT USED TO SIT HERE HAS EXPIRED. This block said for
# several releases that the suite is "latency-bound, not compute-bound -- most of its work is
# waiting on `git init`/commit/mktemp". That was measured over 83 fixtures at 72s and it is no
# longer true of this suite. Re-measured over 153 units: a full run is ~2480 CPU-seconds
# against a ~210s wall, i.e. roughly twelve cores busy for the whole run, and its heaviest
# units are fork-bound at 113% CPU with 62% of that in SYSTEM time.
#
# TWELVE, AND WIDER BUYS NOTHING. Swept on this box with the dispatched set pinned
# (AI_DLC_FIXTURE_NO_SKIP=1 on every run, the durations record reset from one golden copy
# before each, cells visited round-robin so drift spreads evenly rather than loading onto
# whichever ran last). Every run green; wall seconds, and the CPU-seconds the same runs cost:
#
#     -P8   [223.45, 276.22]   2346 CPU-s
#     -P12  [205.40, 218.75]   2433 CPU-s
#     -P16  [209.31, 213.89]   2483 CPU-s
#     -P20  [209.98, 213.76]   2495 CPU-s
#     -P24  [212.38, 220.75]   2500 CPU-s
#
# READ THE RANGES, NOT THE MEDIANS. A difference counts only where two cells' readings do not
# overlap, and on that rule exactly one comparison separates: -P8 is genuinely worse than the
# rest. TWELVE, SIXTEEN, TWENTY AND TWENTY-FOUR ARE INDISTINGUISHABLE FROM EACH OTHER, and no
# number of further repetitions was going to separate them -- the spread WITHIN a cell is
# already the size of the differences BETWEEN them.
#
# -P8 IS THE CONTROL, NOT A CANDIDATE. It has to come out worse or the response variable is
# not measuring the pool at all, and every other cell is uninterpretable. It did.
#
# SO THE CHOICE INSIDE THAT BAND IS NOT A SPEED CLAIM. Wall clock is flat from 12 to 24 while
# CPU-seconds RISE MONOTONICALLY across the same range -- +67 from 12 to 24, all of it system
# time. Going wider buys no wall clock and spends contention for it. Twelve is the narrowest
# width in the indistinguishable band, so it is the one that leaves the most machine to
# everything else the operator is running. That is an operator's ruling about headroom, and it
# is recorded as one; the measurement establishes only that 12 is not slower.
#
# WHAT IS NOT ESTABLISHED HERE. That 12 beats 16 -- the ranges overlap and this does not claim
# it.
#
# THE INNER POOLS, SWEPT. ELEVEN fixtures open their own `xargs -P`, totalling 70 workers on top
# of this one. They cannot be varied by an environment variable -- `enforcement-map-sites/run.sh`
# scrubs every ambient AI_DLC_* name for I10, and I87 binds any key a shipped program
# dereferences -- so the sweep edited the eleven constants on an unpushed branch of a file://
# clone, one commit per cell, at this pool of 12, with the same design as above: dispatched set
# pinned by AI_DLC_FIXTURE_NO_SKIP=1, durations reset from one golden copy before every run, cells
# visited round-robin (A B A B C A C B C), three runs each. Wall seconds:
#
#     B  every inner pool at 1         [1179, 1323]
#     A  the constants as shipped      [1097, 1144]
#     C  every inner pool doubled      [1082, 1254]
#
# B IS THE CONTROL AND IT SEPARATED: its range does not overlap A's. Per unit it is not close --
# at width 1 trunk-audit-mutants ran 186-201s against 37-44s, consumer-machinery-home 249-258s
# against 66-67s, ledger-status-vocabulary 446-490s against 152-156s -- so the response variable
# does see the pools. A AND C OVERLAP, so doubling every pool buys no wall clock this sweep can
# resolve. The suite stays bound by `reconcile-emit-report`, which opens no inner pool and was the
# longest unit in all nine runs. The constants stay as they are: they are the narrowest setting in
# the indistinguishable band, which leaves the most machine to everything else, the same ruling
# as the outer pool's. Per-unit costs are recorded in BL-004's archived entry.
#
# THE NUMBER IS MEASURED ON ONE MACHINE. That is why it stays the tunable
# AI_DLC_FIXTURE_JOBS: on a smaller box, re-measure rather than inherit this.
#
# THE BLOCK BELOW IS JOINED TO core/git-hooks/pre-push BY I66, and the join is on
# EXECUTABLE LINES ONLY. For this project's whole history the distribution ran its
# suite through a pool with a completeness assertion and an empty-suite guard while
# shipping consumers a serial loop that returned 0 when it ran nothing -- 313 lines
# here against 208 there, and nothing compared them. Prose stays deliberately
# different (this one addresses a maintainer, that one a consumer, and the pool size
# is re-derived per box); the code must not. Comments are stripped before the
# comparison because a comparison a comment can satisfy is I64's defect: the token
# is present and the mechanism is absent.
# FIXTURE_POOL_BEGIN
FIXTURE_JOBS="${AI_DLC_FIXTURE_JOBS:-12}"
# THE FIXTURE ROOT, SPELLED ONCE AND SLASH-TERMINATED. It is the one line I66 maps between the hooks.
FXROOT="core/fixtures/"
# RECURSION BOUND. A fixture that drives a hook runs this pool again, and nothing else limits the
# nesting. The depth marker is deliberately NOT named AI_DLC_*: fixtures scrub that whole prefix from
# their environment before driving a hook, so a marker carrying it would be removed exactly where it
# has to survive. Depth 1 is a hook started under a pool's fixture, and its pool is narrowed to two
# workers, not one, because a fixture that asserts parallelism needs two in flight. Depth 2 or more
# refuses to open a pool (run_fixtures). No AI_DLC_FIXTURE_JOBS value lifts the depth-1 cap: one or two
# is kept, and anything else -- larger, zero (BSD `xargs -P 0` is UNLIMITED), not a number, or longer
# than five digits -- becomes two. A drive under `env -i` clears the marker with everything else and must
# pass the depth explicitly. A marker that is SET but not a number, or longer than five digits, is depth
# 2 and refuses: it FAILS CLOSED, because bash arithmetic wraps a 20-digit value (2^64 reads as 0) and
# `[` errors on one, either of which would otherwise open a full pool. The `10#` reads 08 as eight.
POOL_DEPTH_IN="${PREPUSH_POOL_DEPTH:-0}"
case "$POOL_DEPTH_IN" in *[!0-9]*|??????*) POOL_DEPTH_IN=2 ;; esac
POOL_DEPTH_IN=$((10#$POOL_DEPTH_IN))
if [ "$POOL_DEPTH_IN" -ge 1 ]; then
  case "$FIXTURE_JOBS" in ''|*[!0-9]*|??????*) FIXTURE_JOBS=2 ;; esac
  if [ "$FIXTURE_JOBS" -lt 1 ] || [ "$FIXTURE_JOBS" -gt 2 ]; then FIXTURE_JOBS=2; fi
fi
# RESOLVE THE GIT DIRECTORY; NEVER SPELL IT `.git/`. In a LINKED WORKTREE `.git` is a
# FILE, not a directory, so every record below fails to open -- and each write is
# error-suppressed, so the suite proceeds and the banner is unaffected while the
# cross-run evidence is silently lost. `--git-common-dir` answers `.git` in a primary
# checkout and the shared admin directory from a worktree, so one spelling is correct
# in both. The fallback keeps the old behaviour if rev-parse is unavailable.
GITDIR="$(git rev-parse --git-common-dir 2>/dev/null)" || GITDIR=".git"
[ -n "$GITDIR" ] || GITDIR=".git"
DURATIONS_RECORD="$GITDIR/ai-dlc-fixture-durations"
# THIS RUN'S COSTS, UNMERGED, AND THAT IS THE WHOLE DIFFERENCE FROM THE RECORD ABOVE.
# DURATIONS_RECORD merges each run over the last one so a SKIPPED unit keeps the cost it had --
# correct for scheduling, useless for measurement. Its rows are of mixed vintage and nothing in
# it says which run wrote which, so reading a pole figure off it compares two different days.
# This file holds only what THIS pool actually timed.
#
# TRUNCATED AT POOL ENTRY, so the file cannot outlive the run that wrote it. A reader finding it
# non-empty has a measurement from a pool that entered, dispatched, and came back green; every
# other path -- red unit, dead worker, mktemp failure, the empty-suite guard -- leaves it EMPTY,
# which is the state a reader must treat as "nothing was measured" rather than as a figure.
#
# PUBLISHED ONLY ON A FULLY GREEN RUN OVER THE DISPATCHED LIST, gated exactly like
# VERIFIED_RECORD below and for the same reason: a red run's timings are the timings of a suite
# that did not finish, and a guard comparing them against a full-suite baseline would read a
# short run as an improvement.
#
# THE CONTENT-KEY SKIP NEVER ENTERS THE POOL, so it neither truncates nor writes -- the PRIOR
# run's file survives it. That is why the reader is the hook step, which stands down on
# SUITE_SKIPPED rather than trusting the file's age.
LASTRUN_RECORD="$GITDIR/ai-dlc-fixture-durations.last"
READSET_MAP=".ai-dlc-fixture-readsets.tsv"
# THE VERIFIED-STATE RECORD LIVES UNDER .git FOR I55 ARM 4'S REASON EXACTLY: the content key
# hashes the working tree, so a cross-run record inside it would change the key that decides
# whether this suite runs at all.
VERIFIED_RECORD="$GITDIR/ai-dlc-fixture-verified"
# THE RECORD'S FORMAT STAMP IS A SIDECAR, NOT A HEADER LINE, so the record stays pure
# `path<TAB>sha` rows and every reader of it -- `comm`, `cut`, and the fixtures that seed one
# by copying a manifest -- is unchanged. Written only beside a record THIS hook wrote, which is
# already filtered of ignored paths at the manifest; see the reader in apply_readset_skip.
VERIFIED_FORMAT="$GITDIR/ai-dlc-fixture-verified.format"
# ONE KEY RECORD PER FIXTURE, `<fixture>.key`; see the header of apply_readset_skip.
KEYS_DIR="$GITDIR/ai-dlc-fixture-keys"
# A RED UNIT'S OUTPUT HAS TO OUTLIVE THE RUN THAT PRODUCED IT. Until this record existed the
# worker below sent every fixture's stdout and stderr to /dev/null, so an intermittent red left
# ONE line of evidence -- `FAIL <name>` in a terminal -- and the honest local remedy was "push
# again", which is indistinguishable from bypassing a real failure. This repo has spent at least
# three release cycles proposing and refuting causes for one such intermittent, every
# investigation re-running the fixture out of band because the gate that SAW the failure kept
# nothing. Filed by the graph consumer as
# PC-S302-FIXTURE-SUITE-POOL-PRODUCES-AN-UNREPRODUCIBLE-FAIL-AND-THE-EVIDENCE-IS-DELETED-WITH-THE-TEMP-DIR.
#
# UNDER .git FOR THE SAME REASON AS THE TWO ABOVE: the content key hashes the working tree, so a
# record written into it would change the key that decides whether this suite runs at all.
#
# NEVER DELETED ON A GREEN RUN, and that is the whole point. The workflow this exists to serve is
# "it went red, I pushed again, it went green" -- a green run that cleaned up would destroy the
# evidence at exactly the moment the operator went looking for it. The record names the run that
# wrote it, and nothing points a reader at it unless THIS run is red.
#
# AND IT IS OVERWRITTEN BY THE NEXT RED RUN, so every red run also leaves its own copy:
# `ai-dlc-fixture-failures.<UTC %Y%m%dT%H%M%SZ>.<pid>`, pruned to the newest FAILLOG_KEEP of that
# shape. Measured at batch 179: one intermittent red's got-vector was the only evidence of its
# cause, and it lived in a file the next red run would have replaced. The prune takes a name only
# if it starts with a year and month AND its last dot-field is all digits, so a record saved by
# hand is safe when its name fails either test -- `.clean` fails the first, a retained copy
# renamed with a `.keep` suffix fails the second. A hand-saved name passing both is not.
FAILLOG_RECORD="$GITDIR/ai-dlc-fixture-failures"
FAILLOG_KEEP=20

# Reduce "$1" (the dispatch list) to the fixtures whose KEY moved. Each fixture F has a key
# record, `$KEYS_DIR/<F>.key`, holding the PRE-RUN hashes of the last run F passed on. F is
# skipped iff its record exists and every key in K(F) still matches; otherwise F runs.
#
# K(F): every path in F's read set (its committed rows, or its valid local rows once a trace of
# it lands -- those are ADDED to the committed rows, never shadow them), plus every file under F's own directory, each
# keyed by its `.now` sha or `-` when absent; the entry list of every DIRECTORY in that set,
# derived from the hashed path list and never from readdir; and the tool fingerprint. A fixture
# with no rows at all is keyed on the whole `.now` universe.
#
# NOT KEYED, the same exposure as before this record existed: `.git/**`, the content key's
# EXCLUDE tops (readset_excluded_re), git-ignored paths, anything read under `$HOME`, and
# environment knobs.
#
# A record is written per fixture on PASS, whatever its neighbours did; never on a fail, a kill
# or a missing verdict. A fixture that ran because a FILE in its read set or own directory moved
# is recorded `stale`: a stale fixture always runs, and the post-green live trace takes it. Once
# that trace lands its local rows are its key and the next pass records it `ok`. A LISTING
# change never stales: the record is written `ok` with every file and directory under each
# newly appeared entry added to its keys, so whatever F might now read there is keyed.
#
# The ONLY run-all is an empty `.now`: the hashing instrument is broken. NO_SKIP stays.
# Hash every path whose change could matter, into "$1/.now" as `path<TAB>sha`.
#
# THE SUBJECT IS TRACKED FILES *PLUS* EVERY PATH THE MAP NAMES. Tracked files are in it so a
# change to something NO fixture is known to read is still SEEN -- otherwise a validator that
# started reading a new file would drift out of the map with nothing able to notice. Measured
# on this tree: 1% of changed files across 40 commits fell outside every read-set, and that
#1% is exactly the population this arm exists for.
#
# `.git/**` IS DELIBERATELY OUT OF SCOPE, and it is a measurement rather than a convenience.
# Fixtures read git internals constantly -- 33 of 118 name some `.git` path, because validators
# they invoke resolve a root or ask `git status`. But `.git/HEAD`, `.git/index` and the refs
# move on EVERY commit, so honouring them would select those fixtures on every push and take
# the suite-wide win from 42% down to 12%, with two of the heaviest units running every time.
# Measured before excluding them: five fixtures read git HISTORY pointers (refs/HEAD/logs), and
# running all five across an empty commit -- HEAD moved, tree byte-identical -- changed NOT ONE
# verdict, with controls proving HEAD really moved and that the comparison could detect a
# difference. Their git reads are incidental to their verdicts. Excluded here rather than in the
# map so the map stays a faithful record of what was actually read.
# THE CONTENT KEY'S EXCLUSION SET, RESOLVED RATHER THAN RESTATED.
#
# `scripts/suite-content-key.sh` declares which paths cannot change a fixture verdict, and it
# earns each line with a two-tree mutation measurement. The OUTER skip honours that set; this
# INNER one did not, and the asymmetry cost a full suite on almost every push here. A changed
# path in no fixture read-set forces all N, and a NEW file is in no read-set by construction --
# the map is a generated snapshot, so it cannot name a file that did not exist when it was
# derived. `docs/plans/` is edited in nearly every session on this repo, so the arm that exists
# for a genuinely unknown dependency was firing on a directory the key already declares
# irrelevant. Measured: one plan file forced all 133 fixtures on a push whose subject was a
# one-line change.
#
# RESOLVED FROM THE DECLARATION, so this is not a second copy of the list. When the declaring
# script is absent -- it is distribution-only, and a consumer does not have it -- the set is
# EMPTY and this reduces to the previous behaviour exactly. Both hooks run this same code and
# I66 compares them on executable lines.
#
# `.git` is dropped here because it is already excluded, separately and on different grounds,
# at both of the sites below.
readset_excluded_re() {
  local decl="scripts/suite-content-key.sh" tops t re=""
  [ -f "$decl" ] || return 0
  tops="$(sed -n '/^# EXCLUDE_BEGIN$/,/^# EXCLUDE_END$/p' "$decl" \
          | sed -n 's/^\([A-Za-z0-9._-]\{1,\}\)$/\1/p' | grep -v '^\.git$')"
  [ -n "$tops" ] || return 0
  for t in $tops; do
    re="${re}|^$(printf '%s' "$t" | sed 's/\./\\./g')(/|$)"
  done
  printf '%s' "${re#|}"
}

# Drop every path the exclusion set covers. A no-op when the set is empty -- which is the
# consumer case, and must stay a no-op there rather than filtering on an empty pattern, since
# `grep -vE ""` matches everything and would empty the stream.
readset_drop_excluded() { # reads stdin, writes stdout
  local re; re="$(readset_excluded_re)"
  if [ -n "$re" ]; then grep -vE "$re"; else cat; fi
}

# Copy <in> to <res> minus every row whose first tab field git reports IGNORED. ONE helper for
# both sites that build a path set NOW -- the manifest and the orphan universe -- because they
# must agree or a path dropped from one reads as changed in the other. `check-ignore` in its
# default mode never reports a TRACKED file, so a force-added file that matches an ignore
# pattern stays in; a `.gitignore` grep would drop it. That holds only while the file is STILL
# tracked, which is why a verified RECORD is never passed here, stamped or not: once `git rm`'d
# such a file is untracked and ignored, and filtering the record would erase its vanish.
# Exit 1 means "nothing
# ignored". Any other exit fails CLOSED: <res> is emptied and the caller runs everything.
# A PATH INSIDE A SUBMODULE IS NEVER ASKED, because one such path makes `check-ignore` die with
# 128 ("Pathspec ... is in submodule") and that would fail closed on EVERY push. Measured on the
# reference consumer: 397 of its 21034 map paths sit under its one gitlink. They are kept --
# the superproject's ignore rules do not reach inside a submodule.
readset_drop_ignored() { # <in> <res>
  local in="$1" res="$2" ci_rc
  git -c core.quotePath=false ls-files -s 2>/dev/null \
    | awk '$1 == "160000" { sub(/^[^\t]*\t/, ""); print }' > "$res.gl"
  cut -f1 "$in" | awk -v gl="$res.gl" 'BEGIN { while ((getline l < gl) > 0) g[++n] = l "/" }
    { for (i = 1; i <= n; i++) if (index($0, g[i]) == 1) next; print }' > "$res.q"
  git -c core.quotePath=false check-ignore --stdin < "$res.q" > "$res.ign" 2>/dev/null
  ci_rc=$?
  if [ "$ci_rc" -ne 0 ] && [ "$ci_rc" -ne 1 ]; then : > "$res"; return 1; fi
  awk -F'\t' -v ign="$res.ign" 'BEGIN { while ((getline l < ign) > 0) drop[l] = 1 }
                                !($1 in drop)' "$in" > "$res"
}

readset_manifest() {
  local out="$1" hash_rc ign_rc
  # UNTRACKED-BUT-UNIGNORED FILES ARE IN THE UNIVERSE, AND THE WHOLE-SUITE SKIP BELOW IS WHY.
  # `git ls-files` alone answers about the COMMITTED tree, which is the right population for
  # "what am I pushing" and the wrong one for "what will a fixture read": a fixture reads the
  # WORKING tree, and an untracked file there is one a trace never saw and no read-set names.
  # Without this line `.changed` could be empty while an unignored file sat beside a fixture's
  # subject, and the no-change branch would skip the suite over a tree nobody hashed.
  # Git-ignored paths stay out, for the reason the content key states about the same set:
  # hooks and fixtures WRITE INTO them while the suite runs, so a universe covering them would
  # differ from itself across the very run it is keyed on.
  # THE MAP ARM USED TO BYPASS THAT, and it is dropped here from EVERY source. `--exclude-standard`
  # filters only the untracked listing; a map row naming an ignored file was hashed whenever the
  # file existed. Measured: a trace run in the main checkout recorded three ignored `.DS_Store`
  # files, a green run there wrote them into the verified record in the SHARED git dir, and a
  # push from a worktree without them saw them VANISH -- their parents, `core` among them, joined
  # `.match`, and 11 changed paths selected 226 of 232 fixtures where their own rows select 55.
  #
  # A MANIFEST THAT HASHED LESS THAN IT LISTED IS EMPTIED, so the guard in apply_readset_skip
  # runs everything. `xargs` without `-0` stops at the first apostrophe in a filename and the
  # files after it were never hashed -- measured on the reference consumer, 9600 of 12561, so an
  # edit to any later path read as "nothing changed" and skipped the whole suite. A name git
  # still has to quote (tab, newline, `"` or `\`) cannot be hashed by its listed spelling, and
  # an unreadable file fails shasum; both empty it too, so such a file runs the whole suite on
  # every push until it is renamed or made readable. `--` ends shasum's options, so a top-level
  # name beginning with `-` is hashed as a file rather than refused as an option.
  { git -c core.quotePath=false ls-files 2>/dev/null
    git -c core.quotePath=false ls-files --others --exclude-standard 2>/dev/null
    readset_rows "$out" paths
  } | grep -v '^\.git/' | grep -v '^\.git$' | readset_drop_excluded | sort -u > "$out/.paths.all"
  readset_drop_ignored "$out/.paths.all" "$out/.paths"; ign_rc=$?
  while IFS= read -r p; do [ -f "$p" ] && printf '%s\n' "$p"; done < "$out/.paths" > "$out/.files"
  tr '\n' '\000' < "$out/.files" | xargs -0 -n 200 shasum -a 256 -- > "$out/.sums" 2>/dev/null
  hash_rc=$?
  awk '{ path = $0; sub(/^[0-9a-f]+  /, "", path); print path "\t" $1 }' "$out/.sums" | sort > "$out/.now"
  if [ "$hash_rc" -ne 0 ] || [ "$ign_rc" -ne 0 ] || grep -q '^"' "$out/.paths" \
     || [ "$(wc -l < "$out/.now")" -ne "$(wc -l < "$out/.files")" ]; then
    : > "$out/.now"
  fi
}

# The deriver lands under a different parent on each side (install.sh copies core/scripts/<x>
# to scripts/ai-dlc/<x>), so both are probed and neither is assumed. Consumer layout first,
# the order every two-layout resolver here uses. Prints nothing when neither exists.
readset_deriver_path() {
  local c
  for c in scripts/ai-dlc/derive-fixture-readsets.sh core/scripts/derive-fixture-readsets.sh; do
    [ -f "$c" ] && { printf '%s' "$c"; return 0; }
  done
  return 0
}

# THE LOCAL MAP. After a GREEN suite this hook starts one detached, unprivileged trace of the
# fixtures that have no committed row and no valid local row (readset_live_trace, below), and the
# deriver records each clean trace here, under the git dir, never in the tree. `AI_DLC_READSET_LIVE_TRACE=0`
# turns the trace off; the rows already recorded are still read.
READSET_LOCAL="$GITDIR/ai-dlc-fixture-readsets.local"

# ONE HELPER EMITS THE MERGED ROW SET, AND EVERY SITE THAT READ THE COMMITTED MAP CALLS IT. A missed
# site turns a local-only path into an orphan and forces the full suite, or leaves a locally-mapped
# fixture "unmapped" on one side of a join and mapped on the other.
#   paths  committed paths plus EVERY local candidate path -- the manifest's universe. Validity is
#          NOT applied here: the manifest is what validity is computed FROM.
#   rows   `<fx>\t<path>` for selection. A fixture with VALID local rows (`$out/.local.valid`)
#          uses only those; every other fixture uses its committed rows.
# The local rows are read FIRST, so the committed rows of a locally-traced fixture are dropped.
readset_rows() { # <out> <paths|rows>
  local out="$1" mode="$2"
  { if [ "$mode" = rows ]; then [ -s "$out/.local.valid" ] && sed 's/^/V	/' "$out/.local.valid"
    else [ -s "$READSET_LOCAL" ] && sed 's/^/L	/' "$READSET_LOCAL"; fi
    [ -s "$READSET_MAP" ] && grep -v '^#' "$READSET_MAP" | sed 's/^/C	/'
    :
  } | awk -F'\t' -v mode="$mode" '
    $1 == "V" { loc[$2] = 1; print $2 "\t" $3; next }
    $1 == "L" { if (substr($3, 1, 1) != "#") print $3; next }
    $1 == "C" { if (mode != "rows") print $3; else print $2 "\t" $3 }'
}

# A LOCAL ROW SET IS VALID ONLY WHILE EVERY PATH IT RECORDED HASHES AS IT DID IN THE TRACE COPY, AND
# THE DERIVER IS THE ONE THAT TRACED IT. Read off THIS run's `$out/.now`, so a set whose input moved
# is ignored on the very push that moved it: the fixture is unmapped, runs, and is re-traced. A path
# outside the manifest's universe (`.git/**`, the content key's excluded tops, an ignored path) is
# not compared -- no change there can reach `.changed` either, for committed rows or local ones. A
# `-` hash (a directory or an absent name) stays valid while no FILE of that name exists.
# Writes `$out/.local.valid` (`<fx>\t<path>`), `$out/.trace` (the dispatch-list fixtures with no
# committed row and no valid local row) and `$out/.trace.held` (those of them discarded three times
# in a row on their current key, which are not re-traced until the key changes).
readset_local_validate() { # <list> <out>
  local list="$1" out="$2" dv dsha="" rc_map="$READSET_MAP" rl_loc="$READSET_LOCAL" d b k
  : > "$out/.local.valid"; : > "$out/.trace"; : > "$out/.trace.held"
  dv="$(readset_deriver_path)"
  [ -n "$dv" ] && dsha="$(shasum -a 256 -- "$dv" 2>/dev/null | cut -d' ' -f1)"
  [ -s "$rc_map" ] || rc_map=/dev/null
  [ -s "$rl_loc" ] || rl_loc=/dev/null
  if [ -n "$dsha" ] && [ -s "$out/.now" ] && [ "$rl_loc" != /dev/null ]; then
    RL_C="$rc_map" RL_P="$out/.paths" RL_N="$out/.now" awk -F'\t' -v dsha="$dsha" '
      FILENAME == ENVIRON["RL_C"] { if ($0 !~ /^#/) com[$1] = 1; next }
      FILENAME == ENVIRON["RL_P"] { inu[$0] = 1; next }
      FILENAME == ENVIRON["RL_N"] { now[$1] = $2; next }
      $2 == "#deriver" { dok[$1] = ($3 == dsha); next }
      substr($2, 1, 1) == "#" { next }
      { f = $1; seen[f] = 1; rows[f] = rows[f] $2 "\n"
        if ($2 in inu) {
          if ($3 == "-") { if ($2 in now) bad[f] = 1 }
          else if (!(($2 in now) && now[$2] == $3)) bad[f] = 1
        } }
      END { for (f in seen) if ((f in dok) && dok[f] && !(f in bad)) {
              n = split(rows[f], r, "\n"); for (i = 1; i < n; i++) print f "\t" r[i] } }' \
      "$rc_map" "$out/.paths" "$out/.now" "$rl_loc" | sort -u > "$out/.local.valid"
  fi
  readset_rows "$out" rows | cut -f1 | sort -u > "$out/.mapped.all"
  while IFS= read -r d; do
    b="${d%/}"; b="${b##*/}"
    grep -qxF "$b" "$out/.mapped.all" && continue
    readset_trace_add "$out" "$b" "$dsha"
  done < "$list"
}

# Queue <fixture> for the post-green trace, or hold it when its last three traces were discarded on
# the current run.sh and deriver. Unmapped fixtures come here from readset_local_validate, stale
# ones from apply_readset_skip.
readset_trace_add() { # <out> <fixture> <deriver sha>
  local k rl="$READSET_LOCAL"
  [ -s "$rl" ] || rl=/dev/null
  k="$(awk -F'\t' -v p="${FXROOT}$2/run.sh" '$1 == p { print $2 }' "$1/.now")"
  if awk -F'\t' -v f="$2" -v k="${k:--}:$3" '$1 == f && $2 == "#discards" && $3 >= 3 && $4 == k { h = 1 } END { exit !h }' "$rl"; then
    printf '%s\n' "$2" >> "$1/.trace.held"
  else
    printf '%s\n' "$2" >> "$1/.trace"
  fi
}

# THE START TIME OF A PID, ONE NORMALISED STRING, for the live-trace lock. The writer and the reader
# both call this, so the two sides cannot disagree on locale, zone or column padding: `ps` runs
# under LC_ALL=C TZ=UTC0 and its words are re-joined by single spaces. Prints nothing and returns 1
# when `ps` fails or prints nothing (no such pid, or no usable `ps`).
readset_pid_start() { # <pid>
  local x
  x="$(LC_ALL=C TZ=UTC0 ps -o lstart= -p "$1" 2>/dev/null)" || return 1
  set -- $x
  [ -n "$*" ] || return 1
  printf '%s' "$*"
}

# IS THE LIVE-TRACE LOCK STALE? `$lk/pid` is line 1 `<pid> <epoch>` (the only line an older hook
# writes or reads) and line 2 the start time of that pid as readset_pid_start printed it when the
# lock was taken. The pid is the detached trace subshell's `$!`, never `$$`. Decided in this order:
#   (1) a malformed pid or epoch                                   -> stale
#   (2) `kill -0` on the pid fails                                 -> stale
#   (3) the epoch is more than 6h old                              -> stale
#   (4) no start line (a lock taken by an older hook)              -> held, judged as before
#   (5) the pid's start time cannot be read now                    -> held, and it says so
#   (6) the pid's start time differs from the recorded one         -> stale (the pid was reused)
#   otherwise                                                      -> held
# (5) is reached only after `kill -0` succeeded, so an empty `ps` there is a `ps` failure or a pid
# that died in the gap. HELD with the announcement is right for both and the next push re-judges;
# do not turn it into stale, because a false stale lets two traces run at once. A lock dir with no
# pid file is stale once older than 60s (a launcher killed between `mkdir` and writing the pid).
# Never a process-table grep: `kill -0` on the recorded pid is the liveness test.
readset_lock_stale() { # <lock dir>
  local lk="$1" p="" e="" now
  local s="" c=""
  if [ -f "$lk/pid" ]; then
    { read -r p e; read -r s; } < "$lk/pid" 2>/dev/null
    case "$p" in ''|*[!0-9]*) return 0 ;; esac
    case "$e" in ''|*[!0-9]*) return 0 ;; esac
    kill -0 "$p" 2>/dev/null || return 0
    now="$(date +%s)"
    [ $(( now - e )) -gt 21600 ] && return 0
    set -- $s; s="$*"
    [ -n "$s" ] || return 1
    if ! c="$(readset_pid_start "$p")"; then
      printf '   ..    read-set live trace: could not read the start time of lock pid %s (ps failed or printed nothing) -- the lock is judged HELD on pid and age alone\n' "$p"
      return 1
    fi
    [ "$c" != "$s" ] && return 0
    return 1
  fi
  [ -n "$(find "$lk" -maxdepth 0 -mmin +1 2>/dev/null)" ] && return 0
  return 1
}

# AFTER A GREEN SUITE, START ONE DETACHED TRACE OF THE UNMAPPED FIXTURES THAT RAN. The push is never
# delayed: every descriptor goes to a log under the git dir, so git has nothing to wait on, and the
# durations, the pole and the verified record were all written before this runs and are never
# touched by it. A fixture's normal-run output is stashed beside the local map first, because the
# deriver discards a trace whose verdict lines differ from the run that passed. Under a NON-blocking
# lock: if another trace holds it this push starts none and says so. Every precondition that fails
# is ONE line naming it, and the fixtures stay unmapped -- the behaviour before this existed.
readset_live_trace() { # <out>
  local out="$1" b names="" n=0 dv why="" lk tr logf tp
  [ "${AI_DLC_READSET_LIVE_TRACE:-1}" = 0 ] && return 0
  if [ -s "$out/.trace.held" ]; then
    printf '   ..    read-set live trace: NOT re-tracing %s -- discarded 3 times in a row on the same run.sh and deriver; unmapped until one of them changes (see %s.log)\n' \
      "$(tr '\n' ' ' < "$out/.trace.held" | sed 's/ $//')" "$READSET_LOCAL"
  fi
  [ -s "$out/.trace" ] || return 0
  while IFS= read -r b; do
    [ -n "$b" ] && [ "$(cat "$out/$b" 2>/dev/null)" = ok ] || continue
    names="${names}${names:+ }$b"; n=$((n + 1))
  done < "$out/.trace"
  [ "$n" -gt 0 ] || return 0
  dv="$(readset_deriver_path)"
  [ -n "$dv" ] || why="no derive-fixture-readsets.sh in either layout"
  command -v sandbox-exec >/dev/null 2>&1 || why="${why:+$why; }no sandbox-exec"
  [ -x /usr/bin/log ] || why="${why:+$why; }no /usr/bin/log"
  command -v python3 >/dev/null 2>&1 || why="${why:+$why; }no python3"
  [ "$(git rev-parse --git-dir 2>/dev/null)" = "$(git rev-parse --git-common-dir 2>/dev/null)" ] \
    || why="${why:+$why; }a linked worktree (the deriver traces only the main checkout)"
  if [ -n "$why" ]; then
    printf '   ..    read-set live trace: skipped (%s); %s fixture(s) stay unmapped: %s\n' "$why" "$n" "$names"
    return 0
  fi
  lk="$READSET_LOCAL.lock"
  if ! mkdir "$lk" 2>/dev/null; then
    if readset_lock_stale "$lk"; then rm -f "$lk/pid"; rmdir "$lk" 2>/dev/null; fi
    if ! mkdir "$lk" 2>/dev/null; then
      printf '   ..    read-set live trace: another trace holds %s -- none started; %s fixture(s) stay unmapped this push\n' "$lk" "$n"
      return 0
    fi
  fi
  mkdir -p "$READSET_LOCAL.logs" 2>/dev/null
  for b in $names; do cp "$out/.log/$b" "$READSET_LOCAL.logs/$b" 2>/dev/null; done
  tr="${TMPDIR:-/tmp}"; tr="${tr%/}/ai-dlc-readset-live.$$"
  logf="$READSET_LOCAL.log"
  ( trap '' HUP
    AI_DLC_READSET_TRACE_ROOT="$tr" bash "$dv" --list "$names" --tracer sandbox --local-map "$READSET_LOCAL"
    rm -f "$lk/pid"; rmdir "$lk" 2>/dev/null || { sleep 1; rm -f "$lk/pid"; rmdir "$lk" 2>/dev/null; }
  ) </dev/null >"$logf" 2>&1 &
  tp="$!"
  printf '%s %s\n%s\n' "$tp" "$(date +%s)" "$(readset_pid_start "$tp")" > "$lk/pid" 2>/dev/null
  printf '   ..    read-set live trace: started detached for %s unmapped fixture(s) (%s) -> %s\n' "$n" "$names" "$logf"
  return 0
}

# THE TOOLS, KEYED PER FIXTURE. One pass over the manifest's `.sh` files writes `<out>/.ftools`
# (`<file>\t<tool path>`): every word of a non-comment line that names a command on $PATH, the first hit
# on $PATH winning. Derived that way, never hand-listed. `<out>/.tools` is `<tool path>\t<sha256>` for
# every tool named anywhere. F's tool keys are the tools its keyed files name, so a changed binary reruns
# only the fixtures whose files name it. Keyed on the binary's CONTENT: nothing is EXECUTED to read a
# version, because the derived name set includes commands such as `halt`, `yes` and `passwd`.
readset_tools() { # <out>
  local out="$1"
  ( IFS=:; for p in $PATH; do
      [ -d "$p" ] && ls -1 "$p" 2>/dev/null | awk -v d="$p" '{ print d "\t" $0 }'
    done ) > "$out/.pathcmds"
  grep '\.sh$' "$out/.files" | tr '\n' '\000' | RT_CMDS="$out/.pathcmds" xargs -0 awk '
    BEGIN { while ((getline l < ENVIRON["RT_CMDS"]) > 0) { t = index(l, "\t"); n = substr(l, t + 1); if (!(n in cmd)) cmd[n] = substr(l, 1, t - 1) "/" n } }
    FNR == 1 { delete seen }
    /^[[:space:]]*#/ { next }
    { n = split($0, w, /[^A-Za-z0-9_.+-]+/)
      for (i = 1; i <= n; i++) if ((w[i] in cmd) && !(w[i] in seen)) { seen[w[i]] = 1; print FILENAME "\t" cmd[w[i]] } }' \
    > "$out/.ftools" 2>/dev/null
  cut -f2 "$out/.ftools" | LC_ALL=C sort -u | tr '\n' '\000' | xargs -0 shasum -a 256 -- 2>/dev/null \
    | awk '{ p = $0; sub(/^[0-9a-f]+  /, "", p); print p "\t" $1 }' > "$out/.tools"
}

# `<dir>/\t#listing:<sha256>` for every directory a path list implies, derived from the list alone and
# never from readdir. A listing is the directory's immediate entry names, C-sorted, one per line.
readset_listings() { # <path list> <out file>
  local w="$2.d"
  mkdir -p "$w" || { : > "$2"; return 1; }
  awk '{ p = $0; while ((i = match(p, /\/[^\/]*$/)) > 0) { d = substr(p, 1, i - 1); print d "\t" substr(p, i + 1); p = d } }' "$1" \
    | LC_ALL=C sort -u | awk -F'\t' -v w="$w" '
      $1 != d { if (f != "") close(f); d = $1; n++; f = w "/" n; print n "\t" d "/" > (w "/.idx") }
      { print $2 > f }'
  find "$w" -type f ! -name .idx -print0 | xargs -0 shasum -a 256 -- 2>/dev/null \
    | awk -v idx="$w/.idx" 'BEGIN { while ((getline l < idx) > 0) { t = index(l, "\t"); d[substr(l, 1, t - 1)] = substr(l, t + 1) } }
      { n = $0; sub(/^[0-9a-f]+  /, "", n); sub(/.*\//, "", n); if (n in d) print d[n] "\t#listing:" $1 }' > "$2"
}

# THE RECORD, `$KEYS_DIR/<fx>.key`: `#format k1`, `#state ok|stale|seeded`, `#tools per-fixture`
# (a constant; the tools are rows), then one row per key, C-sorted: `<path>\t<sha256>` for a file,
# `<path>\t-` for an absent name, `<dir>/\t#listing:<sha256>` for a directory listing, and
# `<tool path>\t<sha256>` for a tool (an absolute path). A changed tool row reruns F as `tools
# changed` and never stales it.
#
# DECIDE EVERY FIXTURE IN <list> FROM ITS KEY RECORD. Writes `<out>/.kdec`, one line per fixture:
# `<fx>\trun\t<reason>\t<k|u|s>\t<new state>` or `<fx>\tskip\t\t\t<state>`, and the prospective record
# of every fixture that runs (or that a seed skips) to `<out>/.k/<fx>`. The record holds the PRE-RUN
# hashes; run_fixtures publishes it only for a fixture that passed.
#
# THE SEED: no `$KEYS_DIR` yet and a `v2` verified record present. That record is a copy of the
# pre-run `.now` of a suite every fixture passed on, so each fixture's record is the projection of it
# onto K(F) -- listings from its path set, a path it lacks as `-`, its tools as they are now, state
# `seeded`. Once the directory exists the seed never runs again, and a missing record is `unrecorded`.
#
# A LISTING MOVED, AND WHICH ENTRIES ARE NEW. The record holds only a listing's hash, so the old entry
# set is taken from a path list whose listing hash EQUALS the recorded one -- the previous run's `.now`
# (`$KEYS_DIR/.prev`) or the verified record. Every file and directory under a new entry is added to
# the record, which stays `ok`; with no matching list the record goes `stale`. A change to a key added
# that way reruns the fixture and stales it, so a new script's own reads are traced; a key K(F) gained
# (a trace landed or the map moved), which reruns it once to record the key. An `ok` record's keys
# are carried into the next one while it has any listing key, so a key added that way is not dropped
# when the fixture next runs for another reason; a whole-tree record has no listing key, so an
# unmapped fixture that gains a trace sheds it.
readset_keys() { # <list> <out>
  local list="$1" out="$2" seed=0 v2=/dev/null lp=/dev/null lv=/dev/null pp=/dev/null pv=/dev/null tab
  tab="$(printf '\t')"
  mkdir -p "$out/.k" || return 1
  readset_tools "$out"
  cut -f1 "$out/.now" > "$out/.is"
  readset_listings "$out/.is" "$out/.ls.now"
  if [ -s "$VERIFIED_RECORD" ] && [ "$(cat "$VERIFIED_FORMAT" 2>/dev/null)" = v2 ]; then
    v2="$VERIFIED_RECORD"; cut -f1 "$v2" > "$out/.pv"; pv="$out/.pv"
    readset_listings "$pv" "$out/.ls.v2"; lv="$out/.ls.v2"
    [ -d "$KEYS_DIR" ] || seed=1
  fi
  if [ -s "$KEYS_DIR/.prev" ]; then
    cut -f1 "$KEYS_DIR/.prev" > "$out/.pp"; pp="$out/.pp"
    readset_listings "$pp" "$out/.ls.prev"; lp="$out/.ls.prev"
  fi
  readset_rows "$out" rows | awk -F'\t' -v u="$out/.paths" 'BEGIN { while ((getline l < u) > 0) in_u[l] = 1 } ($2 in in_u)' > "$out/.krows"
  : > "$out/.krecs"
  if [ "$seed" = 0 ]; then
    awk 'FNR == 1 { ok = ($0 == "#format k1"); f = FILENAME; sub(/.*\//, "", f); sub(/\.key$/, "", f); next }
         !ok { next }
         /^#state / { print f "\t#state\t" substr($0, 8); next }
         /^#/ { next }
         { print f "\t" $0 }' "$KEYS_DIR"/*.key > "$out/.krecs" 2>/dev/null
  fi
  while IFS= read -r d; do b="${d%/}"; printf '%s\n' "${b##*/}"; done < "$list" > "$out/.kl"
  : > "$out/.khdr"; : > "$out/.kout"
  KN="$out/.now" KLN="$out/.ls.now" KLP="$lp" KLV="$lv" KPP="$pp" KPV="$pv" KV2="$v2" KR="$out/.krows" \
  KM="$out/.mapped.all" KLOC="$out/.local.valid" KC="$out/.krecs" KF="$out/.kl" KH="$out/.khdr" KO="$out/.kout" \
  KT="$out/.tools" KFT="$out/.ftools" awk -v seed="$seed" -v root="$FXROOT" '
    function rd(file, arr,   l, t) { while ((getline l < file) > 0) { t = index(l, "\t"); arr[substr(l, 1, t - 1)] = substr(l, t + 1) } }
    function kids(file, set,   l, t, p, i) { while ((getline l < file) > 0) { t = index(l, "\t"); p = (t ? substr(l, 1, t - 1) : l)
        while ((i = match(p, /\/[^\/]*$/)) > 0) { set[substr(p, 1, i - 1) SUBSEP substr(p, i + 1)] = 1; p = substr(p, 1, i - 1) } } }
    function cur(k) { if (substr(k, 1, 1) == "/") return (k in TV) ? TV[k] : "-"
      return (k ~ /\/$/) ? ((k in LN) ? LN[k] : "-") : ((k in NV) ? NV[k] : "-") }
    function sv(k) { if (substr(k, 1, 1) == "/") return cur(k)
      return (k ~ /\/$/) ? ((k in LV) ? LV[k] : "-") : ((k in VV) ? VV[k] : "-") }
    function addk(p) { if (p in NV) K[p] = 1; else if (p in DN) K[p "/"] = 1; else K[p] = 1 }
    function subtree(q,   p, r, i) {
      if (q in NV) X[q] = 1
      if (!(q in DN)) return
      X[q "/"] = 1
      for (p in NV) if (index(p, q "/") == 1) { X[p] = 1; r = substr(p, length(q) + 2)
        while ((i = match(r, /\/[^\/]*$/)) > 0) { r = substr(r, 1, i - 1); X[q "/" r "/"] = 1 } } }
    function grow(k,   d, rv, src, n, a, j) {
      d = substr(k, 1, length(k) - 1); rv = R[k]
      if (!(d in DN)) return 1
      if (rv == "-") src = ""
      else if ((k in LP) && LP[k] == rv) src = "P"
      else if ((k in LV) && LV[k] == rv) src = "V"
      else return 0
      n = split(KIDS[d], a, "\n")
      for (j = 2; j <= n; j++) {
        if (src == "P" && ((d SUBSEP a[j]) in CP)) continue
        if (src == "V" && ((d SUBSEP a[j]) in CV)) continue
        subtree(d "/" a[j]) }
      return 1 }
    BEGIN {
      rd(ENVIRON["KN"], NV); rd(ENVIRON["KLN"], LN); rd(ENVIRON["KLP"], LP); rd(ENVIRON["KLV"], LV)
      kids(ENVIRON["KPP"], CP); kids(ENVIRON["KPV"], CV)
      if (seed) rd(ENVIRON["KV2"], VV)
      rd(ENVIRON["KT"], TV)
      while ((getline l < ENVIRON["KFT"]) > 0) { t = index(l, "\t"); f = substr(l, 1, t - 1); FT[f] = FT[f] "\n" substr(l, t + 1) }
      for (p in NV) { q = p
        while ((i = match(q, /\/[^\/]*$/)) > 0) { d = substr(q, 1, i - 1); e = substr(q, i + 1)
          DN[d] = 1; if (!((d SUBSEP e) in CN)) { CN[d SUBSEP e] = 1; KIDS[d] = KIDS[d] "\n" e }; q = d }
        if (index(p, root) == 1) { r = substr(p, length(root) + 1); i = index(r, "/"); if (i > 1) OWN[substr(r, 1, i - 1)] = OWN[substr(r, 1, i - 1)] "\n" p } }
      while ((getline l < ENVIRON["KM"]) > 0) MAPPED[l] = 1
      while ((getline l < ENVIRON["KLOC"]) > 0) { t = index(l, "\t"); LOC[substr(l, 1, t - 1)] = 1 }
      while ((getline l < ENVIRON["KR"]) > 0) { t = index(l, "\t"); f = substr(l, 1, t - 1); ROWS[f] = ROWS[f] "\n" substr(l, t + 1) }
      while ((getline l < ENVIRON["KC"]) > 0) { n = split(l, a, "\t")
        if (a[2] == "#state") RST[a[1]] = a[3]
        else if (a[2] == "#tools") RTL[a[1]] = a[3]
        else { RK[a[1]] = RK[a[1]] "\n" a[2]; RV[a[1] SUBSEP a[2]] = a[3] } }
      while ((getline f < ENVIRON["KF"]) > 0) {
        delete K; delete R; delete X; delete LM
        um = !(f in MAPPED)
        if (um) { for (p in NV) K[p] = 1 }
        else { n = split(ROWS[f], a, "\n"); for (j = 2; j <= n; j++) addk(a[j])
               n = split(OWN[f], a, "\n"); for (j = 2; j <= n; j++) K[a[j]] = 1 }
        delete TK
        for (k in K) if (k in FT) { n = split(FT[k], a, "\n"); for (j = 2; j <= n; j++) TK[a[j]] = 1 }
        for (k in TK) K[k] = 1
        has = 0; st = ""; rl = 0
        # A SEEDED WHOLE-TREE KEY ALSO COMPARES EVERY v2 PATH: one deleted since v2 is not in K.
        if (seed) { has = 1; st = "seeded"; for (k in K) R[k] = sv(k); if (um) for (p in VV) if (!(p in R)) R[p] = VV[p] }
        else if (f in RST) { has = 1; st = RST[f]
          n = split(RK[f], a, "\n"); for (j = 2; j <= n; j++) R[a[j]] = RV[f SUBSEP a[j]] }
        first = ""; fch = 0; tch = 0
        if (has) {
          for (k in R) { if (k ~ /\/$/) rl = 1
            if (cur(k) == R[k]) continue
            if (substr(k, 1, 1) == "/") { tch = 1; continue }
            if (first == "" || k < first) first = k; if (k ~ /\/$/) LM[k] = 1; else fch = 1 }
          for (k in K) if (!(k in R)) { if (substr(k, 1, 1) == "/") tch = 1; else if (first == "" || k < first) first = k } }
        run = 1; why = ""; c = ""
        if (!has) { why = "unrecorded"; c = "u" }
        else if (st == "stale") { why = "stale"; c = "s" }
        else if (tch) { why = "tools changed"; c = "k" }
        else if (first != "") { why = um ? "unmapped: closure changed" : "changed " first; c = "k" }
        else run = 0
        if (!run) { if (!seed) { print f "\tskip\t\t\t" st; continue }; ns = "seeded" }
        else if (!has || um) ns = "ok"
        else if (st == "stale") ns = ((f in LOC) ? "ok" : "stale")
        else if (fch) ns = "stale"
        else { ns = "ok"; if (rl) for (k in R) X[k] = 1
               for (k in LM) if (!grow(k)) ns = "stale" }
        for (k in K) X[k] = 1
        print f "\t" ns > ENVIRON["KH"]
        for (k in X) print f "\t" k "\t" cur(k) > ENVIRON["KO"]
        print f "\t" (run ? "run" : "skip") "\t" why "\t" c "\t" ns }
    }' > "$out/.kdec"
  LC_ALL=C sort -t "$tab" -k1,1 -k2 "$out/.kout" | awk -F'\t' -v kd="$out/.k" -v hdr="$out/.khdr" '
    BEGIN { while ((getline l < hdr) > 0) { t = index(l, "\t"); st[substr(l, 1, t - 1)] = substr(l, t + 1) } }
    $1 != f { if (f != "") close(o); f = $1; o = kd "/" f; print "#format k1" > o; print "#state " st[f] > o; print "#tools per-fixture" > o }
    { print substr($0, length(f) + 2) > o }'
}

# PUBLISH EACH PROSPECTIVE RECORD WHOSE FIXTURE PASSED, whatever its neighbours did, and every record a
# seed skipped. A FAIL, a kill or a missing verdict publishes nothing. temp + mv per record. The pre-run
# `.now` is kept as `$KEYS_DIR/.prev`, the path list the next run derives a moved listing's old entries
# from; it is only ever read after its listing hash matches the record's, so a red run may write it.
readset_keys_write() { # <out>
  local out="$1" f b
  [ -d "$out/.k" ] || return 0
  mkdir -p "$KEYS_DIR" 2>/dev/null || return 0
  for f in "$out/.k"/*; do
    [ -f "$f" ] || continue
    b="${f##*/}"
    if [ "$(cat "$out/$b" 2>/dev/null)" = ok ] || grep -qxF "$b" "$out/.k.always" 2>/dev/null; then
      cp "$f" "$KEYS_DIR/$b.key.tmp.$$" 2>/dev/null && mv "$KEYS_DIR/$b.key.tmp.$$" "$KEYS_DIR/$b.key" 2>/dev/null
    fi
  done
  if [ -s "$out/.now" ]; then
    cp "$out/.now" "$KEYS_DIR/.prev.tmp.$$" 2>/dev/null && mv "$KEYS_DIR/.prev.tmp.$$" "$KEYS_DIR/.prev" 2>/dev/null
  fi
  return 0
}

apply_readset_skip() {
  local list="$1" out="$2" n_all n_sel readset_at readset_age n_unmapped unmapped_names readset_deriver dv dsha="" b

  n_all="$(grep -c . "$list" 2>/dev/null)"; case "$n_all" in ''|*[!0-9]*) n_all=0 ;; esac

  # THE MANIFEST IS BUILT FIRST, BEFORE ANY EARLY RETURN: it is the pre-run state every record
  # this run publishes is keyed on.
  readset_manifest "$out"
  readset_local_validate "$list" "$out"

  # THE MAP DECAYS SILENTLY, AND THIS LINE IS THE ONLY THING THAT SAYS SO. A fixture directory
  # added after the last derivation has no entry and is keyed on the whole tree, so it runs on
  # almost every push -- correct, and the cost is invisible unless printed. The map's age and the
  # set it does not cover are printed on every run.
  if [ -s "$READSET_MAP" ] || [ -s "$out/.local.valid" ]; then
    readset_at="$(git log -1 --format=%h -- "$READSET_MAP" 2>/dev/null)"
    if [ -n "$readset_at" ]; then
      readset_age="$(git rev-list --count "${readset_at}..HEAD" 2>/dev/null)"
      case "$readset_age" in ''|*[!0-9]*) readset_age='?' ;; esac
      readset_age="derived at ${readset_at}, ${readset_age} commit(s) ago"
    else
      readset_age="UNTRACKED, age unknown"
    fi
    : > "$out/.unmapped"
    while IFS= read -r d; do
      b="${d%/}"; b="${b##*/}"
      grep -qxF "$b" "$out/.mapped.all" || printf '%s\n' "$b" >> "$out/.unmapped"
    done < "$list"
    n_unmapped="$(grep -c . "$out/.unmapped" 2>/dev/null)"; case "$n_unmapped" in ''|*[!0-9]*) n_unmapped=0 ;; esac
    printf '   ..    read-set map: %s; %s of %s fixture dir(s) UNMAPPED (keyed on the whole tree)' "$readset_age" "$n_unmapped" "$n_all"
    if [ "$n_unmapped" -gt 0 ]; then
      unmapped_names="$(tr '\n' ' ' < "$out/.unmapped" | sed 's/ $//')"
      printf ': %s' "$unmapped_names"
      readset_deriver="$(readset_deriver_path)"
      [ -n "$readset_deriver" ] && printf ' -- the next green push traces them automatically; by hand, with no sudo: bash %s --list "%s" --tracer sandbox' "$readset_deriver" "$unmapped_names"
    fi
    printf '\n'
  fi

  # THE ONLY RUN-ALL: the hashing instrument is broken, so no key can be read.
  [ -s "$out/.now" ] || { printf '   ..    could not hash the working tree -- running all %s\n' "$n_all"; return 0; }

  # A DECISION FILE SHORT OF THE LIST IS A BROKEN INSTRUMENT: an undecided fixture would read as skipped.
  if ! readset_keys "$list" "$out" || [ "$(grep -c . "$out/.kdec" 2>/dev/null)" != "$n_all" ]; then
    printf '   ..    could not build the fixture keys -- running all %s\n' "$n_all"; return 0
  fi
  awk -F'\t' '$2 == "skip" && $5 == "seeded" { print $1 }' "$out/.kdec" > "$out/.k.always"

  if [ "${AI_DLC_FIXTURE_NO_SKIP:-}" = "1" ]; then
    : > "$out/.k.always"
    printf '   ..    read-set skip OFF (AI_DLC_FIXTURE_NO_SKIP=1) -- running all %s\n' "$n_all"
    return 0
  fi

  awk -F'\t' 'NR == FNR { if ($2 == "run") r[$1] = 1; next }
              { b = $0; sub(/\/$/, "", b); sub(/.*\//, "", b) } (b in r)' "$out/.kdec" "$list" > "$out/.list.sel"
  n_sel="$(grep -c . "$out/.list.sel" 2>/dev/null)"; case "$n_sel" in ''|*[!0-9]*) n_sel=0 ;; esac
  printf '   ..    read-set keys: %s of %s fixture(s) run (%s changed, %s unrecorded, %s stale); skipping %s\n' \
    "$n_sel" "$n_all" "$(awk -F'\t' '$4 == "k"' "$out/.kdec" | grep -c .)" \
    "$(awk -F'\t' '$4 == "u"' "$out/.kdec" | grep -c .)" "$(awk -F'\t' '$4 == "s"' "$out/.kdec" | grep -c .)" \
    "$(( n_all - n_sel ))"
  awk -F'\t' '$2 == "run" && n < 10 { n++; print "   ..      " $1 ": " $3 }' "$out/.kdec"

  # A FIXTURE RECORDED STALE IS TRACED after a green run, beside the unmapped ones.
  dv="$(readset_deriver_path)"
  [ -n "$dv" ] && dsha="$(shasum -a 256 -- "$dv" 2>/dev/null | cut -d' ' -f1)"
  awk -F'\t' '$2 == "run" && $5 == "stale" { print $1 }' "$out/.kdec" | while IFS= read -r b; do
    grep -qxF "$b" "$out/.trace" "$out/.trace.held" 2>/dev/null || readset_trace_add "$out" "$b" "$dsha"
  done

  # An EMPTY dispatch list is not a skip: it falls through to the empty-suite FAIL in run_fixtures.
  if [ "$n_sel" -eq 0 ] && [ "$n_all" -gt 0 ]; then
    READSET_NO_CHANGE=1
    return 0
  fi
  mv "$out/.list.sel" "$list"
  return 0
}

run_fixtures() {
  local rc=0 d b out n_expected n_actual n_ordered verdict
  if [ "$POOL_DEPTH_IN" -ge 2 ]; then
    printf '   FAIL  fixture pool refused: nested at depth %s (PREPUSH_POOL_DEPTH=%s), a hook started by a hook started by a pool opens no pool\n' "$POOL_DEPTH_IN" "$POOL_DEPTH_IN"
    return 1
  fi
  if [ "$POOL_DEPTH_IN" -ge 1 ]; then printf '   nested: depth %s, width %s\n' "$POOL_DEPTH_IN" "$FIXTURE_JOBS"; fi
  out="$(mktemp -d)" || return 1
  # DOT-PREFIXED, and that is what makes the name collision-proof rather than
  # unlikely. Every verdict file in "$out" is named for a fixture, and the glob
  # below cannot match a directory whose name begins with a dot -- so no fixture
  # can ever be called `.dur` and land on top of this one. `.log` is the same shape and
  # gets its safety from the same dot.
  mkdir -p "$out/.dur" "$out/.log" || { rm -rf "$out"; return 1; }
  # TRUNCATE THE THIS-RUN RECORD HERE, at the first line that can only run because the pool is
  # entering. Every exit below this point -- the empty-suite guard, a red unit, a worker that
  # died -- then leaves an EMPTY file, and a reader that finds one knows no complete measurement
  # exists rather than reading a stale figure as this run's. `2>/dev/null` as every other write
  # in this block carries: a record that cannot be written must not print over the suite's own
  # output, and the publish below is what decides whether anything is there to read.
  : > "$LASTRUN_RECORD" 2>/dev/null

  for d in "$FXROOT"*/; do
    [ -f "$d/run.sh" ] || continue
    printf '%s\n' "$d"
  done > "$out/list"
  # `grep -c .` PRINTS 0 and EXITS 1 on an empty file, so the obvious
  # `$(grep -c . "$f" || echo 0)` yields the two-line string "0\n0" — and both
  # integer tests in this function then die with "integer expression expected",
  # take their false branch, and the suite returns 0 having run nothing. That is
  # how the empty-suite guard below shipped UNABLE TO FIRE: the line was present,
  # the mechanism was not, and a fixture driving the real hook is what found it.
  # Normalise to a bare integer instead of rescuing a failed exit status.
  # Reduce the list to what a change can affect BEFORE the count is taken, so `n_expected` and
  # the verdict-completeness assertion below both speak about the set actually dispatched. A
  # skip applied after the count would make every skipped fixture read as a dropped worker.
  READSET_NO_CHANGE=0
  apply_readset_skip "$out/list" "$out"

  # A WHOLE-SUITE SKIP CANNOT BE SIGNALLED BY AN EMPTY LIST, and the guard four lines down is
  # why: an empty list is a hard FAIL here, deliberately, because "an empty suite passes every
  # assertion it never made". So the no-change case is carried by its own flag and returns
  # before the count is taken, leaving the prior verified state and the prior key untouched --
  # nothing ran, so nothing new is blessed.
  if [ "${READSET_NO_CHANGE:-0}" = "1" ]; then
    SUITE_SKIPPED=1
    # A seed that skips every fixture still publishes its records, so it lands once.
    readset_keys_write "$out"
    rm -rf "$out"
    return 0
  fi

  n_expected="$(grep -c . "$out/list" 2>/dev/null)"
  case "$n_expected" in ''|*[!0-9]*) n_expected=0 ;; esac
  if [ "$n_expected" -eq 0 ]; then
    printf '   FAIL  no fixtures found -- an empty suite passes every assertion it never made\n'
    rm -rf "$out"; return 1
  fi

  # DISPATCH LONGEST-FIRST, FROM WHAT THE LAST RUN ACTUALLY COST.
  #
  # A pool's makespan is decided by when its longest unit STARTS. Dispatched in glob
  # order the poles are picked up wherever the alphabet puts them, and the tail is one
  # long unit finishing alone: measured on the reference consumer at width 16, its two
  # heaviest units sat at positions 62 and 63 of 109 and the pole began 5.5s in.
  # Longest-first started it at 0.0s and took the suite from a 30.83s median to 28.61s
  # over four alternating pairs whose two sets of readings do not overlap -- ~7%.
  #
  # AND IT IS NOT FREE, WHICH IS WHY THE ORDER IS NOT ALSO A CLAIM ABOUT SPEED. Running
  # the heavy units together makes each of them slower: the same measurement puts the
  # consumer's pole at 25.30s dispatched late against 28.46s dispatched first, so a 5.5s
  # head start bought 2.4s. On THIS repository's own suite that trade comes out level --
  # `enforcement-map-sites` alone is 144s of a 148s wall, so no dispatch order can win
  # more than 2.5% here and this one wins nothing measurable. The reorder ships for the
  # consumer's schedule shape, and the distribution carries it because I66 makes the two
  # runners one program. A `hoist the K longest, leave the rest alphabetical` variant was
  # measured too and lost to plain longest-first, so nothing here carries a tuning
  # constant that §7's gate item 3 would have to expire.
  #
  # THE RECORD IS WRITTEN BY THE PREVIOUS RUN AND LIVES UNDER .git, for I55 arm 4's
  # reason exactly: the content key hashes the working tree, so a cost record inside it
  # would change the key that decides whether this suite runs at all.
  #
  # THE FALLBACK IS THE LIST, and it is reached three ways -- no record yet (every first
  # run on a fresh clone), an unreadable one, and a reordering that did not come back
  # with exactly the units it was given. The last is the guard that matters: a reorder
  # which DROPS a unit reads exactly like a reorder that is fast. It cannot hide even if
  # this guard were removed, because `n_expected` and the report below are both taken
  # from "$out/list" and never from the dispatch order -- so a dropped unit still reaches
  # the reader, still finds no verdict, and still fails the push.
  cp "$out/list" "$out/.order"
  if [ -s "$DURATIONS_RECORD" ]; then
    awk 'NR==FNR { if (NF == 2) prev[$1] = $2; next }
         { b = $0; sub(/\/$/, "", b); sub(/.*\//, "", b)
           print ((b in prev) ? prev[b] : 999999) " " $0 }' \
        "$DURATIONS_RECORD" "$out/list" 2>/dev/null \
      | sort -k1,1nr | cut -d' ' -f2- > "$out/.order.lpt" 2>/dev/null
    n_ordered="$(grep -c . "$out/.order.lpt" 2>/dev/null)"
    case "$n_ordered" in ''|*[!0-9]*) n_ordered=0 ;; esac
    [ "$n_ordered" -eq "$n_expected" ] && mv "$out/.order.lpt" "$out/.order"
  fi

  # Each worker records its verdict to a file named for its fixture. The verdict is read
  # back from those FILES, not from xargs exit status, because that is what makes the
  # completeness assertion below possible -- and because `xargs` collapses any number of
  # failures into one exit code that cannot say WHICH.
  #
  # It records its own COST beside the verdict, in whole seconds off the worker shell's
  # own SECONDS -- no clock fork, and a unit never dispatched simply has no line, which
  # is the reading the ordering above wants anyway. A fixture the record has never seen
  # sorts FIRST: an unknown cost is treated as the largest, because the failure mode
  # worth avoiding is a new heavy unit dispatched last.
  PREPUSH_POOL_DEPTH="$((POOL_DEPTH_IN + 1))" AI_DLC_FX_OUT="$out" xargs -P "$FIXTURE_JOBS" -I{} bash -c '
    d="$1"; b="$(basename "$d")"
    if bash "$d/run.sh" > "$AI_DLC_FX_OUT/.log/$b" 2>&1; then printf ok   > "$AI_DLC_FX_OUT/$b"
    else                                      printf FAIL > "$AI_DLC_FX_OUT/$b"; fi
    printf "%s %s\n" "$b" "$SECONDS" > "$AI_DLC_FX_OUT/.dur/$b"
  ' _ {} < "$out/.order"

  # Rendered in list order, so the output is deterministic and diffable across runs even
  # though the work completed out of order.
  n_actual=0
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    b="$(basename "$d")"
    if [ ! -f "$out/$b" ]; then
      printf '   FAIL  %s  (no verdict recorded)\n' "$b"; rc=1; continue
    fi
    n_actual=$((n_actual + 1))
    verdict="$(cat "$out/$b")"
    if [ "$verdict" = ok ]; then printf '   ok    %s\n' "$b"
    else                        printf '   FAIL  %s\n' "$b"; rc=1; fi
  done < "$out/list"

  # THE CONTROL PARALLELISM MAKES NECESSARY. Serially, a fixture that never ran could not
  # print an `ok` -- the loop and the report were the same thing. With a worker pool they
  # are not: a dropped job produces no verdict file, and a suite reporting 70 greens
  # instead of 75 reads exactly like a suite that passed. This is the check-that-cannot-
  # fire class one layer out, so the count is asserted rather than assumed.
  #
  # WHICH OF THE TWO ARMS DOES THE DETECTING, measured rather than asserted, because
  # this comment used to imply the count was an independent detector and it is not.
  # The report walks the LIST, so a missing verdict is caught by the `[ ! -f ]` branch
  # above; `n_actual` is incremented on exactly the path that branch skips, so the
  # count below can only fire when that branch already has. Its contribution is
  # MAGNITUDE -- one line saying how much of the suite is missing, instead of N lines
  # each saying one fixture is. `consumer-suite-pool`'s M2b mutant is the measurement:
  # remove the per-fixture branch and a lost worker is misreported as a failing
  # fixture while this count stays silent.
  if [ "$n_actual" -ne "$n_expected" ]; then
    printf '   FAIL  %s of %s fixtures produced a verdict -- the pool dropped work, and a short green suite reads exactly like a passing one\n' \
      "$n_actual" "$n_expected"
    rc=1
  fi

  # Publish this run's costs for the next run to dispatch on. One `cat` for the whole
  # suite rather than a read per unit: §7 gate item 2 is that a fork per item is the
  # shape that makes a runner system-bound, and this runner is the thing that finding
  # came out of. A run that recorded nothing leaves the previous record alone rather
  # than replacing it with an empty file, which would silently cost the NEXT run its
  # ordering as well.
  #
  # IT MERGES, AND A WHOLE-FILE REPLACE HERE COST THE ORDERING EVERY TIME THE SKIP FIRED.
  # "$out/.dur/" holds a file only for a unit that was DISPATCHED, and the read-set skip
  # above narrows the dispatch list in place before the pool is fed. So a replace deleted
  # the cost of every SKIPPED unit, and those units then re-entered the next run at the
  # 999999 unknown slot, which sorts FIRST -- putting the real poles LAST, the exact
  # inversion of what the longest-first block exists to buy. Measured on this repo's own
  # record: full 150-unit run 506s, the same run after one selective run had clobbered
  # the record 573s, and a fresh clone with no record at all 671s.
  #
  # THE CONCATENATION ORDER IS THE MERGE RULE. Old record first, this run's costs second,
  # `c[$1] = $2` is last-wins -- so a dispatched unit's fresh cost overwrites its stale one
  # and a skipped unit keeps the one it had. `NF == 2` is the same predicate the reader
  # above uses, so writer and reader cannot disagree about the grammar.
  #
  # `NR==FNR` WAS THE OBVIOUS SPELLING AND IT IS WRONG: awk given a record file that does
  # not exist fails outright, and that is the fresh-clone case the old code handled
  # correctly. The `[ -s ]` guard inside the brace group degrades to "just this run's
  # costs", which is byte-for-byte the previous behaviour there.
  #
  # A GHOST KEY FOR A DELETED FIXTURE IS DELIBERATELY LEFT IN. It costs ~20 bytes under
  # .git, nothing reads a key with no unit, and `suite-dispatch-order` already feeds a
  # literal `ghost` line and asserts the suite still runs complete. Pruning against the
  # on-disk set would need a pre-skip copy of the list, i.e. another executable line in
  # this I66-joined region, to buy a defect nobody has measured.
  cat "$out"/.dur/* > "$out/.durations" 2>/dev/null
  if [ -s "$out/.durations" ]; then
    { [ -s "$DURATIONS_RECORD" ] && cat "$DURATIONS_RECORD"; cat "$out/.durations"; } 2>/dev/null \
      | awk 'NF == 2 { c[$1] = $2 } END { for (k in c) print k, c[k] }' \
      | sort > "$out/.merged"
    [ -s "$out/.merged" ] && cp "$out/.merged" "$DURATIONS_RECORD" 2>/dev/null
  fi

  # PUBLISH THE VERIFIED STATE ONLY ON A FULLY GREEN RUN, and that condition is the whole
  # safety of the skip. The record means "every fixture's verdict is known good at these file
  # contents". Writing it after a red run would mark the failing state as verified, and the
  # next push -- changing something else entirely -- would skip the fixture that is still
  # broken and report green.
  # The format stamp is written only AFTER the record copy succeeds, so a failed copy cannot
  # leave a `v2` stamp vouching for a record this run did not write. A copy that lands with no
  # stamp after it is an unstamped record, which the next run reads as "run everything".
  if [ "$rc" -eq 0 ] && [ -s "$out/.now" ]; then
    cp "$out/.now" "$VERIFIED_RECORD" 2>/dev/null && printf 'v2\n' > "$VERIFIED_FORMAT" 2>/dev/null
  fi
  # PER-FIXTURE KEY RECORDS ARE PUBLISHED ON A RED RUN TOO: each one is gated on its own verdict.
  readset_keys_write "$out"

  # PUBLISH THIS RUN'S UNMERGED COSTS UNDER THE SAME GREEN-ONLY GATE, and copy the PRE-MERGE
  # file: "$out/.durations" is exactly the units this pool timed, while "$out/.merged" one block
  # up has already been folded over the prior record and carries rows nothing here measured.
  # Gated on `rc` for the reason the line above is -- a red run's timings belong to a suite that
  # stopped early, and a reader comparing them to a full-suite figure reads "short" as "fast".
  if [ "$rc" -eq 0 ] && [ -s "$out/.durations" ]; then cp "$out/.durations" "$LASTRUN_RECORD" 2>/dev/null; fi

  # THE DETACHED TRACE STARTS ONLY HERE, after every record above is written and only on a GREEN
  # run: a trace measures reads, but a fixture whose normal run failed has no run to compare it to.
  if [ "$rc" -eq 0 ]; then readset_live_trace "$out"; fi

  # PUBLISH THE RED UNITS' CAPTURED OUTPUT BEFORE THE TEMP DIR GOES. Placed here, beside the
  # durations publish, for the same reason that one is here: it is the last point at which
  # "$out" still exists. There is no trap in this hook -- the `rm -rf` below is straight-line
  # -- so anything not copied out on this line is gone.
  #
  # THE VERDICT FILE IS THE SELECTOR, NOT `rc`. Walking the list and re-reading each verdict
  # picks up BOTH failure shapes: a unit that ran and failed, and a unit that produced no
  # verdict at all because its worker died. The second is the one with no output to show, and
  # saying so in the record is the difference between "here is why it failed" and a silent
  # empty section that reads like a clean unit.
  : > "$out/.failures" 2>/dev/null
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    b="$(basename "$d")"
    [ -f "$out/$b" ] && [ "$(cat "$out/$b")" = ok ] && continue
    { printf '===== %s =====\n' "$b"
      if [ -s "$out/.log/$b" ]; then cat "$out/.log/$b"
      elif [ -f "$out/.log/$b" ]; then printf '(ran and printed nothing)\n'
      else printf '(no capture file: the worker died before it could run this unit)\n'; fi
      printf '\n'; } >> "$out/.failures" 2>/dev/null
  done < "$out/list"

  # THE DISPATCH ORDER IS PART OF THE EVIDENCE, and it is the half that dies with "$out".
  # For a failure that only reproduces under load, "what was this scheduled beside" is the
  # question a later reader cannot answer from anything else -- the durations record holds
  # costs, not co-scheduling, and it has already been overwritten by this run.
  if [ -s "$out/.failures" ]; then
    fl_wrote=0
    { printf '===== fixture failures -- %s, pool width %s, %s of %s units red =====\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$FIXTURE_JOBS" \
        "$(grep -c '^===== ' "$out/.failures")" "$n_expected"
      cat "$out/.failures"
      printf '===== dispatch order this run (longest-first) =====\n'
      cat "$out/.order"; :; } > "$FAILLOG_RECORD" 2>/dev/null && fl_wrote=1
    printf '   captured output for the failing unit(s): %s\n' "$FAILLOG_RECORD"
    # THIS RUN'S RETAINED COPY, chained on the PRIMARY write having opened its file. The `:` that
    # ends the brace group is load-bearing: without it the group's status is `cat .order`'s, not
    # the redirect's. A `cp` after a failed primary write would file the PREVIOUS run's record
    # under this run's stamp -- a misattribution, which is worse than a gap. Nothing in this block
    # touches `rc`, and nothing here may trip `set -u`: an abort here skips the `rm -rf` below.
    fl_stamp="$(date -u +%Y%m%dT%H%M%SZ 2>/dev/null)" || fl_stamp=""
    fl_copy="$GITDIR/ai-dlc-fixture-failures.$fl_stamp.$$"
    if [ "$fl_wrote" = 1 ] && [ -n "$fl_stamp" ] && cp "$FAILLOG_RECORD" "$fl_copy" 2>/dev/null; then printf '   retained copy of this run: %s\n' "$fl_copy"; fi
    # PRUNE BY NAME, newest FAILLOG_KEEP survive. Reverse sort + `tail -n +K` rather than
    # `head -n -N`, which BSD head does not have. The glob anchors the FRONT on the generated
    # shape; `ai-dlc-fixture-failures.*` would also match `.clean`, the operator's own saved
    # record. The `case` anchors the END: without it `<stamp>.<pid>.keep` and
    # `<yyyymm>-bisect-Z.notes` both matched the glob and were deleted in an adversary's probe,
    # each also taking a slot from a real copy. Only an all-digit last field (the pid) is ours.
    for fl_f in "$GITDIR"/ai-dlc-fixture-failures.2[0-9][0-9][0-9][01][0-9]*Z.*; do
      case "${fl_f##*.}" in ''|*[!0-9]*) continue ;; esac
      [ -e "$fl_f" ] && printf '%s\n' "$fl_f"
    done | sort -r | tail -n +$((FAILLOG_KEEP + 1)) | while IFS= read -r fl_f; do
      [ -e "$fl_f" ] && rm -f "$fl_f" 2>/dev/null
    done
  fi

  rm -rf "$out"
  return $rc
}
# FIXTURE_POOL_END

# THE SUITE DOES NOT RE-RUN OVER A TREE IT ALREADY RAN OVER.
#
# ~50s of the operator's inner loop was being spent re-deriving 84 identical
# verdicts on pushes that changed CHANGELOG.md, VERSION or docs/ and nothing else.
# `scripts/suite-content-key.sh` hashes a SUPERSET of everything the suite can
# read -- listings, contents, exec bits, symlink targets, the tracked-path set,
# the fixture set and the external tools -- and a hit means the suite already ran
# over byte-identical inputs. Read that script's header for the exclusion set and
# the mutation measurement behind it; I55 keeps the exclusions honest.
#
# THIS IS THE CHECK-THAT-CANNOT-FIRE SHAPE AND IT IS TREATED AS ONE. Four
# consequences, all deliberate:
#
#   1. A hit ANNOUNCES ITSELF, names its key, and prints what the key covers. A
#      cached green that looked like an ordinary green would be the defect.
#   2. The final summary line says the suite was skipped, so no run reports "all
#      gates green" while hiding that its largest gate did not execute.
#   3. Every failure path -- key script errors, empty key, unreadable record,
#      malformed record, a changed fixture count -- runs the suite. The skip is
#      the exceptional branch and it needs everything to line up; the full run is
#      what happens by default.
#   4. AI_DLC_FIXTURE_NO_SKIP=1 forces the run, on the record, for an operator who
#      wants the suite regardless.
#
# The record lives in .git/, NOT in the working tree, and that is load-bearing: a
# record inside the tree would be hashed by the key it stores, so writing it would
# invalidate it and no push could ever hit.
KEY_RECORD="$GITDIR/ai-dlc-suite-key"

# THE HIT RATE IS THE ONE NUMBER THIS CHANGE COULD NOT MEASURE BEFORE SHIPPING.
# main is squash-merged, so its history records releases and not the pushes inside
# them, which is exactly where the repeat runs happen. The release-granularity
# proxy is 2 of the last 60 commits; the inner-loop rate is higher and unknown.
# So the instrument ships with the change: one line per decision, countable with
#   awk '{print $2}' .git/ai-dlc-suite-key.log | sort | uniq -c
KEY_LOG="$GITDIR/ai-dlc-suite-key.log"
key_log() { printf '%s %s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "${2:-none}" >> "$KEY_LOG" 2>/dev/null || true; }

fixture_suite_step() {
  local key cached_key cached_n cached_when n_now record

  # Counted the way run_fixtures counts, so the number in the announce is the
  # number the last green run actually reported. `ls -d core/fixtures/*/` would be
  # three higher -- it includes the data-only directories that carry no run.sh --
  # and an announce saying "87 of 87" beside a suite that prints 84 verdicts is a
  # discrepancy an operator has to go and resolve before they can trust the skip.
  n_now="$(for d in core/fixtures/*/; do [ -f "$d/run.sh" ] && printf 'x\n'; done | wc -l | tr -d ' ')"

  if [ -n "${AI_DLC_FIXTURE_NO_SKIP:-}" ]; then
    printf '   (content-key skip disabled by AI_DLC_FIXTURE_NO_SKIP)\n'
    key="$(bash scripts/suite-content-key.sh 2>/dev/null)" || key=""
    key_log FORCED "$key"
  elif ! key="$(bash scripts/suite-content-key.sh 2>/dev/null)" || [ -z "$key" ]; then
    printf '   (content key unavailable -- running the suite)\n'
    key=""
    key_log UNAVAILABLE
  elif [ ! -r "$KEY_RECORD" ]; then
    printf '   (no prior green run recorded for this clone -- running the suite)\n'
    key_log MISS "$key"
  else
    record="$(cat "$KEY_RECORD" 2>/dev/null)"
    cached_key="$(printf '%s\n' "$record" | awk 'NR==1{print $1}')"
    cached_n="$(printf '%s\n'   "$record" | awk 'NR==1{print $2}')"
    cached_when="$(printf '%s\n' "$record" | awk 'NR==1{print $3}')"
    if [ "$cached_key" = "$key" ] && [ -n "$cached_n" ] && [ "$cached_n" = "$n_now" ]; then
      printf '   SKIPPED -- this exact tree already passed the whole suite.\n'
      printf '     key          %s\n' "$key"
      printf '     last green   %s of %s fixtures at %s\n' "$cached_n" "$n_now" "${cached_when:-unknown}"
      bash scripts/suite-content-key.sh --summary 2>/dev/null | sed 's/^/     /'
      printf '     force a run with AI_DLC_FIXTURE_NO_SKIP=1\n'
      SUITE_SKIPPED=1
      key_log HIT "$key"
      return 0
    fi
    if [ -n "$cached_n" ] && [ "$cached_n" != "$n_now" ]; then
      printf '   (fixture count moved %s -> %s -- running the suite)\n' "$cached_n" "$n_now"
    else
      printf '   (content key changed -- running the suite)\n'
    fi
    key_log MISS "$key"
  fi

  # A DETACHED READ-SET TRACE STILL RUNNING FROM AN EARLIER PUSH SHARES THE MACHINE WITH THIS SUITE,
  # and every unit's loaded cost then reads high for a reason no fixture owns. Recorded HERE, before
  # the pool starts, because this run's own trace takes the same lock at the end of run_fixtures and
  # a check sited after it would report an overlap on every green push. Read by pole_guard_step.
  READSET_TRACE_OVERLAP=0
  if [ -d "$READSET_LOCAL.lock" ] && ! readset_lock_stale "$READSET_LOCAL.lock"; then
    READSET_TRACE_OVERLAP=1
    printf '   (a read-set live trace from an earlier push is still running -- the suite pole will not be compared this run)\n'
  fi

  run_fixtures || return 1

  # Recorded only after a full green run. A partial or red suite leaves the prior
  # record in place rather than blessing the tree that just failed.
  #
  # AND ONLY IF THE SUITE LEFT THE TREE AS IT FOUND IT. A fixture is supposed to do
  # all of its work in a sandbox; one that writes into the repository under test is
  # a writer racing the fifteen readers beside it, and v0.208.0 shipped a fix for
  # exactly that -- `taught-schema` was dropping a probe into core/team-roles/ and
  # transiently stripping the real provenance schema, which killed
  # `enforcement-map-sites`' seed on whichever assertion happened to be copying.
  #
  # This catches the half of that class that SURVIVES the run: a fixture that
  # changes the tree and does not put it back. Recording the pre-run key then would
  # bless a tree that no longer exists. It does NOT catch a transient write that is
  # cleaned up -- that needs filesystem watching, and no cheap sound mechanism for
  # it exists; a grep over the fixtures cannot tell a sandbox $ROOT from the real
  # one (measured: the false-positive set is most of the seed corpus).
  if [ -n "$key" ] && [ "${n_now:-0}" -gt 0 ]; then
    local key_after
    key_after="$(bash scripts/suite-content-key.sh 2>/dev/null)" || key_after=""
    if [ -z "$key_after" ]; then
      printf '   (content key unavailable after the run -- not recording)\n'
    elif [ "$key_after" != "$key" ]; then
      printf '   NOT RECORDING: the suite CHANGED the tree it just tested.\n'
      printf '     before %s\n     after  %s\n' "$key" "$key_after"
      printf '     A fixture wrote into the repository instead of its own sandbox. The verdicts\n'
      printf '     above were taken against a tree that no longer exists, and recording this key\n'
      printf '     would let a later push skip on evidence from a different tree. Find the writer;\n'
      printf '     `git status` names it. The suite still PASSED -- this only refuses the cache.\n'
    else
      printf '%s %s %s\n' "$key" "$n_now" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$KEY_RECORD" 2>/dev/null || true
    fi
  fi
  return 0
}

# A push issued from a LINKED WORKTREE has git export GIT_DIR (pointed at that
# worktree's private `.git/worktrees/<name>` dir) into this hook's process
# environment; a push from the primary checkout does not. A `git` invocation
# above this line still honors an exported GIT_DIR/GIT_WORK_TREE/GIT_INDEX_FILE
# -- that's git's own behavior, not something this hook's shell code opts into
# -- and every one of those invocations wants exactly that: to operate on the
# worktree actually being pushed. What breaks is different: run_fixtures below
# (dispatched via fixture_suite_step, this file's only fixture dispatch site)
# builds its own isolated sandbox (`mktemp -d`, `cd`, `git -C`, a fresh `git init`) on the
# assumption that git's own upward repository-discovery will find that sandbox --
# discovery git only consults when GIT_DIR is unset. Leaked and inherited
# unscrubbed, a fixture's `git init`/`git commit` sequence is silently redirected
# onto THIS repository instead of its own sandbox -- a reference consumer hit
# exactly this corruption twice before the scrub was added there. Scrub once
# here, in the parent shell, immediately before the dispatch.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY

SUITE_SKIPPED=0
step "fixture suite (${FIXTURE_JOBS}-way)" fixture_suite_step

# 3a. THE SUITE'S WALL CLOCK IS ONE NUMBER AND NOTHING WATCHED IT. This suite is POLE-BOUND:
#     the time you wait tracks the single longest fixture DIRECTORY, not the sum over the
#     pool. That figure grew 493 -> 573 across two releases with no mechanism able to see it,
#     and three separate places went on citing a pole that had been displaced four releases
#     earlier. The guard reads the record the block above publishes and compares it against a
#     tracked baseline, failing only on growth beyond a calibrated band.
#
#     IT STANDS DOWN ON THE CONTENT-KEY SKIP RATHER THAN TRUSTING THE FILE'S AGE. A skip never
#     enters the pool, so it neither truncates LASTRUN_RECORD nor writes it -- the PRIOR run's
#     file survives intact and reads exactly like a fresh one. Nothing in the file says which
#     run wrote it, so the only thing that knows is this shell, here, and that is why the
#     stand-down is a hook-side condition and not something the guard can work out for itself.
#
#     NOT ADDED TO core/git-hooks/pre-push, and it sits OUTSIDE the I66 block for the same
#     reason: the baseline lives under docs/, which a consumer tree does not have, so a
#     consumer running this step would refuse on a file that can never exist there.
#
#     ON A CONTENT-KEY SKIP THE GUARD STILL RUNS, AGAINST AN EMPTY DURATIONS FILE. docs/ is
#     in the content key's EXCLUDE set, so a push that edits ONLY the baseline hits the key,
#     skips the suite, and -- if this step stood down with it -- would land a malformed or
#     stale-pole baseline that nothing parsed. The guard parses the baseline BEFORE it looks
#     at durations and refuses (exit 2) on a bad one, then SKIPs on the empty file. So the
#     baseline is read by a shipping program on every push regardless of the key, which is
#     the reader I55 arm 3 requires for a docs/ input: the fixture suite cannot be it.
pole_guard_step() {
  if [ "${SUITE_SKIPPED:-0}" = 1 ]; then
    printf '   (suite skipped on the content key -- parsing the baseline only; nothing was measured)\n'
    bash scripts/validate-suite-pole.sh --durations /dev/null --jobs "$FIXTURE_JOBS"
    return
  fi
  # A LIVE TRACE OVERLAPPED THE SUITE (recorded by fixture_suite_step before the pool started), so
  # this run's costs were taken on a machine the trace was also loading. Comparing them could FAIL
  # a push for the trace's load, and passing them would read as a clean measurement; neither is
  # true. The baseline is still parsed, for the reason the skip branch above gives.
  if [ "${READSET_TRACE_OVERLAP:-0}" = 1 ]; then
    printf '   SKIP: a read-set live trace overlapped this run -- its loaded costs are not compared; parsing the baseline only\n'
    bash scripts/validate-suite-pole.sh --durations /dev/null --jobs "$FIXTURE_JOBS"
    return
  fi
  # --record IS THE MERGED CUMULATIVE FILE, already folded with this run by the pool above, and
  # it is what the guard's coverage denominator is read from: the share of the suite's cost
  # this run timed, not a row count one skipped fixture defeats.
  bash scripts/validate-suite-pole.sh --durations "$LASTRUN_RECORD" --record "$DURATIONS_RECORD" --jobs "$FIXTURE_JOBS"
}
step "suite pole (this run's loaded cost of the longest fixture against docs/suite-pole-baseline.tsv)" pole_guard_step

# 4. A shipped script with a syntax error is a gate that cannot run at all.
#    validate-enforcement-map.sh maps this glob set through map_consumer() and
#    asserts it equals the set in core/git-hooks/pre-push. Add a class here and the
#    consumer hook fails until it carries the class too.
# SYNTAX_GLOB_BEGIN
syntax_all() {
  local rc=0 f
  for f in scripts/*.sh core/scripts/*.sh core/hooks/*.sh \
           core/skills/ai-dlc-update/reconcile/*.sh .githooks/*; do
    [ -f "$f" ] || continue
    bash -n "$f" 2>/dev/null || { printf '   syntax error: %s\n' "$f"; rc=1; }
  done
  return $rc
}
# SYNTAX_GLOB_END
step "shell syntax (every shipped script and hook)" syntax_all

if [ "$fail" -ne 0 ]; then
  printf '\npre-push: BLOCKED. Fix the above, or `git push --no-verify` on the record.\n\n'
  exit 1
fi
if [ "$SUITE_SKIPPED" -ne 0 ]; then
  printf '\npre-push: all gates green -- FIXTURE SUITE SKIPPED on an unchanged content key.\n\n'
  exit 0
fi
printf '\npre-push: all gates green.\n\n'
