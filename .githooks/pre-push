$PUSH_LINES
SK_EOF
    SKIPS_TREE="$(git rev-parse --verify --quiet 'HEAD^{tree}')" || SKIPS_TREE=""
  else printf '   ..    skip record: %s is not writable; this push records no skip set\n' "$GITDIR/ai-dlc-fixture-skips.log"; fi
fi
ps_flush
PRESUITE_DONE=1

# 2f. THE INVOCATION BUDGET. Every declared fixture's bash starts are counted by an rc generated into a private run
#     dir and judged by scripts/validate-fixture-invocations.sh inside hermetic-run.sh, before its verdict-store
#     write, so a budget mismatch is that fixture's own FAIL. Armed at depth 0 only: a nested copy of this hook is
#     inert. A judge whose semantic sha has no `# FXC-IDENTITY` row (--identity-check) FAILs arming.
#     Counted passes live in counted-<vk>, ALWAYS, even
#     under a preset AI_DLC_VERDICT_STORE, so counted and uncounted entries never share a store. vk hashes the judge's
#     FXC_FORMAT alone; what the judge decides for ONE fixture is that entry's `#judge` row (READSET_VS's
#     readset_vs_judge, from the FXCOUNT_KEYROWS table written here), so a judge or allowlist edit re-runs only the
#     fixtures whose row it moves. The judge absent is a FAIL here, never an uncounted pass. The run dir holds the
#     per-fixture start logs and the key-row tables and is left in TMPDIR.
#     THE LEGACY COUNTED STORE: `fxcount_legacy` names the last whole-judge store (its vk, the judge and allowlist blobs
#     it hashed, the judge format they judged under). A fixture whose current row has that format and whose J5 key has
#     the same allowlist membership under that blob as now is listed in FXCOUNT_LEGACY_OK, and readset_verdicts reads
#     its entries in FXCOUNT_LEGACY_STORE, which carry no `#judge` row. The blob unreadable: legacy lookup OFF.
#     scripts/collect-counted-stores.sh reads this line to keep that store and the live one.
fxcount_arm() {
  local run vk idc fmt base lv lj la lf
  local fxcount_legacy="cd68ce325a3d 8c11cb854c0456316b215bfb3c841a43a9f363fc aae7a5b3907faf325ecfd92473bb272aa7b314ec f1"
  [ "$POOL_DEPTH_IN" -eq 0 ] || { printf '   nested pool (depth %s): the outer hook arms the counter; this copy stays inert\n' "$POOL_DEPTH_IN"; return 0; }
  FXCOUNT_JUDGE="$PWD/scripts/validate-fixture-invocations.sh"
  [ -f "$FXCOUNT_JUDGE" ] || { printf '   the invocation judge %s is absent: the suite cannot be counted, and an uncounted suite is not a pass\n' "$FXCOUNT_JUDGE"; return 1; }
  idc="$(bash "$FXCOUNT_JUDGE" --identity-check 2>&1)" || { printf '%s\n' "$idc"; return 1; }
  fmt="$(printf '%s\n' "$idc" | awk '$1 == "judge" && $2 == "identity" && $3 ~ /^f[0-9]+$/ { print $3; exit }')"
  [ -n "$fmt" ] || { printf '   the invocation judge printed no format: %s\n' "$idc"; return 1; }
  run="$(mktemp -d "${TMPDIR:-/tmp}/fxcount.XXXXXX")" && mkdir "$run/log" || return 1
  FXCOUNT_RC="$(bash "$FXCOUNT_JUDGE" --gen-rc "$run")" && [ -s "$FXCOUNT_RC" ] || { printf '   the invocation judge did not generate its rc file into %s\n' "$run"; return 1; }
  FXCOUNT_DIR="$run/log"
  FXCOUNT_KEYROWS="$run/keyrows"
  bash "$FXCOUNT_JUDGE" --key-rows "$PWD" > "$FXCOUNT_KEYROWS" || { printf '   the invocation judge could not write its per-fixture key rows\n'; return 1; }
  vk="$(bash "$FXCOUNT_JUDGE" --store-key)"; vk="${vk#counted-}"
  case "$vk" in *[!0-9a-f]*|'') printf '   the invocation judge printed no counted-store key\n'; return 1 ;; esac
  [ "${#vk}" -eq 12 ] || return 1
  base="${AI_DLC_VERDICT_STORE:-$HOME/.cache/ai-dlc/verdicts}"
  AI_DLC_VERDICT_STORE="$base/counted-$vk"
  export FXCOUNT_RC FXCOUNT_DIR FXCOUNT_JUDGE AI_DLC_VERDICT_STORE
  FXCOUNT_LEGACY_STORE=""; FXCOUNT_LEGACY_OK="$run/legacy.ok"; : > "$FXCOUNT_LEGACY_OK"
  read -r lv lj la lf <<EOF
$fxcount_legacy
EOF
  # The pin binds itself: the legacy vk is recomputed by the whole-judge formula that named it (the judge blob, the rc
  # that blob generates, the framed allowlist blob) and must equal lv, else legacy lookup is OFF.
  if [ "$lf" = "$fmt" ] && git cat-file blob "$la" > "$run/legacy.allow" 2>/dev/null \
    && git cat-file blob "$lj" > "$run/legacy.judge" 2>/dev/null \
    && [ "$({ cat "$run/legacy.judge" "$(bash "$run/legacy.judge" --gen-rc "$run/legacy")" && printf '\n#fxcount-allowlist-present\n' && cat "$run/legacy.allow"; } 2>/dev/null | shasum -a 256 | cut -c1-12)" = "$lv" ] \
    && bash "$FXCOUNT_JUDGE" --legacy-ok "$run/legacy.allow" "$FXCOUNT_KEYROWS" "$lf" > "$FXCOUNT_LEGACY_OK"; then
    FXCOUNT_LEGACY_STORE="$base/counted-$lv"
  else : > "$FXCOUNT_LEGACY_OK"; fi
  export FXCOUNT_KEYROWS FXCOUNT_LEGACY_STORE FXCOUNT_LEGACY_OK
  printf '   %s\n   counting into %s; verdict store %s\n' "$(printf '%s\n' "$idc" | tail -1)" "$FXCOUNT_DIR" "$AI_DLC_VERDICT_STORE"
  if [ -n "$FXCOUNT_LEGACY_STORE" ]; then
    printf '   legacy counted store %s: %s of %s fixture(s) eligible\n' "$FXCOUNT_LEGACY_STORE" "$(awk 'END { print NR }' "$FXCOUNT_LEGACY_OK")" "$(awk 'END { print NR }' "$FXCOUNT_KEYROWS")"
  else
    printf '   legacy counted store OFF (format %s against %s, a blob unreadable, or the pin does not recompute to %s)\n' "$fmt" "$lf" "$lv"
  fi
}
step "invocation counter armed (scripts/validate-fixture-invocations.sh)" fxcount_arm

SUITE_SKIPPED=0
SUITE_SKIP_CAUSE=""
FAIL_BEFORE_SUITE="$fail"
# The consumer-layout tree build in fixture_suite_step requires this flag (BL-1027): only the real hook entry sets it.
PREPUSH_CL_ENTRY=1
# The readset memo (BL-1163) is on only for the real entry at depth 0, the condition the `suite phases:` line prints under.
readset_memo_on
step "fixture suite (${FIXTURE_JOBS}-way)" fixture_suite_step

# 3b. PENDING, NEVER GREEN. The dynamic in-process arms (C1-C3, the stale allowlist row) run only inside a COUNTED
#     run: validate-fixture-invocations.sh's fxc_judge, called by hermetic-run.sh. A fixture this push did not run
#     counted carries a verdict from that judge only if it was skipped on a counted-store entry written under its
#     CURRENT per-fixture key, the store being counted-<vk> (vk hashes the judge's format) and the key carrying the
#     fixture's own `#inproc` and `#judge` rows, or on an entry of the legacy counted store for a fixture
#     FXCOUNT_LEGACY_OK lists. Both other skip paths can skip WITHOUT one: the read-set key-record skip (a
#     `.git/ai-dlc-fixture-keys/<fx>.key` whose keys still hold -- the judge is no declared input of most fixtures, so
#     a pass recorded under an older judge or none skips) and the whole-suite content-key SKIP. So this step, per
#     declared fixture (inputs.decl, no .undeclarable) that is not an allowlist row:
#       counted this push      $FXCOUNT_DIR/<fx> exists (hermetic-run.sh creates it, armed, before the fixture runs)
#       counted elsewhere      the digest of readset_vs_input over <fx>.key's rows names an entry of the counted store
#                              whose body is that digest input -- readset_verdicts' own test, over the record the skip used
#       otherwise              PENDING (no counted run under this judge), named, and counted on the final banner.
#     No counter armed (a nested copy, or arming failed): every such fixture is PENDING. The undeclared and
#     `.undeclarable` fixtures never run counted and are out of BL-879's population (B2). It reads only records this
#     hook wrote, never the pool's temp dir, so it sits outside FIXTURE_POOL in this hook alone. Information, not a
#     verdict: it returns 0, and the final banner names the count it could not vouch for.
PENDING_N=0
inproc_vs_hit() { # <store dir>: 0 when the entry named for the digest of $w/d holds exactly that digest input
  local dig e
  dig="$(shasum -a 256 < "$w/d" | cut -d' ' -f1)"; e="$1/$dig"
  [ "${#dig}" -eq 64 ] && [ -f "$e" ] && readset_vs_entry "$e" "$w/d" > /dev/null
}
inproc_pending_step() {
  local d fx ident="" store="" rec dig e n_dec=0 n_cnt=0 n_vs=0 n_al=0 pl="" w
  w="$(mktemp -d "${TMPDIR:-/tmp}/inproc-pending.XXXXXX")" || { printf '   could not make a scratch dir\n'; return 1; }
  # Armed, AI_DLC_VERDICT_STORE is <base>/counted-<vk>, so readset_vs_store resolves the counted store's project dir.
  if [ -n "${FXCOUNT_DIR:-}" ] && [ -d "$FXCOUNT_DIR" ]; then
    case "${AI_DLC_VERDICT_STORE:-}" in */counted-*) store="$(readset_vs_store "$PWD")" ;; esac
    ident="$(readset_vs_ident_here)" || ident=""
  fi
  for d in "$FXROOT"*/; do
    d="${d%/}"; fx="${d##*/}"
    [ -f "$d/run.sh" ] && [ -f "$d/inputs.decl" ] && [ ! -e "$d/.undeclarable" ] || continue
    n_dec=$((n_dec + 1))
    if [ -f scripts/fixture-inprocess-allowlist.txt ] \
      && F="$fx" awk -F'\t' '$0 !~ /^[[:space:]]*(#|$)/ && $1 == ENVIRON["F"] { f = 1 } END { exit f ? 0 : 1 }' scripts/fixture-inprocess-allowlist.txt; then
      n_al=$((n_al + 1)); continue
    fi
    if [ -n "${FXCOUNT_DIR:-}" ] && [ -e "$FXCOUNT_DIR/$fx" ]; then n_cnt=$((n_cnt + 1)); continue; fi
    rec="$KEYS_DIR/$fx.key"
    if [ -n "$store" ] && [ -n "$ident" ] && [ -f "$rec" ] && readset_key_rows "$rec" > "$w/rows" 2>/dev/null && [ -s "$w/rows" ]; then
      if readset_vs_input "$fx" "$ident" "$w/rows" > "$w/d" 2>/dev/null && inproc_vs_hit "$store"; then n_vs=$((n_vs + 1)); continue; fi
      # The legacy counted store (fxcount_arm): its entries carry no `#judge` row, and only a listed fixture reads it.
      if [ -n "${FXCOUNT_LEGACY_STORE:-}" ] && [ -f "${FXCOUNT_LEGACY_OK:-}" ] && grep -qxF -- "$fx" "$FXCOUNT_LEGACY_OK" \
        && ( unset FXCOUNT_JUDGE; readset_vs_input "$fx" "$ident" "$w/rows" ) > "$w/d" 2>/dev/null \
        && inproc_vs_hit "$FXCOUNT_LEGACY_STORE/${store##*/}"; then n_vs=$((n_vs + 1)); continue; fi
    fi
    pl="$pl $fx"; PENDING_N=$((PENDING_N + 1))
  done
  rm -rf "$w"
  [ -n "${FXCOUNT_DIR:-}" ] || printf '   no invocation counter armed on this push: no declared fixture has a counted verdict here\n'
  printf '   %s declared fixture(s): %s counted this push, %s skipped on a counted pass under this judge, %s on scripts/fixture-inprocess-allowlist.txt, %s PENDING\n' \
    "$n_dec" "$n_cnt" "$n_vs" "$n_al" "$PENDING_N"
  [ -z "$pl" ] || printf '   PENDING (no counted run under this judge):%s\n' "$pl"
  return 0
}
step "in-process cells, dynamic half: every declared fixture judged under this judge, or PENDING (information, not a verdict)" inproc_pending_step

# 3a. THE SUITE'S WALL CLOCK IS PRINTED, NEVER JUDGED, AS ITS TWO LOWER BOUNDS. One is the pole,
#     the single longest fixture DIRECTORY; the other is the summed loaded cost of every unit this
#     run timed over the pool width. A push that dispatches most of the suite is WIDTH-BOUND: the
#     second is the larger (B9 and B10 at width 6: 882s and 999s against poles of 145s and 147s),
#     and only a small selection waits on its pole. The pole once grew 493 -> 573 across two
#     releases with nothing able to see it, so every push names the pole unit, its loaded wall
#     clock and its change against the same unit's figure before this run, then the summed cost
#     over the width and which bound is the larger.
#
#     IT IS INFORMATION, NOT A VERDICT, AND THAT IS A RULING. It was a ratchet with a band, and
#     a loaded wall clock moves several-fold with the box's load (one unit's recorded cost at pool
#     12 spans 101-681s), so any band is a picked number that reddens a push for load. No recorded
#     instance of it catching real growth exists. A growing pole is read by whoever reads the
#     push; this step always returns 0, and a skipped suite prints that it has no pole.
pole_info_step() {
  # THIS RUN'S FIGURES ARE LASTRUN_OWN AND THE PRIOR ONES POLE_PREV, both held in this process: the
  # shared `.last` and durations files can belong to a concurrent push by the time this line runs.
  if [ "${SUITE_SKIPPED:-0}" = 1 ] || [ -z "${LASTRUN_OWN:-}" ]; then
    printf '   (no suite run, no pole)\n'
    return 0
  fi
  # THE POLE IS ONE BOUND ON THE POOL'S MAKESPAN; THE SUMMED COST OVER THE WIDTH IS THE OTHER. The second
  # line divides this run's summed loaded cost by the width the pool ran (FIXTURE_JOBS, never more than
  # the units timed) and names whichever bound is larger. Same awk, no new fork.
  printf '%s\n' "$LASTRUN_OWN" | PP="${POLE_PREV:-}" PW="${FIXTURE_JOBS:-}" awk '
       BEGIN { n = split(ENVIRON["PP"], L, "\n"); for (i = 1; i <= n; i++) if (split(L[i], f, " ") == 2) prev[f[1]] = f[2] }
       NF == 2 && $2 ~ /^[0-9]+$/ { sum += $2; units++ }
       NF == 2 && $2 ~ /^[0-9]+$/ && ($2 + 0 > max + 0 || u == "") { u = $1; max = $2 }
       END {
         if (u == "") { print "   (no suite run, no pole)"; exit }
         if (u in prev) printf "   pole %s %ss loaded (was %ss before this run, %+ds)\n", u, max, prev[u], max - prev[u]
         else           printf "   pole %s %ss loaded (no prior figure for it)\n", u, max
         w = ENVIRON["PW"]
         if (w !~ /^[1-9][0-9]*$/) { printf "   throughput %ss summed over %d unit(s); pool width \"%s\" is not a count, no bound named\n", sum, units, w; exit }
         w += 0; if (w > units) w = units
         tp = int(sum / w + 0.5)
         if (tp > max + 0) printf "   throughput %ss summed over %d unit(s) / %d worker(s) = %ds: THROUGHPUT-BOUND (%ds > pole %ss)\n", sum, units, w, tp, tp, max
         else              printf "   throughput %ss summed over %d unit(s) / %d worker(s) = %ds: POLE-BOUND (pole %ss >= %ds)\n", sum, units, w, tp, max, tp
       }'
  return 0
}
step "suite pole and throughput bound (this run's longest fixture, summed cost / width; information, not a verdict)" pole_info_step

# A POOL WHOSE ONLY RED IS A REFUSAL EXITS 2, NOT 1 (BL-606). Written identically in both hooks, outside
# the I66 block: POOL_REFUSED_ONLY is set inside it, FAIL_BEFORE_SUITE on the line before the suite step.
# FIXTURE_EXIT_BEGIN
if [ "$fail" -ne 0 ] && [ "${POOL_REFUSED_ONLY:-0}" = 1 ] && [ "${FAIL_BEFORE_SUITE:-1}" = 0 ]; then
  printf '\npre-push: REFUSED. A fixture unit made no progress and was killed; no verdict exists for it. Re-run the push once; a second REFUSED is handled as BLOCKED (steps/handoff.md step 3).\n\n'
  exit 2
fi
# FIXTURE_EXIT_END
if [ "$fail" -ne 0 ]; then
  printf '\npre-push: BLOCKED. Fix the above, or `git push --no-verify` on the record.\n\n'
  exit 1
fi
pending_note=""
[ "${PENDING_N:-0}" -gt 0 ] && pending_note=" -- $PENDING_N declared fixture(s) PENDING (no counted run under this judge; see step 3b)"
# SUITE_BANNER_BEGIN
# TWO SEPARATE ARMS SKIP THE SUITE, EACH A DECISION OF ITS OWN WITH ITS OWN LOG LINE, so the banner names the one
# that decided and never a cause it did not observe. The whole-suite content key matched the last green
# (fixture_suite_step logs HIT and sets content-key); or the key had changed (logs MISS) and the read-set skip
# inside run_fixtures found no fixture whose inputs moved (fixture_suite_step sets read-set after it returns).
if [ "$SUITE_SKIPPED" -ne 0 ]; then
  case "${SUITE_SKIP_CAUSE:-}" in
    content-key) skip_why='the whole-suite content key matched the last green (this exact tree already passed)' ;;
    read-set)    skip_why='the read-set skip found no fixture whose inputs changed (the content key had changed)' ;;
    *)           skip_why='cause not recorded' ;;
  esac
  printf '\npre-push: all gates green -- FIXTURE SUITE SKIPPED -- %s%s.\n\n' "$skip_why" "$pending_note"
  exit 0
fi
# SUITE_BANNER_END
printf '\npre-push: all gates green%s.\n\n' "$pending_note"
