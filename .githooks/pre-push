}
readset_decl_keys() { # <now> <ls.now> <parse rows> <tool hash file> <fixture root, with its trailing /> [<memo dir> <memo identity>: the hook only]
  local rk_r="" rk_p rk_d="${HR_ROOT:-.}"
  for rk_p in core/scripts/hermetic-run.sh scripts/ai-dlc/hermetic-run.sh; do
    [ -f "$rk_d/$rk_p" ] && rk_r="$rk_r$rk_p $(readset_span_sha "$rk_d/$rk_p" HR_SANDBOX) $(readset_tail_sha "$rk_d/$rk_p");"
  done
  readset_strip_keys "$rk_d" "$5" "$3" "$4.sk" "$1" "${6:-}" "${7:-}"
  RK_R="$rk_r" RK_L="$2" RK_P="$3" RK_T="$4" RK_S="$4.sk" awk -F'\t' -v root="$5" '
    function out(f, k, v) { if (!((f SUBSEP k) in S)) { S[f SUBSEP k] = 1; print f "\t" k "\t" v } }
    BEGIN {
      while ((getline l < ENVIRON["RK_S"]) > 0) { t = index(l, "\t"); SK[substr(l, 1, t - 1)] = substr(l, t + 1) }
      n = split(ENVIRON["RK_R"], a, ";"); for (j = 1; j < n; j++) { split(a[j], b, " "); RNS[b[1]] = b[2]; RNT[b[1]] = b[3] }
      while ((getline l < ENVIRON["RK_P"]) > 0) { split(l, a, "\t")
        if (a[2] == "N") FX[a[1]] = 1
        else if (a[2] == "F") { if (!index(a[5], "#")) FF[a[3]] = FF[a[3]] "\n" a[1] }
        else if (a[2] == "D") DD[a[3]] = DD[a[3]] "\n" a[1]
        else if (a[2] == "T") TL[a[1]] = TL[a[1]] "\n" a[3]
        else if (a[2] == "P") PL[a[1]] = PL[a[1]] "\n" a[3] "\t" a[4]
        else if (a[2] == "G") PL[a[1]] = PL[a[1]] "\n" a[3] "\t" a[4] }
      while ((getline l < ENVIRON["RK_L"]) > 0) { t = index(l, "\t"); LS[substr(l, 1, t - 1)] = substr(l, t + 1) }
      while ((getline l < ENVIRON["RK_T"]) > 0) { t = index(l, "\t"); TH[substr(l, 1, t - 1)] = substr(l, t + 1) }
      for (f in FX) { n = split(TL[f], a, "\n"); for (j = 2; j <= n; j++) out(f, a[j], (a[j] in TH) ? TH[a[j]] : "-")
        n = split(PL[f], a, "\n"); for (j = 2; j <= n; j++) { t = index(a[j], "\t"); out(f, substr(a[j], 1, t - 1), substr(a[j], t + 1)) } } }
    { p = $1; v = $2
      if (p in RNS) for (f in FX) out(f, p "#HR_SANDBOX", RNS[p])
      if (p in RNT) for (f in FX) out(f, p "#HR_EXIT", RNT[p])
      if (p in FF) { n = split(FF[p], a, "\n"); for (j = 2; j <= n; j++) out(a[j], p, v) }
      dk = ""
      if (index(p, root) == 1) { r = substr(p, length(root) + 1); i = index(r, "/"); if (i > 1 && (substr(r, 1, i - 1) in FX)) out(substr(r, 1, i - 1), p, (p in SK) ? SK[p] : v)
        if (r ~ /^[^\/]+\/(invocations|inputs)\.decl$/) dk = substr(r, 1, i - 1) }
      q = p
      while ((i = match(q, /\/[^\/]*$/)) > 0) { q = substr(q, 1, i - 1)
        if (!(q in DD)) continue
        n = split(DD[q], a, "\n")
        for (j = 2; j <= n; j++) { if (dk != "" && dk != a[j]) continue; out(a[j], p, v); r = p
          while ((i2 = match(r, /\/[^\/]*$/)) > 0) { r = substr(r, 1, i2 - 1); out(a[j], r "/", ((r "/") in LS) ? LS[r "/"] : "-"); if (r == q) break } } } }' "$1"
}
# READSET_KEYROWS_END
# THE MEMO IDENTITY (BL-1163). `readset_strip_keys` and `readset_tools` memoize per file content under READSET_MEMO
# (<base>/readset-memo/<root>; empty = memo off). An entry is valid only under the identity of the programs that
# computed it: the bash that judges (`bash -n`), the bash that prints (`declare -f`, $BASH), the awk, the text of the
# function itself, the runtime locale, and for the tools scan the hash of `.pathcmds`. All of it is content
# (never a path, version or mtime), taken from builtins plus ONE shasum exec per pass. An empty result turns the memo
# off for that pass.
READSET_MEMO_STRIP=""
READSET_MEMO_TOOLS=""
readset_memo_id() { # <out>: sets READSET_MEMO_STRIP and READSET_MEMO_TOOLS
  local out="$1" b="" a="" loc h s_b s_B s_a s_fs s_ft s_pc
  READSET_MEMO_STRIP=""; READSET_MEMO_TOOLS=""
  [ -n "${READSET_MEMO:-}" ] && [ -n "${BASH:-}" ] || return 0
  command -v bash > "$out/.mid.b" 2>/dev/null; command -v awk > "$out/.mid.a" 2>/dev/null
  IFS= read -r b < "$out/.mid.b"; IFS= read -r a < "$out/.mid.a"
  case "$b" in /*) ;; *) return 0 ;; esac
  case "$a" in /*) ;; *) return 0 ;; esac
  loc="LC_ALL=${LC_ALL-}|LC_CTYPE=${LC_CTYPE-}|LANG=${LANG-}"
  case "$loc" in *$'\t'*|*$'\n'*) return 0 ;; esac
  declare -f readset_strip_keys > "$out/.mid.fs"; declare -f readset_tools > "$out/.mid.ft"
  shasum -a 256 -- "$b" "$BASH" "$a" "$out/.mid.fs" "$out/.mid.ft" "$out/.pathcmds" > "$out/.mid.h" 2>/dev/null
  { read -r s_b _; read -r s_B _; read -r s_a _; read -r s_fs _; read -r s_ft _; read -r s_pc _; } < "$out/.mid.h"
  for h in "$s_b" "$s_B" "$s_a" "$s_fs" "$s_ft" "$s_pc"; do
    case "$h" in ''|*[!0-9a-f]*) return 0 ;; esac
    [ "${#h}" -eq 64 ] || return 0
  done
  READSET_MEMO_STRIP="$s_b:$s_B:$s_a:$s_fs:$loc"
  READSET_MEMO_TOOLS="$s_a:$s_ft:$s_pc:$loc"
}
readset_tools() { # <out>
  local out="$1" xp="$READSET_TOOL_XP" tf="" sc="$1/.ftools" ml="$1/.rt.sh" fr="${FXROOT:-}" rt_rc=0
  [ -n "$xp" ] || xp="$(readset_git_exec_path)"
  ( IFS=:; for p in $xp:$READSET_TOOL_DIRS; do
      [ -d "$p" ] || continue
      set +f
      for f in "$p"/*; do [ -e "$f" ] || [ -L "$f" ] || continue; printf '%s\t%s\n' "$p" "${f##*/}"; done
    done ) > "$out/.pathcmds"
  readset_memo_id "$out"
  grep '\.sh$' "$out/.files" > "$out/.rt.sh"
  [ -z "$READSET_MEMO_TOOLS" ] || [ ! -s "$out/.now" ] || tf="$READSET_MEMO/tools.${fr//\//_}"
  if [ -n "$tf" ]; then
    sc="$out/.rt.new"; ml="$out/.rt.miss"
    : > "$out/.rt.hit"; : > "$out/.rt.miss"; : > "$out/.rt.ms"; : > "$out/.rt.keep"; : > "$out/.rt.new"
    RT_W="$out" RT_N="$out/.now" RT_M="$tf" RT_I="$READSET_MEMO_TOOLS" awk -F'\t' 'BEGIN { w = ENVIRON["RT_W"]; id = ENVIRON["RT_I"]
        while ((getline l < ENVIRON["RT_N"]) > 0) { t = index(l, "\t"); NS[substr(l, 1, t - 1)] = substr(l, t + 1) }
        while ((getline l < ENVIRON["RT_M"]) > 0) { k = split(l, a, "\t"); ok = (k >= 4 && a[k] == "end" && a[2] == id && length(a[1]) == 64 && a[1] ~ /^[0-9a-f]+$/ && a[3] == (k - 4) "")
          for (i = 4; ok && i < k; i++) if (a[i] !~ /^\//) ok = 0
          if (ok) M[a[1]] = l }
        while ((getline l < (w "/.rt.sh")) > 0) { s = (l in NS) ? NS[l] : ""
          if (s != "" && (s in M)) { k = split(M[s], a, "\t"); for (i = 4; i < k; i++) print l "\t" a[i] > (w "/.rt.hit")
            if (!(s in KS)) { KS[s] = 1; print M[s] > (w "/.rt.keep") } }
          else { print l > (w "/.rt.miss"); if (s != "") print l "\t" s > (w "/.rt.ms") } } }'
  fi
  tr '\n' '\000' < "$ml" | RT_CMDS="$out/.pathcmds" xargs -0 awk '
    BEGIN { while ((getline l < ENVIRON["RT_CMDS"]) > 0) { t = index(l, "\t"); n = substr(l, t + 1); if (!(n in cmd)) cmd[n] = substr(l, 1, t - 1) "/" n } }
    FNR == 1 { delete seen }
    /^[[:space:]]*#/ { next }
    { n = split($0, w, /[^A-Za-z0-9_.+-]+/)
