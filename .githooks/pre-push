readset_vs_ident() { # <hook> <runner>: prints "<runner span id> f<the hook's READSET_VS_FORMAT>"; fails when either file
  local hk="$1" rn="$2" f             # is absent or the hook does not carry exactly one format line
  [ -f "$hk" ] && [ -f "$rn" ] || return 1
  f="$(sed -n 's/^READSET_VS_FORMAT=\([0-9][0-9]*\)$/\1/p' "$hk")"
  case "$f" in ''|*[!0-9]*) return 1 ;; esac
  printf '%s f%s' "$(readset_span_sha "$rn" HR_SANDBOX)" "$f"
}
readset_vs_input() { # <fx> <ident> <rows file> [<project root>, default .]: the digest input
  printf '#fixture %s\n#runner %s\n#universe %s\n' "$1" "${2%% *}" "${2#* }"
  readset_vs_inproc "$1" "${4:-.}"
  [ -z "${FXCOUNT_JUDGE:-}" ] || readset_vs_judge "$1" "${4:-.}" || return 1
  cat "$3"
}
# THIS FIXTURE'S OWN BL-879 STATE, one row, read under <project root>: `listed` or `unlisted` on
# scripts/fixture-inprocess-allowlist.txt (field 1, never the reason, so a reworded reason voids nothing), and the
# sha256 of its cells.decl or `none`. The judge's C arms read both, so a pass is reused only under the same two; an
# allowlist edit voids only the fixtures whose row changed, never the whole counted store (the allowlist is NOT in
# fxcount_arm's vk). hermetic-run.sh passes its HR_ROOT; this hook's reader runs at the root and passes nothing.
readset_vs_inproc() { # <fx> <project root>
  local d c=none l=unlisted
  for d in core/fixtures tests/fixtures; do [ -d "$2/$d/$1" ] && break; done
  [ -f "$2/$d/$1/cells.decl" ] && c="$(shasum -a 256 < "$2/$d/$1/cells.decl" | cut -d' ' -f1)"
  [ -f "$2/scripts/fixture-inprocess-allowlist.txt" ] \
    && F="$1" awk -F'\t' '$0 !~ /^[[:space:]]*(#|$)/ && $1 == ENVIRON["F"] { f = 1 } END { exit f ? 0 : 1 }' "$2/scripts/fixture-inprocess-allowlist.txt" \
    && l=listed
  printf '#inproc %s %s\n' "$l" "$c"
}
# A COUNTED RUN'S JUDGE ROW (FXCOUNT_JUDGE set, the distribution hook's fxcount_arm): the invocation judge's own
# `#judge f<format> <J5 key> <listed|unlisted>` row for <fx> (its --key-rows), read from the FXCOUNT_KEYROWS table
# the arming wrote once per push, else from one judge call under <project root>. No row: no digest input, so nothing
# is recorded or reused. Uncounted (a consumer, a nested pool), no row is written and the digest input is unchanged.
readset_vs_judge() { # <fx> <project root>
  local r
  if [ -n "${FXCOUNT_KEYROWS:-}" ] && [ -f "$FXCOUNT_KEYROWS" ]; then
    r="$(F="$1" awk -F'\t' '$1 == ENVIRON["F"] { print $2; exit }' "$FXCOUNT_KEYROWS")"
  else
    r="$(bash "$FXCOUNT_JUDGE" --key-rows "$2" "$1" 2>/dev/null | F="$1" awk -F'\t' '$1 == ENVIRON["F"] { print $2; exit }')"
  fi
  case "$r" in '#judge f'*) printf '%s\n' "$r" ;; *) return 1 ;; esac
}
# THE PENDING ROW GRAMMAR, ONE DEFINITION. A green fixture whose subject is absent prints `PENDING  <what>` (two
# spaces after the word, at the start of a line or after indentation). The pool's count over a dispatched fixture's
# log and hermetic-run.sh's count into the store entry both take this variable; no other copy of the regex exists.
READSET_VS_PENDING='^[[:space:]]*PENDING  '
# A STORE ENTRY, ONE EXACT READER: `#format k1`, `#state ok`, exactly the digest input in <digest input file>, then
# an optional LAST line `#pending <n>` (n a non-negative integer, the PENDING rows of the pass that wrote it; an
# output, never part of the entry's name, which is the sha256 of the digest input). Prints n, or `-` for an entry
# with no such line: one written before the count was recorded keeps its meaning (its pass is reused, its count is
# unrecorded). Any other shape -- a header that differs, a body that differs -- fails closed: status 1, nothing
# printed. <digest input file>.e is its scratch copy of the body.
readset_vs_entry() { # <entry> <digest input file>
  local n
  n="$(awk 'NR == 1 { o = ($0 == "#format k1"); next } NR == 2 { o = o && ($0 == "#state ok"); next } { l = $0 }
            END { if (o) print ((l ~ /^#pending (0|[1-9][0-9]*)$/) ? substr(l, 10) : "-") }' "$1" 2>/dev/null)"
  [ -n "$n" ] || return 1
  if [ "$n" = - ]; then tail -n +3 "$1" > "$2.e" 2>/dev/null || return 1
  else sed -e '1,2d' -e '$d' "$1" > "$2.e" 2>/dev/null || return 1; fi
  cmp -s "$2.e" "$2" || return 1
  printf '%s\n' "$n"
}
# A KEY RECORD'S ROWS, ONE READER: every line but the header lines `#format `, `#state `, `#tools `, `#pending `,
# `#modes ` and `#mode<blank>` (BL-1155).
# Status 1 when it prints no row.
readset_key_rows() { # <record>
  grep -vE '^#(format|state|tools|pending|modes) |^#mode[[:blank:]]' "$1"
}
# MANY FIXTURES' DIGEST ROWS IN A FIXED NUMBER OF EXECS (readset_verdicts). For each <fx> line of <cand>, in order,
# whose <keys dir>/<fx> holds a key row: `<fx>\tI\t` and readset_vs_inproc's row, `<fx>\tJ\t` and readset_vs_judge's
# (FXCOUNT_JUDGE set and a row found), then `<fx>\tR\t` and each readset_key_rows row, under the project root `.`.
# Byte-identical to those three readers, which stay the per-fixture API (hermetic-run.sh); a change to one of them
# changes this reader with it. One shasum over every present cells.decl and one awk; without the FXCOUNT_KEYROWS
# table, one judge call per candidate with a key row, the set the per-fixture loop called (each one a bash start).
# <scratch prefix>.p, .s and .j are scratch files.
readset_vs_want() { # <cand> <keys dir> <scratch prefix>
  local fx d c r k="" a=""
  local -a cf=()
  while IFS= read -r fx; do
    for d in core/fixtures tests/fixtures; do [ -d "$d/$fx" ] && break; done
    if [ ! -f "$d/$fx/cells.decl" ]; then printf '%s\tn\t\n' "$fx"
    else
      case "$d/$fx" in
        *\\*) c="$(shasum -a 256 < "$d/$fx/cells.decl" | cut -d' ' -f1)"; printf '%s\ts\t%s\n' "$fx" "$c" ;;
        *) cf[${#cf[@]}]="$d/$fx/cells.decl"; printf '%s\tp\t%s\n' "$fx" "$d/$fx/cells.decl" ;;
      esac
    fi
  done < "$1" > "$3.p" || return 1
  : > "$3.s" || return 1
  [ "${#cf[@]}" -eq 0 ] || shasum -a 256 -- "${cf[@]}" > "$3.s" 2>/dev/null
  if [ -n "${FXCOUNT_JUDGE:-}" ]; then
    if [ -n "${FXCOUNT_KEYROWS:-}" ] && [ -f "$FXCOUNT_KEYROWS" ]; then k="$FXCOUNT_KEYROWS"
    else
      k="$3.j"
      while IFS= read -r fx; do
        [ -f "$2/$fx" ] && readset_key_rows "$2/$fx" > /dev/null 2>&1 || continue
        r="$(readset_vs_judge "$fx" .)" && printf '%s\t%s\n' "$fx" "$r" || :
      done < "$1" > "$k" || return 1
    fi
  fi
  [ -f scripts/fixture-inprocess-allowlist.txt ] && a=scripts/fixture-inprocess-allowlist.txt
  VA="$a" VS="$3.s" VK="$k" VD="$2" awk -F'\t' '
    BEGIN { if (ENVIRON["VA"] != "") while ((getline l < ENVIRON["VA"]) > 0) if (l !~ /^[[:space:]]*(#|$)/) { t = index(l, "\t"); L[t ? substr(l, 1, t - 1) : l] = 1 }
      while ((getline l < ENVIRON["VS"]) > 0) if (substr(l, 65, 2) == "  ") S[substr(l, 67)] = substr(l, 1, 64)
      vj = (ENVIRON["VK"] != "")
      if (vj) while ((getline l < ENVIRON["VK"]) > 0) { t = index(l, "\t"); f = t ? substr(l, 1, t - 1) : l; if (f in J) continue
        r = t ? substr(l, t + 1) : ""; t = index(r, "\t"); J[f] = t ? substr(r, 1, t - 1) : r }
      kd = ENVIRON["VD"] }
    { k = kd "/" $1; n = 0
      while ((getline l < k) > 0) if (l !~ /^#(format|state|tools|pending|modes) / && l !~ /^#mode[[:blank:]]/) R[++n] = l
      close(k)
      if (!n) next
      print $1 "\tI\t#inproc " (($1 in L) ? "listed" : "unlisted") " " (($2 == "n") ? "none" : ($2 == "s") ? $3 : (($3 in S) ? S[$3] : ""))
      if (vj && ($1 in J) && substr(J[$1], 1, 8) == "#judge f") print $1 "\tJ\t" J[$1]
      for (i = 1; i <= n; i++) print $1 "\tR\t" R[i] }' "$3.p"
}
# READSET_VS_END
# RECORD_HOME_BEGIN
# EVERY PASS AND KEY RECORD LIVES IN THE SHARED VERDICT STORE BASE, NEVER UNDER A CLONE'S GIT DIR, so every clone and
# worktree of one repository reads the records any of them wrote. `rec_home <var> <kind>` sets <var> to
# `<base>/<kind>/<repository root commit>`: <base> is AI_DLC_VERDICT_STORE (default ~/.cache/ai-dlc/verdicts) with a
# counted-<vk> suffix stripped, the root commit is readset_vs_store's, resolved once per process (REC_ROOT).
# STORE OFF (no base, a shallow clone, no root commit) sets REC_OFF, a path under /dev/null: nothing under it can be
# read or created, so every record reads absent, every write fails, and every unit runs with nothing recorded.
# `rec_import <legacy> <record>` is the one-time carry-forward of a record an older hook kept under the git dir: it
# copies <legacy> (a file or a directory) to <record> only when <record> is absent and <legacy> present, through a
# temp beside <record> and a rename, never removes <legacy>, and returns 0 only when it copied.
# The pre-push gate, scripts/pregate-self-check.sh, scripts/predict-push-set.sh and
# core/scripts/derive-fixture-readsets.sh source this span and READSET_VS by their sentinel lines.
# The verified record's format stamp is a sidecar, never a header line, so the record stays pure `path<TAB>sha` rows.
REC_OFF=/dev/null/ai-dlc-verdict-store-off
rec_home() { # <var> <kind>; <var> must not be rh_b or rh_p
  local rh_b="${AI_DLC_VERDICT_STORE:-}" rh_p
  [ -n "$rh_b" ] || [ -z "${HOME:-}" ] || rh_b="$HOME/.cache/ai-dlc/verdicts"
  case "${rh_b##*/}" in counted-????????????) rh_b="${rh_b%/*}" ;; esac
  case "$rh_b" in ''|/*) ;; *) rh_b="$PWD/$rh_b" ;; esac
  if [ -z "${REC_ROOT:-}" ] && [ -n "$rh_b" ]; then rh_p="$(readset_vs_store "$PWD")"; REC_ROOT="${rh_p##*/}"; fi
  if [ -n "$rh_b" ] && [ -n "${REC_ROOT:-}" ]; then printf -v "$1" '%s/%s/%s' "$rh_b" "$2" "$REC_ROOT"
  else printf -v "$1" '%s' "$REC_OFF"; fi
}
rec_import() { # <legacy> <record>
  [ -e "$1" ] && [ ! -e "$2" ] || return 1
  mkdir -p "${2%/*}" 2>/dev/null || return 1
  rm -rf "$2.imp.$$" 2>/dev/null
  if cp -Rp "$1" "$2.imp.$$" 2>/dev/null && [ ! -e "$2" ] && mv "$2.imp.$$" "$2" 2>/dev/null; then return 0; fi
  rm -rf "$2.imp.$$" 2>/dev/null
  return 1
}
rec_home VERIFIED_RECORD fixture-verified
VERIFIED_FORMAT="$VERIFIED_RECORD.format"
rec_home KEYS_DIR fixture-keys
CL_KEYS_DIR="$REC_OFF"
# RECORD_HOME_END
READSET_MEMO=""
readset_memo_on() { # the memo is on only at depth 0 (BL-1163); a hook a fixture starts is deeper and reads no store
  [ "$POOL_DEPTH_IN" -ne 0 ] || { rec_home READSET_MEMO readset-memo; [ "$READSET_MEMO" != "$REC_OFF" ] || READSET_MEMO=""; }
}
# A DECLARED FIXTURE'S KEY ROWS, ONE COMPOSER. This hook and hermetic-run.sh both source this span -- the runner at
# top level, the way it sources READSET_TOOLS -- so the declaration is parsed, and the key rows composed, by ONE
# implementation: there is no second composer to hold equal by a census. A code change here adds a `# VS-IDENTITY` row under
# the current READSET_VS_FORMAT when stored entries keep their meaning, or bumps READSET_VS_FORMAT when they do not (the
# `verdict-store identity` step), so an entry written under one composer is never reused under the next.
#   readset_span_sha  <file> <NAME>: the sha256 of the `# NAME_BEGIN`..`# NAME_END` span with every comment line (first
#     non-blank character `#`) and blank line dropped, so a comment edit moves no key and no identity.
#   readset_decl_parse  ONE fixture's inputs.decl and tools.decl -> rows `<fx>\t<kind>\t...`:
#     N                           the fixture is declared (always the first row)
#     F|D <path> <req> <declared> a declared file / directory, mapped to the consumer layout where the
#                                 declaration names core/ there; <declared> is the spelling before the map
#     T <abs path> | U <name>     a keyed tool resolved against <tool search path> | an unkeyed `?name`
#     X <class> <detail>          a refusal; each caller words it (the hook as a .dunres row, the runner on stderr)
#     P <path> <sha256>           a `+` file's key row, hashed HERE from the root (the cwd); see `+` below
#   Normalisation is owned here and nowhere else: `#` and blank lines dropped, a trailing CR stripped, a leading
#   `!` (REQUIRED) or a leading `+` (KEYED) recorded and stripped -- never both on one line (`plusbang`: the
#   other inputs.decl readers strip a single `!`), ALL trailing `/` stripped from a directory. An absolute path
#   or a `..` component refuses the declaration BEFORE the mapper runs, which is fed exactly these normalised
#   paths.
#   `+` KEYS A DECLARED FILE THAT SITS OUTSIDE THE UNIVERSE (an excluded top, such as the dev-repo backlog). Such a file has
#   no `.now` row, so readset_decl_keys has nothing to read its value from; the parse hashes it and emits a P row,
#   which readset_decl_keys turns into an ordinary key row. The F row is emitted as for any declared file, so the
#   sandbox copies it unchanged. `+` on a DIRECTORY is refused (`plusdir`): a directory under an excluded top has
#   no listing either, and keying its files one by one would be a second manifest. A `+` file that cannot be hashed
#   is refused (`plushash`), never keyed on an empty value. scripts/suite-content-key.sh hashes the same `+` set
#   into the OUTER key, so a push changing only such a file reaches this key at all.
#   A keyed tool and an unkeyed `?name` sharing a basename, or two keyed paths sharing one, are refused (`dup`).
#   readset_decl_tool_hashes  append `<abs path>\t<sha256>` to <tool hash file> for each T row it lacks.
#   readset_decl_keys  ONE awk pass over a `.now` manifest for EVERY fixture in <parse rows>: prints
#     `<fx>\t<key>\t<value>`, the record grammar the hook's decision compares: each declared file present in
#     <now> (its manifest hash, never recomputed), every file under a declared directory, `<dir>/` with the
#     `#listing:` value from <ls.now> for the declared directory and every directory between it and such a file
#     (readset_listings' grammar: immediate entry names implied by the file list, never readdir), every file
#     under the fixture's own directory, each T tool, and each P row (a `+` file). A declared path absent from
#     <now> -- an excluded top, a git-ignored file -- has NO row on either side unless it is declared `+`.
#     ANOTHER FIXTURE'S invocations.decl OR inputs.decl IS NOT KEYED THROUGH A DECLARED DIRECTORY. Keying them made each
#     fixture declaring core/ or core/fixtures/ whole re-run whenever any fixture edited either one. A fixture that
#     reads another one's decl declares that file by name, or every one through a `core/fixtures/*/inputs.decl` line
#     (F rows, expanded by readset_decl_parse), and its own decls stay keyed.
#     THE RUNNER ROW: every fixture is keyed on hermetic-run.sh (core/scripts/ here, scripts/ai-dlc/ in a consumer)
#     whether or not its inputs.decl names it, under the key `<runner path>#HR_SANDBOX` with the sha256 of the
#     runner's HR_SANDBOX span (readset_span_sha, the value readset_vs_ident digests as `#runner`), and under
#     `<runner path>#HR_EXIT` with readset_tail_sha of the runner (its exit mapping, after its last function), because every declared fixture
#     runs through that span -- an edit inside it moves every declared key, an edit outside it (store code, the
#     header) moves none. Only a runner path present in <now> is keyed, read under hermetic-run.sh's HR_ROOT when it is
#     the caller (it keys a root other than its cwd), else under the cwd. A fixture that declares the runner by name
#     is also keyed on its whole-file hash, as for any declared file.
# READSET_KEYROWS_BEGIN
readset_span_sha() { # <file> <NAME> [raw]: `raw` keeps comment and blank lines (a declared span: its reader may read them)
  local h x="" nl=1
  if [ "${3:-}" = raw ]; then IFS= read -r -d '' x < "$1" 2>/dev/null || :; [ -z "$x" ] || [ "${x: -1}" = $'\n' ] || nl=0; fi
  h="$(B="# ${2}_BEGIN" E="# ${2}_END" R="${3:-}" NL="$nl" awk 'BEGIN { b = ENVIRON["B"]; e = ENVIRON["E"]; r = (ENVIRON["R"] == "raw") }
    function out(s) { if (r) { printf "%s%s", (p ? "\n" : ""), s; p = 1; l = NR } else if (s !~ /^[[:space:]]*(#|$)/) print s }
    !on { if ($0 != b) next; on = 1; out($0); next } { out($0) } $0 == e { on = 0 }
    END { if (p && (ENVIRON["NL"] == "1" || l != NR)) printf "\n" }' "$1" | shasum -a 256)"
  printf '%s\n' "${h%% *}"
}
#   readset_section  <file> <heading>: the lines of the FIRST section of <file> headed <heading> (a line equal to it, or
#     opening with it and a space) up to, not including, the next line opening with the heading's own `#` run and a
#     space; nothing when no line heads one. readset_section_of <fixture dir> <declared path>: the heading that
#     fixture's section.decl names for that `+` path (`<path> <heading>`, `#` lines and blanks skipped), or nothing.
#     A `+` file with a section is keyed on its section alone, here and in scripts/suite-content-key.sh, which sources
#     this function from this span: an edit elsewhere in the file moves neither key. The fixture's own read of the file
#     must lie inside that section.
readset_section() {
  H="$2" awk 'BEGIN { h = ENVIRON["H"]; m = substr(h, 1, index(h, " ")) }
    on && index($0, m) == 1 { exit } !on && ($0 == h || index($0, h " ") == 1) { on = 1 } on { print }' "$1"
}
readset_section_of() {
  [ -f "$1/section.decl" ] || return 0
  P="$2" awk '$0 ~ /^[[:space:]]*(#|$)/ { next }
    { i = index($0, " "); if (i > 1 && substr($0, 1, i - 1) == ENVIRON["P"]) { h = substr($0, i + 1); print (h ~ /^#+ [^ ]/) ? h : "!"; exit } }' "$1/section.decl"
}
readset_tail_sha() { # <file>: the top-level lines after its last line that is exactly `}`, comments and blanks dropped
  local h
  h="$(awk '{ a[NR] = $0 } $0 == "}" { e = NR } END { for (i = e + 1; i <= NR; i++) if (a[i] !~ /^[[:space:]]*(#|$)/) print a[i] }' "$1" | shasum -a 256)"
  printf '%s\n' "${h%% *}"
}
#   readset_decl_batch  <entries> <dist|cons> [<premap>] [m]: the inputs.decl parse of EVERY entry (`<fx>\t<inputs.decl>\t<scratch
#     prefix>`) in ONE awk, so a declared set costs one start, not one per fixture. Each entry's fx and its `.p .r .mi .f`
#     paths reach awk as assignment operands, escape-processed as a `-v` value is; `.n .m .b` are the raw prefix. Per
#     entry it writes the rows (`.n`), the unmapped five-field rows (`.r`), the mapper input (`.mi`, a D row with its
#     `/`), the `+` paths (`.p`), the flags (`.f`: `<core line> <F row spelling /*/>`) and `.b`: `<status> <joined>`,
#     status 0, 3 (a refusal: `.n` holds the X rows), 2 (unreadable) or 4 (mapcount). THE ONE JOIN, consumer layout, a
#     declaration with a core/ line: its mapped paths come from a PREMAP (`<mapper input>\t<mapper output>` rows, one
#     mapper start for a whole list of fixtures) holding every mapper input, written to `.m`, or, with `m`, from the
#     mapper's own `.m`, line by line, whose count must equal the rows'. The join rewrites `.r` and `.f` and `<joined>` is
#     1; a premap lacking a line leaves `<joined>` 0 and readset_decl_parse starts the mapper for that fixture alone.
readset_decl_batch() {
  local en="$1" lay="$2" pm="" md="${4:-}" e1 e2 e3 n=0
  [ -z "${3:-}" ] || [ ! -f "$3" ] || pm="$3"
  printf '\n' > "$en.mk" || return 0
  set --
  while IFS=$'\t' read -r e1 e2 e3; do
    n=$((n + 1))
    if [ -r "$e2" ]; then set -- "$@" "fx=$e1" "pl=$e3.p" "rf=$e3.r" "mf=$e3.mi" "ff=$e3.f" ur=0 "$e2" "$en.mk"
    else set -- "$@" "fx=$e1" "pl=$e3.p" "rf=$e3.r" "mf=$e3.mi" "ff=$e3.f" ur=1 "$en.mk"
      # the open error the per-fixture awk printed for an unopenable inputs.decl, by an awk that opens it
      awk '{ }' "$e2" < /dev/null > /dev/null; fi
  done < "$en"
  [ "$#" -gt 0 ] || return 0
  RB_E="$en" RB_N="$n" RB_L="$lay" RB_M="$pm" RB_J="$md" awk 'BEGIN { en = ENVIRON["RB_E"]; mk = en ".mk"; lay = ENVIRON["RB_L"]; pmf = ENVIRON["RB_M"]
      jm = (ENVIRON["RB_J"] == "m")
      if (lay == "cons" && pmf != "") { pmok = 1; while ((g = (getline l < pmf)) > 0) { split(l, a, "\t"); PM[a[1]] = a[2] }
        if (g < 0) pmok = 0; close(pmf) } }
    function fin(   i, st, j, raw, w, t, nm, l, g, q, p, f2) {
      raw = ""; getline raw < en; t = index(raw, "\t"); w = substr(raw, t + 1); w = substr(w, index(w, "\t") + 1)
      printf "" > pl; for (i = 1; i <= np; i++) print PB[i] > pl; close(pl)
      printf "" > rf; for (i = 1; i <= nn; i++) print NL[i] "\t" RB[i] > rf; close(rf)
      printf "" > mf; for (i = 1; i <= nn; i++) print MI[i] > mf; close(mf)
      printf "" > (w ".n"); for (i = 1; i <= no; i++) print OB[i] > (w ".n"); close(w ".n")
      st = ur ? 2 : (bad ? 3 : 0); j = 0
      if (!ur) { print (fc + 0) " " (fg + 0) > ff; close(ff) }
      if (st == 0 && lay == "cons" && fc == 1) {
        if (jm) { nm = 0; while ((g = (getline l < (w ".m"))) > 0) MM[++nm] = l; close(w ".m"); j = 1 }
        else if (pmok) { j = 1; for (i = 1; i <= nn; i++) if (!(MI[i] in PM)) { j = 0; break }
          if (j) { nm = nn; for (i = 1; i <= nn; i++) { MM[i] = PM[MI[i]]; print MM[i] > (w ".m") }; close(w ".m") } }
        if (j && nm != nn) { st = 4; j = 0 }
        else if (j) { f2 = 0
          for (i = 1; i <= nn; i++) { split(NL[i], q, "\t"); p = MM[i]; sub(/\/+$/, "", p)
            print q[1] "\t" q[2] "\t" p "\t" q[4] "\t" q[3] > rf; if (q[2] == "F" && index(p, "/*/")) f2 = 1 }
          close(rf); print "1 " (f2 + 0) > ff; close(ff) } }
      print st " " j > (w ".b"); close(w ".b")
      bad = 0; fc = 0; fg = 0; nn = 0; np = 0; no = 0; nfin++ }
    END { if (nfin != ENVIRON["RB_N"] + 0) printf "readset_decl_batch: %d of %d entries scanned\n", nfin, ENVIRON["RB_N"] > "/dev/stderr" }
    FILENAME == mk { fin(); next }
    { sub(/\r$/, ""); if ($0 == "" || $0 ~ /^#/) next
      r = 0; x = 0; while ((c = substr($0, 1, 1)) == "!" || c == "+") { if (c == "!") r = 1; else x = 1; $0 = substr($0, 2) }
      if (r && x) { OB[++no] = fx "\tX\tplusbang\t" $0; bad = 1; next }
      if ($0 ~ /^\// || $0 ~ /(^|\/)\.\.(\/|$)/) { OB[++no] = fx "\tX\tabs\t" $0; bad = 1; next }
      k = "F"; if ($0 ~ /\/$/) { k = "D"; sub(/\/+$/, "") }
      if (x && k == "D") { OB[++no] = fx "\tX\tplusdir\t" $0; bad = 1; next }
      if (x && $0 != "") PB[++np] = $0
      if ($0 != "") { nn++; NL[nn] = fx "\t" k "\t" $0 "\t" r; RB[nn] = $0; MI[nn] = $0 ((k == "D") ? "/" : ""); OB[++no] = NL[nn]
        if ($0 == "core" || index($0, "core/") == 1) fc = 1
        if (k == "F" && index($0, "/*/")) fg = 1 } }' "$@"
}
#   readset_decl_hashes  <entries>: after readset_decl_batch over the same entries, the sha256 of every `+` file those
#     parses will hash, taken in ONE shasum and written to each `+`-declaring entry's `<scratch prefix>.h` as
#     `<path>\t<sha256>`; readset_decl_parse (`pre`) reads its path there and hashes alone any path the file lacks.
#     A shasum whose output does not name the listed paths in order leaves every `.h` empty.
readset_decl_hashes() {
  local en="$1" e1 e2 e3 t k p rq dp q pl u=$'\n' list=$'\n' glist=$'\n' n=0 o hc="" hg="" l
  while IFS=$'\t' read -r e1 e2 e3; do
    : > "$e3.h"
    if [ -s "$e3.gq" ]; then
      : > "$e3.gh"
      while IFS= read -r q || [ -n "$q" ]; do
        [ -f "$q" ] || continue
        case "$list" in *"$u$q$u"*) ;; *) list="$list$q$u"; glist="$glist$q$u"; n=$((n + 1)) ;; esac
      done < "$e3.gq"
    fi
    [ -s "$e3.p" ] || continue
    pl=$u; while IFS= read -r q || [ -n "$q" ]; do pl="$pl$q$u"; done < "$e3.p"
    while IFS=$'\t' read -r t k p rq dp; do
      [ "$k" = F ] || continue
      case "$pl" in *"$u$dp$u"*) ;; *) continue ;; esac
      case "$p" in *"$u"*) continue ;; esac
      [ -f "$p" ] || continue
      case "$list" in *"$u$p$u"*) ;; *) list="$list$p$u"; n=$((n + 1)) ;; esac
    done < "$e3.r"
  done < "$en"
  [ "$n" -gt 0 ] || return 0
  set --; while IFS= read -r p; do [ -z "$p" ] || set -- "$@" "$p"; done <<<"$list"
  o="$(shasum -a 256 -- "$@" 2>/dev/null)" || return 0
  while IFS= read -r l; do
    [ "$#" -gt 0 ] && [ "${l:66}" = "$1" ] || return 0
    case "$glist" in *"$u$1$u"*) hg="$hg$1"$'\t'"${l%% *}"$'\n' ;; *) hc="$hc$1"$'\t'"${l%% *}"$'\n' ;; esac
    shift
  done <<<"$o"
  [ "$#" -eq 0 ] || return 0
  while IFS=$'\t' read -r e1 e2 e3; do
    [ ! -s "$e3.p" ] || printf '%s' "$hc" > "$e3.h"
    [ ! -s "$e3.gq" ] || printf '%s' "$hg" > "$e3.gh"
  done < "$en"
}
readset_decl_parse() { # <fx> <fixture dir> <dist|cons> <mapper, or empty> <tool search path> <scratch prefix> [<premap>] [pre]
  local fx="$1" fd="$2" lay="$3" mp="$4" xpd="$5" w="$6" pm="${7:-}" t k p rq dp name found seen="|" ga gb gn gf ge xr fc=0 fg=0 xs="" xl rb rj gx="" pl="" pfl="" hp hh
  printf '%s\tN\n' "$fx"
  # `pre`: the caller already ran readset_decl_batch over an entry naming this fixture and <scratch prefix>.
  if [ "${8:-}" != pre ]; then
    printf '%s\t%s\t%s\n' "$fx" "$fd/inputs.decl" "$w" > "$w.e1"
    readset_decl_batch "$w.e1" "$lay" "$pm"
  fi
  read -r rb rj < "$w.b" || { rb=2; rj=0; }
  if [ "$rb" != 0 ]; then awk -F'\t' '$2 == "X"' "$w.n"; return 0; fi
  read -r fc fg < "$w.f" || { fc=0; fg=0; }
  if [ "$lay" = cons ] && [ "$fc" = 1 ]; then
    if [ -z "$mp" ] || [ ! -f "$mp" ]; then printf '%s\tX\tnomap\t%s\n' "$fx" "$mp"; return 0; fi
    # A declaration the premap did not answer whole starts the mapper for this fixture alone, and readset_decl_batch's
    # one join (`m`) reads its output, with the mapper's own count check (mapcount).
    if [ "$rj" != 1 ]; then
      bash "$mp" --map < "$w.mi" > "$w.m" 2> "$w.e" \
        || { printf '%s\tX\tmaprefuse\t%s\n' "$fx" "$(sed -n 1p "$w.e" | tr '\t' ' ')"; return 0; }
      printf '%s\t%s\t%s\n' "$fx" "$fd/inputs.decl" "$w" > "$w.e1"
      readset_decl_batch "$w.e1" "$lay" "" m
      read -r rb rj < "$w.b" || rb=2
      [ "$rb" = 0 ] || { printf '%s\tX\tmapcount\t-\n' "$fx"; return 0; }
    fi
    read -r fc fg < "$w.f" || fg=0
  fi
  # A `<dir>/*/<name>` LINE expands here, after mapping, into one F row per file on disk matching it, each carrying the
  # line as its declared spelling. A fixture that reads every fixture's inputs.decl declares `core/fixtures/*/inputs.decl`.
  # Any other `*` spelling, or one matching nothing, stays one row and is refused absf below.
  if [ "$fg" = 1 ]; then
    while IFS=$'\t' read -r t k p rq dp; do
      ga="${p%%/\**}"; gb="${p##*/}"; gn=0
      if [ "$k" = F ] && [ -n "$ga" ] && [ "$p" = "$ga/*/$gb" ]; then case "$ga$gb" in *\**) ;; *)
        case $- in *f*) gf=1; set +f ;; *) gf=0 ;; esac
        for ge in "$ga"/*/"$gb"; do [ -f "$ge" ] || continue; printf -v xl '%s\tF\t%s\t%s\t%s\n' "$t" "$ge" "$rq" "$dp"; gx="$gx$xl"; gn=$((gn + 1)); done
        [ "$gf" = 0 ] || set -f ;; esac; fi
      [ "$gn" -gt 0 ] || { printf -v xl '%s\t%s\t%s\t%s\t%s\n' "$t" "$k" "$p" "$rq" "$dp"; gx="$gx$xl"; }
    done < "$w.r"
    printf '%s' "$gx" > "$w.r"
  fi
  # The rows, then the refusals of the rows absent ON DISK under the root (the cwd): -f for a file, -d for a
  # directory. A path on disk but outside the universe (an excluded top, a git-ignored file) is NOT refused; it
  # simply has no key row. One builtin pass prints both, rows first, so no fork prints `.r`.
  if [ -s "$w.p" ]; then
    pl=$'\n'; while IFS= read -r p || [ -n "$p" ]; do pl="$pl$p"$'\n'; done < "$w.p"
  fi
  while IFS=$'\t' read -r t k p rq dp; do
    printf '%s\t%s\t%s\t%s\t%s\n' "$t" "$k" "$p" "$rq" "$dp"
    if [ "$k" = D ]; then [ -d "$p" ] || { printf -v xl '%s\tX\tabsd\t%s\t%s\n' "$fx" "$p" "$dp"; xs="$xs$xl"; }
    else [ -f "$p" ] || { printf -v xl '%s\tX\tabsf\t%s\t%s\n' "$fx" "$p" "$dp"; xs="$xs$xl"; }; fi
    if [ -n "$pl" ] && [ "$k" = F ]; then case "$pl" in *$'\n'"$dp"$'\n'*) pfl="$pfl$p"$'\t'"$dp"$'\n' ;; esac; fi
  done < "$w.r"
  printf '%s' "$xs"
  # THE `+` ROWS, keyed on the declared spelling (field 5) so a mapped path still finds its marker. An absent file
  # is already refused (absf) above and gets no row. `.pf` is the `+` rows of `.r`, collected by the loop above.
  if [ -s "$w.p" ]; then
    printf '%s' "$pfl" > "$w.pf"
    while IFS=$'\t' read -r p dp; do
      [ -f "$p" ] || continue
      t=""; [ ! -f "$fd/section.decl" ] || t="$(readset_section_of "$fd" "$dp")"
      if [ "$t" = '!' ]; then printf '%s\tX\tplussect\t%s\n' "$fx" "$p"; continue
      elif [ -n "$t" ]; then dp="$(readset_section "$p" "$t" | shasum -a 256 | cut -d' ' -f1)"
      else
        # the hash readset_decl_hashes took for this path in the one shasum of the pre-pass, else its own
        dp=""
        if [ "${8:-}" = pre ] && [ -s "$w.h" ]; then
          while IFS=$'\t' read -r hp hh; do [ "$hp" != "$p" ] || { dp="$hh"; break; }; done < "$w.h"
        fi
        if [ -z "$dp" ]; then dp="$(shasum -a 256 -- "$p" 2>/dev/null)"; dp="${dp%% *}"; fi
      fi
      if [ "${#dp}" -eq 64 ]; then printf '%s\tP\t%s\t%s\n' "$fx" "$p" "$dp"; else printf '%s\tX\tplushash\t%s\n' "$fx" "$p"; fi
    done < "$w.pf"
  fi
  [ ! -f "$fd/spans.decl" ] || readset_decl_spans "$fx" "$fd" "$lay" "$mp" "$w"
  if [ -f "$fd/git.decl" ]; then
    if [ "${8:-}" = pre ] && [ -f "$w.gr" ]; then readset_decl_rangerows "$fx" "$w"; else readset_decl_ranges "$fx" "$fd" "$w"; fi
  fi
  [ -f "$fd/tools.decl" ] || return 0
  while IFS= read -r t || [ -n "$t" ]; do
    case "$t" in ''|'#'*) continue ;; esac
    case "$t" in
      '?'*)
        name="${t#?}"
        case "$name" in ''|*[!A-Za-z0-9_.+-]*) printf '%s\tX\tqbad\t%s\n' "$fx" "$t"; continue ;; esac
        case " $READSET_UNKEYED_TOOLS " in *" $name "*) ;; *) printf '%s\tX\tqout\t%s\n' "$fx" "$t"; continue ;; esac
        case "$seen" in *"|$name=?|"*) continue ;; *"|$name="*) printf '%s\tX\tdup\t%s\n' "$fx" "$name"; continue ;; esac
        seen="$seen$name=?|"; printf '%s\tU\t%s\n' "$fx" "$name"
        continue ;;
    esac
    case "$t" in */*) printf '%s\tX\ttpath\t%s\n' "$fx" "$t"; continue ;; esac
    # THE SEARCH PATH IS WALKED WITH BUILTINS, ONE FIELD PER `:`, FIRST MATCH WINS: no fork per tools.decl line. The
    # fields are those of an IFS=: word split (an empty field is kept, a trailing `:` adds none, an empty path has none).
    found=""; xr="$xpd"
    while [ -n "$xr" ]; do
      p="${xr%%:*}"
      case "$xr" in *:*) xr="${xr#*:}" ;; *) xr="" ;; esac
      [ -x "$p/$t" ] && { found="$p/$t"; break; }
    done
    [ -n "$found" ] || { printf '%s\tX\ttnone\t%s\n' "$fx" "$t"; continue; }
    case "$seen" in *"|${found##*/}=$found|"*) continue ;; *"|${found##*/}="*) printf '%s\tX\tdup\t%s\n' "$fx" "${found##*/}"; continue ;; esac
    seen="$seen${found##*/}=$found|"; printf '%s\tT\t%s\n' "$fx" "$found"
  done < "$fd/tools.decl"
  return 0
}
# readset_decl_spans: each `<path> <NAME>` line of a fixture's spans.decl keys ONE span of a file instead of the whole
#   file. Per line: an F row (the sandbox copies the file; its <declared> field is `<path>#<NAME>`, which
#   readset_decl_keys never keys whole) and a P row `<path>#<NAME>` valued `readset_span_sha <path> <NAME> raw`.
#   `#` and blank lines dropped, a trailing CR stripped; a core/ path is mapped onto the consumer layout as in
#   inputs.decl. Refusals: spanbad (not exactly two fields, or NAME outside [A-Z0-9_]), abs, spandir (a directory),
#   absf (the file is absent), spanabsent (no `# NAME_BEGIN` or no `# NAME_END` line, so the key would hash nothing).
readset_tsv_get() { # <file> <key>: the rest of the first line of <file> opening with `<key>` and a tab, in RS_V; 1 when none
  local l k="$2"$'\t'
  RS_V=""
  while IFS= read -r l || [ -n "$l" ]; do case "$l" in "$k"*) RS_V="${l#"$k"}"; return 0 ;; esac; done < "$1"
  return 1
}
readset_span_scan() { # <rows `<i>\t<path>\t<NAME>`> <scratch prefix> <out>: `<i>\t<1 if the file has a NAME_BEGIN and a NAME_END line>` to <out>, each BEGIN..END span's text to <prefix>.sp.<i>
  awk -F'\t' -v w="$2" '{ i = $1; p = $2; B = "# " $3 "_BEGIN"; E = "# " $3 "_END"; hb = 0; he = 0; on = 0; f = w ".sp." i; printf "" > f; n = 0; lp = 0; c = 0
      while ((g = (getline l < p)) > 0) { n++; if (l == B) hb = 1; if (l == E) he = 1
        if (on) { printf "%s%s", (c++ ? "\n" : ""), l > f; lp = n; if (l == E) on = 0 } else if (l == B) { printf "%s%s", (c++ ? "\n" : ""), l > f; lp = n; on = 1 } }
      close(p); RS = "\001"; z = ""; while ((getline r < p) > 0) z = r; close(p); RS = "\n"
      if (c && !(lp == n && z != "" && substr(z, length(z)) != "\n")) printf "\n" > f
      close(f); print i "\t" ((hb && he) ? 1 : 0) }' "$1" > "$3"
}
#   readset_decl_spansbatch  <entries> <dist|cons> <mapper, or empty>: the spans.decl work of EVERY entry's fixture at once, after
#     readset_decl_batch: one mapper start over the paths of the fixtures that declare a core/ span (consumer layout), one awk
#     and one shasum over every (file, NAME) present. `<entries>.spm` is `<declared path>\t<mapped path>` and `<entries>.spc`
#     `<mapped path>\t<NAME>\t<1|0>\t<sha256>`; readset_decl_spans (RS_SPC naming `<entries>`) reads them, and does the work
#     itself for a fixture any of whose rows they lack. A refused mapper, a count that differs or a shasum that does not
#     name the listed files in order leaves the cache without those rows.
readset_decl_spansbatch() {
  local en="$1" lay="$2" mp="$3" e1 e2 e3 fd ln a b c u=$'\n' tb=$'\t' ul="" pr="" pc=0 fl row i k m="" nm=0 nq=0 q="" hs hl nh ni nl=0
  local -a ua ub
  : > "$en.spm"; : > "$en.spc"
  while IFS=$'\t' read -r e1 e2 e3; do
    fd="${e2%/inputs.decl}"; [ -f "$fd/spans.decl" ] || continue
    row=""; pc=0
    while IFS= read -r ln || [ -n "$ln" ]; do
      ln="${ln%$'\r'}"
      case "$ln" in ''|'#'*) continue ;; esac
      read -r a b c <<<"$ln"
      case "$b" in ''|*[!ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_]*) continue ;; esac
      [ -z "$c" ] || continue
      case "$a" in /*|..|../*|*/../*|*/..|*/) continue ;; esac
      row="$row$a$tb$b$u"
      case "$a" in core|core/*) pc=1 ;; esac
    done < "$fd/spans.decl"
    [ -n "$row" ] || continue
    fl=0
    if [ "$lay" = cons ] && [ "$pc" = 1 ]; then
      fl=1
      while IFS=$'\t' read -r a b; do [ -z "$a" ] || case "$ul" in *"$u$a$u"*) ;; *) ul="$ul$a$u" ;; esac; done <<<"$row"
    fi
    while IFS=$'\t' read -r a b; do [ -z "$a" ] || pr="$pr$fl$tb$a$tb$b$u"; done <<<"$row"
  done < "$en"
  [ -n "$pr" ] || return 0
  if [ -n "$ul" ] && [ -n "$mp" ] && [ -f "$mp" ]; then
    printf '%s' "${ul#"$u"}" | bash "$mp" --map 2>/dev/null > "$en.spmo" || : > "$en.spmo"
    nm=0; while IFS= read -r ln || [ -n "$ln" ]; do ua[$nm]="$ln"; nm=$((nm + 1)); done < "$en.spmo"
    nl=0; while IFS= read -r ln; do [ -z "$ln" ] || nl=$((nl + 1)); done <<<"$ul"
    if [ "$nm" = "$nl" ]; then
      i=0; while IFS= read -r ln; do [ -z "$ln" ] || { printf '%s\t%s\n' "$ln" "${ua[$i]}" >> "$en.spm"; i=$((i + 1)); }; done <<<"$ul"
    fi
  fi
  : > "$en.spq"; m="$u"
  while IFS=$'\t' read -r fl a b; do
    [ -n "$fl" ] || continue
    if [ "$fl" = 1 ]; then readset_tsv_get "$en.spm" "$a" || continue; a="$RS_V"; fi
    [ -f "$a" ] || continue
    case "$m" in *"$u$a$tb$b$u"*) continue ;; esac
    m="$m$a$tb$b$u"; printf '%s\t%s\t%s\n' "$nq" "$a" "$b" >> "$en.spq"; nq=$((nq + 1))
  done <<<"$pr"
  [ "$nq" -gt 0 ] || return 0
  readset_span_scan "$en.spq" "$en" "$en.spk"
  set --
  while IFS=$'\t' read -r i k; do [ "$k" != 1 ] || { ub[$#]="$i"; set -- "$@" "$en.sp.$i"; }; done < "$en.spk"
  if [ "$#" -gt 0 ]; then
    hs="$(shasum -a 256 -- "$@" 2>/dev/null)" || return 0
    k=0
    while IFS= read -r hl; do
      [ -n "$hl" ] || continue
      [ "$k" -lt "$#" ] && [ "${hl:66}" = "$en.sp.${ub[$k]}" ] || return 0
      q="$q${ub[$k]}$tb${hl%% *}$u"; k=$((k + 1))
    done <<<"$hs"
    [ "$k" = "$#" ] || return 0
  fi
  while IFS=$'\t' read -r i a b; do
    nh=""
    while IFS=$'\t' read -r ni hl; do [ "$ni" != "$i" ] || { nh="$hl"; break; }; done <<<"$q"
    if [ -n "$nh" ]; then printf '%s\t%s\t1\t%s\n' "$a" "$b" "$nh" >> "$en.spc"; else printf '%s\t%s\t0\t\n' "$a" "$b" >> "$en.spc"; fi
  done < "$en.spq"
}
readset_decl_spans() { # <fx> <fixture dir> <dist|cons> <mapper, or empty> <scratch prefix>
  local fx="$1" fd="$2" lay="$3" mp="$4" w="$5" p n dp ln a b c i nv=0 nm=0 core=0 hs hl cached=0 cb="${RS_SPC:-}"
  local -a sp sn sm sk sh sq
  while IFS= read -r ln || [ -n "$ln" ]; do
    ln="${ln%$'\r'}"
    case "$ln" in ''|'#'*) continue ;; esac
    read -r a b c <<<"$ln"
    case "$b" in ''|*[!ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_]*) printf '%s\tX\tspanbad\t%s\n' "$fx" "$ln"; continue ;; esac
    [ -z "$c" ] || { printf '%s\tX\tspanbad\t%s\n' "$fx" "$ln"; continue; }
    case "$a" in /*|..|../*|*/../*|*/..) printf '%s\tX\tabs\t%s\n' "$fx" "$a"; continue ;; esac
    case "$a" in */) printf '%s\tX\tspandir\t%s\n' "$fx" "$a"; continue ;; esac
    sp[$nv]="$a"; sn[$nv]="$b"; nv=$((nv + 1))
    case "$a" in core|core/*) core=1 ;; esac
  done < "$fd/spans.decl"
  [ "$nv" -gt 0 ] || return 0
  if [ "$lay" = cons ] && [ "$core" = 1 ]; then
    if [ -z "$mp" ] || [ ! -f "$mp" ]; then printf '%s\tX\tnomap\t%s\n' "$fx" "$mp"; return 0; fi
    # the pre-pass's mapper start (readset_decl_spansbatch) answered every path of this fixture, or the mapper starts here
    nm=0
    if [ -n "$cb" ] && [ -s "$cb.spm" ]; then
      for ((i = 0; i < nv; i++)); do readset_tsv_get "$cb.spm" "${sp[$i]}" || break; sm[$i]="$RS_V"; nm=$((nm + 1)); done
    fi
    if [ "$nm" != "$nv" ]; then
      nm=0
      printf '%s\n' "${sp[@]}" | bash "$mp" --map 2> "$w.e" > "$w.sm" \
        || { printf '%s\tX\tmaprefuse\t%s\n' "$fx" "$(sed -n 1p "$w.e" | tr '\t' ' ')"; return 0; }
      while IFS= read -r ln || [ -n "$ln" ]; do sm[$nm]="$ln"; nm=$((nm + 1)); done < "$w.sm"
      [ "$nm" = "$nv" ] || { printf '%s\tX\tmapcount\t-\n' "$fx"; return 0; }
    fi
  else
    sm=("${sp[@]}")
  fi
  # The presence, and the span's sha, of every present file: from the pre-pass's one awk and one shasum when it holds every
  # row of this fixture, else ONE awk reads every present file of this declaration (whether it carries a `# NAME_BEGIN` and
  # a `# NAME_END` line, anywhere, and the BEGIN..END span text to `<scratch prefix>.sp.<i>`) and ONE shasum hashes those spans.
  cached=0
  if [ -n "$cb" ] && [ -s "$cb.spc" ]; then
    cached=1
    for ((i = 0; i < nv; i++)); do
      sk[$i]=0
      [ -f "${sm[$i]}" ] || continue
      readset_tsv_get "$cb.spc" "${sm[$i]}"$'\t'"${sn[$i]}" || { cached=0; break; }
      if [ "${RS_V%%$'\t'*}" = 1 ]; then sk[$i]=1; sh[$i]="${RS_V#*$'\t'}"; fi
    done
  fi
  if [ "$cached" != 1 ]; then
  : > "$w.sv"
  for ((i = 0; i < nv; i++)); do
    sk[$i]=0
    [ -f "${sm[$i]}" ] || continue
    printf '%s\t%s\t%s\n' "$i" "${sm[$i]}" "${sn[$i]}" >> "$w.sv"
  done
  if [ -s "$w.sv" ]; then
    readset_span_scan "$w.sv" "$w" "$w.sk"
    set --
    while IFS=$'\t' read -r i a; do [ "$a" != 1 ] || { sk[$i]=1; sq[$#]="$i"; set -- "$@" "$w.sp.$i"; }; done < "$w.sk"
    if [ "$#" -gt 0 ]; then
      hs="$(shasum -a 256 -- "$@")"; nm=0
      while IFS= read -r hl || [ -n "$hl" ]; do sh[${sq[$nm]}]="${hl%% *}"; nm=$((nm + 1)); done <<<"$hs"
    fi
  fi
  fi
  for ((i = 0; i < nv; i++)); do
    p="${sm[$i]}"; n="${sn[$i]}"; dp="${sp[$i]}"
    [ -f "$p" ] || { printf '%s\tX\tabsf\t%s\t%s\n' "$fx" "$p" "$dp"; continue; }
    [ "${sk[$i]}" = 1 ] || { printf '%s\tX\tspanabsent\t%s#%s\n' "$fx" "$p" "$n"; continue; }
    printf '%s\tF\t%s\t0\t%s#%s\n' "$fx" "$p" "$dp" "$n"
    printf '%s\tP\t%s#%s\t%s\n' "$fx" "$p" "$n" "${sh[$i]}"
  done
}
# readset_decl_ranges: each `range` line of a fixture's git.decl -> one G row, or one X row carrying the line.
#   range <ref-expr> <path>...   <ref-expr> is `<rev>..<rev>`, or `@<file>`: a bare file name in the fixture's own
#   directory, run with bash from the root (the cwd), whose first stdout line is that `<rev>..<rev>`. The fixture runs
#   the same file outside a sandbox, so the range has ONE derivation. Both ends resolve to commits HERE, and the row's
#   value is the sha256 of `git rev-list <base>..<theirs> -- <path>...` under literal pathspecs: a commit touching a
#   declared path moves the key, and a commit touching only other paths does not, even when it moves THEIRS.
#   G <key> <sha256> <base sha> <theirs sha>   the key is `git-range:<n>`, n the line's ordinal among range lines.
#   Refusals: rnopath (no path), rabs (a path absolute, with a .. component, or opening with -), rderive (the @file
#   is not a bare name, is absent, fails or prints nothing), rref (not `<rev>..<rev>`, or an end that is no commit),
#   rempty (a LITERAL range no commit of which touches a declared path: its ends are fixed, so the fold could never
#   move). An EMPTY @file range is accepted and keyed on the hash of the empty list: a deriver whose range is empty at
#   one HEAD gains commits later, and its key moves then.
#   Every command here reads /dev/null, never the git.decl the loop is reading.
readset_decl_ranges() { # <fx> <fixture dir> <scratch prefix> [prep]
  local fx="$1" fd="$2" w="$3" line kw ex rest out p b t der n=0 ga gl="$3.gl" pm="${4:-}"
  local -a gw
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in range|'range '*) ;; *) continue ;; esac
    n=$((n + 1)); kw=""; ex=""; rest=""; der=0
    read -r kw ex rest <<<"$line"
    [ -n "$rest" ] || { printf '%s\tX\trnopath\t%s\n' "$fx" "$line"; continue; }
    read -r -a gw <<<"$rest"; printf '%s\n' "${gw[@]}" > "$w.gp"; ga=0
    for p in "${gw[@]}"; do case "$p" in /*|-*|..|../*|*/../*|*/..) ga=1 ;; esac; done
    if [ "$ga" = 1 ]; then printf '%s\tX\trabs\t%s\n' "$fx" "$line"; continue; fi
    case "$ex" in
      @*) p="${ex#@}"; out=""; der=1
          case "$p" in ''|*/*|.*) printf '%s\tX\trderive\t%s\n' "$fx" "$line"; continue ;; esac
          [ -f "$fd/$p" ] && out="$(bash "$fd/$p" < /dev/null 2>/dev/null)" && IFS= read -r ex <<<"$out" && [ -n "$ex" ] \
            || { printf '%s\tX\trderive\t%s\n' "$fx" "$line"; continue; } ;;
    esac
    case "$ex" in *...*|-*|*..-*) printf '%s\tX\trref\t%s\n' "$fx" "$line"; continue ;; ?*..?*) ;; *) printf '%s\tX\trref\t%s\n' "$fx" "$line"; continue ;; esac
    b="${ex%%..*}"; t="${ex#*..}"
    b="$(git rev-parse -q --verify "${b}^{commit}" < /dev/null 2>/dev/null)" && t="$(git rev-parse -q --verify "${t}^{commit}" < /dev/null 2>/dev/null)" \
      || { printf '%s\tX\trref\t%s\n' "$fx" "$line"; continue; }
    set --; for p in "${gw[@]}"; do [ -z "$p" ] || set -- "$@" "$p"; done
    [ "$pm" != prep ] || gl="$w.gl.$n"
    GIT_LITERAL_PATHSPECS=1 git rev-list "${b}..${t}" -- "$@" < /dev/null > "$gl" 2>/dev/null || { printf '%s\tX\trref\t%s\n' "$fx" "$line"; continue; }
    [ -s "$gl" ] || [ "$der" = 1 ] || { printf '%s\tX\trempty\t%s\n' "$fx" "$line"; continue; }
    if [ "$pm" = prep ]; then
      printf '%s\n' "$gl" >> "$w.gq"
      printf '%s\tG\tgit-range:%s\t@%s\t%s\t%s\n' "$fx" "$n" "$gl" "$b" "$t"
      continue
    fi
    p="$(shasum -a 256 < "$gl")"; p="${p%% *}"
    printf '%s\tG\tgit-range:%s\t%s\t%s\t%s\n' "$fx" "$n" "$p" "$b" "$t"
  done < "$fd/git.decl"
}
# readset_decl_rangeprep <entries>: after readset_decl_batch over the same entries, runs readset_decl_ranges in `prep`
#   mode for each entry whose fixture carries a git.decl and whose declaration parsed (`.b` first field 0): its rows go
#   to `<scratch prefix>.gr` with each G row's hash field `@<rev-list output file>`, the rev-list files named in
#   `<scratch prefix>.gq`; readset_decl_hashes hashes them in its one shasum into `.gh`, and readset_decl_rangerows
#   prints the rows with the hash filled in (its own shasum for a file `.gh` lacks).
readset_decl_rangeprep() {
  local e1 e2 e3 fd rb rj
  while IFS=$'\t' read -r e1 e2 e3; do
    fd="${e2%/inputs.decl}"
    [ -f "$fd/git.decl" ] || continue
    read -r rb rj < "$e3.b" || continue
    [ "$rb" = 0 ] || continue
    : > "$e3.gq"
    readset_decl_ranges "$e1" "$fd" "$e3" prep > "$e3.gr"
  done < "$1"
}
readset_decl_rangerows() { # <fx> <scratch prefix>
  local fx="$1" w="$2" l a b c d e f hp hh dp
  while IFS= read -r l || [ -n "$l" ]; do
    case "$l" in
      "$fx"$'\t'G$'\t'git-range:*)
        IFS=$'\t' read -r a b c d e f <<<"$l"
        case "$d" in
          @*) dp=""
              while IFS=$'\t' read -r hp hh; do [ "$hp" != "${d#@}" ] || { dp="$hh"; break; }; done < "$w.gh"
              if [ "${#dp}" -ne 64 ]; then dp="$(shasum -a 256 < "${d#@}")"; dp="${dp%% *}"; fi
              printf '%s\tG\t%s\t%s\t%s\t%s\n' "$a" "$c" "$dp" "$e" "$f" ;;
          *) printf '%s\n' "$l" ;;
        esac ;;
      *) printf '%s\n' "$l" ;;
    esac
  done < "$w.gr"
}
readset_decl_tool_hashes() { # <parse rows> <tool hash file, appended>
  awk -F'\t' -v h="$2" 'BEGIN { while ((getline l < h) > 0) { t = index(l, "\t"); have[substr(l, 1, t - 1)] = 1 } }
    $2 == "T" && !($3 in have) { have[$3] = 1; print $3 }' "$1" > "$2.want"
  [ -s "$2.want" ] || return 0
  tr '\n' '\000' < "$2.want" | xargs -0 shasum -a 256 -- 2>/dev/null \
    | awk '{ p = $0; sub(/^[0-9a-f]+  /, "", p); print p "\t" $1 }' >> "$2"
}
#   readset_strip_keys  <dir> <fixture root> <parse rows> <out>: `<run.sh path>\t<sha256>` for each declared fixture's
#     own run.sh, the sha of its text with every comment line (first non-blank character `#`) and blank line dropped,
#     the readset_span_sha rule. Only where the EXECUTOR agrees that nothing else was dropped: the file passes bash -n
#     (so its text cannot close the wrapping function early), and bash's own re-print (declare -f) of the file wrapped
#     in a function is byte-identical to that of the stripped text wrapped alike. A `#` line inside a heredoc, a
#     multi-line string or an awk program is content: the two prints differ and the file keeps its whole-file row.
#     bash -n alone cannot see that case, since deleting such a line still parses. The wrappers are sourced only in a
#     subshell, and bash -n reads no BASH_ENV, so a counted run starts no extra bash.
readset_strip_keys() {
  local d="$1" w="$4.d" n=0 p f mf=""
  rm -rf "$w" && mkdir -p "$w" && : > "$4" || return 0
  : > "$w/all"; : > "$w/res"; : > "$w/l"; : > "$w/ms"; : > "$w/keep"; : > "$w/new"; : > "$w/ne"
  [ -z "${6:-}" ] || [ -z "${7:-}" ] || [ ! -s "${5:-}" ] || mf="$6/strip.${2//\//_}"
  RS_N="${5:-}" RS_M="$mf" RS_I="${7:-}" RS_W="$w" awk -F'\t' -v r="$2" 'BEGIN { w = ENVIRON["RS_W"]; id = ENVIRON["RS_I"]
      if (ENVIRON["RS_M"] != "") {
        while ((getline l < ENVIRON["RS_N"]) > 0) { t = index(l, "\t"); NS[substr(l, 1, t - 1)] = substr(l, t + 1) }
        while ((getline l < ENVIRON["RS_M"]) > 0) { k = split(l, a, "\t")
          if (k == 4 && a[4] == "end" && a[2] == id && length(a[1]) == 64 && a[1] ~ /^[0-9a-f]+$/ && (a[3] == "whole" || (length(a[3]) == 64 && a[3] ~ /^[0-9a-f]+$/))) M[a[1]] = a[3] } } }
    $2 == "N" { p = r $1 "/run.sh"; print p > (w "/all"); s = (p in NS) ? NS[p] : ""
      if (s != "" && (s in M)) { print p "\t" M[s] > (w "/res"); if (!(s in KS)) { KS[s] = 1; print s "\t" id "\t" M[s] "\tend" > (w "/keep") } }
      else { print p > (w "/l"); if (s != "") print p "\t" s > (w "/ms") } }' "$3"
  RS_D="$d" RS_W="$w" awk '{ n++; f = (substr($0, 1, 1) == "/") ? $0 : ENVIRON["RS_D"] "/" $0; b = ENVIRON["RS_W"] "/" n
      printf "" > (b ".s"); print "rs_f() {" > (b ".wo"); print "rs_f() {" > (b ".ws")
      while ((getline l < f) > 0) { print l > (b ".wo"); if (l !~ /^[[:space:]]*(#|$)/) { print l > (b ".s"); print l > (b ".ws") } }
      print "}" > (b ".wo"); print "}" > (b ".ws"); close(f); close(b ".s"); close(b ".wo"); close(b ".ws"); print n > (ENVIRON["RS_W"] "/pd") }' "$w/l"
  ( r=""
    while IFS= read -r p; do
      n=$((n + 1)); case "$p" in /*) f="$p" ;; *) f="$d/$p" ;; esac
      bash -n "$f" 2>/dev/null & r="$r $n:$!"
