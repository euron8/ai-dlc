#!/usr/bin/env bash
# pre-push — the distribution's own gate. Runs its validators against itself.
#
# THE DEFECT THIS REPLACES. ai-dlc shipped fifteen validators and a CI template *to
# its consumers* while gating none of its own. Every check ran only when a human
# remembered to type it, which is how three releases shipped half-wired: the enforcer
# was named, never invoked. `git log --all -- .github` was empty for the project's
# entire history.
#
# WHY NOT GITHUB ACTIONS. Operator policy: no CI in GitHub, for this repo or the
# reference consumer (which removed its own Actions scaffolding deliberately). A gate
# that lives in a service we do not run is a gate we do not control. This runs on the
# machine doing the pushing, needs no network, no runner, and no third party.
#
# The evidence that local is sufficient: v0.52.0's own packaging bug -- a fixture added
# to install.sh's hardcoded loop but not uninstall.sh's -- was caught by
# `validate-enforcement-map.sh` on a local run, BEFORE the push. The Actions run only
# ever saw the fixed tree and caught nothing.
#
# ENABLE (once per clone):
#     git config core.hooksPath .githooks
#
# Bypass for a genuine emergency is `git push --no-verify`, and it is a decision you
# are making on the record, not a default you fall into.
#
# AI_DLC_READSET_LIVE_TRACE=0 stops the detached read-set trace a green suite starts for its
# unmapped fixtures (readset_live_trace); default on. A fixture that drives a copy of this hook
# sets it to 0 on that drive.

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

# SIGPIPE_BEGIN
# ONE SIGNAL DISPOSITION FOR EVERY WRITER OF A RECORD A PUSH READS (BL-999). git runs a pre-push hook with SIGPIPE
# ignored, so a writer whose reader leaves early gets EPIPE, prints `Broken pipe` and exits non-zero, where under the
# default it dies silently with 141. A pass recorded under one disposition and read by a gate under the other can
# disagree with the gate's own run. Both pre-push hooks and core/scripts/hermetic-run.sh carry this span byte for byte,
# so a hand run, the verdict seeder and git's own run all judge under git's disposition. An ignored signal is inherited
# across exec, so every child sees it.
trap '' PIPE
# SIGPIPE_END

# PUSH_DELETE_BEGIN
# A PUSH THAT DELIVERS NO TREE RUNS NO STEP (BL-1010). git hands a pre-push hook one line per ref on stdin,
# `<local ref> <local sha> <remote ref> <remote sha>`, and a delete carries an all-zero local sha (40 zeros, 64 in a
# sha256 repository). True only when there is at least one line and every line is a delete: an empty stdin (a hand
# run, a fixture driving the hook with </dev/null) and a mixed push both run every step.
push_delete_only() { # <ref lines>
  local pd_lr pd_ls pd_rr pd_rs pd_n=0
  while read -r pd_lr pd_ls pd_rr pd_rs; do
    [ -n "$pd_lr" ] || continue
    case "$pd_ls" in ''|*[!0]*) return 1 ;; esac
    pd_n=$((pd_n + 1))
  done <<PD_EOF
$1
PD_EOF
  [ "$pd_n" -gt 0 ]
}
# PUSH_DELETE_END
# stdin is read only when git's two arguments are present and it is not a terminal: a hand run passes no arguments,
# and a terminal read would wait forever. The lines are kept in PUSH_LINES for the pregate gate below, and step 1c
# hands them, with the remote name, to validate-release-version.sh, which excludes the refs this push names from
# its stacked-base search (BL-1047).
PUSH_REMOTE="${1:-}"; PUSH_LINES=""
if [ "$#" -ge 2 ] && [ ! -t 0 ] && { PUSH_LINES="$(cat)"; push_delete_only "$PUSH_LINES"; }; then
  printf 'pre-push: every ref in this push is a delete (all-zero local sha): no tree is delivered, so no step runs.\n'
  exit 0
fi

# PREGATE_GATE_BEGIN
# A PUSH IS REFUSED UNTIL scripts/pregate-self-check.sh HAS PASSED ON THE EXACT TREE IT DELIVERS (BL-1055). That
# script runs this hook's pre-suite prefix, the procsub spelling arm and the counted validator-fork-budget run in
# minutes; the suite below finds the same reds only after the whole pool. On exit 0 over a clean work tree it writes
# `<verdict store base>/pregate-green/<root commit>/<HEAD tree>` (RECORD_HOME); this gate reads that record and nothing else. It exits before
# any step, so a refusal costs seconds. It applies to every push that delivers a tree (a ref line with a non-zero
# local sha): the work tree must be clean, every delivered commit's tree must equal HEAD's (the hook judges the work
# tree, not the pushed sha), and the record must exist. An empty stdin (a hand run, the self-check's own prefix run,
# a fixture driving this hook with </dev/null) delivers nothing and is not gated. A delete-only push exited above.
pregate_gate() { # <ref lines>: 0 = the push may proceed; 1 = refused, the reason printed
  local lr ls rr rs n=0 tree st rec
  tree="$(git rev-parse --verify --quiet 'HEAD^{tree}')" || tree=""
  while read -r lr ls rr rs; do
    [ -n "$lr" ] || continue
    case "$ls" in ''|*[!0]*) : ;; *) continue ;; esac
    n=$((n + 1))
    if [ "$(git rev-parse --verify --quiet "${ls}^{tree}")" != "$tree" ] || [ -z "$tree" ]; then
      printf 'pre-push: REFUSED. %s (%s) delivers a tree that is not this work tree'"'"'s HEAD tree; push from a clean worktree detached at that sha.\n' "$lr" "$ls"
      return 1
    fi
  done <<PG_EOF
$1
PG_EOF
  [ "$n" -gt 0 ] || return 0 # an empty stdin delivers nothing: not gated
  st="$(GIT_OPTIONAL_LOCKS=0 git status --porcelain --untracked-files=normal 2>&1)" || st="git status failed: $st"
  if [ -n "$st" ]; then
    printf 'pre-push: REFUSED. The work tree is not clean, so no pregate record can name it:\n%s\n   Push from a clean worktree detached at the sha, after running bash scripts/pregate-self-check.sh there.\n' "$(printf '%s\n' "$st" | head -5 | sed 's/^/     /')"
    return 1
  fi
  # THE RECORD IS RESOLVED BY THE RECORD_HOME SPAN, read out of this file before the pool defines it.
  eval "$(sed -n '/^# READSET_VS_BEGIN$/,/^# READSET_VS_END$/p;/^# RECORD_HOME_BEGIN$/,/^# RECORD_HOME_END$/p' "${BASH_SOURCE[0]:-$0}" 2>/dev/null)"
  if ! rec_home rec pregate-green 2>/dev/null || [ "$rec" = "$REC_OFF" ]; then
    printf 'pre-push: REFUSED. The verdict store is OFF (no AI_DLC_VERDICT_STORE or HOME, a shallow clone, or no root commit), so no pregate record can be read; pregate-self-check cannot record one either.\n'
    return 1
  fi
  rec_import "$(git rev-parse --git-common-dir)/ai-dlc-pregate-green" "$rec" || :
  rec="$rec/$tree"
  if [ ! -f "$rec" ] || [ "$(sed -n 1p "$rec" 2>/dev/null)" != '#format pg1' ]; then
    printf 'pre-push: REFUSED. No green scripts/pregate-self-check.sh run is recorded for this tree (%s).\n   Run `bash scripts/pregate-self-check.sh` in this worktree (minutes), fix what it names, and push again.\n' "$tree"
    return 1
  fi
  printf 'pre-push: pregate-self-check passed on this tree (%s).\n' "$tree"
  return 0
}
pregate_gate "$PUSH_LINES" || exit 1
# PREGATE_GATE_END
# GATE_HELD_BEGIN
# A RUNNING PUSH GATE IS VISIBLE TO A SEEDER. A push that delivers a tree, at depth 0, writes
# `<git common dir>/ai-dlc-gate-held.<pid>` ("<pid> <ps lstart>"); an EXIT trap removes it until the suite step replaces that
# trap, after which the file outlives the hook and is dead by its pid. scripts/gate-wait.sh, which
# scripts/seed-verdict-store.sh and scripts/census-consumer-layout.sh source, waits while a marker's pid is alive with
# that start time. A stale marker (dead pid, or a reused one) is ignored and deleted by the waiter, so it never wedges.
# A new gate deletes the dead ones it finds.
if [ -n "$PUSH_LINES" ] && [ "${PREPUSH_POOL_DEPTH:-0}" = 0 ]; then
  gate_held_d="$(git rev-parse --git-common-dir 2>/dev/null)" || gate_held_d=""
  case "$gate_held_d" in /*) ;; *) gate_held_d="$PWD/$gate_held_d" ;; esac
  if [ -d "$gate_held_d" ]; then
    for gate_held_f in "$gate_held_d"/ai-dlc-gate-held.*; do
      [ -f "$gate_held_f" ] && ! kill -0 "${gate_held_f##*.}" 2>/dev/null && rm -f -- "$gate_held_f"
    done
    gate_held_f="$gate_held_d/ai-dlc-gate-held.$$"
    printf '%s %s\n' "$$" "$(ps -o lstart= -p "$$" 2>/dev/null)" > "$gate_held_f" 2>/dev/null && trap 'rm -f -- "$gate_held_f"' EXIT
  fi
fi
# GATE_HELD_END

# 0. A GREEN GATE IS NOT A LANDED PUSH, and the cause is a dotfile, not this tree. `git push`
#    opens the SSH connection BEFORE this hook runs; the suite below then idles it for minutes,
#    GitHub's sshd drops it, and the pack write takes SIGPIPE -- exit 141, every phase PASS, the
#    ref absent on origin. Measured: three consecutive pushes dropped mid-suite; adding
#    `ServerAliveInterval 60` / `ServerAliveCountMax 30` to the remote's ssh alias was the one
#    change, and the next three landed. This WARNS, once, when the effective ssh config for the
#    push remote carries no keepalive. It never fails the push: the gate's verdict is about the
#    tree, and a missing keepalive is about the transport.
#
#    WHY NOT `git ls-remote` AFTER THE PUSH. pre-push runs before the transport, so it cannot
#    see the outcome; and a reader run from outside races a backgrounded push -- measured
#    reading 0 while the push was still in flight and then landed. The cause is checkable here;
#    the symptom is not.
#
#    IT READS THE SSH COMMAND GIT WILL ACTUALLY RUN, in git's own precedence: GIT_SSH_COMMAND,
#    then core.sshCommand (both run through `sh -c 'CMD "$@"'`, as git does), then GIT_SSH
#    (exec'd directly), then `ssh`. An operator pushing with
#    `GIT_SSH_COMMAND="ssh -o ServerAliveInterval=60"` IS configured, and a plain `ssh -G`
#    would warn at them -- so the effective value is what `-G` prints through THAT command,
#    never what one file says. That is also how the fixture seeds a config without touching
#    `~/.ssh/config`: it sets `GIT_SSH_COMMAND="ssh -F <seeded config>"`, the same knob an
#    operator uses. No test-only variable exists for a mutant to leave switched on.
#
#    SILENT, never guessing, when: the URL is not ssh (https, file, a local path); the args are
#    absent (a hand run or a fixture driving this hook); the command's first word is not
#    `ssh` (plink, a wrapper -- handed `-G` it might connect); or `ssh -G` fails or prints no
#    `serveraliveinterval`. stdin is closed on the probe: it carries git's ref lines.
#
#    FALSE-POSITIVE SET, measured on the operator's box: `origin` is
#    `git@github-euron8:euron8/ai-dlc.git`, `ssh -G github-euron8` reports
#    `serveraliveinterval 60`, and this block is silent; the same args with
#    `GIT_SSH_COMMAND="ssh -F <empty config>"` fire. `core/fixtures/prepush-ssh-keepalive`
#    drives this block, extracted between the sentinels, in both directions with two mutants.
# KEEPALIVE_BEGIN
ssh_keepalive_warn() {
  local url="${2:-}" cmd="" via="" first="" rest="" auth="" target="" port="" host_alias="" out="" line="" iv=""
  [ -n "$url" ] || return 0
  case "$url" in
    ssh://*|git+ssh://*|ssh+git://*)
      rest="${url#*://}"; auth="${rest%%/*}"
      case "$auth" in *\[*) return 0 ;; esac
      target="${auth%%:*}"
      case "$auth" in *:*) port="${auth#*:}" ;; esac ;;
    *://*) return 0 ;;
    *:*)
      target="${url%%:*}"
      case "$target" in ''|*/*) return 0 ;; esac ;;
    *) return 0 ;;
  esac
  [ -n "$target" ] || return 0
  host_alias="${target#*@}"
  if [ -n "${GIT_SSH_COMMAND:-}" ]; then cmd="$GIT_SSH_COMMAND"; via=shell
  elif cmd="$(git config --get core.sshCommand 2>/dev/null)" && [ -n "$cmd" ]; then via=shell
  elif [ -n "${GIT_SSH:-}" ]; then cmd="$GIT_SSH"; via=exec
  else cmd=ssh; via=exec
  fi
  if [ "$via" = shell ]; then first="${cmd%%[[:space:]]*}"; else first="$cmd"; fi
  [ "${first##*/}" = ssh ] || return 0
  command -v "$first" >/dev/null 2>&1 || return 0
  if [ "$via" = shell ]; then
    if [ -n "$port" ]; then
      out="$(sh -c "$cmd"' "$@"' "$cmd" -G -p "$port" "$target" </dev/null 2>/dev/null)" || return 0
    else
      out="$(sh -c "$cmd"' "$@"' "$cmd" -G "$target" </dev/null 2>/dev/null)" || return 0
    fi
  else
    if [ -n "$port" ]; then
      out="$("$cmd" -G -p "$port" "$target" </dev/null 2>/dev/null)" || return 0
    else
      out="$("$cmd" -G "$target" </dev/null 2>/dev/null)" || return 0
    fi
  fi
  while IFS= read -r line; do
    case "$line" in serveraliveinterval\ *) iv="${line#serveraliveinterval }" ;; esac
  done <<EOF
$out
EOF
  [ "$iv" = 0 ] || return 0
  printf 'pre-push: WARNING -- ssh host alias "%s" has no keepalive (ServerAliveInterval 0). The suite below idles the connection git already opened, GitHub drops it, and the push exits 141 with every gate green and the ref NOT on origin. Add "ServerAliveInterval 60" and "ServerAliveCountMax 30" under "Host %s" in ~/.ssh/config. Not blocking.\n' "$host_alias" "$host_alias"
}
ssh_keepalive_warn "${1:-}" "${2:-}"
# KEEPALIVE_END

fail=0
RED_STEPS=""
# AI_DLC_PRESUITE_SKIP=1 skips every check before the fixture suite: for a re-push of a tree
# whose checks already passed. The suite and its judges still run. The operator's switch.
# The two names below are the layout- and policy-dependent inputs of the span that follows (held identical to the
# consumer hook's by I66): the declaration root, and whether that switch is honoured at all.
PS_DECL_ROOT="scripts/presuite/"
PS_SKIP_OK=1
#
# PRESUITE_UNITS_BEGIN
# PRE-SUITE STEPS ARE UNITS OF THE FIXTURE MECHANISM. A `step` before PRESUITE_DONE is QUEUED, never run where it is
# written; ps_flush (called once, at PRESUITE_DONE) decides every queued step from ONE key pass and runs the steps that
# must run CONCURRENTLY, then prints each step's title, output, verdict and elapsed seconds in declaration order, so a
# gate log reads as a serial one. The key pass is the fixture mechanism's own: a step that declares its inputs in
# scripts/presuite/<slug>/inputs.decl (the inputs.decl grammar, directories allowed) is keyed by readset_manifest,
# readset_declared and readset_keys with FXROOT=scripts/presuite/, exactly as cl_select keys the consumer layout, and
# its pass is a record under <verdict store base>/presuite-keys/<root commit>, published the moment the step passes, and
# kept a second time under its rows' own name (ps_keep), which a step run only on moved keys skips on (ps_select). A
# step with no declaration has no key and runs on every push. A step that reads git state (HEAD, origin/main, the push
# refs, ls-files, log) declares nothing: a declared file cannot express it. Nor does one that reads a git-ignored path
# (agent definitions: .claude/settings.json) or walks the whole tree (stray party-mode: a new top-level file).
# `slug` is the title lower-cased with every run of non-alphanumerics a single `-`, cut at 80.
# AI_DLC_PRESUITE_SKIP=1 skips every step before the suite except one queued with PS_ALWAYS=1, and only where the hook
# set PS_SKIP_OK=1 outside this span. PS_DECL_ROOT, also set outside it, is the directory holding the declarations
# (<root><slug>/inputs.decl); a root that does not exist keys no step, so every step runs on every push.
# A step whose declaration names a file the manifest does not list (git-ignored) runs: that file cannot move the key.
# AI_DLC_FIXTURE_NO_SKIP=1 runs every step. The width is FIXTURE_JOBS (two in a nested pool).
PS_N=0; PS_W=""; PS_ALWAYS=0
ps_slug() { printf '%s' "$1" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9' '-' | tr -s '-' | sed 's/^-//; s/-$//' | cut -c1-80; }
ps_enqueue() { # <title> <cmd...>
  local n
  if [ -z "$PS_W" ]; then PS_W="$(mktemp -d "${TMPDIR:-/tmp}/presuite.XXXXXX")" || PS_W=""; fi
  if [ -z "$PS_W" ]; then
    printf '\n── %s\n' "$1"; shift
    if "$@"; then printf '   PASS\n'; else printf '   FAIL\n'; fail=1; fi
    return 0
  fi
  PS_N=$((PS_N + 1)); n=$PS_N
  printf '%s' "$1" > "$PS_W/$n.title"; printf '%s\n' "$PS_ALWAYS" > "$PS_W/$n.always"
  shift; printf '%s\0' "$@" > "$PS_W/$n.argv"
}
ps_run() { # <n>: one queued step in a forked subshell (a fork, never a new bash start): output, verdict and seconds into $PS_W
  local n="$1" s="$SECONDS" a
  set --; while IFS= read -r -d '' a; do set -- "$@" "$a"; done < "$PS_W/$n.argv"
  ( "$@" ) > "$PS_W/$n.out" 2>&1 < /dev/null 7>&-
  echo $? > "$PS_W/$n.rc"
  echo $((SECONDS - s)) > "$PS_W/$n.sec"
}
ps_select() { # decides every keyed step in the runlist from the fixture mechanism's own key pass; a skip leaves `<n>.keyskip`
  local c="$PS_W/k" n slug kd h keyed=0 dl df forced
  PS_KD=""
  mkdir -p "$c" || return 0
  : > "$c/.list"; : > "$c/.mapped.all"; : > "$c/.kdec"; : > "$c/.k.always"
  for n in $(cat "$PS_W/runlist"); do
    slug="$(ps_slug "$(cat "$PS_W/$n.title")")"; printf '%s' "$slug" > "$PS_W/$n.slug"
    [ -f "${PS_DECL_ROOT}${slug}/inputs.decl" ] || continue
    printf '%s%s/\n' "$PS_DECL_ROOT" "$slug" >> "$c/.list"; printf '%s\n' "$slug" >> "$c/.mapped.all"; keyed=1
  done
  [ "$keyed" = 1 ] || return 0
  rec_home kd presuite-keys
  PS_KD="$kd"
  # THE MARK precedes the key pass, so a declared input changed after it is either in the keys or newer than the mark.
  : > "$c/.mark" 2>/dev/null
  ( KEYS_DIR="$kd"; FXROOT="$PS_DECL_ROOT"; READSET_MAP="$c/.no-map"; READSET_LOCAL="$c/.no-local"; VERIFIED_RECORD=/dev/null # pool-shadow: subshell
    readset_drop_excluded() { cat; } # pool-shadow: subshell
    readset_manifest "$c"
    [ -s "$c/.now" ] || exit 1
    : > "$c/.local.valid"
    readset_keys "$c/.list" "$c" ) > "$c/.log" 2>&1 || { : > "$c/.kdec"; printf '   ..    pre-suite keys: the step keys could not be built (%s) -- every step runs\n' "$(sed -n 1p "$c/.log")"; }
  [ "${AI_DLC_FIXTURE_NO_SKIP:-}" != 1 ] || return 0
  # A DECLARED FILE THE MANIFEST DOES NOT LIST CANNOT MOVE THE KEY (a git-ignored file is dropped from `.now`), so a step
  # declaring one runs. One builtin pass collects `<slug>\t<file>` for every declared file on disk; one awk names the
  # slugs whose file is absent from `.now`.
  : > "$c/.dfiles"
  for n in $(cat "$PS_W/runlist"); do
    slug="$(cat "$PS_W/$n.slug")"
    [ -f "${PS_DECL_ROOT}${slug}/inputs.decl" ] || continue
    while IFS= read -r dl || [ -n "$dl" ]; do
      case "$dl" in ''|'#'*|*/|*\**) continue ;; '!'*|'+'*) dl="${dl#?}" ;; esac
      [ -f "$dl" ] && printf '%s\t%s\n' "$slug" "$dl" >> "$c/.dfiles"
    done < "${PS_DECL_ROOT}${slug}/inputs.decl"
  done
  forced="$(awk -F'\t' 'NR == FNR { now[$1] = 1; next } !($2 in now) && !($1 in seen) { seen[$1] = 1; print $1 "\t" $2 }' "$c/.now" "$c/.dfiles")"
  while IFS=$'\t' read -r df dl; do
    [ -n "$df" ] || continue
    printf '%s\trun\tdeclares %s, which the manifest does not list (git-ignored)\n' "$df" "$dl" >> "$c/.kdec"
  done <<PS_FORCED_EOF
$forced
PS_FORCED_EOF
  for n in $(cat "$PS_W/runlist"); do
    slug="$(cat "$PS_W/$n.slug")"
    case "
$forced
" in *"
$slug"$'\t'*) continue ;; esac
    # A SKIP THAT ADOPTED THE PRESENT MODES (c `a`, a record written without `#modes v1`) is republished through
    # `.k.always`, so the next push compares modes; no other skip and no forced step is listed.
    if awk -F'\t' -v s="$slug" '$1 == s && $2 == "skip" { f = 1 } END { exit f ? 0 : 1 }' "$c/.kdec"; then : > "$PS_W/$n.keyskip"
      awk -F'\t' -v s="$slug" '$1 == s && $2 == "skip" && $4 == "a" { f = 1 } END { exit f ? 0 : 1 }' "$c/.kdec" && printf '%s\n' "$slug" >> "$c/.k.always"
      continue; fi
    # A STEP RUN ONLY BECAUSE ITS KEY ROWS DIFFER FROM <slug>.key (unrecorded, changed, tools changed) SKIPS ON A PASS
    # KEPT UNDER ITS ROWS' OWN NAME (ps_keep): every tree sharing the keys dir writes the one <slug>.key, so another
    # tree's pass at other content must not cost this tree its own. Any other run reason runs.
    awk -F'\t' -v s="$slug" '$1 == s && $2 == "run" && ($3 == "unrecorded" || $3 == "tools changed" || index($3, "changed ") == 1) { f = 1 } END { exit f ? 0 : 1 }' "$c/.kdec" || continue
    h="$(ps_rowkey "$c/.k/$slug")" && [ -f "$kd/$slug.$h.key" ] || continue
    touch "$kd/$slug.$h.key" 2>/dev/null; : > "$PS_W/$n.keyskip"
  done
}
# ps_rowkey <record>: the first 16 hex of the sha256 of a key record's rows and its `#modes v1` and `#mode` lines (its
# other `#` header lines left out). Rows are root-relative, so two trees whose declared inputs hold the same bytes and
# modes print the same name.
ps_rowkey() {
  local h
  [ -s "$1" ] || return 1
  h="$(awk '!/^#/ || $0 == "#modes v1" || index($0, "#mode\t") == 1' "$1" | shasum -a 256 | cut -c1-16)"
  case "$h" in [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) printf '%s' "$h" ;; *) return 1 ;; esac
}
# ps_keep <record> <slug> <keys dir>: keeps a passed step's record as <slug>.<rowkey>.key beside <slug>.key, and prunes
# that step's kept records to the 16 newest (a skip on one touches it).
ps_keep() {
  local h f
  h="$(ps_rowkey "$1")" || return 0
  cp "$1" "$3/$2.$h.key.tmp.$$" 2>/dev/null && mv "$3/$2.$h.key.tmp.$$" "$3/$2.$h.key" 2>/dev/null
  ls -t "$3/$2".*.key 2>/dev/null | sed 1,16d | while IFS= read -r f; do rm -f "$f"; done
  return 0
}
# ps_moved <key record> <mark>: prints the first row path of the record whose inode changed after the mark was written,
# and returns 0. A row path now absent is judged on its nearest existing parent. A missing mark, an unreadable record or
# a find that fails counts as moved. Content keys taken BEFORE the steps cannot see a declared input that a writer
# changed and restored while they ran (a rewrite put back, a file created and removed, an mtime reset); its inode change
# time can, because nothing in this hook resets an atime or a ctime.
ps_moved() {
  local rec="$1" mark="$2" l q tab out
  [ -f "$mark" ] && [ -r "$rec" ] || { printf '%s' "${rec##*/} (no mark or record)"; return 0; }
  tab="$(printf '\t')"
  set --
  while IFS= read -r l; do
    case "$l" in '#'*|'') continue ;; esac
    q="${l%%"$tab"*}"; q="${q%/}"
    while [ -n "$q" ] && [ "$q" != . ] && [ ! -e "$q" ] && [ ! -L "$q" ]; do
      case "$q" in */*) q="${q%/*}" ;; *) q=. ;; esac
    done
    [ -n "$q" ] || q=.
    case "$q" in .) set -- "$@" . ;; *) set -- "$@" "./$q" ;; esac
  done < "$rec"
  [ "$#" -gt 0 ] || return 1
  out="$(find "$@" -prune -cnewer "$mark" -print 2>/dev/null)" || { printf '%s' "${rec##*/} (find failed)"; return 0; }
  [ -n "$out" ] || return 1
  out="${out%%
*}"
  printf '%s' "${out#./}"
}
ps_stop() { # <exit status>: an interrupted flush stops the step forks it started, by their recorded pids
  local p
  trap '' INT TERM HUP
  for p in $PS_PIDS; do kill -TERM "$p" 2>/dev/null; done
  wait $PS_PIDS
  case "$PS_W" in */presuite.*) rm -rf -- "$PS_W" ;; esac
  exit "$1"
}
ps_flush() {
  local n slug title jobs why rc ps_nskip=0 p mv_p
  [ "$PS_N" -gt 0 ] || return 0
  : > "$PS_W/runlist"
  n=0
  while [ "$n" -lt "$PS_N" ]; do
    n=$((n + 1))
    if [ "${AI_DLC_PRESUITE_SKIP:-0}" = 1 ] && [ "${PS_SKIP_OK:-0}" = 1 ] && [ "$(cat "$PS_W/$n.always")" != 1 ]; then : > "$PS_W/$n.skipped"; continue; fi
    printf '%s\n' "$n" >> "$PS_W/runlist"
  done
  ps_select
  for n in $(cat "$PS_W/runlist"); do [ -f "$PS_W/$n.keyskip" ] || printf '%s\n' "$n"; done > "$PS_W/runlist.run"
  jobs="$FIXTURE_JOBS"; case "$jobs" in ''|*[!0-9]*|0) jobs=2 ;; esac
  # THE POOL: fd 7 is a fifo holding $jobs tokens. A step starts only on a token it read, and its fork writes the token
  # back when the step ends, so at most $jobs steps are live and a freed slot is taken the moment it frees; nothing
  # polls and no elapsed time decides admission. Without a fifo the steps run one after another, and the hook says so.
  PS_PIDS=""
  if mkfifo "$PS_W/slots" 2>/dev/null && exec 7<>"$PS_W/slots"; then
    p=0; while [ "$p" -lt "$jobs" ]; do printf 't\n' >&7; p=$((p + 1)); done
    trap 'ps_stop 130' INT; trap 'ps_stop 143' TERM; trap 'ps_stop 129' HUP
    for n in $(cat "$PS_W/runlist.run"); do
      read -r -u 7 p
      { ps_run "$n"; printf 't\n' >&7; } &
      PS_PIDS="$PS_PIDS $!"
    done
    wait $PS_PIDS
    trap - INT TERM HUP
    exec 7>&-
  else
    printf '   ..    pre-suite pool OFF: no fifo under %s -- the steps run one after another\n' "$PS_W"
    for n in $(cat "$PS_W/runlist.run"); do ps_run "$n"; done
  fi
  n=0
  while [ "$n" -lt "$PS_N" ]; do
    n=$((n + 1))
    title="$(cat "$PS_W/$n.title")"
    printf '\n── %s\n' "$title"
    if [ -f "$PS_W/$n.skipped" ]; then printf '   SKIPPED (AI_DLC_PRESUITE_SKIP=1)\n'; continue; fi
    if [ -f "$PS_W/$n.keyskip" ]; then
      [ -z "${SKIPS_LOG:-}" ] || { skips_stamp; read -r sk_s < "$PS_W/$n.slug"; printf -v sk_l '%s\tSKIP\t%s\tpresuite\t%s\tkey\t\n' "$SKIPS_STAMP" "$$" "$sk_s"; SKIPS_PRE="${SKIPS_PRE:-}$sk_l"; }
      printf '   skipped on a recorded pass: none of its declared inputs changed\n   PASS\n'; ps_nskip=$((ps_nskip + 1)); continue
    fi
    why="$(awk -F'\t' -v s="$(cat "$PS_W/$n.slug" 2>/dev/null)" '$1 == s && $2 == "run" { print $3; exit }' "$PS_W/k/.kdec" 2>/dev/null)"
    [ -z "$why" ] || printf '   ..    runs: %s\n' "$why"
    if [ ! -f "$PS_W/$n.rc" ]; then printf '   no verdict was recorded for this step\n   FAIL\n'; rc=1
    else cat "$PS_W/$n.out"; rc="$(cat "$PS_W/$n.rc")"; if [ "$rc" = 0 ]; then printf '   PASS\n'; else printf '   FAIL\n'; fi; fi
    [ "$rc" = 0 ] || { fail=1; RED_STEPS="$RED_STEPS
     $title"; }
    slug="$(cat "$PS_W/$n.slug" 2>/dev/null)"
    # A PASS IS RECORDED ONLY ON THE TREE IT WAS KEYED ON: a step whose key rows moved after the mark passes this push and
    # leaves no record, so the next push runs it.
    if [ "$rc" = 0 ] && [ -n "$PS_KD" ] && [ -n "$slug" ] && [ -f "$PS_W/k/.k/$slug" ] && mv_p="$(ps_moved "$PS_W/k/.k/$slug" "$PS_W/k/.mark")"; then
      printf '   ..    not recorded: %s changed while the pre-suite steps ran\n' "$mv_p"
    elif [ "$rc" = 0 ]; then printf '%s\n' "$slug" >> "$PS_W/k/.passed"; fi
    printf '   ..    step elapsed %ss\n' "$(cat "$PS_W/$n.sec" 2>/dev/null || echo 0)"
  done
  # A PASS IS PUBLISHED THROUGH THE FIXTURE MECHANISM'S OWN WRITER: a verdict file named for the step, then readset_keys_write.
  # A mode-adopting skip (`.k.always`, ps_select) is published by the same writer.
  if [ -n "$PS_KD" ] && { [ -s "$PS_W/k/.passed" ] || [ -s "$PS_W/k/.k.always" ]; }; then
    : >> "$PS_W/k/.passed"
    while IFS= read -r slug; do printf ok > "$PS_W/k/$slug"; done < "$PS_W/k/.passed"
    readset_keys_write "$PS_W/k" "$PS_KD"
    while IFS= read -r slug; do ps_keep "$PS_W/k/.k/$slug" "$slug" "$PS_KD"; done < "$PS_W/k/.passed"
  fi
  printf '\n   ..    pre-suite keys: %s of %s step(s) skipped on a recorded pass\n' "$ps_nskip" "$PS_N"
  case "$PS_W" in */presuite.*) rm -rf -- "$PS_W" ;; esac
  PS_N=0; PS_W=""
}
step() {
  if [ "${PRESUITE_DONE:-0}" = 0 ]; then ps_enqueue "$@"; return 0; fi
  printf '\n── %s\n' "$1"
  # RED_STEPS names every step that went red, for fixture_suite_step to print before the suite runs.
  local st_f0="$fail" st_t="$1" st_s="$SECONDS"
  fail=0
  shift
  if "$@"; then printf '   PASS\n'; else printf '   FAIL\n'; fail=1; fi
  [ "$fail" -eq 0 ] || RED_STEPS="$RED_STEPS
     $st_t"
  [ "$st_f0" -eq 0 ] || fail=1
  printf '   ..    step elapsed %ss\n' "$((SECONDS - st_s))"
  return 0
}
