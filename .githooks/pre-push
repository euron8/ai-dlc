    > "$sc" 2>/dev/null
  rt_rc="${PIPESTATUS[1]}"
  if [ -n "$tf" ]; then
    : > "$out/.rt.sums"; : > "$out/.rt.add"
    # An awk that exited non-zero (a file gone before the scan, a spawn failure) skipped the rest of its argv: store nothing.
    [ "$rt_rc" -eq 0 ] || : > "$out/.rt.ms"
    [ ! -s "$out/.rt.miss" ] || tr '\n' '\000' < "$out/.rt.miss" | xargs -0 shasum -a 256 -- 2>/dev/null > "$out/.rt.sums"
    RT_W="$out" RT_I="$READSET_MEMO_TOOLS" awk -F'\t' 'BEGIN { w = ENVIRON["RT_W"]; id = ENVIRON["RT_I"]
        while ((getline l < (w "/.rt.hit")) > 0) { t = index(l, "\t"); p = substr(l, 1, t - 1); C[p] = C[p] "\t" substr(l, t + 1); N[p]++ }
        while ((getline l < (w "/.rt.new")) > 0) { t = index(l, "\t"); p = substr(l, 1, t - 1); C[p] = C[p] "\t" substr(l, t + 1); N[p]++ }
        while ((getline l < (w "/.rt.sums")) > 0) { q = l; sub(/^[0-9a-f]+  /, "", q); H[q] = substr(l, 1, 64) }
        while ((getline l < (w "/.rt.ms")) > 0) { t = index(l, "\t"); MS[substr(l, 1, t - 1)] = substr(l, t + 1) }
        while ((getline l < (w "/.rt.miss")) > 0) if ((l in MS) && (l in H) && H[l] == MS[l] && !(MS[l] in DONE)) { DONE[MS[l]] = 1; print MS[l] "\t" id "\t" (N[l] + 0) C[l] "\tend" > (w "/.rt.add") }
        while ((getline l < (w "/.rt.sh")) > 0) { n = split(C[l], a, "\t"); for (i = 2; i <= n; i++) print l "\t" a[i] } }' > "$out/.ftools"
    if [ -s "$out/.rt.add" ]; then
      { mkdir -p "${tf%/*}" && awk '{ print }' "$out/.rt.keep" "$out/.rt.add" > "$tf.tmp.$$" && mv "$tf.tmp.$$" "$tf"; } 2>/dev/null || rm -f "$tf.tmp.$$" 2>/dev/null
    fi
  fi
  cut -f2 "$out/.ftools" | LC_ALL=C sort -u | tr '\n' '\000' | xargs -0 shasum -a 256 -- 2>/dev/null \
    | awk '{ p = $0; sub(/^[0-9a-f]+  /, "", p); print p "\t" $1 }' > "$out/.tools"
