      [ -s "$w/$n.s" ] || { printf '%s\n' "$n" >> "$w/ne"; continue; }
      unset -f rs_f; . "$w/$n.wo" 2>/dev/null && declare -f rs_f > "$w/$n.o" || { printf '%s\n' "$n" >> "$w/ne"; continue; }
      unset -f rs_f; . "$w/$n.ws" 2>/dev/null && declare -f rs_f > "$w/$n.p" && printf '%s\t%s\n' "$n" "$p" || printf '%s\n' "$n" >> "$w/ne"
    done < "$w/l" ) > "$w/ok" 2>/dev/null
  if [ -s "$w/l" ]; then
    awk -F'\t' -v w="$w" '{ print w "/" $1 ".o"; print w "/" $1 ".p"; print w "/" $1 ".s" }' "$w/ok" > "$w/hl"
    [ -z "$mf" ] || awk -v d="$d" '{ f = (substr($0, 1, 1) == "/") ? $0 : d "/" $0; print f }' "$w/l" >> "$w/hl"
