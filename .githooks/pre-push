# DECLARED FIXTURES. A fixture directory carrying `inputs.decl` is keyed on its declaration instead of a traced
# read set. readset_declared is the PRE-PASS: it runs the READSET_KEYROWS span's readset_decl_parse over every
# declared fixture in <list> (the same parse hermetic-run.sh runs for one), words its refusal rows into `.dunres`,
# hashes the declared tools into `.tools`, and calls readset_decl_keys ONCE over this push's `.now` for the whole
# declared set, writing `.dkeys` (`<fx>\t<key>\t<value>`). The decision awk in readset_keys takes a declared
# fixture's keys AND their values from `.dkeys` -- never from `.krows` and never from OWN[] -- so the hook and the
# runner (`--key-only`, and the verdict store's rows) cannot key one fixture two ways.
# Each declared fixture lands in `.dfx` and joins `.mapped.all` (readset_local_validate), so it is not keyed on the
# whole tree, is never queued for a trace and never goes `stale`. It takes no scanned tool keys (FT[] is skipped).
# A `.dunres` row makes the decision `run` with reason `tool unresolved <row>` (or the row itself where it begins
# `mapper ` or `git.decl range refused `, whose cause is not a tool), so the hermetic runner reports the refusal (exit 2). The record format is unchanged (`#format k1`).
readset_declared() { # <list> <out>
  local list="$1" out="$2" d b p lay mp="" xp xpd pm=""
  : > "$out/.dparse"; : > "$out/.dfx"; : > "$out/.dunres"; : > "$out/.dkeys"; : > "$out/.dtools"
  RS_SPC=""
  lay=cons; [ -d core/scripts ] && lay=dist
  for p in scripts/ai-dlc/core-paths.sh core/scripts/core-paths.sh; do [ -f "$p" ] && { mp="$p"; break; }; done
  xp="$READSET_TOOL_XP"; [ -n "$xp" ] || xp="$(readset_git_exec_path)"; xpd="$xp:$READSET_TOOL_DIRS"
  while IFS= read -r d; do
    b="${d%/}"; b="${b##*/}"
    [ -f "${FXROOT}${b}/inputs.decl" ] && printf '%s\n' "${FXROOT}${b}/inputs.decl"
  done < "$list" > "$out/.dlist"
  # THE PREMAP, consumer layout: every declared line of the listed fixtures, spelled as readset_decl_parse sends it to
  # the mapper, through ONE mapper start. It is built only when two or more listed fixtures carry a `core/` line, the
  # only case in which it saves a start. A refusal anywhere, or a count that differs, leaves no premap, and each
  # fixture then starts the mapper alone, as it would with none (its own maprefuse or mapcount row).
  if [ "$lay" = cons ] && [ -n "$mp" ] && [ -f "$mp" ] && [ -s "$out/.dlist" ]; then
    if awk 'NR == FNR { f[++n] = $0; next } END { for (i = 1; i <= n; i++) { c1 = 0; while ((getline l < f[i]) > 0) {
        sub(/\r$/, "", l); if (l == "" || l ~ /^#/) continue
        while ((c = substr(l, 1, 1)) == "!" || c == "+") l = substr(l, 2)
        if (l ~ /^\// || l ~ /(^|\/)\.\.(\/|$)/) continue
        k = ""; if (l ~ /\/$/) { k = "/"; sub(/\/+$/, "", l) }
        if (l == "core" || index(l, "core/") == 1) c1 = 1
        if (l != "" && !((l k) in s)) { s[l k] = 1; print l k } }
        close(f[i]); nc += c1 }
      exit (nc >= 2) ? 0 : 1 }' "$out/.dlist" > "$out/.pm.in" \
    && bash "$mp" --map < "$out/.pm.in" > "$out/.pm.out" 2>/dev/null \
      && awk 'FILENAME == ARGV[1] { a[FNR] = $0; n = FNR; next } { print a[FNR] "\t" $0; m = FNR } END { exit (n + 0 == m + 0) ? 0 : 1 }' \
        "$out/.pm.in" "$out/.pm.out" > "$out/.pm"; then pm="$out/.pm"; fi
  fi
  while IFS= read -r d; do
    b="${d%/inputs.decl}"; b="${b##*/}"
    printf '%s\t%s\t%s\n' "$b" "${FXROOT}${b}/inputs.decl" "$out/.dp.$b"
  done < "$out/.dlist" > "$out/.dbatch"
  [ ! -s "$out/.dbatch" ] || { readset_decl_batch "$out/.dbatch" "$lay" "$pm"; readset_decl_rangeprep "$out/.dbatch"; readset_decl_hashes "$out/.dbatch"; readset_decl_spansbatch "$out/.dbatch" "$lay" "$mp"; RS_SPC="$out/.dbatch"; }
  while IFS= read -r d; do
    b="${d%/inputs.decl}"; b="${b##*/}"
    readset_decl_parse "$b" "${FXROOT}${b}" "$lay" "$mp" "$xpd" "$out/.dp.$b" "$pm" pre >> "$out/.dparse"
  done < "$out/.dlist"
  awk -F'\t' '$2 == "N" { print $1 }' "$out/.dparse" > "$out/.dfx"
  [ -s "$out/.dfx" ] || return 0
  awk -F'\t' '$2 != "X" { next }
    $3 == "abs" { print $1 "\tdeclaration path is absolute or contains .."; next }
    $3 == "nomap" { print $1 "\tmapper absent"; next }
    $3 == "maprefuse" || $3 == "mapcount" { print $1 "\tmapper refused a declared path"; next }
    $3 == "absd" { print $1 "\tdeclared directory absent " $4; next }
    $3 == "absf" { print $1 "\tdeclared file absent " $4; next }
    $3 == "dup" { print $1 "\tduplicate basename " $4; next }
    $3 == "plusdir" { print $1 "\t+ marks a directory, and only a file may be keyed outside the universe: " $4; next }
    $3 == "plusbang" { print $1 "\t+ and ! on one inputs.decl line (a line carries one marker): " $4; next }
    $3 == "plushash" { print $1 "\t+ file could not be hashed " $4; next }
    $3 == "plussect" { print $1 "\tsection.decl names no `#` heading for the + file " $4; next }
    $3 == "rnopath" || $3 == "rabs" || $3 == "rderive" || $3 == "rref" || $3 == "rempty" { print $1 "\tgit.decl range refused (" $3 "): " $4; next }
    $3 == "spanbad" || $3 == "spandir" || $3 == "spanabsent" { print $1 "\tspans.decl refused (" $3 "): " $4; next }
    { print $1 "\t" $4 }' "$out/.dparse" > "$out/.dunres"
  # `.dtools` (`<fx>\t<tool path>`) is a VIEW of the parse for diagnostics and probes; the decision reads `.dkeys`.
  awk -F'\t' '$2 == "T" { print $1 "\t" $3 }' "$out/.dparse" > "$out/.dtools"
  readset_decl_tool_hashes "$out/.dparse" "$out/.tools"
  HR_ROOT=. readset_decl_keys "$out/.now" "$out/.ls.now" "$out/.dparse" "$out/.tools" "$FXROOT" "${READSET_MEMO:-}" "${READSET_MEMO_STRIP:-}" > "$out/.dkeys"
}

# THE RECORD, `$KEYS_DIR/<fx>.key`: `#format k1`, `#state ok|stale|seeded`, `#tools canonical`
# (the tool rows were resolved against the fixed tool dirs of readset_tools), `#pending <n>` where the count is
# known (readset_keys_write writes it; the prospective `<out>/.k/<fx>` never carries it), then one row per key,
# C-sorted: `<path>\t<sha256>` for a file, `<path>\t-` for an absent name, `<dir>/\t#listing:<sha256>`
# for a directory listing, and `<tool path>\t<sha256>` for a tool (an absolute path). A changed tool
# row reruns F as `tools changed` and never stales it.
# A RECORD WITH NO `#pending` LINE (written before the count was recorded) IS DECIDED EXACTLY AS ONE WITH IT: its
# absence is never a run reason, so no stored verdict is re-run for it; its count reads as unrecorded (`-`) until
# the fixture next runs for a key that moved.
#
# THE ONE-TIME TOOL MIGRATION. A record whose `#tools` line is not `canonical` (the hook before the
# fixed tool dirs wrote `per-fixture`) holds tool rows keyed on whatever PATH its writer inherited, so
# they cannot be compared. For such a record ONLY its tool rows are ignored -- every file, absent-name
# and listing key is still compared -- and a record that matches on those SKIPS and is republished
# through `.k.always` (c `m`) with its tools keyed under the fixed dirs and `#tools canonical`, so the
# amnesty fires once per record. A migrating record that runs drops its old tool rows from the carry.
# A migrating stale record is the stale route's (c `v`). The seed never migrates: it reads no record.
#
# DECIDE EVERY FIXTURE IN <list> FROM ITS KEY RECORD. Writes `<out>/.kdec`, one line per fixture:
# `<fx>\trun\t<reason>\t<k|u|s>\t<new state>` or `<fx>\tskip\t\t\t<state>`, and the prospective record
# of every fixture that runs (or that a seed skips) to `<out>/.k/<fx>`. The record holds the PRE-RUN
# hashes; run_fixtures publishes it only for a fixture that passed.
#
# THE SEED: no `$KEYS_DIR` yet and a `v2` verified record present. That record is a copy of the
# pre-run `.now` of a suite every fixture passed on, so each fixture's record is the projection of it
# onto K(F) -- listings from its path set, a path it lacks as `-`, its tools as they are now, state
# `seeded`. Once the directory exists the seed never runs again, and a missing record is `unrecorded`.
#
# A LISTING MOVED, AND WHICH ENTRIES ARE NEW. The record holds only a listing's hash, so the old entry
# set is taken from a path list whose listing hash EQUALS the recorded one -- the previous run's `.now`
# (`$KEYS_DIR/.prev`) or the verified record. Every file and directory under a new entry is added to
# the record, which stays `ok`; with no matching list the record goes `stale`. A change to a key added
# that way reruns the fixture and stales it, so a new script's own reads are traced; a key K(F) gained
# (a trace landed or the map moved), which reruns it once to record the key. An `ok` record's keys
# are carried into the next one while it has any listing key, so a key added that way is not dropped
# when the fixture next runs for another reason; a whole-tree record has no listing key, so an
# unmapped fixture that gains a trace sheds it.
# THE SHARED VERDICT STORE. A declared fixture's pass is keyed on content alone (the declared inputs, its own
# files, its tools), so it is valid in any clone at any path. `${AI_DLC_VERDICT_STORE:-$HOME/.cache/ai-dlc/verdicts}`
# holds one entry per pass, NAMED for the sha256 of its body: `#format k1`, `#state ok`, then the digest input
# (`#fixture`, `#runner`, `#universe`, `#inproc` and the key rows). `#runner` is the comment-stripped sha of the
# runner's HR_SANDBOX span and `#universe` the format version (READSET_VS span), so a pass under an older runner or
# format is not reused. The key rows carry the same span sha for every declared fixture (the RUNNER ROW of
# readset_decl_keys), so a code edit inside that span also moves the per-fixture key decision.
# AN ENTRY MAY END IN `#pending <n>`, the PENDING rows of the pass that wrote it (hermetic-run.sh writes it; the
# entry's name stays the sha256 of its digest input). Every reader takes the count from that last line, or `-` when
# the entry has none: an entry written before the count was recorded is reused with its count unrecorded, never
# re-run for it.
# A STORED PASS COVERS THE CURRENT ROWS, IT NEED NOT EQUAL THEM (readset_verdicts). An entry is reused when every
# current row is in it with the same value, its rows under the fixture's own directory are exactly the current ones,
# and its `#inproc` and identity lines match. The own inputs.decl is an own-directory row, so a declaration changed in
# any way, a narrowing included, runs once in each layout. An entry written
# under the LEGACY identity (`#runner` the raw span sha, `#universe` one of READSET_VS_LEGACY_UNIVERSE, the runner
# keyed whole-file) is read the same way with the runner row as it was then keyed, at today's whole-file hash.
# hermetic-run.sh writes the same entry on a clean pass; it is the store's ONLY writer -- this hook reads the
# store and never writes it. A reader fails closed: no store, no entry, a malformed body, or no entry covering the
# current rows means the fixture runs. Only DECLARED fixtures are ever looked up.
# PER PROJECT: `<base>/<root commit sha>`, the base being the env var or the default. The project is the repository's
# root commit (`git rev-list --max-parents=0 HEAD`, C-sorted, first line), the same in every full clone at any path
# and over any remote URL. A shallow clone, a failed git, or anything that is not a 40-hex sha prints NOTHING: the
# store is OFF for that run, no read and no write.
readset_vs_ident_here() { # the ident from the cwd, both layouts, consumer runner first
  local hk="" rn="" c
  for c in .githooks/pre-push core/git-hooks/pre-push; do [ -f "$c" ] && { hk="$c"; break; }; done
  for c in scripts/ai-dlc/hermetic-run.sh core/scripts/hermetic-run.sh; do [ -f "$c" ] && { rn="$c"; break; }; done
  readset_vs_ident "$hk" "$rn"
}
# THE LEGACY IDENTITY: the `#universe` values the distribution and consumer hooks wrote before READSET_VS_FORMAT.
READSET_VS_LEGACY_UNIVERSE="68c5a2f2659c8bc02f3f1b087af17c0e683e0ae989392cf465350c1664aa7e47 a829a5b0f9ef73ce7a53c6e37f3321b852ba2c180b1627855590f562ff3c9335"
readset_verdicts() { # <out>: a DECLARED fixture decided `run` with a stored pass covering its current key rows is decided `skip`
  local out="$1" store ident fx rn="" c rraw vld vlok vj pn
  : > "$out/.vs"
  [ -s "$out/.dfx" ] || return 0
  store="$(readset_vs_store "$PWD")"
  if [ -z "$store" ]; then printf '   ..    verdict store OFF: no store base, or the project root commit cannot be resolved (shallow clone or git failure)\n'; return 0; fi
  # COUNTED (FXCOUNT_JUDGE set): an entry of the counted store carries the fixture's `#judge` row after `#inproc`; an
  # entry of FXCOUNT_LEGACY_STORE (the last whole-judge store, fxcount_arm) carries none and is read only for a fixture
  # FXCOUNT_LEGACY_OK lists, and is read while the counted store has no directory yet. Uncounted, both are empty and
  # every entry is read as before.
  vld=""; vlok=""; vj=""
  if [ -n "${FXCOUNT_JUDGE:-}" ]; then
    vj=1
    if [ -n "${FXCOUNT_LEGACY_STORE:-}" ] && [ -n "${FXCOUNT_LEGACY_OK:-}" ] && [ -s "$FXCOUNT_LEGACY_OK" ] && [ -d "$FXCOUNT_LEGACY_STORE/${store##*/}" ]; then
      vld="$FXCOUNT_LEGACY_STORE/${store##*/}"; vlok="$FXCOUNT_LEGACY_OK"
    fi
  fi
  [ -d "$store" ] || [ -n "$vld" ] || return 0
  ident="$(readset_vs_ident_here)" || return 0
  [ -n "$ident" ] || return 0
  for c in scripts/ai-dlc/hermetic-run.sh core/scripts/hermetic-run.sh; do [ -f "$c" ] && { rn="$c"; break; }; done
  rraw="$(sed -n '/^# HR_SANDBOX_BEGIN$/,/^# HR_SANDBOX_END$/p' "$rn" | shasum -a 256 | cut -d' ' -f1)"
  : > "$out/.vs.hit"; : > "$out/.vs.want"
  # ONE FILTER for every candidate: a declared fixture (a line of `.dfx`) with no `.dunres` and no `.qfx` row (first
  # field), in `.kdec` order. A `.qfx` that cannot be opened reads as empty.
  VD="$out/.dfx" VU="$out/.dunres" VQ="$out/.qfx" awk -F'\t' 'BEGIN { while ((getline l < ENVIRON["VD"]) > 0) D[l] = 1
      while ((getline l < ENVIRON["VU"]) > 0) { t = index(l, "\t"); U[t ? substr(l, 1, t - 1) : l] = 1 }
      while ((getline l < ENVIRON["VQ"]) > 0) { t = index(l, "\t"); U[t ? substr(l, 1, t - 1) : l] = 1 } }
    $2 == "run" && ($4 == "k" || $4 == "u" || $4 == "s") && $1 != "" && ($1 in D) && !($1 in U) { print $1 }' \
    "$out/.kdec" > "$out/.vs.cand"
  readset_vs_want "$out/.vs.cand" "$out/.k" "$out/.vs.b" > "$out/.vs.want" 2>/dev/null || : > "$out/.vs.want"
  [ -s "$out/.vs.want" ] || return 0
  # ONE SCAN: the entries carrying a line `#fixture <candidate>`, then ONE matcher over all of them. An entry is read
  # line by line and listed at its first such line; one whose line 3 is a `#fixture ` line naming no candidate is
  # left there (the writer puts `#fixture` on line 3, and the matcher reads only that line's), and any other entry
  # is read to its end.
  awk -F'\t' '$2 == "I" { print "#fixture " $1 }' "$out/.vs.want" > "$out/.vs.pat"
  { find "$store" -maxdepth 1 -type f ! -name '.tmp*' -print 2>/dev/null
    [ -z "$vld" ] || find "$vld" -maxdepth 1 -type f ! -name '.tmp*' -print 2>/dev/null; } \
    | VP="$out/.vs.pat" awk 'BEGIN { while ((getline l < ENVIRON["VP"]) > 0) P[l] = 1 }
      { f = $0; n = 0
        while ((getline l < f) > 0) { if (l in P) { print f; break }; if (++n == 3 && substr(l, 1, 9) == "#fixture ") break }
        close(f) }' > "$out/.vs.files"
  [ -s "$out/.vs.files" ] || return 0
  tr '\n' '\000' < "$out/.vs.files" | VW="$out/.vs.want" VN="$out/.now" VR="${ident%% *}" VU="${ident#* }" VL="$rraw" VLU="$READSET_VS_LEGACY_UNIVERSE" VJ="$vj" VLD="$vld" VLOK="$vlok" \
    xargs -0 awk -v root="$FXROOT" '
    function addw(md, f, r, o) { if ((md SUBSEP f SUBSEP r) in W) return; W[md SUBSEP f SUBSEP r] = 1; NW[md SUBSEP f]++; if (o) NO[md SUBSEP f]++ }
    function fin() { if (ok && fx != "" && md != "" && !(fx in HIT) && m == NW[md SUBSEP fx] && own == NO[md SUBSEP fx] + 0) { HIT[fx] = 1; print fx "\t" pn } }
    BEGIN {
      n = split(ENVIRON["VLU"], a, " "); for (j = 1; j <= n; j++) LU[a[j]] = 1
      if (ENVIRON["VLOK"] != "") while ((getline l < ENVIRON["VLOK"]) > 0) LOK[l] = 1
      vj = (ENVIRON["VJ"] != ""); vld = ENVIRON["VLD"]
      while ((getline l < ENVIRON["VN"]) > 0) { t = index(l, "\t"); p = substr(l, 1, t - 1)
        if (p == "core/scripts/hermetic-run.sh" || p == "scripts/ai-dlc/hermetic-run.sh") NOW[p] = substr(l, t + 1)
        else if (index(p, root) == 1 && p ~ /\/run\.sh$/) RAW[p] = substr(l, t + 1) }
      while ((getline l < ENVIRON["VW"]) > 0) { t = index(l, "\t"); f = substr(l, 1, t - 1); r = substr(l, t + 1); kd = substr(r, 1, 1); r = substr(r, 3)
        if (kd == "I") { INP[f] = r; continue }
        if (kd == "J") { JR[f] = r; continue }
        t = index(r, "\t"); k = substr(r, 1, t - 1)
        if (k == root f "/run.sh") SV[f] = substr(r, t + 1)
        o = (index(k, root f "/") == 1)
        addw("n", f, r, o)
        if (k ~ /#HR_(SANDBOX|EXIT)$/) { sub(/#HR_[A-Z]+$/, "", k); if (!(k in NOW)) continue; r = k "\t" NOW[k] }
        addw("l", f, r, o) } }
    FNR == 1 { fin(); ok = ($0 == "#format k1"); fx = ""; md = ""; m = 0; own = 0; pn = "-"; leg = (vld != "" && index(FILENAME, vld "/") == 1); next }
    FNR == 2 { ok = ok && ($0 == "#state ok"); next }
    FNR == 3 { if (substr($0, 1, 9) == "#fixture ") fx = substr($0, 10); ok = ok && (fx in INP) && (!leg || (fx in LOK)); next }
    FNR == 4 { rr = $0; next }
    FNR == 5 { if (rr == "#runner " ENVIRON["VR"] && $0 == "#universe " ENVIRON["VU"]) md = "n"
               else if (rr == "#runner " ENVIRON["VL"] && substr($0, 1, 10) == "#universe " && (substr($0, 11) in LU)) md = "l"
               else ok = 0
               next }
    FNR == 6 { ok = ok && ($0 == INP[fx]); next }
    FNR == 7 && vj && !leg { ok = ok && (fx in JR) && ($0 == JR[fx]); next }
    FNR > 6 && /^#pending (0|[1-9][0-9]*)$/ { pn = substr($0, 10); next }
    !ok { next }
    { t = index($0, "\t"); k = substr($0, 1, t - 1); row = $0
      if (k == root fx "/run.sh" && (fx in SV) && (k in RAW) && substr($0, t + 1) == RAW[k]) row = k "\t" SV[fx]
      if ((md SUBSEP fx SUBSEP row) in W) { m++; if (index(k, root fx "/") == 1) own++ }
      else if (index(k, root fx "/") == 1) ok = 0 }
    END { fin() }' 2>/dev/null | awk -F'\t' '!s[$1]++' > "$out/.vs.hit"
  [ -s "$out/.vs.hit" ] || return 0
  awk -F'\t' 'NR == FNR { h[$1] = 1; next } ($1 in h) && $2 == "run" { print $1 "\tskip\t\tv\tok"; next } { print }' "$out/.vs.hit" "$out/.kdec" > "$out/.kdec.t" \
    && mv "$out/.kdec.t" "$out/.kdec" || return 0
  # A STORE SKIP CARRIES THE STORE ENTRY'S PENDING COUNT into `.kpn`, which the publish writes as the record's line 4.
  # ONE awk writes every hit's rewritten record (line 2 only) into the staging directory `.k.s`, a sibling of `.k` on the
  # same filesystem, and ONE `mv` renames each staged file over its `.k` record: an entry is never written in place and
  # a reader sees the old record or the whole new one. A record that cannot be read or has no line 2 is not staged and
  # stays as it is. The awk also appends the `.kpn` rows.
  mkdir -p "$out/.k.s" || return 0
  awk -F'\t' -v ko="$out/.k/" -v ks="$out/.k.s/" -v kpn="$out/.kpn" '{ f = ko $1; n = 0
      while ((getline l < f) > 0) L[++n] = l
      close(f)
      if (n >= 2) { L[2] = "#state ok"; g = ks $1; for (i = 1; i <= n; i++) print L[i] > g; close(g) }
      for (i = 1; i <= n; i++) delete L[i]
      print $1 "\t" $2 >> kpn }' "$out/.vs.hit"
  _vs_st=("$out/.k.s/"*)
  [ ! -e "${_vs_st[0]}" ] || mv -f "${_vs_st[@]}" "$out/.k/"
  cut -f1 "$out/.vs.hit" > "$out/.vs"
  return 0
}

# THE LEGACY RUNNER BLOBS: `<whole-file sha256>:<HR_SANDBOX span sha>:<HR_EXIT tail sha>` of a hermetic-run.sh some
# record keyed WHOLE-FILE before the span RUNNER ROWS, pinned once from that blob (the READSET_VS_LEGACY_UNIVERSE
# precedent). readset_keys reads such a row as standing in for `<runner>#HR_SANDBOX` and `#HR_EXIT` when the pinned
# span shas equal the current ones, so a record of a runner whose SPANS did not move carries forward. One entry: the
# runner the consumer-placement census keyed (BL-1043, its 210 records under consumer-placement-keys/).
READSET_RUNNER_LEGACY="424152daacd574e7998875de703bcfa957951fe690809e7208bcb95b3b449c06:ad96b5dbb41480ae48a6dd818f8ead71a3fe6618d5f897a95bc7b58e5a0069e1:90f62e6944174ca1c9e82d68bf2ca14c7cffda305e5f9189bb6c2827e5f618e6"
# THE RUNNER CARRY: `<old HR_SANDBOX span sha>:<new HR_SANDBOX span sha>` pairs. A key record whose `<runner>#HR_SANDBOX`
# row holds the OLD sha, read while the current span sha is the NEW one, is read as holding the new one and republished
# (c `m`), so a runner span edit that only ADDS a way to fail re-runs no fixture its other rows do not move: a pass
# carried this way is exactly the guarantee it had before the edit, and the new arm judges each fixture on its next
# run. A pair whose NEW sha is not the current span is inert. Each span a key record may still hold maps to the current
# one: the undeclared-tool trap (BL-1118) and its distribution-layout FAIL (BL-1143).
READSET_RUNNER_CARRY="ad96b5dbb41480ae48a6dd818f8ead71a3fe6618d5f897a95bc7b58e5a0069e1:059bbe1a035443c9e2e31a2d395cc11120e27cac4bd01cfc7097bb6bd5a977c9 366c7a6c930e1b61a719e0d5122fa54c2c3626ee89943c19652bd0b5d1e64238:059bbe1a035443c9e2e31a2d395cc11120e27cac4bd01cfc7097bb6bd5a977c9"
readset_keys() { # <list> <out>
  local list="$1" out="$2" seed=0 v2=/dev/null lp=/dev/null lv=/dev/null pp=/dev/null pv=/dev/null tab
  tab="$(printf '\t')"
  mkdir -p "$out/.k" || return 1
  readset_tools "$out"
  cut -f1 "$out/.now" > "$out/.is"
  [ -s "$out/.ls.now" ] || readset_listings "$out/.is" "$out/.ls.now"
  # ONE READ OF THE SHARED RECORD: it is copied into "$out" once and only the copy is read, so a
  # concurrent push renaming a new record over it cannot hand this run path lists and hashes from two trees.
  if [ -s "$VERIFIED_RECORD" ] && [ "$(cat "$VERIFIED_FORMAT" 2>/dev/null)" = v2 ] && cp "$VERIFIED_RECORD" "$out/.v2" 2>/dev/null; then
    v2="$out/.v2"; cut -f1 "$v2" > "$out/.pv"; pv="$out/.pv"
    readset_listings "$pv" "$out/.ls.v2"; lv="$out/.ls.v2"
    [ -d "$KEYS_DIR" ] || seed=1
  fi
  if [ -s "$KEYS_DIR/.prev" ]; then
    cut -f1 "$KEYS_DIR/.prev" > "$out/.pp"; pp="$out/.pp"
    readset_listings "$pp" "$out/.ls.prev"; lp="$out/.ls.prev"
  fi
  readset_rows "$out" rows | awk -F'\t' -v u="$out/.paths" 'BEGIN { while ((getline l < u) > 0) in_u[l] = 1 } ($2 in in_u)' > "$out/.krows"
  readset_declared "$list" "$out"
  readset_rows "$out" rows | awk -F'\t' '$2 ~ /^"/ { if (!($1 in q)) { q[$1] = 1; print $1 "\t" $2 } }' > "$out/.qfx"
  : > "$out/.krecs"
  if [ "$seed" = 0 ]; then
    readset_key_records "$KEYS_DIR" > "$out/.krecs"
  fi
  while IFS= read -r d; do b="${d%/}"; printf '%s\n' "${b##*/}"; done < "$list" > "$out/.kl"
  : > "$out/.khdr"; : > "$out/.kout"; : > "$out/.kpn"
  KPN="$out/.kpn" KN="$out/.now" KLN="$out/.ls.now" KLP="$lp" KLV="$lv" KPP="$pp" KPV="$pv" KV2="$v2" KR="$out/.krows" \
  KM="$out/.mapped.all" KLOC="$out/.local.valid" KC="$out/.krecs" KF="$out/.kl" KH="$out/.khdr" KO="$out/.kout" \
  KQ="$out/.qfx" KT="$out/.tools" KFT="$out/.ftools" KDF="$out/.dfx" KDK="$out/.dkeys" KDU="$out/.dunres" KRL="$READSET_RUNNER_LEGACY" KRC="$READSET_RUNNER_CARRY" \
  KMD="$out/.modes" awk -v seed="$seed" -v root="$FXROOT" '
    function rd(file, arr,   l, t) { while ((getline l < file) > 0) { t = index(l, "\t"); arr[substr(l, 1, t - 1)] = substr(l, t + 1) } }
    function kids(file, set,   l, t, p, i) { while ((getline l < file) > 0) { t = index(l, "\t"); p = (t ? substr(l, 1, t - 1) : l)
        while ((i = match(p, /\/[^\/]*$/)) > 0) { set[substr(p, 1, i - 1) SUBSEP substr(p, i + 1)] = 1; p = substr(p, 1, i - 1) } } }
    function cur(k) { if (substr(k, 1, 1) == "/") return (k in TV) ? TV[k] : "-"
      return (k ~ /\/$/) ? ((k in LN) ? LN[k] : "-") : ((k in NV) ? NV[k] : "-") }
    function sv(k) { if (substr(k, 1, 1) == "/") return cur(k)
      return (k ~ /\/$/) ? ((k in LV) ? LV[k] : "-") : ((k in VV) ? VV[k] : "-") }
    function addk(p) { if (p in NV) K[p] = 1; else if (p in DN) K[p "/"] = 1; else K[p] = 1 }
    # A DECLARED fixture takes its key VALUES from the shared composer (`.dkeys`), so the compare and the record
    # hold exactly what hermetic-run.sh --key-only prints; every other fixture reads the manifest through cur().
    # (No apostrophe may appear here: this awk program is a single-quoted shell literal.)
    function cv(f, k) { return ((f SUBSEP k) in DV) ? DV[f SUBSEP k] : cur(k) }
    function subtree(q,   p, r, i) {
      if (q in NV) X[q] = 1
      if (!(q in DN)) return
      X[q "/"] = 1
      for (p in NV) if (index(p, q "/") == 1) { X[p] = 1; r = substr(p, length(q) + 2)
        while ((i = match(r, /\/[^\/]*$/)) > 0) { r = substr(r, 1, i - 1); X[q "/" r "/"] = 1 } } }
    function sibs_only(k,   d, rv, n, a, j, e, any) {
      d = substr(k, 1, length(k) - 1); rv = R[k]; any = 0
      if (!(d in DN) || rv == "-") return 0
      n = split(KIDS[d], a, "\n")
      for (j = 2; j <= n; j++) { e = a[j]
        if ((k in LP) && LP[k] == rv) { if ((d SUBSEP e) in CP) continue }
        else if ((k in LV) && LV[k] == rv) { if ((d SUBSEP e) in CV) continue }
        else return 0
        if (!((d "/" e) in DN)) return 0
        any = 1 }
      return any }
    function grow(k,   d, rv, src, n, a, j) {
      d = substr(k, 1, length(k) - 1); rv = R[k]
      if (!(d in DN)) return 1
      if (rv == "-") src = ""
      else if ((k in LP) && LP[k] == rv) src = "P"
      else if ((k in LV) && LV[k] == rv) src = "V"
      else return 0
      n = split(KIDS[d], a, "\n")
      for (j = 2; j <= n; j++) {
        if (src == "P" && ((d SUBSEP a[j]) in CP)) continue
        if (src == "V" && ((d SUBSEP a[j]) in CV)) continue
        subtree(d "/" a[j]) }
      return 1 }
    BEGIN {
      rcn = split(ENVIRON["KRC"], rca, " "); for (rcj = 1; rcj <= rcn; rcj++) if (split(rca[rcj], rcb, ":") == 2) RCY[rcb[1] SUBSEP rcb[2]] = 1
      rln = split(ENVIRON["KRL"], rla, " "); for (rlj = 1; rlj <= rln; rlj++) if (split(rla[rlj], rlb, ":") == 3) { RLS[rlb[1]] = rlb[2]; RLT[rlb[1]] = rlb[3] }
      rd(ENVIRON["KN"], NV); rd(ENVIRON["KLN"], LN); rd(ENVIRON["KLP"], LP); rd(ENVIRON["KLV"], LV)
      kids(ENVIRON["KPP"], CP); kids(ENVIRON["KPV"], CV)
      if (seed) rd(ENVIRON["KV2"], VV)
      rd(ENVIRON["KT"], TV)
      while ((getline l < ENVIRON["KFT"]) > 0) { t = index(l, "\t"); f = substr(l, 1, t - 1); FT[f] = FT[f] "\n" substr(l, t + 1) }
      for (p in NV) { q = p
        while ((i = match(q, /\/[^\/]*$/)) > 0) { d = substr(q, 1, i - 1); e = substr(q, i + 1)
          DN[d] = 1; if (!((d SUBSEP e) in CN)) { CN[d SUBSEP e] = 1; KIDS[d] = KIDS[d] "\n" e }; q = d }
        if (index(p, root) == 1) { r = substr(p, length(root) + 1); i = index(r, "/"); if (i > 1) OWN[substr(r, 1, i - 1)] = OWN[substr(r, 1, i - 1)] "\n" p } }
      while ((getline l < ENVIRON["KM"]) > 0) MAPPED[l] = 1
      while ((getline l < ENVIRON["KDF"]) > 0) DECL[l] = 1
      while ((getline l < ENVIRON["KDK"]) > 0) { split(l, a, "\t"); DK[a[1]] = DK[a[1]] "\n" a[2]; DV[a[1] SUBSEP a[2]] = a[3] }
      while ((getline l < ENVIRON["KDU"]) > 0) { t = index(l, "\t"); f = substr(l, 1, t - 1); if (!(f in UN)) UN[f] = substr(l, t + 1) }
      while ((getline l < ENVIRON["KQ"]) > 0) { t = index(l, "\t"); QF[substr(l, 1, t - 1)] = substr(l, t + 1) }
      while ((getline l < ENVIRON["KLOC"]) > 0) { t = index(l, "\t"); LOC[substr(l, 1, t - 1)] = 1 }
      while ((getline l < ENVIRON["KR"]) > 0) { t = index(l, "\t"); f = substr(l, 1, t - 1); ROWS[f] = ROWS[f] "\n" substr(l, t + 1) }
      while ((getline l < ENVIRON["KC"]) > 0) { n = split(l, a, "\t")
        if (a[2] == "#state") RST[a[1]] = a[3]
        else if (a[2] == "#tools") RTL[a[1]] = a[3]
        else if (a[2] == "#pending") RPN[a[1]] = a[3]
        else if (a[2] == "#modes") RMH[a[1]] = a[3]
        else if (a[2] == "#mode") RMD[a[1] SUBSEP a[3]] = a[4]
        else { RK[a[1]] = RK[a[1]] "\n" a[2]; RV[a[1] SUBSEP a[2]] = a[3] } }
      while ((getline l < ENVIRON["KMD"]) > 0) { t = index(l, "\t"); MD[substr(l, 1, t - 1)] = substr(l, t + 1) }
      while ((getline f < ENVIRON["KF"]) > 0) {
        delete K; delete R; delete X; delete LM
        um = !(f in MAPPED)
        if (um) { for (p in NV) K[p] = 1 }
        else if (f in DECL) { n = split(DK[f], a, "\n"); for (j = 2; j <= n; j++) K[a[j]] = 1 }
        else { n = split(ROWS[f], a, "\n"); for (j = 2; j <= n; j++) addk(a[j])
               n = split(OWN[f], a, "\n"); for (j = 2; j <= n; j++) K[a[j]] = 1 }
        delete TK
        if (!(f in DECL)) for (k in K) if (k in FT) { n = split(FT[k], a, "\n"); for (j = 2; j <= n; j++) TK[a[j]] = 1 }
        for (k in TK) K[k] = 1
        has = 0; st = ""; rl = 0
        # A SEEDED WHOLE-TREE KEY ALSO COMPARES EVERY v2 PATH: one deleted since v2 is not in K.
        if (seed) { has = 1; st = "seeded"; for (k in K) R[k] = sv(k); if (um) for (p in VV) if (!(p in R)) R[p] = VV[p] }
        else if (f in RST) { has = 1; st = RST[f]
          n = split(RK[f], a, "\n"); for (j = 2; j <= n; j++) R[a[j]] = RV[f SUBSEP a[j]] }
        first = ""; fch = 0; tch = 0; SB = 0
        mig = (!seed && (f in RST) && RTL[f] != "canonical")
        # A RECORD KEYING THE RUNNER WHOLE-FILE (written before the span RUNNER ROWS): that row, equal to the current
        # file hash, stands in for `<runner>#HR_SANDBOX` and `#HR_EXIT` (same bytes); so does one naming a pinned legacy
        # blob (READSET_RUNNER_LEGACY) whose span sha for that key equals the current one. The record is republished, c `m`.
        lg = 0
        if (has && (f in DECL)) for (k in K) if (k ~ /#HR_(SANDBOX|EXIT)$/ && (!(k in R) || (seed && R[k] == "-"))) { w = k; sub(/#HR_[A-Z]+$/, "", w)
            ow = (w in R) ? R[w] : ((seed && (w in VV)) ? VV[w] : "-")
            if (ow != "-" && (((w in NV) && ow == NV[w]) || ((ow in RLS) && ((k ~ /#HR_SANDBOX$/) ? RLS[ow] : RLT[ow]) == cv(f, k)))) { R[k] = cv(f, k); lg = 1 } }
        # A RECORD UNDER A CARRIED RUNNER SPAN (READSET_RUNNER_CARRY): its old HR_SANDBOX row reads as the current one.
        if (has && (f in DECL)) for (k in K) if (k ~ /#HR_SANDBOX$/ && (k in R) && ((R[k] SUBSEP cv(f, k)) in RCY)) { R[k] = cv(f, k); lg = 1 }
        # A DECLARED FIXTURE IS COMPARED ON THE ROWS IT HAS NOW: a recorded row it no longer keys is ignored, except under
        # its own directory, where a recorded file now absent runs it. Its own inputs.decl is one of those files, so ANY edit
        # to the declaration, a narrowing included, runs the fixture once in each layout.
        if (has) {
          for (k in R) {
            if ((f in DECL) && !(k in K) && index(k, root f "/") != 1) continue
            if (k ~ /\/$/) rl = 1
            if (cv(f, k) == R[k]) continue
            if (substr(k, 1, 1) == "/") { if (!mig) tch = 1; continue }
            if (k == root && sibs_only(k)) { SB = 1; continue }
            if (first == "" || k < first) first = k; if (k ~ /\/$/) LM[k] = 1; else fch = 1 }
          for (k in K) if (!(k in R)) { if (substr(k, 1, 1) == "/") { if (!mig) tch = 1 } else if (first == "" || k < first) first = k } }
        # A MODE OR TYPE CHANGE (BL-1155): a record carrying `#modes v1` compares each recorded file key present then and
        # now on its tag (`#mode` lines; none is plain) against `.modes`, and a difference runs it, c `x`, which outranks
        # a content change because the store, twin and side-record skips clear only `k`. A record without the header
        # (written before it) adopts the current tags: `am`, republished c `a` when nothing else runs it.
        mch = ""; am = 0
        if (has && !seed) {
          if (RMH[f] == "v1") { for (k in R) { if (substr(k, 1, 1) == "/" || k ~ /\/$/ || R[k] == "-" || cv(f, k) == "-") continue
              if ((f in DECL) && !(k in K) && index(k, root f "/") != 1) continue
              if (((k in MD) ? MD[k] : "") != (((f SUBSEP k) in RMD) ? RMD[f SUBSEP k] : "") && (mch == "" || k < mch)) mch = k } }
          else am = 1 }
        run = 1; why = ""; c = ""
        if (!has) { why = "unrecorded"; c = "u" }
        else if (mch != "") { why = "mode changed " mch; c = "x" }
        else if (st == "stale" && !(f in LOC) && !((f in DECL) && RK[f] != "")) { why = "stale"; c = "s" }
        else if (tch) { why = "tools changed"; c = "k" }
        else if (first != "") { why = um ? "unmapped: closure changed" : "changed " first; c = "k" }
        else run = 0
        if (!run && (f in QF)) { run = 1; why = "read set names a quoted path " QF[f]; c = "k" }
        if (!run && (f in UN)) { run = 1; why = (substr(UN[f], 1, 7) == "mapper " || index(UN[f], "git.decl range refused ") == 1 || index(UN[f], "spans.decl refused ") == 1) ? UN[f] : "tool unresolved " UN[f]; c = "k" }
        # A STALE RECORD WITH A VALID ROW SET AND NO MOVED KEY SKIPS, and its `ok` record is published
        # on this push through `.k.always`, as a seeded one is: c `v` marks it.
        if (!run) { if (!seed && st != "stale" && !mig && !SB && !lg && !am) { print f "\tskip\t\t\t" st; continue }
                    ns = seed ? "seeded" : ((st == "stale") ? "ok" : st); if (!seed) c = (st == "stale") ? "v" : ((am && !mig && !lg) ? "a" : "m")
                    if (SB && !seed && st != "stale") { c = "b"; ns = "ok" }
                    if ((c == "m" || c == "a") && rl && !(f in DECL)) for (k in R) if (substr(k, 1, 1) != "/") X[k] = 1 }
        else if (!has || um) ns = "ok"
        else if (st == "stale" && !(f in DECL)) ns = ((f in LOC) ? "ok" : "stale")
        else if (fch && !(f in DECL)) ns = "stale"
        else { ns = "ok"; if (rl && !(f in DECL)) for (k in R) if (!mig || substr(k, 1, 1) != "/") X[k] = 1
               if (!(f in DECL)) for (k in LM) if (!grow(k)) ns = "stale" }
        for (k in K) X[k] = 1
        print f "\t" ns > ENVIRON["KH"]
        # A RECORD REPUBLISHED WITHOUT A RUN CARRIES ITS PENDING COUNT (none on a seed, which reads no record).
        if (!run && !seed && (f in RPN)) print f "\t" RPN[f] > ENVIRON["KPN"]
        for (k in X) print f "\t" k "\t" cv(f, k) > ENVIRON["KO"]
        print f "\t" (run ? "run" : "skip") "\t" why "\t" c "\t" ns }
    }' > "$out/.kdec"
  # THE RECORD carries `#modes v1` after its header and one `#mode\t<path>\t<tag>` line per non-plain file key in row
  # order, ahead of its rows (BL-1155); the publish puts `#pending` above them. The pre-suite's records carry both too.
  LC_ALL=C sort -t "$tab" -k1,1 -k2 "$out/.kout" | KMD="$out/.modes" awk -F'\t' -v kd="$out/.k" -v hdr="$out/.khdr" '
    function flush() { if (f == "") return; o = kd "/" f; print "#format k1" > o; print "#state " st[f] > o; print "#tools canonical" > o
      print "#modes v1" > o; if (mb != "") printf "%s", mb > o
      printf "%s", rb > o; close(o) }
    BEGIN { while ((getline l < hdr) > 0) { t = index(l, "\t"); st[substr(l, 1, t - 1)] = substr(l, t + 1) }
      while ((getline l < ENVIRON["KMD"]) > 0) { t = index(l, "\t"); MD[substr(l, 1, t - 1)] = substr(l, t + 1) } }
    $1 != f { flush(); f = $1; mb = ""; rb = "" }
    { r = substr($0, length(f) + 2); rb = rb r "\n"
      k = substr(r, 1, index(r, "\t") - 1); if (substr(k, 1, 1) != "/" && (k in MD)) mb = mb "#mode\t" k "\t" MD[k] "\n" }
    END { flush() }'
  readset_verdicts "$out"
}

# PUBLISH EACH PROSPECTIVE RECORD WHOSE FIXTURE PASSED, whatever its neighbours did, and every record a
# seed skipped. A FAIL, a kill or a missing verdict publishes nothing. temp + mv per record. The pre-run
# `.now` is kept as `$KEYS_DIR/.prev`, the path list the next run derives a moved listing's old entries
# from; it is only ever read after its listing hash matches the record's, so a red run may write it.
# LINE 4 IS `#pending <n>`: for a fixture this push RAN green, the PENDING rows of its log (`<out>/.pend`); for one
# republished without a run, the count carried in `<out>/.kpn` (its prior record's, or the store entry's on a store
# skip). Neither known: no line, and the count stays unrecorded (never a run reason). ONE awk writes every temp record.
# cl_write's consumer-layout records (<keys dir> = CL_KEYS_DIR) take line 4 from `.cl/.kpn` alone (no `.pend` is
# written under its <out>): a store skip's entry count, or the prior record's, which cl_publish wrote from the unit's log.
readset_keys_write() { # <out> [<keys dir>, default $KEYS_DIR]
  local out="$1" kd="${2:-$KEYS_DIR}" f b r
  [ -d "$out/.k" ] || return 0
  mkdir -p "$kd" 2>/dev/null || return 0
  : > "$out/.k.pub"
  for f in "$out/.k"/*; do
    [ -f "$f" ] || continue
    b="${f##*/}"; r=1
    if [ "$(cat "$out/$b" 2>/dev/null)" = ok ] || { r=0; grep -qxF "$b" "$out/.k.always" 2>/dev/null; }; then
      printf '%s\t%s\n' "$b" "$r" >> "$out/.k.pub"
    fi
  done
  # A write error is fatal to awk, so a failed awk publishes NOTHING (a short record would key on fewer rows).
  if KP="$out/.pend" KPN="$out/.kpn" awk -F'\t' -v kd="$out/.k" -v to="$kd" -v sfx=".key.tmp.$$" '
    BEGIN { while ((getline l < ENVIRON["KP"]) > 0) { i = index(l, ":"); if (i > 1) P[substr(l, 1, i - 1)] = substr(l, i + 1) }
            while ((getline l < ENVIRON["KPN"]) > 0) { i = index(l, "\t"); if (i > 1) C[substr(l, 1, i - 1)] = substr(l, i + 1) } }
    { b = $1; n = ""; if ($2 == "1") { if (b in P) n = P[b] } else if (b in C) n = C[b]
      if (n !~ /^(0|[1-9][0-9]*)$/) n = ""
      o = to "/" b sfx; i = 0
      while ((getline l < (kd "/" b)) > 0) { print l > o; if (++i == 3 && n != "") print "#pending " n > o }
      close(kd "/" b); close(o) }' "$out/.k.pub" 2>/dev/null; then
    while read -r b f; do
      [ -f "$kd/$b.key.tmp.$$" ] && mv "$kd/$b.key.tmp.$$" "$kd/$b.key" 2>/dev/null
    done < "$out/.k.pub"
  else
    while read -r b f; do rm -f "$kd/$b.key.tmp.$$" 2>/dev/null; done < "$out/.k.pub"
  fi
  if [ -s "$out/.now" ]; then
    cp "$out/.now" "$kd/.prev.tmp.$$" 2>/dev/null && mv "$kd/.prev.tmp.$$" "$kd/.prev" 2>/dev/null
  fi
  return 0
}

# CONSUMER-LAYOUT JOBS (BL-1027, keyed on INSTALLED PLACEMENT by BL-1043). A shipping fixture can pass here and
# fail in the layout install.sh builds, so the distribution hook installs this tree into a scratch consumer tree
# and names it in AI_DLC_FX_CL_TREE; run_fixtures reads that switch at depth 0 only (into `cl_tree`) and unsets
# it for every unit. Unset or empty, every function below returns at its first test and the run is the run
# without them; a consumer hook never sets it. Each SHIPPING fixture of the tree (tests/fixtures/<fx>/run.sh,
# install.sh's own ship rule) is a candidate. A selected fixture is one pool unit labelled `<fx>@consumer`, a
# name no fixture directory can carry, and its decision rows live in their own `.cl/.kdec`.
# THE KEYS ARE TAKEN INSIDE THE INSTALLED TREE. readset_manifest and readset_keys run with the tree as the cwd
# and tests/fixtures/ as the fixture root, so every key row is an INSTALLED path holding its INSTALLED bytes: a
# declared fixture's inputs reach it through core-paths.sh --map (readset_decl_parse's `cons` layout), and an
# undeclared one is keyed on the whole installed tree. A change to install.sh, a template it renders or a file
# it copies moves exactly the units whose installed inputs it moved, and a change that installs nothing moves
# none. The records live in CL_KEYS_DIR, never KEYS_DIR, so a pass recorded for the distribution layout skips
# nothing here. The verified record is left as it is: with no CL_KEYS_DIR, readset_keys seeds from it, and a seed
# keyed on distribution paths matches no installed key (every unit carries tests/fixtures/ or the installed runner
# row, which the distribution has not), so every seeded candidate runs and none is recorded unrun.
# EVERY PASS IS SHARED AND KEPT AT ONCE. Both stores sit in the SHARED verdict store base, counted suffix stripped:
# hermetic-run.sh writes a declared unit's entry under <base>/<the tree's FIXED root commit> as the unit passes, and
# the pool worker calls cl_publish for the unit's placement record under <base>/consumer-placement-keys/<repository
# root commit> at the same moment; cl_write at the end only drops reds and republishes store skips. So any run,
# in any clone or worktree, that reaches the same placement keys reuses the pass, and a stopped run loses none.
# The verdict store is read inside the tree: its rows are installed paths, so no distribution-layout entry matches.
# NO PUSH RUNS EVERY CANDIDATE. With no record and no store entry at all the step FAILs and names
# scripts/census-consumer-layout.sh, the one-time census that records each candidate it ran green; keys that
# cannot be built FAIL it too, naming the cause and the census. Both write `<out>/.cl.refused`, which
# run_fixtures reads. Only AI_DLC_FIXTURE_NO_SKIP=1 (`all`) runs every candidate.
# cl_select <out> <all|keys|census>: writes <out>/.cl.sel, the bare names this push runs as `<fx>@consumer`.
# `census` is scripts/census-consumer-layout.sh's mode, the only one that selects with no record present.
# It prints the selection line, up to ten `<fx>@consumer: <reason>` rows, the line naming every unit the
# distribution-twin skip took, and the verdict-store line naming every `<fx>@consumer` unit skipped on a store entry
# or on an unconfirmed placement record.
# THE DISTRIBUTION-TWIN SKIP (BL-1133). A unit cl_select would run because a key moved (flag `k`) is decided
# `<fx>\tskip\t\td\t<state>` instead when its DISTRIBUTION twin's row in the distribution decisions is a `skip` (a
# pass recorded on this tree's distribution key) and no key row that moved between the unit's prospective record
# (.cl/.k/<fx>) and its placement record is LAYOUT-SENSITIVE. A row is layout-sensitive when it was added or
# removed, is a listing (`<dir>/`), a tool (an absolute path) or a span row (`#` in the key), sits under
# tests/fixtures/ (the fixture's own run.sh and declarations, and lib/), is the runner or the mapper
# (scripts/ai-dlc/hermetic-run.sh, scripts/ai-dlc/core-paths.sh), or is not a byte copy of ITS OWN distribution
# source: the declared path the consumer-layout parse (.cl/.dparse) mapped it from, an F row's or, under a D row, the
# declared directory plus the rest of the path, must carry the same hash in the distribution's `.now`. A row no
# declaration maps (an undeclared unit's whole-tree keys) and a file install.sh renders over another path's bytes
# are layout-sensitive. Only a byte-copied subject file moving is
# acquitted; the class it lets through, identical bytes resolving paths differently once installed, is I33's. A
# unit with a `.dunres` row (a declared input the installed tree lacks, among the consumer-layout parse's
# refusals) always runs, so hermetic-run.sh refuses it: such an input has no key row on either side
# (readset_decl_keys), so nothing need move for it.
# The distribution decisions are <out> itself in `keys` mode, and the directory AI_DLC_CL_DIST_OUT names in `census`
# mode (scripts/predict-push-set.sh sets it for --predict; the census and its --only never do); they are read only
# when their `.now` is non-empty and their `.kdec` decides every fixture under FXROOT. A record that cannot be read,
# or holds no row, keeps the unit running. A `d` row publishes no record and is not a consumer-layout pass:
# `.k.always`, `.rskip` and `.vs.all` leave it out.
cl_select() {
  local out="$1" c b n_c n_s why="" kd vh base p dd="" n_d=0 hh
  [ -n "${cl_tree:-}" ] || return 0
  for b in "$cl_tree"/tests/fixtures/*/; do
    [ -f "$b/run.sh" ] || continue
    b="${b%/}"; printf '%s\n' "${b##*/}"
  done > "$out/.cl.all"
  : > "$out/.cl.sel"; rm -f "$out/.cl.refused"
  n_c="$(grep -c . "$out/.cl.all")"; case "$n_c" in ''|*[!0-9]*) n_c=0 ;; esac
  if [ "$n_c" -eq 0 ]; then printf '   ..    consumer layout: 0 of 0 shipping fixture(s) run as <fx>@consumer in %s\n' "$cl_tree"; return 0; fi
  # THE SHARED BASE: the verdict store base with a counted-<vk> suffix stripped. @consumer units run uncounted, and
  # counted and uncounted entries never share a store; the census runs unarmed and lands on the same base.
  base="${AI_DLC_VERDICT_STORE:-${HOME:-}/.cache/ai-dlc/verdicts}"
  case "${base##*/}" in counted-????????????) base="${base%/*}" ;; esac
  case "$base" in /*) ;; *) base="$PWD/$base" ;; esac
  rec_home kd consumer-placement-keys
  CL_KEYS_DIR="$kd"
  printf '%s\n' "$kd" > "$out/.cl.keys"; printf '%s\n' "$base" > "$out/.cl.store"; declare -f cl_publish > "$out/.cl.pub"
  mkdir -p "$out/.cl/.k" && c="$(cd "$out/.cl" && pwd -P)" || { printf 'no consumer-layout decision dir under %s\n' "$out" > "$out/.cl.refused"; return 0; }
  while IFS= read -r b; do printf 'tests/fixtures/%s/\n' "$b"; done < "$out/.cl.all" > "$c/.list"
  while IFS= read -r b; do [ ! -f "$cl_tree/tests/fixtures/$b/inputs.decl" ] || printf '%s\n' "$b"; done < "$out/.cl.all" > "$c/.mapped.all"
  : > "$c/.kdec"
  printf 'READSET_VS_PENDING=%q\n' "${READSET_VS_PENDING:-}" >> "$out/.cl.pub"
  # THE STORE LOOKUP IS KEYED AS ITS ENTRIES ARE WRITTEN: an @consumer unit runs uncounted (pool_cl's `env -u`), so
  # its entry carries no `#judge` row, and a counted run's judge must not be demanded of it here.
  ( cd "$cl_tree" || exit 1
    unset FXCOUNT_JUDGE FXCOUNT_KEYROWS FXCOUNT_LEGACY_STORE FXCOUNT_LEGACY_OK
    KEYS_DIR="$kd"; FXROOT="tests/fixtures/"; READSET_MAP="$c/.no-map"; READSET_LOCAL="$c/.no-local"; AI_DLC_VERDICT_STORE="$base"
    readset_manifest "$c"
    [ -s "$c/.now" ] || exit 1
    # THE INSTALL STAMP IS KEYED ON ITS STABLE FIELDS. install.sh writes .claude/.ai-dlc-version with the install time,
    # the source commit and the release, which move on every install or every release; measured as the only installed
    # file that differs between two installs of one sha, and the only one carrying the sha or VERSION. Its key value
    # is the hash of the file without those lines, so no unit reruns on the stamp alone.
    if [ -f .claude/.ai-dlc-version ]; then
      vh="$(grep -vE '^(installed_at|commit|skill_commit|version|skill_version):' .claude/.ai-dlc-version | shasum -a 256 | cut -d' ' -f1)"
      awk -F'\t' -v v="$vh" '$1 == ".claude/.ai-dlc-version" { print $1 "\t" v; next } { print }' "$c/.now" > "$c/.now.t" && mv "$c/.now.t" "$c/.now" || exit 1
    fi
    : > "$c/.local.valid"
    readset_keys "$c/.list" "$c"
    readset_vs_store "$PWD" > "$c/.vsdir" ) > "$c/.log" 2>&1 || : > "$c/.kdec"
  n_s="$(grep -c . "$c/.kdec")"; case "$n_s" in ''|*[!0-9]*) n_s=0 ;; esac
  if [ "$2" = all ]; then why="the read-set skip is forced off (AI_DLC_FIXTURE_NO_SKIP=1)"
    cp "$out/.cl.all" "$out/.cl.sel"; : > "$c/.k.always"
  elif [ "$n_s" != "$n_c" ]; then
    printf 'the consumer-layout keys could not be built in %s (%s of %s decided)%s\n' "$cl_tree" "$n_s" "$n_c" \
      "$([ -s "$c/.now.why" ] && printf -- ' -- %s' "$(sed -n 1p "$c/.now.why")")" > "$out/.cl.refused"
    printf 'once the cause is fixed, rebuild the records off-gate from a clean worktree at this sha: bash scripts/census-consumer-layout.sh\n' >> "$out/.cl.refused"; return 0
  elif [ "$2" != census ] && ! cl_any_record "$kd" "$(cat "$c/.vsdir" 2>/dev/null)"; then
    printf 'no consumer-layout record exists in %s, so every one of the %s candidates would run -- run the one-time census from a clean worktree at this sha: bash scripts/census-consumer-layout.sh\n' "$kd" "$n_c" > "$out/.cl.refused"; return 0
  else
    if [ "$2" = keys ]; then dd="$out"; elif [ "$2" = census ]; then dd="${AI_DLC_CL_DIST_OUT:-}"; fi
    for p in "$FXROOT"*/; do [ ! -f "$p/run.sh" ] || n_d=$((n_d + 1)); done
    if [ -n "$dd" ] && [ -s "$dd/.now" ] && [ -s "$dd/.kdec" ] && [ "$(grep -c . "$dd/.kdec")" = "$n_d" ]; then
      KN="$dd/.now" KD="$dd/.kdec" KP="$c/.dparse" KU="$c/.dunres" awk -F'\t' -v c="$c" -v kd="$kd" '
        function rows(f, A,   l, i, n) { n = 0
          while ((getline l < f) > 0) { if (substr(l, 1, 1) == "#") continue
            i = index(l, "\t"); if (i > 1) { A[substr(l, 1, i - 1)] = substr(l, i + 1); n++ } }
          close(f); return n }
        function src(f, k,   j, p) { if ((f SUBSEP k) in MF) return MF[f, k]
          for (j = 1; j <= ND[f]; j++) { p = DI[f, j] "/"; if (index(k, p) == 1) return DS[f, j] "/" substr(k, length(p) + 1) }
          return "" }
        function sens(f, k, v,   s) { if (k ~ /^\// || k ~ /\/$/ || index(k, "#") > 0 || index(k, "tests/fixtures/") == 1 \
            || k == "scripts/ai-dlc/hermetic-run.sh" || k == "scripts/ai-dlc/core-paths.sh") return 1
          s = src(f, k); return !(s in NOW) || NOW[s] != v }
        function quiet(f,   N, R, k) {
          if (rows(c "/.k/" f, N) == 0 || rows(kd "/" f ".key", R) == 0) return 0
          for (k in R) if (!(k in N)) return 0
          for (k in N) { if (!(k in R)) return 0; if (N[k] != R[k] && sens(f, k, N[k])) return 0 }
          return 1 }
        BEGIN { while ((getline l < ENVIRON["KN"]) > 0) { i = index(l, "\t"); if (i > 1) NOW[substr(l, 1, i - 1)] = substr(l, i + 1) }
                while ((getline l < ENVIRON["KD"]) > 0) { split(l, a, "\t"); if (a[2] == "skip") P[a[1]] = 1 }
                while ((getline l < ENVIRON["KP"]) > 0) { split(l, a, "\t")
                  if (a[2] == "F" && a[5] != "") MF[a[1], a[3]] = a[5]
                  else if (a[2] == "D" && a[5] != "") { ND[a[1]]++; DI[a[1], ND[a[1]]] = a[3]; DS[a[1], ND[a[1]]] = a[5] } }
                while ((getline l < ENVIRON["KU"]) > 0) { i = index(l, "\t"); if (i > 1) U[substr(l, 1, i - 1)] = 1 } }
        $2 == "run" && $4 == "k" && ($1 in P) && !($1 in U) && quiet($1) { print $1 "\tskip\t\td\t" $5; next }
        { print }' "$c/.kdec" > "$c/.kdec.t" && mv "$c/.kdec.t" "$c/.kdec" || rm -f "$c/.kdec.t"
    fi
    # THE CONTENT-KEYED SIDE RECORD (cl_publish): a unit decided `run` on its key (`k`) whose prospective record hash has a
    # side record under `<fx>.k/` passed at exactly these keys in some tree, so it is skipped (`h`). Not in a real census
    # (a prediction, which names AI_DLC_CL_DIST_OUT as the `d` skip does, applies it). A key record with no side directory
    # decides exactly as before. The skip's `#pending` count is the SIDE record's line 4, written to `.cl/.kpn`, never the
    # `<fx>.key` another tree's push may have replaced.
    if [ "$2" != census ] || [ -n "${AI_DLC_CL_DIST_OUT:-}" ]; then
      : > "$c/.hhit"; awk -F'\t' '$2 == "run" && $4 == "k" { print $1 }' "$c/.kdec" > "$c/.hcand"
      while IFS= read -r b; do
        [ -d "$kd/$b.k" ] && [ -s "$c/.k/$b" ] || continue
        hh="$(awk '!/^#/ || $0 == "#modes v1" || index($0, "#mode\t") == 1' "$c/.k/$b" | shasum -a 256 | cut -d' ' -f1)"
        [ -z "$hh" ] || [ ! -f "$kd/$b.k/$hh" ] || { printf '%s\n' "$b" >> "$c/.hhit"
          awk -v f="$b" 'NR <= 4 && /^#pending / { n = substr($0, 10) } END { print f "\t" (n == "" ? "-" : n) }' "$kd/$b.k/$hh" >> "$c/.kpn"; }
      done < "$c/.hcand"
      if [ -s "$c/.hhit" ]; then
        HH="$c/.hhit" awk -F'\t' 'BEGIN { while ((getline l < ENVIRON["HH"]) > 0) H[l] = 1 }
          $2 == "run" && $4 == "k" && ($1 in H) { print $1 "\tskip\t\th\t" $5; next } { print }' "$c/.kdec" > "$c/.kdec.t" \
          && mv "$c/.kdec.t" "$c/.kdec" || rm -f "$c/.kdec.t"
      fi
    fi
    awk -F'\t' '$2 == "run" { print $1 }' "$c/.kdec" > "$out/.cl.sel"
    awk -F'\t' '$2 == "skip" && ($4 == "v" || $4 == "m" || $4 == "b" || $4 == "a") { print $1 }' "$c/.kdec" > "$c/.k.always"
  fi
  n_s="$(grep -c . "$out/.cl.sel")"; case "$n_s" in ''|*[!0-9]*) n_s=0 ;; esac
  printf '   ..    consumer layout: %s of %s shipping fixture(s) run as <fx>@consumer in %s%s\n' "$n_s" "$n_c" "$cl_tree" "${why:+ -- every one, because $why}"
  [ -n "$why" ] || awk -F'\t' '$2 == "run" && n < 10 { n++; print "   ..      " $1 "@consumer: " $3 }' "$c/.kdec"
  [ -n "$why" ] || awk -F'\t' '$4 == "d" { n++; s = s " " $1 "@consumer" }
    END { if (n) print "   ..    consumer layout: " n " <fx>@consumer unit(s) skipped, the distribution twin passed on this key and every moved installed input is a byte copy of a distribution file:" s }' "$c/.kdec"
  # THE CONSUMER LAYOUT'S MODE ADOPTION (BL-1155). An `a` row is republished through `.k.always` with the present modes.
  # A `d` or `h` skip publishes no record, so its existing `<fx>.key` with no `#modes v1` line is listed in `.kmh` and
  # rewritten in place by cl_write (header added, nothing else moved). Decided here, so a prediction prints it too.
  : > "$c/.kmh"
  [ -n "$why" ] || KMH="$c/.kmh" awk -F'\t' -v kd="$kd" '
    function bare(r,   l, n, h) { n = 0; h = 0
      while ((getline l < r) > 0) { n++; if (n == 1 && l != "#format k1") { close(r); return 0 }; if (l == "#modes v1") h = 1 }
      close(r); return n > 0 && !h }
    $2 == "skip" && $4 == "a" { a++ }
    $2 == "skip" && ($4 == "d" || $4 == "h") && bare(kd "/" $1 ".key") { m++; print $1 > ENVIRON["KMH"] }
    END { if (a || m) print "   ..    read-set modes: consumer layout: " a + 0 " <fx>@consumer record(s) written before mode keys are decided to be republished with the present modes and types adopted; " m + 0 " <fx>@consumer record(s) skipped on a twin or side record (d/h) are decided to have the present modes added in place, with no run" }' "$c/.kdec"
  # EVERY UNIT SKIPPED ON A PASS RECORDED ELSEWHERE IS NAMED, in the distribution's own verdict-store line: a store hit
  # (`.vs`, readset_verdicts' hit list) and a record skip whose record is still UNCONFIRMED (`.vs.u`: cl_publish marked
  # it and no run that reached its end has cleared the mark, so a stopped run or a census wrote it). A skip on a record
  # a completed run published or confirmed, and a skip on a content-keyed side record (`h`), is named on the
  # `placement records:` line below.
  if [ -z "$why" ]; then
    awk -F'\t' '$2 == "skip" && $4 != "v" && $4 != "d" { print $1 }' "$c/.kdec" > "$c/.rskip"
    while IFS= read -r b; do [ ! -f "$kd/.unconfirmed/$b" ] || printf '%s\n' "$b"; done < "$c/.rskip" > "$c/.vs.u"
    cat "$c/.vs" "$c/.vs.u" > "$c/.vs.all" 2>/dev/null
  fi
  [ -n "$why" ] || VU="$c/.vs.u" awk -F'\t' 'BEGIN { while ((getline l < ENVIRON["VU"]) > 0) U[l] = 1 }
    $2 == "skip" && $4 != "v" && $4 != "d" && !($1 in U) { if ($4 == "h") { m++; t = t " " $1 "@consumer" } else { n++; s = s " " $1 "@consumer" } }
    END { if (n) print "   ..    placement records: " n " <fx>@consumer unit(s) skipped on a confirmed record:" s
      if (m) print "   ..    placement records: " m " <fx>@consumer unit(s) skipped on a content-keyed pass (a side record of exactly these keys):" t }' "$c/.kdec"
  [ -n "$why" ] || [ ! -s "$c/.vs.all" ] || printf '   ..    verdict store: %s fixture(s) skipped on a pass recorded elsewhere: %s\n' "$(grep -c . "$c/.vs.all")" "$(sed 's/$/@consumer/' "$c/.vs.all" | tr '\n' ' ' | sed 's/ $//')"
  return 0
}
# cl_tree_init <dir>: `git init` and the consumer tree's FIXED root commit (empty tree, fixed identity, date and
# message). Every consumer tree therefore has ONE project id, the key the verdict store files a pass under
# (<base>/<root commit>); a root that moved with the content would make every @consumer pass unreachable to the
# next run. The suite step and scripts/census-consumer-layout.sh both build their tree through this function.
# Runs with the caller's GIT_* location variables unset, so a leaked GIT_DIR can never init or commit into the
# repository being pushed instead of the scratch tree.
cl_tree_init() {
  ( unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY
    git -C "$1" init -q && GIT_AUTHOR_NAME=ai-dlc GIT_AUTHOR_EMAIL=ai-dlc@invalid GIT_COMMITTER_NAME=ai-dlc GIT_COMMITTER_EMAIL=ai-dlc@invalid GIT_AUTHOR_DATE=2000-01-01T00:00:00Z GIT_COMMITTER_DATE=2000-01-01T00:00:00Z \
      git -C "$1" -c commit.gpgsign=false commit -q --no-verify --allow-empty -m 'consumer-layout root' )
}
# cl_any_record <keys dir> <consumer store project dir>: true when either holds any record or entry at all.
cl_any_record() {
  local f
  for f in "$1"/*.key; do [ -f "$f" ] && return 0; done
  [ -n "$2" ] || return 1
  for f in "$2"/*; do [ -f "$f" ] && return 0; done
  return 1
}
# cl_publish <out> <fx>: publishes <fx>'s consumer-layout record THE MOMENT its unit passed, so a run stopped or red
# later keeps every pass it made. cl_select writes this definition to <out>/.cl.pub, which the pool worker and the
# census unit source: ONE implementation. hermetic-run.sh writes a declared unit's store entry at the same moment.
# The record lands UNCONFIRMED (`<keys dir>/.unconfirmed/<fx>`, written first) until cl_confirm clears the mark.
# LINE 4 IS `#pending <n>`, the READSET_VS_PENDING rows of the unit's log `<out>/.log/<fx>@consumer` (the definition
# .cl.pub carries); no log or no regex, no line, and a later skip on the record names its count unrecorded.
# THE CONTENT-KEYED SIDE RECORD `<keys dir>/<fx>.k/<sha256 of the prospective record's non-# rows>` is a copy of the
# published record, copied from this unit's own temporary file (never from `<fx>.key`, which a concurrent publish of
# another tree may have replaced), written beside `<fx>.key` and never replaced by another tree's push: cl_select skips a unit whose
# prospective record hash has one (decision `h`). All of it stays inside this function body, which is all .cl.pub carries.
cl_publish() {
  local kd="" n="" h="" t=""
  read -r kd 2>/dev/null < "$1/.cl.keys" || return 0
  [ -n "$kd" ] && [ -s "$1/.cl/.k/$2" ] || return 0
  [ -n "${READSET_VS_PENDING:-}" ] && [ -f "$1/.log/$2@consumer" ] && n="$(grep -cE "$READSET_VS_PENDING" "$1/.log/$2@consumer")" || :
  case "$n" in ''|*[!0-9]*) n="" ;; esac
  t="$kd/$2.key.tmp.$$"
  mkdir -p "$kd/.unconfirmed" 2>/dev/null && : > "$kd/.unconfirmed/$2" 2>/dev/null \
    && awk -v n="$n" '{ print } NR == 3 && n != "" { print "#pending " n }' "$1/.cl/.k/$2" > "$t" 2>/dev/null || return 0
  h="$(awk '!/^#/ || $0 == "#modes v1" || index($0, "#mode\t") == 1' "$1/.cl/.k/$2" | shasum -a 256 | cut -d' ' -f1)"
  if [ -n "$h" ] && mkdir -p "$kd/$2.k" 2>/dev/null && cp "$t" "$kd/$2.k/$h.t$$" 2>/dev/null; then mv "$kd/$2.k/$h.t$$" "$kd/$2.k/$h" 2>/dev/null || :; fi
  mv "$t" "$kd/$2.key" 2>/dev/null
  return 0
}
# cl_write <out>: publishes the remaining consumer-layout records through
# readset_keys_write with CL_KEYS_DIR named explicitly: only the store-skipped and republished rows (`.k.always`),
# because a PASS was already published by cl_publish the moment its unit passed. It drops the prospective record of
# every selected unit that did not pass. It never deletes a published record: the directory is shared, a record there is some run's
# real pass at its own keys, and a red unit is re-selected anyway, its keys differing from every pass recorded.
# Never writes KEYS_DIR. A refused selection publishes nothing.
cl_write() {
  local out="$1" c="$1/.cl" b
  [ -n "${cl_tree:-}" ] && [ -d "$c" ] && [ ! -e "$out/.cl.refused" ] && [ -s "$out/.cl.keys" ] || return 0
  read -r CL_KEYS_DIR < "$out/.cl.keys"
  mkdir -p "$CL_KEYS_DIR" 2>/dev/null || return 0
  while IFS= read -r b; do
    [ -n "$b" ] || continue
    [ "$(cat "$out/$b@consumer" 2>/dev/null)" = ok ] || rm -f "$c/.k/$b"
  done < "$out/.cl.sel"
  readset_keys_write "$c" "$CL_KEYS_DIR"
  # A `d`/`h` SKIP'S HEADER-LESS RECORD (`.kmh`, cl_select) TAKES `#modes v1` and one `#mode\t<path>\t<tag>` line per
  # non-plain file key it rows, from the consumer layout's present `.modes`, just before its first row; every other byte
  # is kept. temp + mv; a record already headed, absent or not `#format k1` is left as it is.
  [ ! -s "$c/.kmh" ] || [ ! -f "$c/.modes" ] || while IFS= read -r b; do
    [ -n "$b" ] && [ -f "$CL_KEYS_DIR/$b.key" ] || continue
    KMD="$c/.modes" awk '
      BEGIN { while ((getline l < ENVIRON["KMD"]) > 0) { t = index(l, "\t"); if (t > 1) MD[substr(l, 1, t - 1)] = substr(l, t + 1) } }
      { L[NR] = $0; if ($0 == "#modes v1") h = 1
        if (substr($0, 1, 1) != "#") { if (!p) p = NR; k = substr($0, 1, index($0, "\t") - 1)
          if (k != "" && substr(k, 1, 1) != "/" && substr(k, length(k)) != "/" && (k in MD) && !(k in S)) { S[k] = 1; mb = mb "#mode\t" k "\t" MD[k] "\n" } } }
      END { if (NR == 0 || L[1] != "#format k1" || h) exit 1
        for (i = 1; i <= NR; i++) { if (i == p) printf "#modes v1\n%s", mb; print L[i] }
        if (!p) printf "#modes v1\n%s", mb }' "$CL_KEYS_DIR/$b.key" > "$CL_KEYS_DIR/$b.key.mh.$$" 2>/dev/null \
      && mv "$CL_KEYS_DIR/$b.key.mh.$$" "$CL_KEYS_DIR/$b.key" 2>/dev/null || rm -f "$CL_KEYS_DIR/$b.key.mh.$$"
  done < "$c/.kmh"
  return 0
}
# cl_confirm <out>: at the end of a hook run, red or green (the distribution publishes its key records on a red run
# too), clears the unconfirmed mark of every unit this run passed or named on its verdict-store line. Only the hook's
# run calls it, so a stopped run's passes and a census's stay marked and are named once by the next push.
cl_confirm() {
  local out="$1" c="$1/.cl" kd="" b v
  [ -n "${cl_tree:-}" ] && [ -d "$c" ] && [ ! -e "$out/.cl.refused" ] && [ -s "$out/.cl.keys" ] || return 0
  read -r kd < "$out/.cl.keys"
  [ -n "$kd" ] && [ -d "$kd/.unconfirmed" ] || return 0
  set --
  while IFS= read -r b; do
    [ -n "$b" ] || continue
    v=""; read -r v < "$out/$b@consumer" 2>/dev/null
    [ "$v" != ok ] || set -- "$@" "$kd/.unconfirmed/$b"
  done < "$out/.cl.sel"
  while IFS= read -r b; do [ -z "$b" ] || set -- "$@" "$kd/.unconfirmed/$b"; done < "$c/.vs.all" 2>/dev/null
  [ "$#" -eq 0 ] || rm -f -- "$@" 2>/dev/null
  return 0
}

# THE SKIP-SET RECORD (BL-878): `$SKIPS_LOG` (the distribution hook's real push entry sets it; every other hook, a nested
# pool and a span a fixture sources leave it empty, and each function below then writes nothing). One header line per
# push, `<stamp>\tPUSH\t<hook pid>\t<local shas>\t<HEAD tree>\t<suite key or ->\t<detail>`, then one
# `<stamp>\tSKIP\t<hook pid>\t<layout>\t<fixture>\t<class or key>\t<state>` line per skipped unit. A write that fails
# changes nothing: the caller tested the path with a builtin, and every append here is error-suppressed.
skips_stamp() { [ -n "${SKIPS_STAMP:-}" ] || SKIPS_STAMP="$(date -u +%Y-%m-%dT%H:%M:%SZ)"; }
skips_flush() { # <log>: the pre-suite step lines queued in SKIPS_PRE follow the header
  [ -z "${1:-}" ] || [ -z "${SKIPS_PRE:-}" ] || { printf '%s' "$SKIPS_PRE" >> "$1"; } 2>/dev/null || :
  SKIPS_PRE=""
}
skips_header() { # <log> <detail> [<layout> <fixture> <why>]: a header, then one SKIP line when a layout is given
  [ -n "${1:-}" ] || return 0
  skips_stamp
  { printf '%s\tPUSH\t%s\t%s\t%s\t%s\t%s\n' "$SKIPS_STAMP" "$$" "${SKIPS_SHAS:--}" "${SKIPS_TREE:--}" "${SKIPS_KEY:--}" "$2" >> "$1"
    [ -z "${3:-}" ] || printf '%s\tSKIP\t%s\t%s\t%s\t%s\n' "$SKIPS_STAMP" "$$" "$3" "$4" "$5" >> "$1"; } 2>/dev/null || :
  skips_flush "$1"
}
# A FIXTURE SKIPPED ON A RECORDED PASS KEEPS ITS PENDING COUNT IN SIGHT. Writes `<out>/.precorded`, C-sorted, one
# `<fx>\t<n>` line per `skip` row of `.kdec` this push did not dispatch (no verdict file): n from `.kpn` (a
# republished or store-skipped record), else from line `#pending` of `$KEYS_DIR/<fx>.key`, else `-` (a record or
# entry written before the count was recorded, or a seeded one: unrecorded, never a run reason). A `skip` row of
# `.cl/.kdec` is the line `<fx>@consumer\t<n>`, read the same way from `.cl/.kpn` and the consumer-layout keys dir
# `.cl.keys` names. Called on the unchanged-push return and on the pool path, after the dispatch.
readset_pending_recorded() { # <out> [<skip record>]
  local o="$1" ckd="" sl="${2:-}" rc
  [ -z "$sl" ] || skips_stamp
  : > "$o/.precorded"
  read -r ckd 2>/dev/null < "$o/.cl.keys" || :
  if [ -s "$o/.kdec" ]; then set -- "$o/.kdec"; [ ! -s "$o/.cl/.kdec" ] || set -- "$o/.kdec" "$o/.cl/.kdec"
  elif [ -s "$o/.cl/.kdec" ]; then set -- "$o/.cl/.kdec"
  else skips_header "$sl" no-kdec; return 0; fi
  awk -F'\t' -v out="$o" -v kd="$KEYS_DIR" -v ckd="$ckd" -v cl="$o/.cl/.kdec" -v sl="$sl" -v id="$$" -v stp="${SKIPS_STAMP:--}" -v shas="${SKIPS_SHAS:--}" -v tree="${SKIPS_TREE:--}" -v sk="${SKIPS_KEY:--}" -v nc="${READSET_NO_CHANGE:-0}" '
    function kpn(c, A,   l, i) { while ((getline l < c) > 0) { i = index(l, "\t"); if (i > 1) A[substr(l, 1, i - 1)] = substr(l, i + 1) } }
    BEGIN { kpn(out "/.kpn", C); kpn(out "/.cl/.kpn", CC)
      while (nc != 1 && (getline l < (out "/list")) > 0) { if (l ~ /@consumer$/) rc++; else rd++ } }
    $2 != "skip" { next }
    { b = $1; d = kd; if (FILENAME == cl) { b = b "@consumer"; d = ckd }
      v = out "/" b; if ((getline l < v) >= 0) { close(v); next }
      if (FILENAME == cl) sc++; else sd++
      sr = sr stp "\tSKIP\t" id "\t" (FILENAME == cl ? "consumer" : "dist") "\t" $1 "\t" ($4 == "" ? "key" : $4) "\t" $5 "\n"
      n = "-"
      if (FILENAME == cl && ($1 in CC)) n = CC[$1]
      else if (FILENAME != cl && ($1 in C)) n = C[$1]
      else if (d != "") { r = d "/" $1 ".key"; i = 0
             while (i < 4 && (getline l < r) > 0) { i++; if (l ~ /^#pending /) n = substr(l, 10) }
             close(r) }
      if (n !~ /^(0|[1-9][0-9]*)$/) n = "-"
      print b "\t" n }
    END { if (sl != "") printf "%s\tPUSH\t%s\t%s\t%s\t%s\tdist=%d/%d/%d consumer=%d/%d/%d\n%s", stp, id, shas, tree, sk, rd + sd, rd, sd, rc + sc, rc, sc, sr >> sl }' "$@" | LC_ALL=C sort > "$o/.precorded.t" && mv "$o/.precorded.t" "$o/.precorded"
  rc=$?; skips_flush "$sl"; return $rc
}
# THE PENDING SUMMARY LINE, ONE RENDERER: <green count> fixtures this push ran printed PENDING rows (<green names>,
# space-led), and <recorded file> holds `<fx>\t<n>` for every fixture skipped on a recorded pass (`-` names stdin);
# only n > 0 is named, and an n of `-` is counted as "count unrecorded", never read as a zero; a `<fx>@consumer` one
# in its own clause, so consumer-layout records published before they carried a count do not swamp the distribution's.
# Prints nothing when no clause has a member.
readset_pending_line() { # <green count> <green names> <recorded file>
  awk -F'\t' -v g="$1" -v gn="$2" '
    $2 ~ /^[1-9][0-9]*$/ { k++; kn = kn " " $1 "(recorded)=" $2 }
    $2 == "-" && $1 ~ /@consumer$/ { cu++; next }
    $2 == "-" { u++ }
    END { s = ""
      if (g > 0) s = g " green fixture(s) printed a PENDING row, so part of each checked nothing:" gn
      if (k) s = s (s == "" ? "" : "; ") k " skipped on a recorded pass that printed a PENDING row:" kn
      if (u) s = s (s == "" ? "" : "; ") u " skipped on a recorded pass whose PENDING count is unrecorded (count unrecorded: recorded before counts were kept, or seeded)"
      if (cu) s = s (s == "" ? "" : "; ") cu " <fx>@consumer unit(s) skipped on a consumer-layout pass whose PENDING count is unrecorded (recorded before those records kept counts)"
      if (s != "") print "   PENDING: " s }' "$3"
}

apply_readset_skip() {
  local list="$1" out="$2" n_all n_sel readset_at readset_age n_unmapped unmapped_names readset_deriver dv dsha="" b

  n_all="$(grep -c . "$list" 2>/dev/null)"; case "$n_all" in ''|*[!0-9]*) n_all=0 ;; esac
  # THE ONE-TIME CARRY-FORWARD (RECORD_HOME): the key records before the verified record, whose sidecar is copied only
  # with it, so a copied record never pairs with a stamp it did not come with.
  rec_import "$GITDIR/ai-dlc-fixture-keys" "$KEYS_DIR"
  rec_import "$GITDIR/ai-dlc-fixture-verified" "$VERIFIED_RECORD" && rec_import "$GITDIR/ai-dlc-fixture-verified.format" "$VERIFIED_FORMAT"
  [ "$KEYS_DIR" != "$REC_OFF" ] || printf '   ..    verdict store OFF (no store base, a shallow clone or no root commit): no key record is read or written\n'

  # THE MANIFEST IS BUILT FIRST, BEFORE ANY EARLY RETURN: it is the pre-run state every record
  # this run publishes is keyed on.
  readset_manifest "$out"
  readset_local_validate "$list" "$out"

  # THE MAP DECAYS SILENTLY, AND THIS LINE IS THE ONLY THING THAT SAYS SO. A fixture directory
  # added after the last derivation has no entry and is keyed on the whole tree, so it runs on
  # almost every push -- correct, and the cost is invisible unless printed. The map's age and the
  # set it does not cover are printed on every run.
  if [ -s "$READSET_MAP" ] || [ -s "$out/.local.valid" ]; then
    readset_at="$(git log -1 --format=%h -- "$READSET_MAP" 2>/dev/null)"
    if [ -n "$readset_at" ]; then
      readset_age="$(git rev-list --count "${readset_at}..HEAD" 2>/dev/null)"
      case "$readset_age" in ''|*[!0-9]*) readset_age='?' ;; esac
      readset_age="derived at ${readset_at}, ${readset_age} commit(s) ago"
    else
      readset_age="UNTRACKED, age unknown"
    fi
    readset_unmapped "$list" "$out/.mapped.all" > "$out/.unmapped"
    n_unmapped="$(grep -c . "$out/.unmapped" 2>/dev/null)"; case "$n_unmapped" in ''|*[!0-9]*) n_unmapped=0 ;; esac
    printf '   ..    read-set map: %s; %s of %s fixture dir(s) UNMAPPED (keyed on the whole tree)' "$readset_age" "$n_unmapped" "$n_all"
    if [ "$n_unmapped" -gt 0 ]; then
      unmapped_names="$(tr '\n' ' ' < "$out/.unmapped" | sed 's/ $//')"
      printf ': %s' "$unmapped_names"
      readset_deriver="$(readset_deriver_path)"
      [ -n "$readset_deriver" ] && printf ' -- the next green push traces them automatically; by hand, with no sudo: bash %s --list "%s" --tracer sandbox' "$readset_deriver" "$unmapped_names"
    fi
    printf '\n'
  fi

  # THE ONLY RUN-ALL: the hashing instrument is broken, so no key can be read.
  [ -s "$out/.now" ] || { printf '   ..    could not hash the working tree -- running all %s\n' "$n_all"
    [ -s "$out/.now.why" ] && printf '   ..      cause: %s\n' "$(cat "$out/.now.why")"
    cl_select "$out" keys
    return 0; }

  # A DECISION FILE SHORT OF THE LIST IS A BROKEN INSTRUMENT: an undecided fixture would read as skipped.
  if ! readset_keys "$list" "$out" || [ "$(grep -c . "$out/.kdec" 2>/dev/null)" != "$n_all" ]; then
    printf '   ..    could not build the fixture keys -- running all %s\n' "$n_all"; cl_select "$out" keys; return 0
  fi
  awk -F'\t' '$2 == "skip" && ($5 == "seeded" || $4 == "v" || $4 == "m" || $4 == "b" || $4 == "a") { print $1 }' "$out/.kdec" > "$out/.k.always"

  if [ "${AI_DLC_FIXTURE_NO_SKIP:-}" = "1" ]; then
    : > "$out/.k.always"
    printf '   ..    read-set skip OFF (AI_DLC_FIXTURE_NO_SKIP=1) -- running all %s\n' "$n_all"
    cl_select "$out" all
    return 0
  fi

  awk -F'\t' 'NR == FNR { if ($2 == "run") r[$1] = 1; next }
              { b = $0; sub(/\/$/, "", b); sub(/.*\//, "", b) } (b in r)' "$out/.kdec" "$list" > "$out/.list.sel"
  n_sel="$(grep -c . "$out/.list.sel" 2>/dev/null)"; case "$n_sel" in ''|*[!0-9]*) n_sel=0 ;; esac
  printf '   ..    read-set keys: %s of %s fixture(s) run (%s changed, %s unrecorded, %s stale); skipping %s\n' \
    "$n_sel" "$n_all" "$(awk -F'\t' '$4 == "k"' "$out/.kdec" | grep -c .)" \
    "$(awk -F'\t' '$4 == "u"' "$out/.kdec" | grep -c .)" "$(awk -F'\t' '$4 == "s"' "$out/.kdec" | grep -c .)" \
    "$(( n_all - n_sel ))"
  awk -F'\t' '$2 == "run" && n < 10 { n++; print "   ..      " $1 ": " $3 }' "$out/.kdec"
  awk -F'\t' '$4 == "b" { n++ } END { if (n) print "   ..    read-set listings: " n " record(s) skipped on a fixture-root listing moved only by new sibling fixture directories and republished with the new listing" }' "$out/.kdec"
  awk -F'\t' '$4 == "m" { n++ } $4 == "a" { a++ } END { if (n) print "   ..    read-set tool keys: " n " record(s) written before the fixed tool dirs skipped on their tree keys alone and are republished with canonical tool keys (once per record)"
    if (a) print "   ..    read-set modes: " a " record(s) written before mode keys skipped on their content keys and are republished with the present modes and types adopted (once per record)" }' "$out/.kdec"
  if [ -s "$out/.vs" ]; then printf '   ..    verdict store: %s fixture(s) skipped on a pass recorded elsewhere: %s\n' "$(grep -c . "$out/.vs")" "$(tr '\n' ' ' < "$out/.vs" | sed 's/ $//')"; fi
  # WHAT WOULD CLEAR EACH STALE FIXTURE: a committed trace whose `# digest` line matches this tree, or a
  # valid local row. Every stale fixture is named under the reason its committed rows did not clear it.
  RS_D="$out/.cdig" awk -F'\t' 'FILENAME == ENVIRON["RS_D"] { d[$1] = $2; next }
    $2 == "run" && $4 == "s" { r = ($1 in d) ? d[$1] : "unmapped"; l[r] = l[r] " " $1; n[r]++ }
    END { t["nodigest"] = "committed rows carry no # digest line (written before digests)"
          t["differs"] = "committed # digest no longer matches this tree"
          t["unmapped"] = "no committed rows"
          for (r in l) print "   ..    stale, " n[r] " fixture(s): " t[r] " -- cleared by a committed trace whose # digest matches this tree, or a valid local row:" l[r] }' \
    "$out/.cdig" "$out/.kdec" | LC_ALL=C sort
  if grep -q '	run	stale	s	' "$out/.kdec" && [ -n "$(readset_deriver_path)" ]; then
    printf '   ..    to trace every stale, changed and unmapped fixture, with no sudo: bash %s --reconcile\n' "$(readset_deriver_path)"
  fi

  # A FIXTURE RECORDED STALE IS TRACED after a green run, beside the unmapped ones.
  dv="$(readset_deriver_path)"
  [ -n "$dv" ] && dsha="$(shasum -a 256 -- "$dv" 2>/dev/null | cut -d' ' -f1)"
  awk -F'\t' '$2 == "run" && $5 == "stale" { print $1 }' "$out/.kdec" | while IFS= read -r b; do
    grep -qxF "$b" "$out/.trace" "$out/.trace.held" 2>/dev/null || readset_trace_add "$out" "$b" "$dsha"
  done

  # An EMPTY dispatch list is not a skip: it falls through to the empty-suite FAIL in run_fixtures.
  # NO CHANGE MEANS BOTH SELECTIONS ARE EMPTY: a consumer-layout unit still to run keeps the pool open.
  cl_select "$out" keys
  if [ "$n_sel" -eq 0 ] && [ "$n_all" -gt 0 ] && [ ! -s "$out/.cl.sel" ]; then
    READSET_NO_CHANGE=1
    return 0
  fi
  mv "$out/.list.sel" "$list"
  return 0
}

# THE POOL'S INT/TERM/HUP HANDLER (BL-881). It runs inside run_fixtures, whose locals it reads. With no pool
# running (`pool_xp` empty) it only exits, as the traps did before it. With one running it ignores a second
# signal, writes `.pr/.stop` and only then reads the `.k` records, TERMs each recorded worker pid -- never a
# `.g` group and never by pattern, since a group id the watcher saw can be stale -- and waits for xargs, whose
# workers each reap their own unit and watcher through pool_abort. It waits ONCE: INT, TERM and HUP are
# ignored by then, so no signal can interrupt the wait, and a status above 128 means xargs itself died by a
# signal. Never re-wait on that status: bash 3.2 answers a second wait on a reaped pid with the SAME status,
# not 127, so a re-wait loop spins forever with every signal that could stop it ignored. The exit runs the
# EXIT trap, which removes the root.
# A RECORDED PID IS TERMED ONLY WHILE IT IS IN XARGS' GROUP. A worker SIGKILLed mid-run never empties its
# `.k`, and its pid can be reused by an unrelated process; a live worker is always in group `$pool_xp` (its
# units and watchers lead their own), and that id cannot be reused while xargs is this shell's unreaped child.
# THE GROUP IS READ ONCE, BY `pgrep -g "$pool_xp"`, and a record is TERMed only on a whole-line match in that
# listing. Not `ps`: under sandbox-exec, even an allow-default profile, the setuid /bin/ps cannot run (rc 126
# through the deriver, rc 71 bare, measured), so a ps test is always false and no worker is TERMed. pgrep's
# default exclusion of itself and its ancestors cannot hide a worker: pgrep's ancestors are this shell and
# its own ancestors, none of them in xargs' group. The listing is taken AFTER `.stop` is written: a worker
# that starts after the listing then sees `.stop` and exits 255, whereas with the listing taken first, a
# worker started between it and `.stop` would be in no listing, pass its `.stop` check and run its unit.
# The match is a `case` on the newline-framed listing, so it forks nothing per record.
# A BOX WITHOUT pgrep KEEPS THE PER-RECORD `ps -o pgid=` TEST, which is what ran before the listing: pgrep is
# primary, and only when `command -v pgrep` fails does each record get its own ps test (still false under
# sandbox-exec, as before; a box with neither has no way to read the group at all).
pool_stop() { # pool_stop <exit status>
  local k p pg="" pl=0
  trap '' INT TERM HUP
  if [ -n "${pool_xp:-}" ]; then
    : > "$out/.pr/.stop"
    command -v pgrep > /dev/null 2>&1 && pl=1 && pg="$(pgrep -g "$pool_xp" 2>/dev/null)"
    for k in "$out"/.pr/*.k; do
      [ -s "$k" ] || continue
      p=""; read -r p < "$k"
      case "$p" in ''|*[!0-9]*) continue ;; esac
      [ "$pl" = 1 ] || { [ "$(ps -o pgid= -p "$p" 2>/dev/null | tr -d ' ')" = "$pool_xp" ] && kill -TERM "$p" 2>/dev/null; continue; }
      case $'\n'"$pg"$'\n' in *$'\n'"$p"$'\n'*) kill -TERM "$p" 2>/dev/null ;; esac
    done
    wait "$pool_xp"
  fi
  exit "$1"
}

# THE INVALIDATION GUARD (BL-1052): scripts/invalidation-guard.sh, distribution only, fails the push before dispatch when a
# declared fixture is selected only by a change it cannot read. Absent (a consumer tree, a probe world): no-op.
readset_invalidation_guard() { # <out>
  [ -d core/scripts ] && [ -f scripts/invalidation-guard.sh ] || return 0
  if [ "${AI_DLC_FIXTURE_NO_SKIP:-}" = "1" ]; then
    printf '   ..    invalidation guard: SKIP -- AI_DLC_FIXTURE_NO_SKIP=1 dispatches every fixture, so no selection is judged\n'; return 0
  fi
  [ "${READSET_NO_CHANGE:-0}" = "1" ] && return 0
  bash scripts/invalidation-guard.sh --out "$1" --keys "$KEYS_DIR"
}

run_fixtures() {
  local rc=0 rf_hard=0 d b out out_q n_expected n_actual n_ordered verdict fx_root fx_s fx_err fx_m fx_p fx_t fx_e pool_xp=""
  # THE WORK OUTSIDE THE POOL IS TIMED (BL-1124): `ph` collects `<phase> <n>s` from the shell's own SECONDS, no
  # fork, and the distribution hook's real entry (depth 0, PREPUSH_CL_ENTRY) prints it as one `suite phases:` line.
  local ph="" ph_t="$SECONDS"
  # THE CONSUMER-LAYOUT SWITCH (cl_select) is read at depth 0 only and then UNSET, so no unit and no nested
  # hook ever inherits it: builtins only, and with the switch unset nothing below changes.
  local cl_tree="" cl_q=""
  if [ "$POOL_DEPTH_IN" -eq 0 ]; then cl_tree="${AI_DLC_FX_CL_TREE:-}"; fi
  unset AI_DLC_FX_CL_TREE
  if [ "$POOL_DEPTH_IN" -ge 2 ]; then
    printf '   FAIL  fixture pool refused: nested at depth %s (PREPUSH_POOL_DEPTH=%s), a hook started by a hook started by a pool opens no pool\n' "$POOL_DEPTH_IN" "$POOL_DEPTH_IN"
    return 1
  fi
  if [ "$POOL_DEPTH_IN" -ge 1 ]; then printf '   nested: depth %s, width %s\n' "$POOL_DEPTH_IN" "$FIXTURE_JOBS"; fi
  # THE POOL ROOT, in order: $TMPDIR, then /tmp, then a LOUD bare `mktemp -d`. A unit's TMPDIR is
  # "<root>/fx.XXXXXX/.t.XXXXX", 23 ENCODED characters (characters plus two per `/`) past the root, and it
  # must stay at or under 58 -- the macOS default TMPDIR `/var/folders/xx/<28>/T` as units saw it before the
  # pool set their TMPDIR -- so $TMPDIR is taken only when it is a writable directory whose PHYSICAL path is
  # at most 58 - 23 = 35 encoded. That keeps "point TMPDIR at a shorter directory" true under the pool, and a
  # consumer whose /tmp is a small tmpfs keeps its scratch on the disk TMPDIR names. A longer $TMPDIR (the
  # macOS default is 68 physical) is passed over silently for /tmp, which is 29 encoded per unit. The bare
  # fallback lands under the system temp dir, 86 encoded per unit on macOS as mktemp names it and 96 physical, past
  # the 85 that procsub-staged-refusal-boot allows, so it says so on stderr with the reason /tmp failed.
  fx_root=""
  if [ -n "${TMPDIR:-}" ] && [ -d "$TMPDIR" ] && [ -w "$TMPDIR" ]; then
    fx_root="$(cd "$TMPDIR" 2>/dev/null && pwd -P)" || fx_root=""
    fx_s="${fx_root//[!\/]/}"
    if [ -z "$fx_root" ] || [ "$(( ${#fx_root} + 2 * ${#fx_s} ))" -gt 35 ]; then fx_root=""; fi
  fi
  out=""
  if [ -n "$fx_root" ]; then out="$(mktemp -d "$fx_root/fx.XXXXXX" 2>/dev/null)" || out=""; fi
  if [ -z "$out" ]; then
    if fx_err="$(mktemp -d /tmp/fx.XXXXXX 2>&1)" && [ -d "$fx_err" ]; then out="$fx_err"
    else
      out="$(mktemp -d)" || return 1
      fx_s="${out//[!\/]/}"
      printf 'pre-push: fixture pool: /tmp/fx.XXXXXX failed (%s); FELL BACK to %s, where a unit TMPDIR is %s encoded characters -- units with a path-length limit may then fail; point TMPDIR at a short writable directory\n' "$(printf '%s' "$fx_err" | tr '\n' ' ')" "$out" "$(( ${#out} + 2 * ${#fx_s} + 11 ))" >&2
    fi
  fi
  # THE POOL ROOT IS REMOVED ON AN INTERRUPT OR AN ABORT TOO (BL-690). The EXIT trap's body carries the
  # path BAKED IN, %q-quoted, never `$out`: measured on bash 3.2, an EXIT trap fired by `exit` or by a
  # `set -u` abort inside this function runs after its locals are gone and reads `$out` unset, so a
  # body naming the variable removes nothing. INT, TERM and HUP go through pool_stop, which tears the
  # pool down when one is running and then exits 130, 143 and 129, which runs the EXIT trap and keeps
  # the hook non-zero. The parent shell sets no other trap (the trace's and the
  # worker's are in their own subshells), so nothing is chained; each straight-line removal of the root
  # below clears all four right after it, so the trap never outlives this function.
  printf -v out_q '%q' "$out"
  if [ -n "$cl_tree" ]; then printf -v cl_q ' %q' "$cl_tree"; fi
  trap "rm -rf -- $out_q$cl_q" EXIT; trap 'pool_stop 130' INT; trap 'pool_stop 143' TERM; trap 'pool_stop 129' HUP
  # DOT-PREFIXED, and that is what makes the name collision-proof rather than
  # unlikely. Every verdict file in "$out" is named for a fixture, and the glob
  # below cannot match a directory whose name begins with a dot -- so no fixture
  # can ever be called `.dur` and land on top of this one. `.log` is the same shape and
  # gets its safety from the same dot.
  mkdir -p "$out/.dur" "$out/.log" "$out/.pr" || { rm -rf "$out"; trap - EXIT INT TERM HUP; return 1; }
  # A NESTED POOL REGISTERS ITS ROOT with the nearest enclosing unit's watcher (BL-691; the watched-root
  # comment at POOL_STALL says why). A run under no `.pool-unit` marker writes nothing.
  fx_m=""
  if [ -n "${TMPDIR:-}" ]; then fx_m="$(cd "$TMPDIR" 2>/dev/null && pwd -P)" || fx_m=""; fi
  while [ -n "$fx_m" ]; do
    case "${fx_m##*/}" in
      .t.?????)
        if [ -f "$fx_m/.pool-unit" ] && [ ! -L "$fx_m/.pool-unit" ] && [ -O "$fx_m" ]; then
          if [ ! -L "$fx_m/.pool-nested" ] && fx_p="$(cd "$out" 2>/dev/null && pwd -P)" && printf '%s\n' "$fx_m" > "$fx_p/.pool-parent" \
            && fx_t="$(mktemp "$fx_m/.pool-nested.XXXXXX" 2>/dev/null)"; then
            { printf '%s\n' "$fx_p"
              if [ -f "$fx_m/.pool-nested" ]; then while IFS= read -r fx_e; do [ -d "$fx_e" ] && printf '%s\n' "$fx_e"; done < "$fx_m/.pool-nested"; fi; } > "$fx_t" 2>/dev/null && mv -f "$fx_t" "$fx_m/.pool-nested" 2>/dev/null || rm -f "$fx_t"
          fi
          break
        fi ;;
    esac
    fx_m="${fx_m%/*}"
  done
  # TRUNCATE THE THIS-RUN RECORD HERE, at the first line that can only run because the pool is
  # entering. Every exit below this point -- the empty-suite guard, a red unit, a worker that
  # died -- then leaves an EMPTY file, and a reader that finds one knows no complete measurement
  # exists rather than reading a stale figure as this run's. `2>/dev/null` as every other write
  # in this block carries: a record that cannot be written must not print over the suite's own
  # output, and the publish below is what decides whether anything is there to read.
  { : > "$LASTRUN_RECORD.tmp.$$" && mv -f "$LASTRUN_RECORD.tmp.$$" "$LASTRUN_RECORD"; } 2>/dev/null
  LASTRUN_OWN=""

  for d in "$FXROOT"*/; do
    [ -f "$d/run.sh" ] || continue
    printf '%s\n' "$d"
  done > "$out/list"
  # `grep -c .` PRINTS 0 and EXITS 1 on an empty file, so the obvious
  # `$(grep -c . "$f" || echo 0)` yields the two-line string "0\n0" — and both
  # integer tests in this function then die with "integer expression expected",
  # take their false branch, and the suite returns 0 having run nothing. That is
  # how the empty-suite guard below shipped UNABLE TO FIRE: the line was present,
  # the mechanism was not, and a fixture driving the real hook is what found it.
  # Normalise to a bare integer instead of rescuing a failed exit status.
  # Reduce the list to what a change can affect BEFORE the count is taken, so `n_expected` and
  # the verdict-completeness assertion below both speak about the set actually dispatched. A
  # skip applied after the count would make every skipped fixture read as a dropped worker.
  READSET_NO_CHANGE=0
  ph="$ph setup $((SECONDS - ph_t))s"; ph_t="$SECONDS"
  apply_readset_skip "$out/list" "$out"
  ph="$ph select $((SECONDS - ph_t))s"; ph_t="$SECONDS"
  readset_trace_report "$out"
  ph="$ph trace-report $((SECONDS - ph_t))s"; ph_t="$SECONDS"
  readset_invalidation_guard "$out" || { skips_header "${SKIPS_LOG:-}" invalidation-guard; rm -rf "$out"; trap - EXIT INT TERM HUP; return 1; }
  ph="$ph guard $((SECONDS - ph_t))s"; ph_t="$SECONDS"
  # A REFUSED CONSUMER-LAYOUT SELECTION FAILS THE STEP before any dispatch or skip return (cl_select says why).
  if [ -s "$out/.cl.refused" ]; then
    sed 's/^/   FAIL  consumer layout: /' "$out/.cl.refused"; skips_header "${SKIPS_LOG:-}" cl-refused
    rm -rf "$out"; trap - EXIT INT TERM HUP; return 1
  fi
  if [ -s "$out/.cl.sel" ]; then
    printf '%s\n' "$cl_tree" > "$out/.cl.tree"
    sed 's/$/@consumer/' "$out/.cl.sel" >> "$out/list"
  fi

  # A WHOLE-SUITE SKIP CANNOT BE SIGNALLED BY AN EMPTY LIST, and the guard four lines down is
  # why: an empty list is a hard FAIL here, deliberately, because "an empty suite passes every
  # assertion it never made". So the no-change case is carried by its own flag and returns
  # before the count is taken, leaving the prior verified state and the prior key untouched --
  # nothing ran, so nothing new is blessed.
  if [ "${READSET_NO_CHANGE:-0}" = "1" ]; then
    SUITE_SKIPPED=1
    # A seed that skips every fixture still publishes its records, so it lands once.
    readset_keys_write "$out"
    cl_write "$out"
    cl_confirm "$out"
    readset_pending_recorded "$out" "${SKIPS_LOG:-}"
    readset_pending_line 0 "" "$out/.precorded"
    rm -rf "$out"; trap - EXIT INT TERM HUP
    return 0
  fi

  n_expected="$(grep -c . "$out/list" 2>/dev/null)"
  case "$n_expected" in ''|*[!0-9]*) n_expected=0 ;; esac
  if [ "$n_expected" -eq 0 ]; then
    printf '   FAIL  no fixtures found -- an empty suite passes every assertion it never made\n'; skips_header "${SKIPS_LOG:-}" empty-suite
    rm -rf "$out"; trap - EXIT INT TERM HUP; return 1
  fi

  # DISPATCH LONGEST-FIRST, FROM WHAT THE LAST RUN ACTUALLY COST.
  #
  # A pool's makespan has two lower bounds: its longest unit, and the summed cost of its units
  # over the width. Dispatch order can move it only while the first is the larger, where the
  # makespan is decided by when the longest unit STARTS. Dispatched in glob
  # order the poles are picked up wherever the alphabet puts them, and the tail is one
  # long unit finishing alone: measured on the reference consumer at width 16, its two
  # heaviest units sat at positions 62 and 63 of 109 and the pole began 5.5s in.
  # Longest-first started it at 0.0s and took the suite from a 30.83s median to 28.61s
  # over four alternating pairs whose two sets of readings do not overlap -- ~7%.
  #
  # AND IT IS NOT FREE, WHICH IS WHY THE ORDER IS NOT ALSO A CLAIM ABOUT SPEED. Running
  # the heavy units together makes each of them slower: the same measurement puts the
  # consumer's pole at 25.30s dispatched late against 28.46s dispatched first, so a 5.5s
  # head start bought 2.4s. On THIS repository's own suite a push that dispatches most units
  # is WIDTH-BOUND: the summed cost over the width is several times the pole (the pole step
  # prints both and names the larger), and a list schedule over BL-1124's recorded costs
  # gives the same makespan in the logged order and longest-first, so no dispatch order
  # wins anything measurable here. The reorder ships for the
  # consumer's schedule shape, and the distribution carries it because I66 makes the two
  # runners one program. A `hoist the K longest, leave the rest alphabetical` variant was
  # measured too and lost to plain longest-first, so nothing here carries a tuning
  # constant that §7's gate item 3 would have to expire.
  #
  # A CLEAN ROW WINS; `<unit>@red` IS THE FALLBACK, then the 999999 unknown slot. A red pool writes
  # only `@red` rows (the merge below), so a unit that has only ever run red is ordered by its red cost
  # rather than as unknown. A `<fx>@consumer@red` row strips to `<fx>@consumer`, which `b` never is --
  # the same as a clean `<fx>@consumer` row: a consumer-layout unit is ordered by its distribution rows.
  # THE RECORD IS WRITTEN BY EVERY POOL AND LIVES UNDER .git, for I55 arm 4's
  # reason exactly: the content key hashes the working tree, so a cost record inside it
  # would change the key that decides whether this suite runs at all.
  #
  # THE FALLBACK IS THE LIST, and it is reached three ways -- no record yet (every first
  # run on a fresh clone), an unreadable one, and a reordering that did not come back
  # with exactly the units it was given. The last is the guard that matters: a reorder
  # which DROPS a unit reads exactly like a reorder that is fast. It cannot hide even if
  # this guard were removed, because `n_expected` and the report below are both taken
  # from "$out/list" and never from the dispatch order -- so a dropped unit still reaches
  # the reader, still finds no verdict, and still fails the push.
  cp "$out/list" "$out/.order"
  if [ -s "$DURATIONS_RECORD" ]; then
    awk 'NR==FNR { if (NF == 2) { k = $1; if (sub(/@red$/, "", k)) red[k] = $2; else prev[k] = $2 }; next }
         { b = $0; sub(/\/$/, "", b); sub(/.*\//, "", b); sub(/@consumer$/, "", b)
           print ((b in prev) ? prev[b] : ((b in red) ? red[b] : 999999)) " " $0 }' \
        "$DURATIONS_RECORD" "$out/list" 2>/dev/null \
      | sort -k1,1nr | cut -d' ' -f2- > "$out/.order.lpt" 2>/dev/null
    n_ordered="$(grep -c . "$out/.order.lpt" 2>/dev/null)"
    case "$n_ordered" in ''|*[!0-9]*) n_ordered=0 ;; esac
    [ "$n_ordered" -eq "$n_expected" ] && mv "$out/.order.lpt" "$out/.order"
  fi

  # Each worker records its verdict to a file named for its fixture. The verdict is read
  # back from those FILES, not from xargs exit status, because that is what makes the
  # completeness assertion below possible -- and because `xargs` collapses any number of
  # failures into one exit code that cannot say WHICH.
  #
  # It records its own COST beside the verdict, in whole seconds off the worker shell's
  # own SECONDS -- no clock fork, and a unit never dispatched simply has no line, which
  # is the reading the ordering above wants anyway. A fixture the record has never seen
  # sorts FIRST: an unknown cost is treated as the largest, because the failure mode
  # worth avoiding is a new heavy unit dispatched last.
  # A FIXTURE THAT CARRIES `inputs.decl` IS RUN BY core/scripts/hermetic-run.sh, in a sandbox holding only
  # what it declares, and never by its own run.sh directly. The runner is resolved the way
  # readset_deriver_path resolves the deriver (consumer layout first); a declared fixture whose runner is
  # absent FAILS with a log line, because falling through to run.sh would run it un-sandboxed and read green.
  # EVERY RUN SITE GOES THROUGH pool_run (BL-606), the in-pool trace's deriver call included: a hung trace
  # is a hung unit. The unit leads its own group; a WATCHER beside it (its own group too, so the walk never
  # sees it) reads the byte signature once a second -- one `find -ls` over the watched root, the log and
  # every validated nested pool root listed in the root's `.pool-nested`, summed by one awk; the list is
  # read and validated with builtins only (`read`, `[`, `case`), so it adds no fork -- and walks the tree
  # with one `ps` and one awk to know what a kill must reach: five forks a poll with the `sleep`. NO `{}` MAY APPEAR IN THIS BODY: `xargs -I{}` substitutes it inside the
  # body string too, so a `find -exec stat {} +` becomes a stat of the unit's own path and the sum is wrong.
  # The worker blocks on `wait` for the unit itself,
  # so a unit that exits costs no poll latency. On POOL_STALL still polls the watcher records the refusal
  # FIRST, then stops the whole tree, re-walks it and kills every group and pid it found; the worker, seeing
  # the record, waits for the watcher to finish rather than killing it mid-sweep. A refusal recorded after
  # the worker killed its watcher (the unit exited in the same instant) is swept again by the worker from
  # the groups the watcher last saw. A refused deriver call never falls through to a direct run.sh.
  # The watcher also kills the unit's OWN group by its recorded pid: the unit is still the worker's
  # unreaped child at that point, so the id cannot have been reused, and a `ps` that cannot see the tree
  # (a sandbox granting no process-info) still leaves a refused unit killed rather than waited on forever.
  # WHEN `ps` FAILS (sandbox-exec denies the setuid /bin/ps), `self` is empty and pool_kill walks the unit's
  # descendants without ps: pool_tree lists the unit pid and then, breadth-first, each listed pid's children
  # by `pgrep -P`, which runs under the same sandbox. The discipline is the ps path's: STOP every listed pid,
  # re-walk, then KILL each listed pid's group and each pid. A listed pid is live, so its id cannot name a
  # reused group, and a pid is listed before its children are asked for, so a failing pgrep leaves the unit
  # pid and its own group killed, as before the walk. Measured: a unit's grandchild in its own group survived
  # the TERM teardown with `ps` failing (a PATH shim exiting 71, and an allow-default sandbox-exec) before the
  # walk, and dies under it.
  # THE WALK CANNOT REACH A REPARENTED PROCESS, so with `ps` failing the watcher keeps the ps path's known-group
  # memory without ps (pool_mem): each poll it walks the tree, takes every walked pid whose `pgrep -g` listing
  # holds a walked or previously known pid as a group (a live pid leads group <pid> or no group at all), keeps
  # each remembered group that still holds a known pid, and writes the known pids and groups to `.g` as the ps
  # path does. pool_kill_tree then KILLs each remembered group that is not a walked pid (the per-pid group KILL
  # before it already covers those), and only while its listing NOW holds a known pid: a group id is reused only
  # after every member is gone, so a reused id can name a known pid only if that pid was itself reused into the
  # new group -- the ps path residual, stated beside POOL_WALK. Measured: a unit's own-group descendant whose
  # parent had exited (ppid 1) survived the TERM teardown with `ps` failing before the memory, and dies under it;
  # a remembered group whose listing held no known pid was left alive, the same group with its pid known was killed.
  # THE WATCHER CHECKS ITS WORKER'S PID EVERY POLL. A worker that dies (SIGKILLed, or its xargs gone) never
  # reaps the watcher, so on that poll the watcher kills the unit's tree, whose verdict nobody will record,
  # and exits; without the check its only exit was a refusal and it outlived its worker indefinitely.
  # IT CHECKS ITS UNIT'S PID TOO, with the builtin `kill -0` (no fork): bash reaps an exited async child at once,
  # so the check fails as soon as the unit is gone and the watcher exits with no sweep, as when the worker kills
  # it after `wait`. A worker left blocked with no unit under it (BL-1072) is released then, not at POOL_STALL.
  # A UNIT IN ITS OWN GROUP DOES NOT HEAR THE TERMINAL'S ^C, and neither does a worker: xargs is started in
  # the background under `set -m`, so it and its workers lead a group of their own. The push's shell hears
  # the ^C (or a TERM or HUP) and pool_stop TERMs every worker recorded in `.pr/<unit>.k`; the worker traps
  # INT/TERM/HUP and kills its unit's tree and its watcher (BL-881). WHY `set -m` AND NOT A PLAIN `&`: bash
  # starts a plain background job of a non-interactive shell with SIGINT ignored, an ignored signal cannot
  # be trapped, and every unit would inherit it -- measured on /bin/bash 3.2.57, the worker's INT trap
  # fired in 0 of 2 workers under `&` and 2 of 2 under `set -m`. `.k` is written AFTER the trap is set and
  # BEFORE the `.stop` check: pool_stop writes `.stop` before it reads the `.k` files, so a worker is
  # either read and TERMed or sees `.stop` and exits 255, which stops xargs dispatching the queue (an
  # exit of 130 does not). Every exit empties `.k` first, with no fork, so a reused pid is never TERMed.
  # REFUSED IS WRITTEN BEFORE THE TRACE'S ROW DISCARD, so a refused unit keeps no trace rows; it writes no
  # `.dur` line, so it records no cost; readset_keys_write and readset_live_trace take only `ok`.
  readset_pool_trace_prep "$out"
  ph="$ph order $((SECONDS - ph_t))s"; ph_t="$SECONDS"
  set -m
  { PREPUSH_POOL_DEPTH="$((POOL_DEPTH_IN + 1))" AI_DLC_FX_OUT="$out" AI_DLC_FX_TRACE="$PT_ROOT" AI_DLC_FX_TRACE_LIST="$PT_LIST" AI_DLC_FX_DV="$PT_DV" \
  POOL_STALL="$POOL_STALL" POOL_WALK="$POOL_WALK" AI_DLC_FX_TOTAL="$n_expected" \
    exec xargs -P "$FIXTURE_JOBS" -I{} bash -c '
    d="$1"; b="$(basename "$d")"; tp=""; wx=""; pr="$AI_DLC_FX_OUT/.pr/$b"
    pool_walk() { ps -A -o pid=,ppid=,pgid=,stat=,time= 2>/dev/null | awk -v root="$1" -v self="$2" -v groups="$3" -v known="$4" "$POOL_WALK"; }
    pool_tree() {
      local l="$1" q="$1" c p
      while [ -n "$q" ]; do
        c=""; for p in $q; do c="$c $(pgrep -P "$p")"; done
        q="$(printf "%s\n" $c)"; l="$l $q"
      done
      printf "%s" "$l"
    }
    pool_mem() {
      local t="" g m p ng="" nk=""
      for p in $(pool_tree "$1"); do t="$t $p"; done
      for g in $t $3; do
        case " $ng " in *" $g "*) continue ;; esac
        m="$(pgrep -g "$g")"
        for p in $m; do case " $t $2 " in *" $p "*) ng="$ng $g"; for p in $m; do nk="$nk $p"; done; break ;; esac; done
      done
      kp="$t$nk"; kg="$ng"
    }
    pool_kill_tree() {
      local l p g m
      l="$(pool_tree "$1")"
      for p in $l; do kill -STOP "$p"; done
      l="$l $(pool_tree "$1")"
      for p in $l; do kill -KILL -- "-$p"; done
      for g in $3; do case " $l " in *" $g "*) continue ;; esac; m="$(pgrep -g "$g")"; for p in $m; do case " $2 " in *" $p "*) kill -KILL -- "-$g"; break ;; esac; done; done
      for p in $l; do kill -KILL "$p"; done
    }
    pool_kill() {
      local w ws wsig wlp wlg p
      [ -n "$2" ] || { pool_kill_tree "$1" "$3" "$4"; return 0; }
      w="$(pool_walk "$1" "$2" "$4" "$3")"
      IFS="|" read -r ws wsig wlp wlg <<< "$w"
      for p in $wlp; do kill -STOP "$p"; done
      w="$(pool_walk "$1" "$2" "$wlg $4" "$wlp $3")"
      IFS="|" read -r ws wsig wlp wlg <<< "$w"
      for p in $wlg; do kill -KILL -- "-$p"; done
      for p in $wlp; do kill -KILL "$p"; done
    } 2>/dev/null
    pool_kill_saved() {
      local kp="" kg=""
      { read -r kp; read -r kg; } < "$pr.g"
      pool_kill "$pid" "$self" "$kp" "$kg"
    } 2>/dev/null
    pool_abort() {
      [ -n "${wpid:-}" ] && kill -KILL -- "-$wpid"
      [ -n "${pid:-}" ] && pool_kill_saved
      : > "$pr.k"
      exit 130
    } 2>/dev/null
    trap pool_abort INT TERM HUP
    printf "%s\n" "$$" > "$pr.k"
    [ -f "$AI_DLC_FX_OUT/.pr/.stop" ] && { : > "$pr.k"; exit 255; }
    pool_run() {
      local lg="$1" rc wr wp
      shift
      wr="$(mktemp -d "$AI_DLC_FX_OUT/.t.XXXXX" 2>&1)" && [ -d "$wr" ] \
        || { printf "pre-push: pool: no watched root under %s (%s); the unit is NOT run\n" "$AI_DLC_FX_OUT" "$wr" | tee "$lg" >&2; return 1; }
      : > "$wr/.pool-unit"; wp="$(cd "$wr" && pwd -P)" || wp="$wr"
      self="$(ps -o pgid= -p "$$" 2>/dev/null | tr -d " ")"
      : > "$pr.g"; rm -f "$pr.st"
      set -m
      TMPDIR="$wr" "$@" > "$lg" 2>&1 < /dev/null &
      pid=$!
      ( still=0; max=0; sg=""; kp=""; kg=""
        while :; do
          sleep 1
          if ! kill -0 "$$"; then pool_kill "$pid" "$self" "$kp" "$kg"; exit 0; fi
          kill -0 "$pid" || exit 0
          w="$(pool_walk "$pid" "$self" "$kg" "$kp")"
          IFS="|" read -r ws wsig wlp wlg <<< "$w"
          [ -n "$wlp" ] && { kp="$wlp"; kg="$wlg"; printf "%s\n%s\n" "$kp" "$kg" > "$pr.g"; }
          [ -n "$self" ] || { pool_mem "$pid" "$kp" "$kg"; printf "%s\n%s\n" "$kp" "$kg" > "$pr.g"; }
          set --; nn=0
          [ -f "$wr/.pool-nested" ] && [ ! -L "$wr/.pool-nested" ] && while [ "$nn" -lt 16 ] && IFS= read -r e; do
            nn=$((nn + 1)); x=""
            case "${e##*/}" in fx.??????) [ -d "$e" ] && [ ! -L "$e" ] && [ -f "$e/.pool-parent" ] && [ ! -L "$e/.pool-parent" ] && read -r x < "$e/.pool-parent" && [ "$x" = "$wp" ] && set -- ${1+"$@"} "$e" ;; esac
          done < "$wr/.pool-nested"
          cur="$(find "$wr" "$lg" ${wx:+"$wx"} ${1+"$@"} -type f -ls 2>/dev/null | awk "{ s += \$7 } END { print s + 0 }")"
          if [ "$cur" = "$sg" ]; then still=$((still + 1)); else still=0; sg="$cur"; fi
          [ "$still" -gt "$max" ] && { max=$still; printf "%s\n" "$max" > "$pr.st"; }
          if [ "$still" -ge "$POOL_STALL" ]; then
            printf "%s\n" "$still" > "$pr.refused"
            pool_kill "$pid" "$self" "$kp" "$kg"
            kill -KILL -- "-$pid" 2>/dev/null
            exit 0
          fi
        done ) < /dev/null > /dev/null 2>&1 &
      wpid=$!
      set +m
      printf "%s\n" "$wpid" > "$pr.w"
      wait "$pid"; rc=$?
      if [ -f "$pr.refused" ]; then wait "$wpid"
      else
        kill -KILL -- "-$wpid"; wait "$wpid"
        [ -f "$pr.refused" ] && pool_kill_saved
      fi
      pid=""; wpid=""
      printf "%s %s\n" "$b" "$(cat "$pr.st" 2>/dev/null || echo 0)" >> "$AI_DLC_FX_OUT/.stall"
      return "$rc"
    } 2>/dev/null
    pool_cl() { cd "$1" || exit 1; shift; export TMPDIR; exec "$@"; }
    if case "$b" in *@consumer) true ;; *) false ;; esac; then
      ct=""; read -r ct 2>/dev/null < "$AI_DLC_FX_OUT/.cl.tree"; cf="${b%@consumer}"
      if [ -f "$ct/tests/fixtures/$cf/inputs.decl" ]; then set -- bash "$ct/scripts/ai-dlc/hermetic-run.sh" --root "$ct" "$cf"
      else set -- bash "tests/fixtures/$cf/run.sh"; fi
      cs=""; read -r cs 2>/dev/null < "$AI_DLC_FX_OUT/.cl.store"
      [ -n "$cs" ] || printf "consumer layout: %s/.cl.store names no shared store base, so %s did not run\n" "$AI_DLC_FX_OUT" "$b" > "$AI_DLC_FX_OUT/.log/$b"
      if [ -n "$ct" ] && [ -n "$cs" ] && pool_run "$AI_DLC_FX_OUT/.log/$b" pool_cl "$ct" env -u FXCOUNT_RC -u FXCOUNT_DIR -u FXCOUNT_JUDGE -u AI_DLC_FX_CL_TREE \
        AI_DLC_VERDICT_STORE="$cs" "$@"; then printf ok > "$AI_DLC_FX_OUT/$b"; . "$AI_DLC_FX_OUT/.cl.pub" && cl_publish "$AI_DLC_FX_OUT" "$cf"
      else printf FAIL > "$AI_DLC_FX_OUT/$b"; fi
    elif [ -f "$d/inputs.decl" ]; then
      hr=""
      for c in scripts/ai-dlc/hermetic-run.sh core/scripts/hermetic-run.sh; do
        [ -f "$c" ] && { hr="$c"; break; }
      done
      if [ -z "$hr" ]; then
        printf "hermetic-run.sh not found at scripts/ai-dlc/ or core/scripts/; %s declares inputs.decl and cannot run without it\n" "$b" > "$AI_DLC_FX_OUT/.log/$b"
        printf FAIL > "$AI_DLC_FX_OUT/$b"
      elif pool_run "$AI_DLC_FX_OUT/.log/$b" bash "$hr" --root "$PWD" "$b"; then printf ok   > "$AI_DLC_FX_OUT/$b"
      else                                                                    printf FAIL > "$AI_DLC_FX_OUT/$b"; fi
    elif [ -n "${AI_DLC_FX_TRACE:-}" ] && case " $AI_DLC_FX_TRACE_LIST " in *" $b "*) true ;; *) false ;; esac; then
      tp="$AI_DLC_FX_OUT/.lt/$b"; tr="$AI_DLC_FX_TRACE.$b"; wx="$tr/w/$b.log"
      AI_DLC_READSET_TRACE_ROOT="$tr" pool_run "$tp.drv" bash "$AI_DLC_FX_DV" --list "$b" --tracer sandbox --in-pool "$tp"; wx=""
      if [ -f "$pr.refused" ]; then :
      elif [ -f "$tp/rc" ] && [ ! -f "$tp/trip" ]; then
        cp "$tp/log" "$AI_DLC_FX_OUT/.log/$b"
        if [ "$(cat "$tp/rc")" = 0 ]; then printf ok > "$AI_DLC_FX_OUT/$b"; else printf FAIL > "$AI_DLC_FX_OUT/$b"; fi
      elif pool_run "$AI_DLC_FX_OUT/.log/$b" bash "$d/run.sh"; then printf ok   > "$AI_DLC_FX_OUT/$b"
      else                                                      printf FAIL > "$AI_DLC_FX_OUT/$b"; fi
    elif pool_run "$AI_DLC_FX_OUT/.log/$b" bash "$d/run.sh"; then printf ok   > "$AI_DLC_FX_OUT/$b"
    else                                                      printf FAIL > "$AI_DLC_FX_OUT/$b"; fi
    if [ -f "$pr.refused" ]; then
      printf REFUSED > "$AI_DLC_FX_OUT/$b"; : > "$AI_DLC_FX_OUT/.refused"
      printf "REFUSED %s: no progress for %s polls; its whole process tree was killed\n" "$b" "$(cat "$pr.refused")" >> "$AI_DLC_FX_OUT/.log/$b"
    fi
    if [ -n "$tp" ]; then
      [ "$(cat "$AI_DLC_FX_OUT/$b")" = ok ] || rm -f "$tp/rows" "$tp/discard"
      ( rm -rf "$tr" ) </dev/null >/dev/null 2>&1 &
    fi
    [ -f "$pr.refused" ] || printf "%s %s\n" "$b" "$SECONDS" > "$AI_DLC_FX_OUT/.dur/$b"
    printf "%s\n" "$b" >> "$AI_DLC_FX_OUT/.done"
    dn=0; while IFS= read -r dl; do [ -z "$dl" ] || dn=$((dn + 1)); done 2>/dev/null < "$AI_DLC_FX_OUT/.done"
    dv=""; read -r dv 2>/dev/null < "$AI_DLC_FX_OUT/$b"
    printf "   done %s/%s  %s %s\n" "$dn" "$AI_DLC_FX_TOTAL" "$dv" "$b"
    : > "$pr.k"
  ' _ {} < "$out/.order"
  } &
  pool_xp=$!
  set +m
  wait "$pool_xp"
  pool_xp=""
  ph="$ph pool $((SECONDS - ph_t))s"; ph_t="$SECONDS"
  readset_pool_trace_merge "$out"

  # A GREEN FIXTURE THAT CHECKED NOTHING SAYS SO (BL-998). A shipped fixture whose subject is absent prints a
  # `PENDING  <what>` row (two spaces after the word, at the start of the line or after indentation) and exits 0,
  # and a bare `ok` row read the same as a pass. One grep over every captured log counts those rows; an ok row
  # carrying any is printed with its count, and one line after the report names them all. The count covers the
  # fixtures THIS run dispatched, and `<out>/.pend` keeps it for the key record's `#pending` line; one skipped on a
  # recorded pass is named from that line by readset_pending_recorded.
  pend_map=" "; pend_fx=""; pend_n=0
  ( cd "$out/.log" 2>/dev/null && grep -HcE "$READSET_VS_PENDING" -- * 2>/dev/null ) > "$out/.pend"
  while IFS=: read -r pk pv; do
    case "$pv" in ''|*[!0-9]*|0) continue ;; esac
    pend_map="$pend_map$pk=$pv "
  done < "$out/.pend"
  # Rendered in list order, so the output is deterministic and diffable across runs even
  # though the work completed out of order.
  n_actual=0
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    b="$(basename "$d")"
    if [ ! -f "$out/$b" ]; then
      printf '   FAIL  %s  (no verdict recorded)\n' "$b"; rc=1; rf_hard=1; continue
    fi
    n_actual=$((n_actual + 1))
    verdict="$(cat "$out/$b")"
    if [ "$verdict" = ok ]; then
      case "$pend_map" in
        *" $b="*) pv="${pend_map#* $b=}"; pv="${pv%% *}"; pend_fx="$pend_fx $b"; pend_n=$((pend_n + 1))
                  printf '   ok    %s  (%s PENDING row(s): its subject is absent, so those parts checked nothing)\n' "$b" "$pv" ;;
        *) printf '   ok    %s\n' "$b" ;;
      esac
    elif [ "$verdict" = REFUSED ]; then printf '   REFUSED  %s  (no progress for %s polls; a refusal costs a re-run, never a verdict)\n' "$b" "$POOL_STALL"; rc=1
    else                        printf '   FAIL  %s\n' "$b"; rc=1; rf_hard=1; fi
  done < "$out/list"
  readset_pending_recorded "$out" "${SKIPS_LOG:-}"
  readset_pending_line "$pend_n" "$pend_fx" "$out/.precorded"

  # THE CONTROL PARALLELISM MAKES NECESSARY. Serially, a fixture that never ran could not
  # print an `ok` -- the loop and the report were the same thing. With a worker pool they
  # are not: a dropped job produces no verdict file, and a suite reporting 70 greens
  # instead of 75 reads exactly like a suite that passed. This is the check-that-cannot-
  # fire class one layer out, so the count is asserted rather than assumed.
  #
  # WHICH OF THE TWO ARMS DOES THE DETECTING, measured rather than asserted, because
  # this comment used to imply the count was an independent detector and it is not.
  # The report walks the LIST, so a missing verdict is caught by the `[ ! -f ]` branch
  # above; `n_actual` is incremented on exactly the path that branch skips, so the
  # count below can only fire when that branch already has. Its contribution is
  # MAGNITUDE -- one line saying how much of the suite is missing, instead of N lines
  # each saying one fixture is. `consumer-suite-pool`'s M2b mutant is the measurement:
  # remove the per-fixture branch and a lost worker is misreported as a failing
  # fixture while this count stays silent.
  if [ "$n_actual" -ne "$n_expected" ]; then
    printf '   FAIL  %s of %s fixtures produced a verdict -- the pool dropped work, and a short green suite reads exactly like a passing one\n' \
      "$n_actual" "$n_expected"
    rc=1; rf_hard=1
  fi

  # Publish this run's costs for the next run to dispatch on. One `cat` for the whole
  # suite rather than a read per unit: §7 gate item 2 is that a fork per item is the
  # shape that makes a runner system-bound, and this runner is the thing that finding
  # came out of. A run that recorded nothing leaves the previous record alone rather
  # than replacing it with an empty file, which would silently cost the NEXT run its
  # ordering as well.
  #
  # IT MERGES, AND A WHOLE-FILE REPLACE HERE COST THE ORDERING EVERY TIME THE SKIP FIRED.
  # "$out/.dur/" holds a file only for a unit that was DISPATCHED, and the read-set skip
  # above narrows the dispatch list in place before the pool is fed. So a replace deleted
  # the cost of every SKIPPED unit, and those units then re-entered the next run at the
  # 999999 unknown slot, which sorts FIRST -- putting the real poles LAST, the exact
  # inversion of what the longest-first block exists to buy. Measured on this repo's own
  # record: full 150-unit run 506s, the same run after one selective run had clobbered
  # the record 573s, and a fresh clone with no record at all 671s.
  #
  # THE CONCATENATION ORDER IS THE MERGE RULE. Old record first, this run's costs second,
  # `c[$1] = $2` is last-wins -- so a dispatched unit's fresh cost overwrites its stale one
  # and a skipped unit keeps the one it had. `NF == 2` is the same predicate the reader
  # above uses, so writer and reader cannot disagree about the grammar.
  #
  # `NR==FNR` WAS THE OBVIOUS SPELLING AND IT IS WRONG: awk given a record file that does
  # not exist fails outright, and that is the fresh-clone case the old code handled
  # correctly. The `[ -s ]` guard inside the brace group degrades to "just this run's
  # costs", which is byte-for-byte the previous behaviour there.
  #
  # A KEY WHOSE FIXTURE IS GONE IS PRUNED HERE, keyed on "${FXROOT}${name}/run.sh" -- the
  # same test the list loop above dispatches on, so a row survives exactly when its unit
  # could be dispatched again. A ghost key was once left in as harmless, and it was not:
  # this record is where the suite pole is read, and dead units were sitting at the top of it,
  # so the pole read off it named a unit that no longer exists. A SKIPPED unit keeps its
  # row, because the test is the directory on disk and not the narrowed dispatch list.
  # FXROOT and not a literal path: this block is I66-joined with the consumer hook, where
  # the fixtures live under tests/fixtures/, and a literal core/fixtures there prunes
  # every row the consumer has.
  # A RED POOL MERGES UNDER ITS OWN KEY, `<unit>@red <secs>`, and never touches a clean row. Every unit
  # that gave a verdict (ok or FAIL) has a `.dur/` file; a REFUSED unit and a unit with no verdict have
  # none, because the `.dur/` write follows the verdict write and skips a refusal. Its ok units were timed
  # under that run's load and its FAIL units may have stopped early, so a red figure never displaces a
  # clean one: the dispatch order reads `<unit>@red` only for a unit with no clean row, and the trace
  # ceiling and the pole line key on the bare unit name, which an `@red` row never matches. A clean
  # `<unit> <secs>` row is written only by a green run. The prune tests the unit with `@red` stripped, so a red row lives exactly as long as its
  # fixture directory. `.last` below is this run's own measurement, unsuffixed, whatever `rc` is.
  ph="$ph verdicts $((SECONDS - ph_t))s"; ph_t="$SECONDS"
  cat "$out"/.dur/* > "$out/.durations" 2>/dev/null
  dur_sfx=""; [ "$rc" -eq 0 ] || dur_sfx=@red
  # The merge reads the record and writes it back, so it runs under the record's lock: two pushes
  # merging at once would otherwise each drop the rows the other timed.
  if [ -s "$out/.durations" ]; then
    if rec_lock "$DURATIONS_RECORD.lock"; then
      { [ -s "$DURATIONS_RECORD" ] && cat "$DURATIONS_RECORD"; awk -v s="$dur_sfx" 'NF == 2 { print $1 s, $2 }' "$out/.durations"; } 2>/dev/null \
        | awk 'NF == 2 { c[$1] = $2 } END { for (k in c) print k, c[k] }' \
        | while read -r k v; do kb="${k%@red}"; [ -f "${FXROOT}${kb%@consumer}/run.sh" ] && printf '%s %s\n' "$k" "$v"; done \
        | sort > "$out/.merged"
      [ -s "$out/.merged" ] && rec_put "$out/.merged" "$DURATIONS_RECORD"
      rec_unlock "$DURATIONS_RECORD.lock"
    else
      printf '   ..    durations record: another push holds %s -- the costs timed by this run are not merged\n' "$DURATIONS_RECORD.lock"
    fi
  fi

  # PUBLISH THE VERIFIED STATE ONLY ON A FULLY GREEN RUN, and that condition is the whole
  # safety of the skip. The record means "every fixture's verdict is known good at these file
  # contents". Writing it after a red run would mark the failing state as verified, and the
  # next push -- changing something else entirely -- would skip the fixture that is still
  # broken and report green.
  # The format stamp is written only AFTER the record copy succeeds, so a failed copy cannot
  # leave a `v2` stamp vouching for a record this run did not write. A copy that lands with no
  # stamp after it is an unstamped record, which the next run reads as "run everything".
  if [ "$rc" -eq 0 ] && [ -s "$out/.now" ]; then
    rec_put "$out/.now" "$VERIFIED_RECORD" && printf 'v2\n' > "$out/.vfmt" 2>/dev/null && rec_put "$out/.vfmt" "$VERIFIED_FORMAT"
  fi
  # PER-FIXTURE KEY RECORDS ARE PUBLISHED ON A RED RUN TOO: each one is gated on its own verdict.
  readset_keys_write "$out"
  cl_write "$out"
  cl_confirm "$out"
  ph="$ph records $((SECONDS - ph_t))s"; ph_t="$SECONDS"

  # PUBLISH THIS RUN'S UNMERGED COSTS WHATEVER `rc` IS, and copy the PRE-MERGE file:
  # "$out/.durations" is exactly the units this pool timed, while "$out/.merged" one block up
  # has already been folded over the prior record and carries rows nothing here measured.
  # `.last` is this run's own measurement and is read only by the pole line, so it is true on a
  # red run too; gating it on `rc` made a red run print "no suite run, no pole". The merged
  # record above steers dispatch; a red run's rows there carry `@red`.
  # LASTRUN_OWN is the same figures held in this process: the shared file can be another push's by the
  # time a reader opens it, so this run's pole line reads the variable, never the file.
  if [ -s "$out/.durations" ]; then rec_put "$out/.durations" "$LASTRUN_RECORD"; LASTRUN_OWN="$(cat "$out/.durations")"; fi

  # THE DETACHED TRACE STARTS ONLY HERE, after every record above is written, and whatever the push's
  # rc: readset_live_trace selects each unmapped fixture by its OWN verdict (ok), so a fixture whose
  # normal run failed has no run to compare it to and is never traced, and a good fixture run is traced.
  readset_live_trace "$out"

  # PUBLISH THE RED UNITS' CAPTURED OUTPUT BEFORE THE TEMP DIR GOES. Placed here, beside the
  # durations publish, for the same reason that one is here: it is the last point at which
  # "$out" still exists. The trap installed beside its `mktemp` removes it on an interrupt and the
  # straight-line `rm -rf` below removes it otherwise, so anything not copied out on this line is gone.
  #
  # THE VERDICT FILE IS THE SELECTOR, NOT `rc`. Walking the list and re-reading each verdict
  # picks up BOTH failure shapes: a unit that ran and failed, and a unit that produced no
  # verdict at all because its worker died. The second is the one with no output to show, and
  # saying so in the record is the difference between "here is why it failed" and a silent
  # empty section that reads like a clean unit.
  : > "$out/.failures" 2>/dev/null
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    b="$(basename "$d")"
    [ -f "$out/$b" ] && [ "$(cat "$out/$b")" = ok ] && continue
    { printf '===== %s =====\n' "$b"
      if [ -s "$out/.log/$b" ]; then cat "$out/.log/$b"
      elif [ -f "$out/.log/$b" ]; then printf '(ran and printed nothing)\n'
      else printf '(no capture file: the worker died before it could run this unit)\n'; fi
      printf '\n'; } >> "$out/.failures" 2>/dev/null
  done < "$out/list"

  # THE DISPATCH ORDER IS PART OF THE EVIDENCE, and it is the half that dies with "$out".
  # For a failure that only reproduces under load, "what was this scheduled beside" is the
  # question a later reader cannot answer from anything else -- the durations record holds
  # costs, not co-scheduling, and it has already been overwritten by this run.
  if [ -s "$out/.failures" ]; then
    # BUILT IN A PRIVATE TEMP beside the record, copied to this run's retained name FROM THAT TEMP, and
    # only then renamed over the shared primary: a concurrent red push may replace the primary at any
    # moment, and a copy taken from it would file that push's failures under this run's stamp.
    fl_wrote=0; fl_tmp="$FAILLOG_RECORD.tmp.$$"
    { printf '===== fixture failures -- %s, pool width %s, %s of %s units red =====\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$FIXTURE_JOBS" \
        "$(grep -c '^===== ' "$out/.failures")" "$n_expected"
      cat "$out/.failures"
      printf '===== dispatch order this run (longest-first) =====\n'
      cat "$out/.order"; :; } > "$fl_tmp" 2>/dev/null && fl_wrote=1
    printf '   captured output for the failing unit(s): %s\n' "$FAILLOG_RECORD"
    # THIS RUN'S RETAINED COPY, chained on the PRIMARY write having opened its file. The `:` that
    # ends the brace group is load-bearing: without it the group's status is `cat .order`'s, not
    # the redirect's. A `cp` after a failed primary write would file the PREVIOUS run's record
    # under this run's stamp -- a misattribution, which is worse than a gap. Nothing in this block
    # touches `rc`, and nothing here may trip `set -u`: an abort here skips the `rm -rf` below.
    fl_stamp="$(date -u +%Y%m%dT%H%M%SZ 2>/dev/null)" || fl_stamp=""
    fl_copy="$GITDIR/ai-dlc-fixture-failures.$fl_stamp.$$"
    if [ "$fl_wrote" = 1 ] && [ -n "$fl_stamp" ] && cp "$fl_tmp" "$fl_copy" 2>/dev/null; then printf '   retained copy of this run: %s\n' "$fl_copy"; fi
    [ "$fl_wrote" = 1 ] && mv -f "$fl_tmp" "$FAILLOG_RECORD" 2>/dev/null
    rm -f "$fl_tmp" 2>/dev/null
    # PRUNE BY NAME, newest FAILLOG_KEEP survive. Reverse sort + `tail -n +K` rather than
    # `head -n -N`, which BSD head does not have. The glob anchors the FRONT on the generated
    # shape; `ai-dlc-fixture-failures.*` would also match `.clean`, the operator's own saved
    # record. The `case` anchors the END: without it `<stamp>.<pid>.keep` and
    # `<yyyymm>-bisect-Z.notes` both matched the glob and were deleted in an adversary's probe,
    # each also taking a slot from a real copy. Only an all-digit last field (the pid) is ours.
    for fl_f in "$GITDIR"/ai-dlc-fixture-failures.2[0-9][0-9][0-9][01][0-9]*Z.*; do
      case "${fl_f##*.}" in ''|*[!0-9]*) continue ;; esac
      [ -e "$fl_f" ] && printf '%s\n' "$fl_f"
    done | sort -r | tail -n +$((FAILLOG_KEEP + 1)) | while IFS= read -r fl_f; do
      [ -e "$fl_f" ] && rm -f "$fl_f" 2>/dev/null
    done
  fi

  # THE STILL-POLL FIGURES ARE PUBLISHED RED OR GREEN: they are the owed measurement behind POOL_STALL,
  # and a red run's longest still stretch is still evidence about the window. One line per unit run.
  [ -s "$out/.stall" ] && rec_put "$out/.stall" "$GITDIR/ai-dlc-pool-stall.last"
  # THE EXIT-2 CARRIER. "$out" dies on the next line, so the `.refused` flag is read here into a global the
  # hook's final exit reads. A refusal alone exits 2; a real FAIL, or a dropped worker, anywhere in the
  # pool exits 1, because a FAIL is a verdict and a refusal is the absence of one.
  POOL_REFUSED_ONLY=0
  if [ -f "$out/.refused" ] && [ "$rf_hard" = 0 ]; then POOL_REFUSED_ONLY=1; fi
  rm -rf "$out"; trap - EXIT INT TERM HUP
  if [ "$POOL_DEPTH_IN" -eq 0 ] && [ "${PREPUSH_CL_ENTRY:-}" = 1 ]; then printf '   ..    suite phases:%s after %ss\n' "$ph" "$((SECONDS - ph_t))"; fi
  return $rc
}
# FIXTURE_POOL_END

# THE SUITE DOES NOT RE-RUN OVER A TREE IT ALREADY RAN OVER.
#
# ~50s of the operator's inner loop was being spent re-deriving 84 identical
# verdicts on pushes that changed CHANGELOG.md, VERSION or docs/ and nothing else.
# `scripts/suite-content-key.sh` hashes a SUPERSET of everything the suite can
# read -- listings, contents, exec bits, symlink targets, the tracked-path set,
# the fixture set, the `+`-declared files, the history range of every git.decl
# `range` line (the `### ranges` component) and the external tools -- and a hit
# means the suite already ran over byte-identical inputs and history ranges. Read that script's header for the exclusion set and
# the mutation measurement behind it; I55 keeps the exclusions honest.
#
# THIS IS THE CHECK-THAT-CANNOT-FIRE SHAPE AND IT IS TREATED AS ONE. Four
# consequences, all deliberate:
#
#   1. A hit ANNOUNCES ITSELF, names its key, and prints what the key covers. A
#      cached green that looked like an ordinary green would be the defect.
#   2. The final summary line says the suite was skipped, so no run reports "all
#      gates green" while hiding that its largest gate did not execute.
#   3. Every failure path -- key script errors, empty key, unreadable record,
#      malformed record, a changed fixture count -- runs the suite. The skip is
#      the exceptional branch and it needs everything to line up; the full run is
#      what happens by default.
#   4. AI_DLC_FIXTURE_NO_SKIP=1 forces the run, on the record, for an operator who
#      wants the suite regardless.
#
# The record lives in the shared verdict store base (RECORD_HOME), NOT in the working
# tree, and that is load-bearing: a record inside the tree would be hashed by the key it
# stores, so writing it would invalidate it and no push could ever hit.
# SUITE_STEP_BEGIN
rec_home KEY_RECORD suite-key

# THE HIT RATE IS THE ONE NUMBER THIS CHANGE COULD NOT MEASURE BEFORE SHIPPING.
# main is squash-merged, so its history records releases and not the pushes inside
# them, which is exactly where the repeat runs happen. The release-granularity
# proxy is 2 of the last 60 commits; the inner-loop rate is higher and unknown.
# So the instrument ships with the change: one line per decision, countable with
#   awk '{print $2}' .git/ai-dlc-suite-key.log | sort | uniq -c
KEY_LOG="$GITDIR/ai-dlc-suite-key.log"
key_log() { # the stamp it forks is the push's stamp for the skip record
  local kl_t; kl_t="$(date -u +%Y-%m-%dT%H:%M:%SZ)"; [ -n "${SKIPS_STAMP:-}" ] || SKIPS_STAMP="$kl_t"
  printf '%s %s %s\n' "$kl_t" "$1" "${2:-none}" >> "$KEY_LOG" 2>/dev/null || true
}

fixture_suite_step() {
  local key cached_key cached_n cached_when n_now record sp="" sp_t="$SECONDS" cl_kd="" kf

  # A RED STEP ABOVE DOES NOT STOP THE SUITE. Every pass the pool makes is recorded for reuse by
  # content key; the push stays BLOCKED because step() keeps $fail. The red steps are named first.
  if [ -n "${RED_STEPS:-}" ]; then
    printf '   a step above is red; this push is BLOCKED, and the suite still runs so every pass it makes is recorded:%s\n' "$RED_STEPS"
  fi

  # Counted the way run_fixtures counts, so the number in the announce is the
  # number the last green run actually reported. `ls -d core/fixtures/*/` would be
  # three higher -- it includes the data-only directories that carry no run.sh --
  # and an announce saying "87 of 87" beside a suite that prints 84 verdicts is a
  # discrepancy an operator has to go and resolve before they can trust the skip.
  n_now="$(for d in core/fixtures/*/; do [ -f "$d/run.sh" ] && printf 'x\n'; done | wc -l | tr -d ' ')"
  rec_import "$GITDIR/ai-dlc-suite-key" "$KEY_RECORD"

  if [ -n "${AI_DLC_FIXTURE_NO_SKIP:-}" ]; then
    printf '   (content-key skip disabled by AI_DLC_FIXTURE_NO_SKIP)\n'
    key="$(bash scripts/suite-content-key.sh 2>/dev/null)" || key=""
    key_log FORCED "$key"
  elif ! key="$(bash scripts/suite-content-key.sh 2>/dev/null)" || [ -z "$key" ]; then
    printf '   (content key unavailable -- running the suite)\n'
    key=""
    key_log UNAVAILABLE
  elif [ ! -r "$KEY_RECORD" ]; then
    printf '   (no prior green run recorded for this repository -- running the suite)\n'
    key_log MISS "$key"
  else
    record="$(cat "$KEY_RECORD" 2>/dev/null)"
    cached_key="$(printf '%s\n' "$record" | awk 'NR==1{print $1}')"
    cached_n="$(printf '%s\n'   "$record" | awk 'NR==1{print $2}')"
    cached_when="$(printf '%s\n' "$record" | awk 'NR==1{print $3}')"
    if [ "$cached_key" = "$key" ] && [ -n "$cached_n" ] && [ "$cached_n" = "$n_now" ]; then
      printf '   SKIPPED -- this exact tree already passed the whole suite.\n'
      printf '     key          %s\n' "$key"
      printf '     last green   %s of %s fixtures at %s\n' "$cached_n" "$n_now" "${cached_when:-unknown}"
      bash scripts/suite-content-key.sh --summary 2>/dev/null | sed 's/^/     /'
      printf '     force a run with AI_DLC_FIXTURE_NO_SKIP=1\n'
      # Every fixture is skipped on the recorded pass: the PENDING counts come from the record's line 2 alone.
      printf '%s\n' "$record" | awk 'NR == 2 && $1 == "#pending" { for (i = 2; i <= NF; i++) { j = index($i, "="); if (j > 1) print substr($i, 1, j - 1) "\t" substr($i, j + 1) } }' \
        | readset_pending_line 0 "" -
      readset_trace_report ""
      SUITE_SKIPPED=1
      SUITE_SKIP_CAUSE=content-key
      key_log HIT "$key"
      SKIPS_KEY="$key"; skips_header "${SKIPS_LOG:-}" suite-key '*' '*' suite-key
      return 0
    fi
    if [ -n "$cached_n" ] && [ "$cached_n" != "$n_now" ]; then
      printf '   (fixture count moved %s -> %s -- running the suite)\n' "$cached_n" "$n_now"
    else
      printf '   (content key changed -- running the suite)\n'
    fi
    key_log MISS "$key"
  fi
  sp=" content-key $((SECONDS - sp_t))s"; sp_t="$SECONDS"
  SKIPS_KEY="${key:--}"

  # THE CONSUMER-LAYOUT TREE (BL-1027): scripts/install.sh into a fresh scratch tree, so run_fixtures runs every
  # selected SHIPPING fixture there too, as `<fx>@consumer` (cl_select, inside FIXTURE_POOL). Built at depth 0
  # only, here and nowhere else: after the content-key HIT return above, and after the
  # top-level GIT_DIR scrub, which runs before this step is called. It FAILS CLOSED: a failed mktemp, git init,
  # install, commit, or a tree carrying no shipping fixture fails the step and names it, never a skip. The tree
  # is the consumer world, with `_bmad/` (install.sh refuses a target without it) and one commit. The switch is
  # a plain shell variable, never exported, and run_fixtures unsets it on entry. The tree is removed by the
  # %q-baked trap pattern: this step's own trap while it is built, run_fixtures' EXIT trap during the pool, and
  # the same baked command after run_fixtures returns.
  # KEYED ON THE REAL ENTRY, NOT ON DEPTH ALONE: PREPUSH_CL_ENTRY is set by this hook's main body on the line
  # before the step runs, outside SUITE_STEP, so a fixture that extracts and sources SUITE_STEP never builds the
  # tree, and its verdict cannot depend on the PREPUSH_POOL_DEPTH it was invoked under.
  local cl_top="" cl_q="" cl_r="" cl_s cl_rc=0 cl_why=""
  if [ "$POOL_DEPTH_IN" -eq 0 ] && [ "${PREPUSH_CL_ENTRY:-}" = 1 ]; then
    if [ -n "${TMPDIR:-}" ] && [ -d "$TMPDIR" ] && [ -w "$TMPDIR" ]; then
      cl_r="$(cd "$TMPDIR" 2>/dev/null && pwd -P)" || cl_r=""
      cl_s="${cl_r//[!\/]/}"
      if [ -z "$cl_r" ] || [ "$(( ${#cl_r} + 2 * ${#cl_s} ))" -gt 35 ]; then cl_r=""; fi
    fi
    cl_top="$(mktemp -d "${cl_r:-/tmp}/cl.XXXXXX" 2>/dev/null)" || cl_top=""
    if [ -z "$cl_top" ] || [ ! -d "$cl_top" ]; then
      printf '   FAIL  consumer-layout tree: mktemp -d under %s failed, so no shipping fixture can run in the consumer layout\n' "${cl_r:-/tmp}"; skips_header "${SKIPS_LOG:-}" cl-tree-mktemp
      return 1
    fi
    printf -v cl_q '%q' "$cl_top"
    trap "rm -rf -- $cl_q" EXIT; trap "rm -rf -- $cl_q; exit 130" INT; trap "rm -rf -- $cl_q; exit 143" TERM; trap "rm -rf -- $cl_q; exit 129" HUP
    # cl_tree_init (FIXTURE_POOL) makes the fixed root commit, the one consumer project id the verdict store keys on.
    if ! { mkdir "$cl_top/_bmad" && cl_tree_init "$cl_top"; } > /dev/null 2>&1; then cl_why="git init"
    elif ! ( unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY; bash scripts/install.sh "$cl_top" ) > "$cl_top/.git/ai-dlc-install.log" 2>&1; then cl_why="scripts/install.sh $cl_top"
    elif ! ( unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY; git -C "$cl_top" add -A && GIT_AUTHOR_NAME=ai-dlc GIT_AUTHOR_EMAIL=ai-dlc@invalid GIT_COMMITTER_NAME=ai-dlc \
        GIT_COMMITTER_EMAIL=ai-dlc@invalid GIT_AUTHOR_DATE=2000-01-01T00:00:00Z GIT_COMMITTER_DATE=2000-01-01T00:00:00Z \
        git -C "$cl_top" -c commit.gpgsign=false commit -q --no-verify -m 'consumer-layout tree' ) > /dev/null 2>&1; then cl_why="the tree's commit"
    else
      cl_s=0
      for cl_r in "$cl_top"/tests/fixtures/*/; do [ -f "$cl_r/run.sh" ] && cl_s=$((cl_s + 1)); done
      [ "$cl_s" -gt 0 ] || cl_why="the shipping-fixture count (the installed tree carries no tests/fixtures/*/run.sh)"
    fi
    if [ -n "$cl_why" ]; then
      printf '   FAIL  consumer-layout tree: %s failed, so no shipping fixture can run in the consumer layout\n' "$cl_why"
      [ -s "$cl_top/.git/ai-dlc-install.log" ] && tail -n 5 "$cl_top/.git/ai-dlc-install.log" | sed 's/^/     /'
      eval "rm -rf -- $cl_q"; trap - EXIT INT TERM HUP; skips_header "${SKIPS_LOG:-}" cl-tree-build
      return 1
    fi
    printf '   consumer layout: scripts/install.sh built %s (%s shipping fixture(s)); a selected one runs there as <fx>@consumer\n' "$cl_top" "$cl_s"
    AI_DLC_FX_CL_TREE="$cl_top"
  fi

  # THE PRIOR COSTS, SNAPSHOT BEFORE THE POOL. run_fixtures folds this run's costs into
  # DURATIONS_RECORD inside the I66 block, so after it returns the record already holds this run's
  # figure for every unit it timed and cannot say what the pole cost LAST time. pole_info_step reads
  # this snapshot for that. Sited here, outside the I66 block, because a consumer hook prints no pole.
  # Held in this process, never in a shared file a concurrent push could replace before the pole line.
  POLE_PREV="$(cat "$DURATIONS_RECORD" 2>/dev/null)" || POLE_PREV=""
  sp="$sp consumer-layout $((SECONDS - sp_t))s"; sp_t="$SECONDS"
  run_fixtures || cl_rc=1
  if [ -n "$cl_top" ]; then eval "rm -rf -- $cl_q"; trap - EXIT INT TERM HUP; fi
  sp="$sp run_fixtures $((SECONDS - sp_t))s"; sp_t="$SECONDS"
  [ "$cl_rc" -eq 0 ] || { [ "$POOL_DEPTH_IN" -ne 0 ] || [ "${PREPUSH_CL_ENTRY:-}" != 1 ] || printf '   ..    suite step:%s\n' "$sp"; return 1; }
  # THE OTHER SKIP ARM: run_fixtures returned 0 having run nothing because the read-set skip found no
  # fixture whose inputs changed (it sets READSET_NO_CHANGE and SUITE_SKIPPED inside the I66 block, which
  # may not be edited here). The cause is recorded at this site, beside the content-key setter above.
  if [ "${READSET_NO_CHANGE:-0}" = 1 ] && [ "${SUITE_SKIPPED:-0}" = 1 ]; then SUITE_SKIP_CAUSE=read-set; fi

  # Recorded only after a full green run. A partial or red suite leaves the prior
  # record in place rather than blessing the tree that just failed.
  #
  # AND ONLY IF THE SUITE LEFT THE TREE AS IT FOUND IT. A fixture is supposed to do
  # all of its work in a sandbox; one that writes into the repository under test is
  # a writer racing the fifteen readers beside it, and v0.208.0 shipped a fix for
  # exactly that -- `taught-schema` was dropping a probe into core/team-roles/ and
  # transiently stripping the real provenance schema, which killed
  # `enforcement-map-sites`' seed on whichever assertion happened to be copying.
  #
  # This catches the half of that class that SURVIVES the run: a fixture that
  # changes the tree and does not put it back. Recording the pre-run key then would
  # bless a tree that no longer exists. It does NOT catch a transient write that is
  # cleaned up -- that needs filesystem watching, and no cheap sound mechanism for
  # it exists; a grep over the fixtures cannot tell a sandbox $ROOT from the real
  # one (measured: the false-positive set is most of the seed corpus).
  if [ -n "$key" ] && [ "${n_now:-0}" -gt 0 ]; then
    local key_after
    key_after="$(bash scripts/suite-content-key.sh 2>/dev/null)" || key_after=""
    if [ -z "$key_after" ]; then
      printf '   (content key unavailable after the run -- not recording)\n'
    elif [ "$key_after" != "$key" ]; then
      printf '   NOT RECORDING: the suite CHANGED the tree it just tested.\n'
      printf '     before %s\n     after  %s\n' "$key" "$key_after"
      printf '     A fixture wrote into the repository instead of its own sandbox. The verdicts\n'
      printf '     above were taken against a tree that no longer exists, and recording this key\n'
      printf '     would let a later push skip on evidence from a different tree. Find the writer;\n'
      printf '     `git status` names it. The suite still PASSED -- this only refuses the cache.\n'
    else
      # LINE 2 SNAPSHOTS THE PENDING COUNTS a HIT reprints: `#pending` then `<fx>=<n>` for every fixture whose key
      # record carries n > 0, and `<fx>=-` for one with no `#pending` line (count unrecorded). One awk over the records. Written to a temp file and renamed (BL-1046).
      # A HIT SKIPS THE `<fx>@consumer` UNITS TOO (BL-1116): when this run built the consumer layout, the records in
      # its keys dir (rec_home consumer-placement-keys, the dir cl_select names) are read by the same awk as
      # `<fx>@consumer=<n>`, so readset_pending_line names them in their own clause; one whose fixture now carries
      # `.dist-only` is not a unit of this tree and is dropped. Only existing files are passed.
      set -- "$KEYS_DIR"/*.key
      [ -z "$cl_top" ] || rec_home cl_kd consumer-placement-keys
      if [ -n "$cl_kd" ] && [ -d "$cl_kd" ]; then for kf in "$cl_kd"/*.key; do [ ! -f "$kf" ] || set -- "$@" "$kf"; done; fi
      { { [ -d "${KEY_RECORD%/*}" ] || mkdir -p "${KEY_RECORD%/*}"; } && { printf '%s %s %s\n' "$key" "$n_now" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
          awk -v fr="$FXROOT" -v ckd="${cl_kd:+$cl_kd/}" '
            function flush() { if (f != "" && x && n != "0") s = s " " f "=" n }
            FNR == 1 { flush(); f = FILENAME; c = (ckd != "" && index(f, ckd) == 1); sub(/.*\//, "", f); sub(/\.key$/, "", f); n = "-"; r = fr f "/run.sh"; x = ((getline l < r) >= 0); if (x) close(r)
              if (c) { f = f "@consumer"; r = fr substr(f, 1, length(f) - 9) "/.dist-only"; if ((getline l < r) >= 0) { close(r); x = 0 } } }
            FNR <= 4 && /^#pending (0|[1-9][0-9]*)$/ { n = substr($0, 10) }
            END { flush(); print "#pending" s }' "$@" 2>/dev/null || :; } > "$KEY_RECORD.tmp.$$" \
          && mv -f "$KEY_RECORD.tmp.$$" "$KEY_RECORD"; } 2>/dev/null || rm -f "$KEY_RECORD.tmp.$$" 2>/dev/null || true
    fi
    sp="$sp content-key-after $((SECONDS - sp_t))s"
  fi
  [ "$POOL_DEPTH_IN" -ne 0 ] || [ "${PREPUSH_CL_ENTRY:-}" != 1 ] || printf '   ..    suite step:%s\n' "$sp"
  return 0
}
# SUITE_STEP_END

# A push issued from a LINKED WORKTREE has git export GIT_DIR (pointed at that
# worktree's private `.git/worktrees/<name>` dir) into this hook's process
# environment; a push from the primary checkout does not. A `git` invocation
# above this line still honors an exported GIT_DIR/GIT_WORK_TREE/GIT_INDEX_FILE
# -- that's git's own behavior, not something this hook's shell code opts into
# -- and every one of those invocations wants exactly that: to operate on the
# worktree actually being pushed. What breaks is different: run_fixtures below
# (dispatched via fixture_suite_step, this file's only fixture dispatch site)
# builds its own isolated sandbox (`mktemp -d`, `cd`, `git -C`, a fresh `git init`) on the
# assumption that git's own upward repository-discovery will find that sandbox --
# discovery git only consults when GIT_DIR is unset. Leaked and inherited
# unscrubbed, a fixture's `git init`/`git commit` sequence is silently redirected
# onto THIS repository instead of its own sandbox -- a reference consumer hit
# exactly this corruption twice before the scrub was added there. Scrub once
# here, in the parent shell, immediately before the dispatch.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY

# 2e. A shipped script with a syntax error is a gate that cannot run at all.
#    validate-enforcement-map.sh maps this glob set through map_consumer() and
#    asserts it equals the set in core/git-hooks/pre-push. Add a class here and the
#    consumer hook fails until it carries the class too.
#    SITED ABOVE THE FIXTURE POOL, not after it: it costs a second, and a syntax red found only
#    after the whole pool is a red the pool's minutes could not have changed. A red here is
#    named before the suite, which still runs and records its passes.
# SYNTAX_GLOB_BEGIN
syntax_all() {
  local rc=0 f
  for f in scripts/*.sh core/scripts/*.sh core/hooks/*.sh \
           core/skills/ai-dlc-update/reconcile/*.sh .githooks/*; do
    [ -f "$f" ] || continue
    bash -n "$f" 2>/dev/null || { printf '   syntax error: %s\n' "$f"; rc=1; }
  done
  return $rc
}
# SYNTAX_GLOB_END
step "shell syntax (every shipped script and hook)" syntax_all
step "verdict-store identity (a code change in the READSET_* spans needs a VS-IDENTITY pin)" bash scripts/validate-verdict-identity.sh
# 2g. BL-879'S STATIC HALF: the cells.decl grammar (C2, C4), the source guard on a `cli` subject (C5), every fixture
#     the static join refuses being an allowlist row, and scripts/fixture-inprocess-allowlist.txt down-only (M4).
#     Queued with PS_ALWAYS=1, so an AI_DLC_PRESUITE_SKIP=1 push still runs it, and before the suite, so a red here is
#     named before the pool runs. It judges GRAMMAR ONLY: C1-C3 and the stale allowlist row are the invocation judge's, per counted
#     run, and step 3b below names every fixture that had none. Distribution hook only, outside FIXTURE_POOL.
PS_ALWAYS=1
step "fixture in-process cells, static half (scripts/validate-fixture-inprocess.sh; grammar only)" \
  bash scripts/validate-fixture-inprocess.sh

# 2g. THE WHOLE-ROW RATCHET (BL-1052). No new inputs.decl line declares a whole shared program or a whole directory:
#     docs/inputs-decl-whole-rows.tsv lists the ones that exist and may only shrink against origin/main. Distribution
#     hook only, outside FIXTURE_POOL. The push-time half is readset_invalidation_guard inside the pool.
#     A tree without the script (a fixture world running this hook) is a named SKIP, not a red.
inputs_decl_ratchet() {
  [ -f scripts/invalidation-guard.sh ] || { printf '   SKIP  scripts/invalidation-guard.sh absent: not the distribution tree\n'; return 0; }
  bash scripts/invalidation-guard.sh --ratchet
}
step "inputs.decl whole-row ratchet (scripts/invalidation-guard.sh --ratchet)" inputs_decl_ratchet
PS_ALWAYS=0

# THE SKIP-SET RECORD'S SWITCH (BL-878): armed for a real push at depth 0 only (a hand run, the self-check prefix and
# predict-push-set.sh carry no stdin lines, a nested hook has depth >= 1), once the log is writable by a builtin test.
SKIPS_LOG=""; SKIPS_STAMP=""; SKIPS_PRE=""; SKIPS_SHAS=""; SKIPS_TREE=""; SKIPS_KEY="-"
if [ -n "$PUSH_LINES" ] && [ "$POOL_DEPTH_IN" -eq 0 ]; then
