#!/usr/bin/env bash
# pre-push — the distribution's own gate. Runs its validators against itself.
#
# THE DEFECT THIS REPLACES. ai-dlc shipped fifteen validators and a CI template *to
# its consumers* while gating none of its own. Every check ran only when a human
# remembered to type it, which is how three releases shipped half-wired: the enforcer
# was named, never invoked. `git log --all -- .github` was empty for the project's
# entire history.
#
# WHY NOT GITHUB ACTIONS. Operator policy: no CI in GitHub, for this repo or the
# reference consumer (which removed its own Actions scaffolding deliberately). A gate
# that lives in a service we do not run is a gate we do not control. This runs on the
# machine doing the pushing, needs no network, no runner, and no third party.
#
# The evidence that local is sufficient: v0.52.0's own packaging bug -- a fixture added
# to install.sh's hardcoded loop but not uninstall.sh's -- was caught by
# `validate-enforcement-map.sh` on a local run, BEFORE the push. The Actions run only
# ever saw the fixed tree and caught nothing.
#
# ENABLE (once per clone):
#     git config core.hooksPath .githooks
#
# Bypass for a genuine emergency is `git push --no-verify`, and it is a decision you
# are making on the record, not a default you fall into.

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

fail=0
step() {
  printf '\n── %s\n' "$1"; shift
  if "$@"; then printf '   PASS\n'; else printf '   FAIL\n'; fail=1; fi
}

# 1. The enforcement map is the index of which rule is enforced by what, and WHERE it
#    is invoked. I9/W1: a script enforcer with no declared call site is a rule guarded
#    by nobody. It also asserts install.sh and uninstall.sh agree on the fixture list.
step "taught schema == read schema (provenance examples derive from schemas/)" \
  bash core/scripts/sync-taught-schema.sh --check

step "enforcement-map integrity (I1-I11)" \
  bash scripts/validate-enforcement-map.sh

# 1a-i. docs/invariant-index.md is DERIVED from the arm headers in the validator above, and
#       byte-compared here. It replaced a hand-typed enumeration in that script's own `OK:`
#       line which had gone stale by 22 invariants -- it named 71 while 93 arms could fire,
#       and CLAUDE.md pointed readers at it as the live list. The renderer also asserts, on
#       every run, that no emitter sits outside a declared arm, that no declared arm is
#       unable to emit, and that no ID is claimed twice. Runs in ~0.06s and never touches
#       the validator's body, so it costs the pole nothing.
step "invariant index derived from the map's arm headers" \
  bash scripts/render-invariant-index.sh --check

# 1a-ii. docs/vocabulary-index.md is DERIVED from the `# vocabulary:` markers those same arm
#        headers carry, plus every enum in core/schemas/*.json, and byte-compared here. Six
#        invariants in this tree exist only because a closed vocabulary correctly owned by one
#        file kept being restated from memory somewhere else; until this ran there was no place
#        a reader could see the sets at all, so the restating continued and the invariant caught
#        it afterwards. It also fails the push on an arm header that READS as a vocabulary join
#        while carrying no marker, which is what keeps the index's population from going stale
#        as arms are added. Runs in ~0.4s. It must sit AFTER the invariant index, whose output
#        it consumes to resolve every marker's `vocabulary-invariant:` citation.
step "vocabulary index derived from the markers and the schemas" \
  bash scripts/render-vocabulary-index.sh --check

# 1a. The same corpus-wide party-mode floor the consumer hook runs, over the DISTRIBUTION's own
#     tree. It is here for a reason beyond symmetry: this tree holds the two files the check has
#     to get right — the one rendered taught example (exempt only because the generated-region
#     carve-out works) and the fixture that embeds five forged blocks on purpose (exempt only
#     because a fixture directory is a declared home). A change that breaks either exemption goes
#     red here, on the machine that made it, instead of on a consumer's next push.
step "stray party-mode provenance (distribution tree)" \
  bash core/scripts/validate-provenance-block.sh --strays

# 1b. A core/ pointer at a dev-repo docs/ spec that install never ships is dead in every
#     consumer tree — resolves for a maintainer, 404s for a consumer. Derived, no hand-list.
step "no dead doc refs (core/ cites no unshipped dev-repo doc)" \
  bash scripts/validate-no-dead-doc-refs.sh

# 1c. Three things name a release -- the commit subject, VERSION, and the CHANGELOG's
#     top heading -- and until v0.125.0 nothing joined them. v0.124.1 was committed
#     with a subject one patch ahead of both. Push is the right seam: it is the last
#     point before the version becomes a claim other people read.
step "release version triple (subject == VERSION == CHANGELOG heading)" \
  bash scripts/validate-release-version.sh

# 1d. A plan in docs/plans/ is a handoff to a session that has never seen this one. Push
#     is the seam: it is the last point before the file becomes the thing someone else is
#     told to READ and FOLLOW. Measured on the first plan promoted here — two status
#     records with the older one a release stale, and two merged releases still written
#     in the imperative. Followed literally, that redoes shipped work.
step "plan shape (docs/plans/ is resumable by a session that never saw this one)" \
  bash scripts/validate-plan-shape.sh

# 1e. Narrow authoring rules live in `.claude/rules/*.md` and load only when Claude READS
#     a matching file -- measured on CC 2.1.226: Read and Edit fire the trigger, Write,
#     Grep, Glob and Bash do not. Three of the four failure modes that creates are silent:
#     a glob matching nothing is a rule that never loads, `globs:`-instead-of-`paths:`
#     frontmatter is a rule that is silently resident in EVERY session, and a rule with
#     neither a CLAUDE.md pointer nor a reasoned no-stub marker is invisible in both
#     channels. The fourth bounds the .gitignore narrowing that lets rule files be
#     committed at all. Push is the seam: it is the last point before the split rulebook
#     becomes what the next session reads.
step "claude-rules joins (tracked paths, live globs, paths-only frontmatter, pointers)" \
  bash scripts/validate-claude-rules.sh

# 1f. The bash-3.2 / BSD-userland floor for every shipped shell file. GNU-only idioms do not
#     error here, they return the WRONG ANSWER quietly -- `sed -i` takes the script as a
#     backup suffix, `\s` matches a literal `s`, `mapfile` reads nothing. Every arm reports
#     zero over the corpus today and is a pure regression guard, so its fixture is the only
#     evidence any of them works. Standalone and ~0.5s: deliberately NOT an arm inside
#     validate-enforcement-map.sh, which the suite pole invokes at roughly 30s of gate per
#     second of script.
step "shell portability (bash 3.2 + BSD userland floor)" \
  bash scripts/validate-shell-portability.sh

# 2. SKILL.md's first ~5000 tokens are whole-re-read on EVERY compaction. The resident
#    region sits within a few hundred tokens of the ceiling, so an edit above the fold
#    can silently push the post-compact recovery protocol below it.
step "re-attach budget (SKILL.md resident region)" \
  bash core/scripts/validate-reattach-budget.sh --skill core/skills/ai-dlc/SKILL.md

# 2b. Rule 18 and rule-authoring.md govern rule prose, but the audit that enforces them
#     was driven only from a consumer's retro. Narrative authored here reached every
#     consumer before anything could see it. Only the deterministic tier gates the push;
#     the judgement tier prints and is dispositioned at retro.
step "rule-file audit (origin tags, dates, dangling pointers)" \
  bash core/scripts/audit-rule-files.sh --fail-on=deterministic

# 3. Every fixture is an adversarial self-test for one gate check. A fixture that is
#    never driven is a green light nobody earned.
#
# RUN IN PARALLEL, AND THE REASON IS MEASURED. The suite is latency-bound, not
# compute-bound: most of its work is waiting on `git init`/commit/mktemp in per-fixture
# sandboxes. Serially it was 7m06s of wall clock on an idle 18-core machine; 8 workers took
# it to 2m34s.
#
# SIXTEEN, AND THE KNEE MOVED BECAUSE THE FLOOR DID. For four releases this said EIGHT, NOT
# MORE, on a measurement that was true when it was taken: -P16 gave 2m30s against -P8's
# 2m34s, four seconds, because ONE fixture set a floor no pool size beats. That was the
# right reading of a floor-bound suite and the wrong constant to keep once the floor moved.
# `enforcement-map-sites` was 194s in v0.204.0, 107s after v0.205.0, and 25s once it started
# running its own assertions through a pool. Re-measured on the same idle 18-core machine
# with that fixture parallel, over the full 83:
#
#     -P8  95.5s     -P12  80.4s     -P16  72.0s     -P24  64.2s      (83/83 verdicts each)
#
# It is still falling at 24 because the remaining pole sleeps rather than computes, so this
# is not the CPU knee. Sixteen is where the measurement stops buying more than it costs:
# -P24 nearly doubled some units' individual durations through contention (a 25s fixture
# took 47.6s), and this suite has a known intermittent-red class that correlates with
# concurrency and cold caches. Beyond 16 the run gets faster by making every unit slower,
# which is how a timing-sensitive assertion starts failing for reasons that have nothing to
# do with what it tests.
#
# The remaining pole is `wait-stale-deliverable` at ~52s: at -P24 it starts at t=10.8s and
# is still running when everything else has finished. It is sleep-bound rather than
# fork-bound, so no pool size touches it -- the fix is inside that fixture.
#
# THE NUMBER IS MEASURED ON ONE MACHINE. That is why it stays the tunable
# AI_DLC_FIXTURE_JOBS: on a smaller box, re-measure rather than inherit this.
#
# THE BLOCK BELOW IS JOINED TO core/git-hooks/pre-push BY I66, and the join is on
# EXECUTABLE LINES ONLY. For this project's whole history the distribution ran its
# suite through a pool with a completeness assertion and an empty-suite guard while
# shipping consumers a serial loop that returned 0 when it ran nothing -- 313 lines
# here against 208 there, and nothing compared them. Prose stays deliberately
# different (this one addresses a maintainer, that one a consumer, and the pool size
# is re-derived per box); the code must not. Comments are stripped before the
# comparison because a comparison a comment can satisfy is I64's defect: the token
# is present and the mechanism is absent.
# FIXTURE_POOL_BEGIN
FIXTURE_JOBS="${AI_DLC_FIXTURE_JOBS:-16}"
DURATIONS_RECORD=".git/ai-dlc-fixture-durations"
READSET_MAP=".ai-dlc-fixture-readsets.tsv"
# THE VERIFIED-STATE RECORD LIVES UNDER .git FOR I55 ARM 4'S REASON EXACTLY: the content key
# hashes the working tree, so a cross-run record inside it would change the key that decides
# whether this suite runs at all.
VERIFIED_RECORD=".git/ai-dlc-fixture-verified"

# Reduce "$1" (the dispatch list) to the fixtures a change can actually affect, using the
# trace-derived read-sets in $READSET_MAP. Announces what it skipped and why; leaves the list
# untouched whenever it cannot justify a reduction.
#
# WHY THIS EXISTS BESIDE THE CONTENT KEY. `scripts/suite-content-key.sh` already skips the
# WHOLE suite when nothing moved, and it is NOT touched here -- it stays the safe outer gate.
# What it cannot do is skip PART of the suite, so one changed file costs the full makespan.
# This is the finer skip inside that outer one, and when it is in any doubt the fallback is
# the full run.
#
# EVERY BRANCH THAT CANNOT JUSTIFY A SKIP RUNS EVERYTHING. Under-recording one path does not
# make the suite slow, it makes it SILENTLY SHORT: a fixture that never ran reports nothing
# and the summary still says green. So absence of evidence is spelled "run it" at every step
# -- no map, no state, an unreadable either, a changed path no fixture is known to read, or a
# fixture with no entry of its own.
# Hash every path whose change could matter, into "$1/.now" as `path<TAB>sha`.
#
# THE SUBJECT IS TRACKED FILES *PLUS* EVERY PATH THE MAP NAMES. Tracked files are in it so a
# change to something NO fixture is known to read is still SEEN -- otherwise a validator that
# started reading a new file would drift out of the map with nothing able to notice. Measured
# on this tree: 1% of changed files across 40 commits fell outside every read-set, and that
#1% is exactly the population this arm exists for.
#
# `.git/**` IS DELIBERATELY OUT OF SCOPE, and it is a measurement rather than a convenience.
# Fixtures read git internals constantly -- 33 of 118 name some `.git` path, because validators
# they invoke resolve a root or ask `git status`. But `.git/HEAD`, `.git/index` and the refs
# move on EVERY commit, so honouring them would select those fixtures on every push and take
# the suite-wide win from 42% down to 12%, with two of the heaviest units running every time.
# Measured before excluding them: five fixtures read git HISTORY pointers (refs/HEAD/logs), and
# running all five across an empty commit -- HEAD moved, tree byte-identical -- changed NOT ONE
# verdict, with controls proving HEAD really moved and that the comparison could detect a
# difference. Their git reads are incidental to their verdicts. Excluded here rather than in the
# map so the map stays a faithful record of what was actually read.
# THE CONTENT KEY'S EXCLUSION SET, RESOLVED RATHER THAN RESTATED.
#
# `scripts/suite-content-key.sh` declares which paths cannot change a fixture verdict, and it
# earns each line with a two-tree mutation measurement. The OUTER skip honours that set; this
# INNER one did not, and the asymmetry cost a full suite on almost every push here. A changed
# path in no fixture read-set forces all N, and a NEW file is in no read-set by construction --
# the map is a generated snapshot, so it cannot name a file that did not exist when it was
# derived. `docs/plans/` is edited in nearly every session on this repo, so the arm that exists
# for a genuinely unknown dependency was firing on a directory the key already declares
# irrelevant. Measured: one plan file forced all 133 fixtures on a push whose subject was a
# one-line change.
#
# RESOLVED FROM THE DECLARATION, so this is not a second copy of the list. When the declaring
# script is absent -- it is distribution-only, and a consumer does not have it -- the set is
# EMPTY and this reduces to the previous behaviour exactly. Both hooks run this same code and
# I66 compares them on executable lines.
#
# `.git` is dropped here because it is already excluded, separately and on different grounds,
# at both of the sites below.
readset_excluded_re() {
  local decl="scripts/suite-content-key.sh" tops t re=""
  [ -f "$decl" ] || return 0
  tops="$(sed -n '/^# EXCLUDE_BEGIN$/,/^# EXCLUDE_END$/p' "$decl" \
          | sed -n 's/^\([A-Za-z0-9._-]\{1,\}\)$/\1/p' | grep -v '^\.git$')"
  [ -n "$tops" ] || return 0
  for t in $tops; do
    re="${re}|^$(printf '%s' "$t" | sed 's/\./\\./g')(/|$)"
  done
  printf '%s' "${re#|}"
}

# Drop every path the exclusion set covers. A no-op when the set is empty -- which is the
# consumer case, and must stay a no-op there rather than filtering on an empty pattern, since
# `grep -vE ""` matches everything and would empty the stream.
readset_drop_excluded() { # reads stdin, writes stdout
  local re; re="$(readset_excluded_re)"
  if [ -n "$re" ]; then grep -vE "$re"; else cat; fi
}

readset_manifest() {
  local out="$1"
  { git ls-files 2>/dev/null
    [ -s "$READSET_MAP" ] && grep -v '^#' "$READSET_MAP" | cut -f2
  } | grep -v '^\.git/' | grep -v '^\.git$' | readset_drop_excluded | sort -u > "$out/.paths"
  while IFS= read -r p; do [ -f "$p" ] && printf '%s\n' "$p"; done < "$out/.paths" > "$out/.files"
  xargs -n 200 shasum -a 256 < "$out/.files" 2>/dev/null \
    | awk '{ path = $0; sub(/^[0-9a-f]+  /, "", path); print path "\t" $1 }' | sort > "$out/.now"
}

apply_readset_skip() {
  local list="$1" out="$2" n_all n_sel n_skip

  n_all="$(grep -c . "$list" 2>/dev/null)"; case "$n_all" in ''|*[!0-9]*) n_all=0 ;; esac

  # THE MANIFEST IS BUILT FIRST, BEFORE ANY EARLY RETURN, because the run that cannot skip is
  # exactly the run that must leave a state behind for the next one. Computed only here and
  # copied by the caller on a green run: if it were built after the early returns, the first
  # run would write nothing, the second would find no state, and the skip could never
  # bootstrap -- a mechanism that is always inert and never says so.
  readset_manifest "$out"

  if [ "${AI_DLC_FIXTURE_NO_SKIP:-}" = "1" ]; then
    printf '   ..    read-set skip OFF (AI_DLC_FIXTURE_NO_SKIP=1) -- running all %s\n' "$n_all"
    return 0
  fi
  if [ ! -s "$READSET_MAP" ]; then
    printf '   ..    no read-set map at %s -- running all %s\n' "$READSET_MAP" "$n_all"; return 0
  fi
  if [ ! -s "$VERIFIED_RECORD" ]; then
    printf '   ..    no verified-state record yet -- running all %s (this run writes one)\n' "$n_all"; return 0
  fi

  [ -s "$out/.now" ] || { printf '   ..    could not hash the working tree -- running all %s\n' "$n_all"; return 0; }

  # A path is changed if its hash moved, if it appeared, or if it vanished. comm -3 reports
  # exactly those three, and the parent directory rides along because adding or removing an
  # entry changes what a listing of that directory returns -- which is how a fixture that
  # globs a directory depends on it.
  comm -3 "$VERIFIED_RECORD" "$out/.now" 2>/dev/null | sed 's/^\t//' | cut -f1 | sort -u > "$out/.changed"

  # TWO SETS, AND CONFLATING THEM MAKES THE SKIP INERT. `.changed` is what actually moved and
  # is the ONLY thing the orphan test below may consider. `.match` adds each changed path's
  # parent directory, because adding or removing an entry changes what a listing of that
  # directory returns -- which is how a fixture that globs a directory depends on it.
  # A synthesised parent is not itself a change, so putting it in `.changed` made every run
  # report "a changed path no fixture reads" and fall back to the full suite: measured, the
  # skip could never fire once, in any scenario, and said so in wording that read like caution.
  # A PARENT RIDES ALONG ONLY FOR AN APPEARANCE OR A DISAPPEARANCE, never for a plain edit.
  # Adding or removing an entry changes what a listing of that directory returns, which is how
  # a fixture that globs a directory depends on it; rewriting a file's contents does not. Doing
  # it for every changed path instead selects every fixture that ever stat'd the enclosing
  # directory, which quietly turns the skip back into a full run.
  cut -f1 "$VERIFIED_RECORD" | sort > "$out/.was"
  cut -f1 "$out/.now"        | sort > "$out/.is"
  { comm -23 "$out/.was" "$out/.is"; comm -13 "$out/.was" "$out/.is"; } | sort -u > "$out/.appeared"
  { cat "$out/.changed"; sed -n 's|/[^/]*$||p' "$out/.appeared" | grep -v '^$'; } \
    | sort -u > "$out/.match"

  if [ ! -s "$out/.changed" ]; then
    printf '   ..    read-set map: nothing changed since the last verified state -- running all %s (the content key owns that case)\n' "$n_all"
    return 0
  fi

  # A changed path no fixture is known to read cannot be reasoned about: either it genuinely
  # affects nothing, or the map is stale and a fixture reads it without our knowing. The two
  # are indistinguishable from here, so this runs everything.
  # Same exclusion as the manifest, and it has to be the same or the two disagree: a `.git`
  # path left in the universe but absent from the manifest can never be compared, while one in
  # the manifest but not the universe would read as "changed, and no fixture reads it" and
  # force a full run on every commit -- the failure this exclusion exists to prevent, arriving
  # through the other side of the same join.
  grep -v '^#' "$READSET_MAP" | cut -f2 | grep -v '^\.git/' | grep -v '^\.git$' \
    | readset_drop_excluded | sort -u > "$out/.universe"
  comm -23 "$out/.changed" "$out/.universe" > "$out/.orphan"
  if [ -s "$out/.orphan" ]; then
    printf '   ..    read-set map: %s changed path(s) are in NO fixture read-set (e.g. %s) -- running all %s\n' \
      "$(grep -c . "$out/.orphan")" "$(head -1 "$out/.orphan")" "$n_all"
    return 0
  fi

  # Selected = every fixture naming a changed path, PLUS every fixture with no map entry.
  # The second half is the fail-closed one: absence from the map means "unknown", never
  # "depends on nothing".
  awk -F'\t' 'NR==FNR { ch[$0]=1; next } /^#/ { next } ch[$2] { sel[$1]=1 }
              END { for (f in sel) print f }' "$out/.match" "$READSET_MAP" | sort -u > "$out/.sel"
  grep -v '^#' "$READSET_MAP" | cut -f1 | sort -u > "$out/.mapped"
  while IFS= read -r d; do
    b="${d%/}"; b="${b##*/}"
    if ! grep -qxF "$b" "$out/.mapped"; then printf '%s\n' "$b" >> "$out/.sel"; fi
  done < "$list"
  sort -u -o "$out/.sel" "$out/.sel"

  : > "$out/.list.sel"
  while IFS= read -r d; do
    b="${d%/}"; b="${b##*/}"
    if grep -qxF "$b" "$out/.sel"; then printf '%s\n' "$d" >> "$out/.list.sel"; fi
  done < "$list"

  n_sel="$(grep -c . "$out/.list.sel" 2>/dev/null)"; case "$n_sel" in ''|*[!0-9]*) n_sel=0 ;; esac
  n_skip=$(( n_all - n_sel ))
  if [ "$n_sel" -eq 0 ]; then
    printf '   ..    read-set map selected NOTHING from %s changed path(s) -- running all %s rather than trusting an empty selection\n' \
      "$(grep -c . "$out/.changed")" "$n_all"
    return 0
  fi
  mv "$out/.list.sel" "$list"
  printf '   ..    read-set map: %s changed path(s) select %s of %s fixtures; SKIPPING %s\n' \
    "$(grep -c . "$out/.changed")" "$n_sel" "$n_all" "$n_skip"
  return 0
}

run_fixtures() {
  local rc=0 d b out n_expected n_actual n_ordered verdict
  out="$(mktemp -d)" || return 1
  # DOT-PREFIXED, and that is what makes the name collision-proof rather than
  # unlikely. Every verdict file in "$out" is named for a fixture, and the glob
  # below cannot match a directory whose name begins with a dot -- so no fixture
  # can ever be called `.dur` and land on top of this one.
  mkdir -p "$out/.dur" || { rm -rf "$out"; return 1; }

  for d in core/fixtures/*/; do
    [ -f "$d/run.sh" ] || continue
    printf '%s\n' "$d"
  done > "$out/list"
  # `grep -c .` PRINTS 0 and EXITS 1 on an empty file, so the obvious
  # `$(grep -c . "$f" || echo 0)` yields the two-line string "0\n0" — and both
  # integer tests in this function then die with "integer expression expected",
  # take their false branch, and the suite returns 0 having run nothing. That is
  # how the empty-suite guard below shipped UNABLE TO FIRE: the line was present,
  # the mechanism was not, and a fixture driving the real hook is what found it.
  # Normalise to a bare integer instead of rescuing a failed exit status.
  # Reduce the list to what a change can affect BEFORE the count is taken, so `n_expected` and
  # the verdict-completeness assertion below both speak about the set actually dispatched. A
  # skip applied after the count would make every skipped fixture read as a dropped worker.
  apply_readset_skip "$out/list" "$out"

  n_expected="$(grep -c . "$out/list" 2>/dev/null)"
  case "$n_expected" in ''|*[!0-9]*) n_expected=0 ;; esac
  if [ "$n_expected" -eq 0 ]; then
    printf '   FAIL  no fixtures found -- an empty suite passes every assertion it never made\n'
    rm -rf "$out"; return 1
  fi

  # DISPATCH LONGEST-FIRST, FROM WHAT THE LAST RUN ACTUALLY COST.
  #
  # A pool's makespan is decided by when its longest unit STARTS. Dispatched in glob
  # order the poles are picked up wherever the alphabet puts them, and the tail is one
  # long unit finishing alone: measured on the reference consumer at width 16, its two
  # heaviest units sat at positions 62 and 63 of 109 and the pole began 5.5s in.
  # Longest-first started it at 0.0s and took the suite from a 30.83s median to 28.61s
  # over four alternating pairs whose two sets of readings do not overlap -- ~7%.
  #
  # AND IT IS NOT FREE, WHICH IS WHY THE ORDER IS NOT ALSO A CLAIM ABOUT SPEED. Running
  # the heavy units together makes each of them slower: the same measurement puts the
  # consumer's pole at 25.30s dispatched late against 28.46s dispatched first, so a 5.5s
  # head start bought 2.4s. On THIS repository's own suite that trade comes out level --
  # `enforcement-map-sites` alone is 144s of a 148s wall, so no dispatch order can win
  # more than 2.5% here and this one wins nothing measurable. The reorder ships for the
  # consumer's schedule shape, and the distribution carries it because I66 makes the two
  # runners one program. A `hoist the K longest, leave the rest alphabetical` variant was
  # measured too and lost to plain longest-first, so nothing here carries a tuning
  # constant that §7's gate item 3 would have to expire.
  #
  # THE RECORD IS WRITTEN BY THE PREVIOUS RUN AND LIVES UNDER .git, for I55 arm 4's
  # reason exactly: the content key hashes the working tree, so a cost record inside it
  # would change the key that decides whether this suite runs at all.
  #
  # THE FALLBACK IS THE LIST, and it is reached three ways -- no record yet (every first
  # run on a fresh clone), an unreadable one, and a reordering that did not come back
  # with exactly the units it was given. The last is the guard that matters: a reorder
  # which DROPS a unit reads exactly like a reorder that is fast. It cannot hide even if
  # this guard were removed, because `n_expected` and the report below are both taken
  # from "$out/list" and never from the dispatch order -- so a dropped unit still reaches
  # the reader, still finds no verdict, and still fails the push.
  cp "$out/list" "$out/.order"
  if [ -s "$DURATIONS_RECORD" ]; then
    awk 'NR==FNR { if (NF == 2) prev[$1] = $2; next }
         { b = $0; sub(/\/$/, "", b); sub(/.*\//, "", b)
           print ((b in prev) ? prev[b] : 999999) " " $0 }' \
        "$DURATIONS_RECORD" "$out/list" 2>/dev/null \
      | sort -k1,1nr | cut -d' ' -f2- > "$out/.order.lpt" 2>/dev/null
    n_ordered="$(grep -c . "$out/.order.lpt" 2>/dev/null)"
    case "$n_ordered" in ''|*[!0-9]*) n_ordered=0 ;; esac
    [ "$n_ordered" -eq "$n_expected" ] && mv "$out/.order.lpt" "$out/.order"
  fi

  # Each worker records its verdict to a file named for its fixture. The verdict is read
  # back from those FILES, not from xargs exit status, because that is what makes the
  # completeness assertion below possible -- and because `xargs` collapses any number of
  # failures into one exit code that cannot say WHICH.
  #
  # It records its own COST beside the verdict, in whole seconds off the worker shell's
  # own SECONDS -- no clock fork, and a unit never dispatched simply has no line, which
  # is the reading the ordering above wants anyway. A fixture the record has never seen
  # sorts FIRST: an unknown cost is treated as the largest, because the failure mode
  # worth avoiding is a new heavy unit dispatched last.
  AI_DLC_FX_OUT="$out" xargs -P "$FIXTURE_JOBS" -I{} bash -c '
    d="$1"; b="$(basename "$d")"
    if bash "$d/run.sh" >/dev/null 2>&1; then printf ok   > "$AI_DLC_FX_OUT/$b"
    else                                      printf FAIL > "$AI_DLC_FX_OUT/$b"; fi
    printf "%s %s\n" "$b" "$SECONDS" > "$AI_DLC_FX_OUT/.dur/$b"
  ' _ {} < "$out/.order"

  # Rendered in list order, so the output is deterministic and diffable across runs even
  # though the work completed out of order.
  n_actual=0
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    b="$(basename "$d")"
    if [ ! -f "$out/$b" ]; then
      printf '   FAIL  %s  (no verdict recorded)\n' "$b"; rc=1; continue
    fi
    n_actual=$((n_actual + 1))
    verdict="$(cat "$out/$b")"
    if [ "$verdict" = ok ]; then printf '   ok    %s\n' "$b"
    else                        printf '   FAIL  %s\n' "$b"; rc=1; fi
  done < "$out/list"

  # THE CONTROL PARALLELISM MAKES NECESSARY. Serially, a fixture that never ran could not
  # print an `ok` -- the loop and the report were the same thing. With a worker pool they
  # are not: a dropped job produces no verdict file, and a suite reporting 70 greens
  # instead of 75 reads exactly like a suite that passed. This is the check-that-cannot-
  # fire class one layer out, so the count is asserted rather than assumed.
  #
  # WHICH OF THE TWO ARMS DOES THE DETECTING, measured rather than asserted, because
  # this comment used to imply the count was an independent detector and it is not.
  # The report walks the LIST, so a missing verdict is caught by the `[ ! -f ]` branch
  # above; `n_actual` is incremented on exactly the path that branch skips, so the
  # count below can only fire when that branch already has. Its contribution is
  # MAGNITUDE -- one line saying how much of the suite is missing, instead of N lines
  # each saying one fixture is. `consumer-suite-pool`'s M2b mutant is the measurement:
  # remove the per-fixture branch and a lost worker is misreported as a failing
  # fixture while this count stays silent.
  if [ "$n_actual" -ne "$n_expected" ]; then
    printf '   FAIL  %s of %s fixtures produced a verdict -- the pool dropped work, and a short green suite reads exactly like a passing one\n' \
      "$n_actual" "$n_expected"
    rc=1
  fi

  # Publish this run's costs for the next run to dispatch on. One `cat` for the whole
  # suite rather than a read per unit: §7 gate item 2 is that a fork per item is the
  # shape that makes a runner system-bound, and this runner is the thing that finding
  # came out of. A run that recorded nothing leaves the previous record alone rather
  # than replacing it with an empty file, which would silently cost the NEXT run its
  # ordering as well.
  cat "$out"/.dur/* > "$out/.durations" 2>/dev/null
  [ -s "$out/.durations" ] && cp "$out/.durations" "$DURATIONS_RECORD" 2>/dev/null

  # PUBLISH THE VERIFIED STATE ONLY ON A FULLY GREEN RUN, and that condition is the whole
  # safety of the skip. The record means "every fixture's verdict is known good at these file
  # contents". Writing it after a red run would mark the failing state as verified, and the
  # next push -- changing something else entirely -- would skip the fixture that is still
  # broken and report green.
  if [ "$rc" -eq 0 ] && [ -s "$out/.now" ]; then cp "$out/.now" "$VERIFIED_RECORD" 2>/dev/null; fi

  rm -rf "$out"
  return $rc
}
# FIXTURE_POOL_END

# THE SUITE DOES NOT RE-RUN OVER A TREE IT ALREADY RAN OVER.
#
# ~50s of the operator's inner loop was being spent re-deriving 84 identical
# verdicts on pushes that changed CHANGELOG.md, VERSION or docs/ and nothing else.
# `scripts/suite-content-key.sh` hashes a SUPERSET of everything the suite can
# read -- listings, contents, exec bits, symlink targets, the tracked-path set,
# the fixture set and the external tools -- and a hit means the suite already ran
# over byte-identical inputs. Read that script's header for the exclusion set and
# the mutation measurement behind it; I55 keeps the exclusions honest.
#
# THIS IS THE CHECK-THAT-CANNOT-FIRE SHAPE AND IT IS TREATED AS ONE. Four
# consequences, all deliberate:
#
#   1. A hit ANNOUNCES ITSELF, names its key, and prints what the key covers. A
#      cached green that looked like an ordinary green would be the defect.
#   2. The final summary line says the suite was skipped, so no run reports "all
#      gates green" while hiding that its largest gate did not execute.
#   3. Every failure path -- key script errors, empty key, unreadable record,
#      malformed record, a changed fixture count -- runs the suite. The skip is
#      the exceptional branch and it needs everything to line up; the full run is
#      what happens by default.
#   4. AI_DLC_FIXTURE_NO_SKIP=1 forces the run, on the record, for an operator who
#      wants the suite regardless.
#
# The record lives in .git/, NOT in the working tree, and that is load-bearing: a
# record inside the tree would be hashed by the key it stores, so writing it would
# invalidate it and no push could ever hit.
KEY_RECORD=".git/ai-dlc-suite-key"

# THE HIT RATE IS THE ONE NUMBER THIS CHANGE COULD NOT MEASURE BEFORE SHIPPING.
# main is squash-merged, so its history records releases and not the pushes inside
# them, which is exactly where the repeat runs happen. The release-granularity
# proxy is 2 of the last 60 commits; the inner-loop rate is higher and unknown.
# So the instrument ships with the change: one line per decision, countable with
#   awk '{print $2}' .git/ai-dlc-suite-key.log | sort | uniq -c
KEY_LOG=".git/ai-dlc-suite-key.log"
key_log() { printf '%s %s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "${2:-none}" >> "$KEY_LOG" 2>/dev/null || true; }

fixture_suite_step() {
  local key cached_key cached_n cached_when n_now record

  # Counted the way run_fixtures counts, so the number in the announce is the
  # number the last green run actually reported. `ls -d core/fixtures/*/` would be
  # three higher -- it includes the data-only directories that carry no run.sh --
  # and an announce saying "87 of 87" beside a suite that prints 84 verdicts is a
  # discrepancy an operator has to go and resolve before they can trust the skip.
  n_now="$(for d in core/fixtures/*/; do [ -f "$d/run.sh" ] && printf 'x\n'; done | wc -l | tr -d ' ')"

  if [ -n "${AI_DLC_FIXTURE_NO_SKIP:-}" ]; then
    printf '   (content-key skip disabled by AI_DLC_FIXTURE_NO_SKIP)\n'
    key="$(bash scripts/suite-content-key.sh 2>/dev/null)" || key=""
    key_log FORCED "$key"
  elif ! key="$(bash scripts/suite-content-key.sh 2>/dev/null)" || [ -z "$key" ]; then
    printf '   (content key unavailable -- running the suite)\n'
    key=""
    key_log UNAVAILABLE
  elif [ ! -r "$KEY_RECORD" ]; then
    printf '   (no prior green run recorded for this clone -- running the suite)\n'
    key_log MISS "$key"
  else
    record="$(cat "$KEY_RECORD" 2>/dev/null)"
    cached_key="$(printf '%s\n' "$record" | awk 'NR==1{print $1}')"
    cached_n="$(printf '%s\n'   "$record" | awk 'NR==1{print $2}')"
    cached_when="$(printf '%s\n' "$record" | awk 'NR==1{print $3}')"
    if [ "$cached_key" = "$key" ] && [ -n "$cached_n" ] && [ "$cached_n" = "$n_now" ]; then
      printf '   SKIPPED -- this exact tree already passed the whole suite.\n'
      printf '     key          %s\n' "$key"
      printf '     last green   %s of %s fixtures at %s\n' "$cached_n" "$n_now" "${cached_when:-unknown}"
      bash scripts/suite-content-key.sh --summary 2>/dev/null | sed 's/^/     /'
      printf '     force a run with AI_DLC_FIXTURE_NO_SKIP=1\n'
      SUITE_SKIPPED=1
      key_log HIT "$key"
      return 0
    fi
    if [ -n "$cached_n" ] && [ "$cached_n" != "$n_now" ]; then
      printf '   (fixture count moved %s -> %s -- running the suite)\n' "$cached_n" "$n_now"
    else
      printf '   (content key changed -- running the suite)\n'
    fi
    key_log MISS "$key"
  fi

  run_fixtures || return 1

  # Recorded only after a full green run. A partial or red suite leaves the prior
  # record in place rather than blessing the tree that just failed.
  #
  # AND ONLY IF THE SUITE LEFT THE TREE AS IT FOUND IT. A fixture is supposed to do
  # all of its work in a sandbox; one that writes into the repository under test is
  # a writer racing the fifteen readers beside it, and v0.208.0 shipped a fix for
  # exactly that -- `taught-schema` was dropping a probe into core/team-roles/ and
  # transiently stripping the real provenance schema, which killed
  # `enforcement-map-sites`' seed on whichever assertion happened to be copying.
  #
  # This catches the half of that class that SURVIVES the run: a fixture that
  # changes the tree and does not put it back. Recording the pre-run key then would
  # bless a tree that no longer exists. It does NOT catch a transient write that is
  # cleaned up -- that needs filesystem watching, and no cheap sound mechanism for
  # it exists; a grep over the fixtures cannot tell a sandbox $ROOT from the real
  # one (measured: the false-positive set is most of the seed corpus).
  if [ -n "$key" ] && [ "${n_now:-0}" -gt 0 ]; then
    local key_after
    key_after="$(bash scripts/suite-content-key.sh 2>/dev/null)" || key_after=""
    if [ -z "$key_after" ]; then
      printf '   (content key unavailable after the run -- not recording)\n'
    elif [ "$key_after" != "$key" ]; then
      printf '   NOT RECORDING: the suite CHANGED the tree it just tested.\n'
      printf '     before %s\n     after  %s\n' "$key" "$key_after"
      printf '     A fixture wrote into the repository instead of its own sandbox. The verdicts\n'
      printf '     above were taken against a tree that no longer exists, and recording this key\n'
      printf '     would let a later push skip on evidence from a different tree. Find the writer;\n'
      printf '     `git status` names it. The suite still PASSED -- this only refuses the cache.\n'
    else
      printf '%s %s %s\n' "$key" "$n_now" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$KEY_RECORD" 2>/dev/null || true
    fi
  fi
  return 0
}

SUITE_SKIPPED=0
step "fixture suite (${FIXTURE_JOBS}-way)" fixture_suite_step

# 4. A shipped script with a syntax error is a gate that cannot run at all.
#    validate-enforcement-map.sh maps this glob set through map_consumer() and
#    asserts it equals the set in core/git-hooks/pre-push. Add a class here and the
#    consumer hook fails until it carries the class too.
# SYNTAX_GLOB_BEGIN
syntax_all() {
  local rc=0 f
  for f in scripts/*.sh core/scripts/*.sh core/hooks/*.sh \
           core/skills/ai-dlc-update/reconcile/*.sh .githooks/*; do
    [ -f "$f" ] || continue
    bash -n "$f" 2>/dev/null || { printf '   syntax error: %s\n' "$f"; rc=1; }
  done
  return $rc
}
# SYNTAX_GLOB_END
step "shell syntax (every shipped script and hook)" syntax_all

if [ "$fail" -ne 0 ]; then
  printf '\npre-push: BLOCKED. Fix the above, or `git push --no-verify` on the record.\n\n'
  exit 1
fi
if [ "$SUITE_SKIPPED" -ne 0 ]; then
  printf '\npre-push: all gates green -- FIXTURE SUITE SKIPPED on an unchanged content key.\n\n'
  exit 0
fi
printf '\npre-push: all gates green.\n\n'
